<ui:FluentWindow x:Class="Retail.App.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="Retail - Sistema ERP &amp; Punto de Venta"
                   Width="1180"
                   Height="680"
                   MinWidth="960"
                   MinHeight="560"
                   WindowStartupLocation="CenterScreen"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica"
                   Background="{DynamicResource SurfaceBackgroundBrush}"
                   BorderThickness="0"
                   BorderBrush="Transparent"
                   Padding="0">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Estilo dinámico de ancho para el Sidebar colapsable con transición fluida Fluent -->
        <Style x:Key="CollapsibleSidebarBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="Width" Value="58" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="200"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="58"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Columna 0: Sidebar a altura completa -->
            <ColumnDefinition Width="Auto" />
            <!-- Columna 1: Barra de título y contenedor de vistas -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================= -->
        <!-- 1. SIDEBAR LATERAL (ALTURA COMPLETA FLUENT)                   -->
        <!-- ============================================================= -->
        <Border Grid.Column="0"
                Style="{StaticResource CollapsibleSidebarBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Cabecera: solo botón de Toggle / Hamburguesa -->
                        <RowDefinition Height="Auto" />
                        <!-- Lista de Módulos (Scrollable) -->
                        <RowDefinition Height="*" />
                        <!-- Pie del Sidebar: Operador, Rol y Cambio de Usuario -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- CABECERA: Botón Toggle Colapso -->
                    <Border Grid.Row="0"
                            Height="48"
                            BorderThickness="0"
                            Padding="8,8">
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource SidebarHamburgerButtonStyle}"
                                VerticalAlignment="Center">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Expandir menú lateral" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                            <Setter Property="Text" Value="Contraer menú lateral" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Style="{StaticResource KeycapBadgeStyle}">
                                            <TextBlock Text="Ctrl+B" Style="{StaticResource TextBlockKeycap}" />
                                        </Border>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <iconPacks:PackIconBoxIcons Width="20"
                                                        Height="20"
                                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                <iconPacks:PackIconBoxIcons.Style>
                                    <Style TargetType="iconPacks:PackIconBoxIcons">
                                        <Setter Property="Kind" Value="RegularMenu" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="Kind" Value="RegularDockLeftArrow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconBoxIcons.Style>
                            </iconPacks:PackIconBoxIcons>
                        </Button>
                    </Border>

                    <!-- CUERPO DEL SIDEBAR: BOTONERA DE MÓDULOS -->
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource SidebarScrollViewerStyle}"
                                  Padding="6,8">
                        <StackPanel>
                            <!-- SECCIÓN: OPERACIONES DE MOSTRADOR -->
                            <TextBlock Text="OPERACIONES DE MOSTRADOR"
                                       Style="{StaticResource TextBlockCaption}"
                                       Foreground="{DynamicResource SidebarTextMutedBrush}"
                                       FontWeight="Bold"
                                       Margin="12,14,12,6"
                                       FontSize="10"
                                       Visibility="{Binding MostrarCabecerasOperativas, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- 1. Punto de Venta (POS) [F1] -->
                            <Button Command="{Binding NavegarPosCommand}"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Pos">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Punto de Venta (POS)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="F1" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularStoreAlt2"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Punto de Venta"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 2. Catálogo de Artículos [F2] -->
                            <Button Command="{Binding NavegarArticulosCommand}"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Articulos">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Catálogo de Artículos" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="F2" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularBook"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Artículos"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 3. Clientes y Cuentas Corrientes [F4] -->
                            <Button Command="{Binding NavegarClientesCommand}"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Clientes">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Clientes" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="F4" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularUser"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Clientes"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 4. Turnos de Caja [F5] -->
                            <Button Command="{Binding NavegarCajaCommand}"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Caja">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Caja y Turnos" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="F5" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularDollarCircle"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Caja y Turnos"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 5. Presupuestos [F6] -->
                            <Button Command="{Binding NavegarPresupuestosCommand}"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Presupuestos">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Presupuestos" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="F6" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularFile"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Presupuestos"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- Divisor de Grupo: Mostrador a Gestión & Stock (oculto para el Administrador) -->
                            <Border Height="1"
                                    Background="{DynamicResource SidebarBorderBrush}"
                                    Margin="10,10,10,8"
                                    SnapsToDevicePixels="True"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- SECCIÓN: GESTIÓN & STOCK -->
                            <TextBlock Text="GESTIÓN &amp; STOCK"
                                       Style="{StaticResource TextBlockCaption}"
                                       Foreground="{DynamicResource SidebarTextMutedBrush}"
                                       FontWeight="Bold"
                                       Margin="12,14,12,6"
                                       FontSize="10"
                                       Visibility="{Binding MostrarCabecerasOperativas, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- 6. Compras a Distribuidores -->
                            <Button Command="{Binding NavegarComprasCommand}"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Compras">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <TextBlock Text="Compras" FontWeight="SemiBold" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularPackage"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Compras"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 6.1 Pedidos a Proveedores (Track 4.3): solo Encargado y Gerente (A-14) -->
                            <Button Command="{Binding NavegarPedidosCommand}"
                                    Visibility="{Binding PuedeAbastecer, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Pedidos">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <TextBlock Text="Pedidos a Proveedores" FontWeight="SemiBold" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularCart"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Pedidos"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 7. Proveedores -->
                            <Button Command="{Binding NavegarProveedoresCommand}"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Proveedores">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <TextBlock Text="Padrón de Proveedores" FontWeight="SemiBold" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularTruck"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Proveedores"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 8. Catálogos Mayoristas e Importador -->
                            <Button Command="{Binding NavegarCatalogosCommand}"
                                    Visibility="{Binding PuedeOperarNegocio, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Catalogos">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <TextBlock Text="Catálogos Mayoristas e Importador" FontWeight="SemiBold" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularFileDetail"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Catálogos"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- Divisor de Grupo: Gestión a Administración (solo el Gerente ve ambos grupos) -->
                            <Border Height="1"
                                    Background="{DynamicResource SidebarBorderBrush}"
                                    Margin="10,10,10,8"
                                    SnapsToDevicePixels="True"
                                    Visibility="{Binding EsGerente, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- SECCIÓN: ADMINISTRACIÓN (Gerente o Administrador, con el sidebar expandido) -->
                            <TextBlock Text="ADMINISTRACIÓN"
                                       Style="{StaticResource TextBlockCaption}"
                                       Foreground="{DynamicResource SidebarTextMutedBrush}"
                                       FontWeight="Bold"
                                       Margin="12,14,12,6"
                                       FontSize="10"
                                       Visibility="{Binding MostrarCabeceraAdmin, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Tablero gerencial (Solo Gerente) -->
                            <Button Command="{Binding NavegarTableroCommand}"
                                    Visibility="{Binding EsGerente, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Tablero">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <TextBlock Text="Tablero gerencial" FontWeight="SemiBold" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularBarChart"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Tablero"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 8. Consola Fiscal ARCA [F9] (Solo Gerente) -->
                            <Button Command="{Binding NavegarConsolaFiscalCommand}"
                                    Visibility="{Binding EsGerente, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Fiscal">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Consola Fiscal" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="F9" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularBadgeCheck"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Consola Fiscal"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 9. Operadores y Roles [F10] (Gerente o Administrador) -->
                            <Button Command="{Binding NavegarUsuariosCommand}"
                                    Visibility="{Binding PuedeGestionarUsuarios, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Usuarios">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Usuarios y Roles" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="F10" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularUserIdCard"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Operadores"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- 10. Respaldos [F11] (Gerente o Administrador; el Administrador solo consulta) -->
                            <Button Command="{Binding NavegarRespaldosCommand}"
                                    Visibility="{Binding PuedeGestionarUsuarios, Converter={StaticResource BoolToVisConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Respaldos">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Respaldos" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="F11" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularSave"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Respaldos"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- TEMPORAL (desarrollo): acceso a la galería de estilos para revisar componentes a mano. Se quita
                                 antes del release de producción (Etapa 6), junto con este divisor. -->
                            <Border Height="1"
                                    Margin="12,8"
                                    Background="{DynamicResource SidebarBorderBrush}" />
                            <Button Command="{Binding NavegarGaleriaDevCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModuloActivo}" Value="Galeria">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <TextBlock Text="Galería de estilos (Dev)" FontWeight="SemiBold" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularPalette"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Galería (Dev)"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PIE DEL SIDEBAR: Operador Activo, Rol y Único Botón de Cambio de Sesión -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,10">
                        <StackPanel>
                            <!-- Ficha de Operador Expandida -->
                            <!-- Operador activo: avatar circular, nombre y rol en texto plano (sin tarjeta ni borde) -->
                            <Grid Margin="6,0,6,12"
                                  Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{DynamicResource SidebarTextStrongBrush}"
                                        Margin="0,0,12,0">
                                    <iconPacks:PackIconBoxIcons Kind="SolidUser"
                                                                Width="18"
                                                                Height="18"
                                                                Foreground="{DynamicResource SidebarBackgroundBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OperadorNombre}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource SidebarTextStrongBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OperadorRol}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            
                            <!-- ÚNICO BOTÓN DE CAMBIO DE OPERADOR (RF-02) -->
                            <Button Command="{Binding CambiarUsuarioCommand}"
                                    Style="{StaticResource SidebarGhostButtonStyle}"
                                    ToolTipService.Placement="Right"
                                    ToolTipService.HorizontalOffset="8"
                                    ToolTipService.VerticalOffset="4"
                                    HorizontalContentAlignment="Center"
                                    Padding="6,6">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Cambiar Operador" FontWeight="SemiBold" Margin="0,0,6,0" />
                                            
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
                                    <TextBlock Text="Cambiar Operador"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        <!-- ============================================================= -->
        <!-- 2. ÁREA DERECHA: BARRA DE TÍTULO + CONTENIDO PRINCIPAL        -->
        <!-- ============================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 2.1 BARRA DE TÍTULO FLUENT NATIVA (BORDERLESS & COMPACTA) -->
            <ui:TitleBar Grid.Row="0"
                         Title="Retail POS - Librería &amp; Punto de Venta"
                         Height="32"
                         MinHeight="32"
                         Padding="8,0"
                         BorderThickness="0"
                         BorderBrush="Transparent"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         FontFamily="{StaticResource FontFamilyText}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- 2.2 AVISO NO BLOQUEANTE DE RESTAURACIÓN RECIENTE (Gerente / Administrador, R-20) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,6"
                    Visibility="{Binding MostrarAvisoRestauracion, Converter={StaticResource BoolToVisConverter}}">
                <DockPanel LastChildFill="True">
                    <Button Command="{Binding CerrarAvisoRestauracionCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            DockPanel.Dock="Right"
                            Padding="8,2"
                            Margin="12,0,0,0"
                            Content="Entendido" />
                    <TextBlock Text="{Binding AvisoRestauracion}"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- 2.3 ÁREA DE CONTENIDO PRINCIPAL (Frame) -->
            <Frame x:Name="RootFrame"
                   Grid.Row="2"
                   NavigationUIVisibility="Hidden"
                   Background="{DynamicResource SurfaceBackgroundBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
