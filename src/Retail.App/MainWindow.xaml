<ui:FluentWindow x:Class="Retail.App.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="Retail - Sistema ERP &amp; Punto de Venta"
                   Width="1180"
                   Height="680"
                   MinWidth="960"
                   MinHeight="560"
                   WindowStartupLocation="CenterScreen"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica"
                   Background="{DynamicResource SurfaceBackgroundBrush}"
                   BorderThickness="0"
                   BorderBrush="Transparent"
                   Padding="0">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Estilo dinámico de ancho para el Sidebar colapsable con transición fluida Fluent -->
        <Style x:Key="CollapsibleSidebarBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="Width" Value="58" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="200"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="58"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Columna 0: Sidebar a altura completa -->
            <ColumnDefinition Width="Auto" />
            <!-- Columna 1: Barra de título y contenedor de vistas -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================= -->
        <!-- 1. SIDEBAR LATERAL (ALTURA COMPLETA FLUENT)                   -->
        <!-- ============================================================= -->
        <Border Grid.Column="0"
                Style="{StaticResource CollapsibleSidebarBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Cabecera: solo botón de Toggle / Hamburguesa -->
                        <RowDefinition Height="Auto" />
                        <!-- Lista de Módulos (Scrollable) -->
                        <RowDefinition Height="*" />
                        <!-- Pie del Sidebar: Operador, Rol y Cambio de Usuario -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- CABECERA: Botón Toggle Colapso -->
                    <Border Grid.Row="0"
                            Height="48"
                            BorderThickness="0"
                            Padding="8,8">
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource SidebarHamburgerButtonStyle}"
                                VerticalAlignment="Center">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Expandir menú lateral" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                            <Setter Property="Text" Value="Contraer menú lateral" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Style="{StaticResource KeycapBadgeStyle}">
                                            <TextBlock Text="Ctrl+B" Style="{StaticResource TextBlockKeycap}" />
                                        </Border>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <iconPacks:PackIconBoxIcons Width="20"
                                                        Height="20"
                                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                <iconPacks:PackIconBoxIcons.Style>
                                    <Style TargetType="iconPacks:PackIconBoxIcons">
                                        <Setter Property="Kind" Value="RegularMenu" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="Kind" Value="RegularDockLeftArrow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconBoxIcons.Style>
                            </iconPacks:PackIconBoxIcons>
                        </Button>
                    </Border>

                    <!-- CUERPO DEL SIDEBAR: BOTONERA DE MÓDULOS -->
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource SidebarScrollViewerStyle}"
                                  Padding="6,8">
                        <StackPanel>
                            <!-- Accesos del menú: salen del registro de navegación (RegistroNavegacion) según el rol del operador.
                                 Cada acceso abre su sección; con varias páginas, la página muestra bajo su título un selector
                                 para pasar de una a otra. -->
                            <ItemsControl ItemsSource="{Binding SeccionesMenu}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.IrASeccionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                            <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Detalle}"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource SidebarTextMutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding TieneDetalle, Converter={StaticResource BoolToVisConverter}}" />
                                                        <Border Style="{StaticResource KeycapBadgeStyle}"
                                                                Margin="8,0,0,0"
                                                                Visibility="{Binding TieneAtajo, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="{Binding Atajo}" Style="{StaticResource TextBlockKeycap}" />
                                                        </Border>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                            Kind="{Binding Icono}"
                                                                            Width="20"
                                                                            Height="20"
                                                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Titulo}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- TEMPORAL (desarrollo): acceso a la galería de estilos para revisar componentes a mano. Se quita
                                 antes del release de producción (Etapa 6), junto con este divisor. -->
                            <Border Height="1"
                                    Margin="12,8"
                                    Background="{DynamicResource SidebarBorderBrush}" />
                            <Button Command="{Binding NavegarGaleriaDevCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GaleriaActiva}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <TextBlock Text="Galería de estilos (Dev)" FontWeight="SemiBold" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularPalette"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Galería (Dev)"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PIE DEL SIDEBAR: Operador Activo, Rol y Único Botón de Cambio de Sesión -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,10">
                        <StackPanel>
                            <!-- Ayuda y Soporte: acceso fijo para todos los roles con atajo Ctrl+H -->
                            <Button Margin="0,0,0,8"
                                    Command="{Binding AbrirAyudaCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Ayuda y Soporte" FontWeight="SemiBold" Margin="0,0,6,0" />
                                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                                <TextBlock Text="Ctrl+H" Style="{StaticResource TextBlockKeycap}" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularHelpCircle"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Ayuda"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- Ajustes: acceso fijo sobre el operador (tema claro/oscuro y futuras configuraciones) -->
                            <Button Margin="0,0,0,8"
                                    Command="{Binding IrASeccionCommand}"
                                    CommandParameter="ajustes">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemAjustes.EsActiva}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <TextBlock Text="Ajustes" FontWeight="SemiBold" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                                Kind="RegularCog"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Ajustes"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Button>

                            <!-- Ficha de Operador Expandida -->
                            <!-- Operador activo: avatar circular, nombre y rol en texto plano (sin tarjeta ni borde) -->
                            <Grid Margin="6,0,6,12"
                                  Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{DynamicResource SidebarTextStrongBrush}"
                                        Margin="0,0,12,0">
                                    <iconPacks:PackIconBoxIcons Kind="SolidUser"
                                                                Width="18"
                                                                Height="18"
                                                                Foreground="{DynamicResource SidebarBackgroundBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OperadorNombre}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource SidebarTextStrongBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OperadorRol}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            
                            <!-- ÚNICO BOTÓN DE CAMBIO DE OPERADOR (RF-02) -->
                            <Button Command="{Binding CambiarUsuarioCommand}"
                                    Style="{StaticResource SidebarGhostButtonStyle}"
                                    ToolTipService.Placement="Right"
                                    ToolTipService.HorizontalOffset="8"
                                    ToolTipService.VerticalOffset="4"
                                    HorizontalContentAlignment="Center"
                                    Padding="6,6">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SidebarToolTipStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Cambiar Operador" FontWeight="SemiBold" Margin="0,0,6,0" />
                                            
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
                                    <TextBlock Text="Cambiar Operador"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        <!-- ============================================================= -->
        <!-- 2. ÁREA DERECHA: BARRA DE TÍTULO + CONTENIDO PRINCIPAL        -->
        <!-- ============================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 2.1 BARRA DE TÍTULO FLUENT NATIVA (BORDERLESS & COMPACTA) -->
            <ui:TitleBar Grid.Row="0"
                         Title="Retail POS - Librería &amp; Punto de Venta"
                         Height="32"
                         MinHeight="32"
                         Padding="8,0"
                         BorderThickness="0"
                         BorderBrush="Transparent"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         FontFamily="{StaticResource FontFamilyText}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}">
                <!-- Ícono vectorial (Icons.xaml): nítido con cualquier escalado de Windows, a diferencia del .ico. -->
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource ImagenIconoApp}" Width="16" Height="16" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- 2.2 AVISO NO BLOQUEANTE DE RESTAURACIÓN RECIENTE (Gerente / Administrador, R-20) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,6"
                    Visibility="{Binding MostrarAvisoRestauracion, Converter={StaticResource BoolToVisConverter}}">
                <DockPanel LastChildFill="True">
                    <Button Command="{Binding CerrarAvisoRestauracionCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            DockPanel.Dock="Right"
                            Padding="8,2"
                            Margin="12,0,0,0"
                            Content="Entendido" />
                    <TextBlock Text="{Binding AvisoRestauracion}"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- 2.3 ÁREA DE CONTENIDO PRINCIPAL (Frame) -->
            <Frame x:Name="RootFrame"
                   Grid.Row="2"
                   NavigationUIVisibility="Hidden"
                   Background="{DynamicResource SurfaceBackgroundBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
