<Window x:Class="Retail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retail - Sistema ERP &amp; Punto de Venta"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra Superior -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,12">
            <DockPanel>
                <TextBlock Text="Retail POS"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"
                           VerticalAlignment="Center" />
                <TextBlock Text=" - Sistema ERP &amp; Punto de Venta para Librería"
                           FontSize="14"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center" />
                <TextBlock Text="v1.0.0-preview (.NET 8 LTS)"
                           HorizontalAlignment="Right"
                           Foreground="#38BDF8"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Contenido Central Inicial -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="Cimientos de Arquitectura Inicializados Exitosamente"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <TextBlock Text="Clean Desktop Monolith (.NET 8 / WPF / MVVM)"
                       FontSize="14"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16" />
            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    MaxWidth="500">
                <StackPanel>
                    <TextBlock Text="Equipo de Desarrollo:" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBlock Text="• Pablo Fernandez (Líder Técnico / Backend)" Foreground="#475569" Margin="0,0,0,2"/>
                    <TextBlock Text="• Lucas Kruzolek (UI Designer / Frontend)" Foreground="#475569" Margin="0,0,0,12"/>
                    <TextBlock Text="Estado: Etapas 0.1 y 0.2 Concluidas (Scaffolding &amp; Estandarización)"
                               Foreground="#059669"
                               FontWeight="Medium" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Barra de Estado Inferior -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="12,6">
            <DockPanel>
                <TextBlock Text="Listo" FontSize="12" Foreground="#475569" />
                <TextBlock Text="LocalDB / En Memoria" HorizontalAlignment="Right" FontSize="12" Foreground="#64748B" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
