<ui:FluentWindow x:Class="Retail.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:dev="clr-namespace:Retail.App.Views.Dev"
                 Title="Retail - Sistema ERP &amp; Punto de Venta"
                 Width="1180"
                 Height="680"
                 MinWidth="960"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource SurfaceBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- BARRA SUPERIOR UNIFICADA CON BOTONES DE VENTANA FLUENT        -->
        <!-- ============================================================= -->
        <ui:TitleBar Grid.Row="0"
                     Title="Retail POS - Sistema ERP &amp; Punto de Venta para Librería"
                     Padding="8,0,0,0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BarcodeScanner24" Foreground="{DynamicResource PrimaryBrush}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleVista"
                            Click="BtnToggleVista_Click"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="10,4"
                            Margin="16,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtToggleIcon" Text="🎨" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtToggleText" Text="Ver Galería de Controles (Etapa 0.6)" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Border Background="{DynamicResource KeycapBackgroundBrush}"
                            BorderBrush="{DynamicResource KeycapBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0-preview (.NET 8 LTS | WPF-UI)"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ============================================================= -->
        <!-- CONTENIDO PRINCIPAL CONMUTABLE                                -->
        <!-- ============================================================= -->
        <Grid Grid.Row="1">
            <!-- Panel 1: Pantalla de Bienvenida y Estado del Proyecto -->
            <Grid x:Name="PanelBienvenida" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="Cimientos Técnicos y Sistema de Diseño Inicializados"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Clean Desktop Monolith (.NET 8 / WPF-UI / C# 12 / MVVM)"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />

                    <Border Style="{StaticResource CardBorderStyle}"
                            MaxWidth="560"
                            Padding="24">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Etapa 0.6: Sistema de Diseño XAML"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border HorizontalAlignment="Right"
                                        Style="{StaticResource BadgeSuccessStyle}">
                                    <TextBlock Text="Completada"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessForegroundBrush}" />
                                </Border>
                            </DockPanel>

                            <TextBlock Text="Responsable: Lucas Kruzolek (UI Designer / Frontend)"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Componentes listos: Paleta Carmín / Borravino (#9D0F33), Fluent System Icons, Cascadia Code para importes, botones con teclas F1-F12 y DataGrid estilizado."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Margin="0,0,0,16" />

                            <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="BtnToggleVista_Click"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Abrir Galería de Controles Interactiva" FontWeight="Bold" />
                                    <TextBlock Text=" →" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Panel 2: Galería de Controles (Living Styleguide) -->
            <Grid x:Name="PanelGaleria" Visibility="Collapsed">
                <dev:StyleGalleryView />
            </Grid>
        </Grid>


        <!-- ============================================================= -->
        <!-- BARRA DE ESTADO INFERIOR                                      -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Sistema Retail listo para mostrador" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="LocalDB / In-Memory Mock • Latencia &lt; 15 ms"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
