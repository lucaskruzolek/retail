<UserControl x:Class="Retail.App.Views.Dev.StyleGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="2400" d:DesignWidth="1100"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <!-- ================================================================================================================ -->
    <!-- GALERÍA DE ESTILOS: referencia viva del sistema de diseño (docs/SISTEMA_DE_DISENO.md). Todo lo que se ve acá usa  -->
    <!-- los estilos y componentes reales. Sigue su propia premisa: las muestras van sobre el fondo, separadas por títulos -->
    <!-- y aire, sin una tarjeta por sección; solo son superficie las piezas que lo son en la aplicación (tabla, sección  -->
    <!-- de modal, panel flotante). Bloques: A. Fundamentos · B. Componentes · C. Patrones de pantalla · D. Desarrollo.   -->
    <!-- ================================================================================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Título de bloque (A, B, C, D) y título de sección, con el aire que los separa del bloque anterior -->
        <Style x:Key="GaleriaBloqueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockHeader1}">
            <Setter Property="Margin" Value="0,48,0,4" />
        </Style>
        <Style x:Key="GaleriaSeccionStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockHeader2}">
            <Setter Property="Margin" Value="0,32,0,4" />
        </Style>
        <!-- Nota explicativa: cuándo se usa cada pieza (no repite el documento, orienta) -->
        <Style x:Key="GaleriaNotaStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockCaptionSecondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <!-- Rótulo chico sobre una muestra -->
        <Style x:Key="GaleriaRotuloStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockCaption}">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- Muestra de color: cuadrado de 40 con su nombre y su clave -->
        <Style x:Key="MuestraColorStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="MuestraColorCeldaStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Width" Value="248" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style x:Key="MuestraClaveStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockMonospaceCell}">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="1080">

            <components:PageHeader Titulo="Galería de estilos" Subtitulo="Referencia viva del sistema de diseño: fundamentos, componentes y patrones de pantalla con los estilos reales.">
                <Button Click="BtnAbrirModalMuestra_Click" Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularWindow" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Abrir modal de muestra" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </components:PageHeader>

            <!-- ============================================================================================ -->
            <!-- A. FUNDAMENTOS                                                                               -->
            <!-- ============================================================================================ -->
            <TextBlock Text="A. Fundamentos" Style="{StaticResource GaleriaBloqueStyle}" Margin="0,24,0,4" />
            <TextBlock Text="Las vistas piden un significado (SurfaceCardBrush), nunca un color: cada tema decide el valor. Grilla de 4 px, escala tipográfica fija y radios concéntricos."
                       Style="{StaticResource GaleriaNotaStyle}" />

            <!-- A.1 Color -->
            <TextBlock Text="Color: superficies y texto" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Casi todo es neutro. Las superficies se distinguen por tono, no por bordes gruesos; el texto tiene cuatro niveles de jerarquía."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <WrapPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SurfaceBackgroundBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Fondo de página" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SurfaceBackgroundBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SurfaceCardBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Superficie" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SurfaceCardBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource DialogBackgroundBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Fondo de modal" Style="{StaticResource TextBlockBody}" /><TextBlock Text="DialogBackgroundBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SurfaceSubtleBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Riel / insignia" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SurfaceSubtleBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SurfaceHoverBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Hover" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SurfaceHoverBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SurfaceSelectedBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Seleccionado" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SurfaceSelectedBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SurfacePressedBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Presionado" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SurfacePressedBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SurfaceBorderBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Borde" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SurfaceBorderBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Texto principal" Style="{StaticResource TextBlockBody}" /><TextBlock Text="TextPrimaryBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Texto secundario" Style="{StaticResource TextBlockBody}" /><TextBlock Text="TextSecondaryBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource TextSubtleBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Texto suave" Style="{StaticResource TextBlockBody}" /><TextBlock Text="TextSubtleBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource TextMutedBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Texto apagado" Style="{StaticResource TextBlockBody}" /><TextBlock Text="TextMutedBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SectionTitleBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Título de sección de modal e ícono" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SectionTitleBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
            </WrapPanel>

            <TextBlock Text="Color: acento y estado" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="El carmín se reserva para lo esencial: la acción principal, el foco, la casilla marcada y el filtro activo. Ámbar, rojo y verde solo comunican estado, nunca decoran."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <WrapPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource PrimaryBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Acento" Style="{StaticResource TextBlockBody}" /><TextBlock Text="PrimaryBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource PrimaryLightBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Acento suave" Style="{StaticResource TextBlockBody}" /><TextBlock Text="PrimaryLightBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource WarningBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Advertencia" Style="{StaticResource TextBlockBody}" /><TextBlock Text="WarningBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource DangerBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Error / peligro" Style="{StaticResource TextBlockBody}" /><TextBlock Text="DangerBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource MuestraColorCeldaStyle}">
                    <Border Style="{StaticResource MuestraColorStyle}" Background="{DynamicResource SuccessBrush}" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Éxito" Style="{StaticResource TextBlockBody}" /><TextBlock Text="SuccessBrush" Style="{StaticResource MuestraClaveStyle}" /></StackPanel>
                </StackPanel>
            </WrapPanel>

            <!-- A.2 Tipografía -->
            <TextBlock Text="Tipografía" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="DM Sans para la interfaz (DM Sans Display desde 20 px). Los importes se alinean a la derecha con cifras proporcionales; JetBrains Mono solo para lo que es un código. El peso y el color jerarquizan antes que el tamaño."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Título de página · 24 · TextBlockPageTitle" Style="{StaticResource TextBlockPageTitle}" Margin="{StaticResource StackMd}" />
                    <TextBlock Text="Título de modal o bloque · 20 · TextBlockHeader1" Style="{StaticResource TextBlockHeader1}" Margin="{StaticResource StackMd}" />
                    <TextBlock Text="Título de sección · TextBlockHeader2" Style="{StaticResource TextBlockHeader2}" Margin="{StaticResource StackMd}" />
                    <TextBlock Text="Cuerpo · 13 · descripciones y datos del cliente (14 en botones y celdas de grilla)." Style="{StaticResource TextBlockBody}" Margin="{StaticResource StackSm}" />
                    <TextBlock Text="Secundario · etiquetas de campo y textos de apoyo." Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackSm}" />
                    <TextBlock Text="Leyenda · 12 · metadatos y ayudas." Style="{StaticResource TextBlockCaption}" Margin="{StaticResource StackSm}" />
                    <TextBlock Text="7791234567890 · CUIT 30-71234567-8" Style="{StaticResource TextBlockMonospaceCell}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Importes alineados a la derecha" Style="{StaticResource GaleriaRotuloStyle}" />
                    <TextBlock Text="$ 43.350,50" Style="{StaticResource TextBlockDisplayCurrency}" HorizontalAlignment="Right" />
                    <TextBlock Text="$ 1.111,11" Style="{StaticResource TextBlockPriceCell}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                    <TextBlock Text="$ 8.888,88" Style="{StaticResource TextBlockPriceCell}" HorizontalAlignment="Right" />
                    <TextBlock Text="$ 420,00" Style="{StaticResource TextBlockCurrencyCell}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- A.3 Espaciado y radios -->
            <TextBlock Text="Espaciado y radios" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Todo margen, relleno y alto es múltiplo de 4. Radios: 4 en insignias, 6 en controles, 8 en superficies; dentro de una superficie, el radio interior es el exterior menos el relleno."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom"><Rectangle Width="4" Height="4" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" /><TextBlock Text="4" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom"><Rectangle Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" /><TextBlock Text="8" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom"><Rectangle Width="12" Height="12" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" /><TextBlock Text="12" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom"><Rectangle Width="16" Height="16" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" /><TextBlock Text="16" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom"><Rectangle Width="24" Height="24" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" /><TextBlock Text="24" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Margin="0,0,48,0" VerticalAlignment="Bottom"><Rectangle Width="32" Height="32" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" /><TextBlock Text="32" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>

                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom"><Border Width="48" Height="32" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource SurfaceSubtleBrush}" /><TextBlock Text="RadiusSm 4" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom"><Border Width="48" Height="32" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource SurfaceSubtleBrush}" /><TextBlock Text="RadiusMd 6" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel VerticalAlignment="Bottom"><Border Width="48" Height="32" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource SurfaceSubtleBrush}" /><TextBlock Text="RadiusLg 8" Style="{StaticResource MuestraClaveStyle}" Margin="0,4,0,0" /></StackPanel>
            </WrapPanel>

            <!-- A.4 Iconografía -->
            <TextBlock Text="Iconografía" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="BoxIcons (variante Regular) en gris secundario, de 14 a 16 px junto a texto. El ícono toma el color de su control; el carmín y los colores de estado solo cuando el ícono comunica eso."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="iconPacks:PackIconBoxIcons">
                        <Setter Property="Width" Value="16" />
                        <Setter Property="Height" Value="16" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    </Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Setter Property="Width" Value="196" />
                        <Setter Property="Margin" Value="0,0,8,12" />
                    </Style>
                </WrapPanel.Resources>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularCart" /><TextBlock Text="Punto de venta · Cart" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularTag" /><TextBlock Text="Artículos · Tag" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularUser" /><TextBlock Text="Clientes · User" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularTruck" /><TextBlock Text="Proveedores · Truck" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularReceipt" /><TextBlock Text="Comprobantes · Receipt" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularScanBarcode" /><TextBlock Text="Código · ScanBarcode" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularMenuFilter" /><TextBlock Text="Filtro · MenuFilter" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularSearch" /><TextBlock Text="Buscar · Search" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularLink" /><TextBlock Text="Fuente · Link" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularDotsVerticalRounded" /><TextBlock Text="Acciones · DotsVertical" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularChevronRight" /><TextBlock Text="Navegar · ChevronRight" Style="{StaticResource TextBlockBody}" /></StackPanel>
                <StackPanel><iconPacks:PackIconBoxIcons Kind="RegularAlertTriangle" Foreground="{DynamicResource WarningBrush}" /><TextBlock Text="Alerta · AlertTriangle" Style="{StaticResource TextBlockBody}" /></StackPanel>
            </WrapPanel>

            <!-- ============================================================================================ -->
            <!-- B. COMPONENTES                                                                               -->
            <!-- ============================================================================================ -->
            <TextBlock Text="B. Componentes" Style="{StaticResource GaleriaBloqueStyle}" />
            <TextBlock Text="Hover neutro y sin cambio de borde; el foco del teclado (Tab) dibuja un anillo gris que no aparece con el mouse. Densidad compacta: controles de 34 px, filas de 36 (el mostrador conserva 40/42)."
                       Style="{StaticResource GaleriaNotaStyle}" />

            <!-- B.1 Botones -->
            <TextBlock Text="Botones" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Una sola acción primaria por vista. La secundaria lleva contorno; la terciaria es texto. Deshabilitado = atenuado, con el motivo en el tooltip."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <WrapPanel>
                <Button Content="Guardar" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,8" />
                <Button Content="Cancelar" Style="{StaticResource KeycapButtonStyle}" Margin="0,0,8,8" />
                <Button Content="Limpiar filtros" Style="{StaticResource GhostNeutralButtonStyle}" Margin="0,0,8,8" />
                <Button Style="{StaticResource GhostPrimaryButtonStyle}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularUndo" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Restablecer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="Dar de baja" Style="{StaticResource DangerActionButtonStyle}" Margin="0,0,8,8" />
                <Button Content="Deshabilitado" Style="{StaticResource KeycapButtonStyle}" IsEnabled="False" Margin="0,0,24,8" />
                <Button Style="{StaticResource IconDangerButtonStyle}" ToolTip="Eliminar ítem [Supr]" Margin="0,0,8,8" VerticalAlignment="Center">
                    <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="16" Height="16" />
                </Button>
            </WrapPanel>

            <TextBlock Text="Con carga (ButtonHelper.IsLoading)" Style="{StaticResource GaleriaRotuloStyle}" Margin="0,8,0,8" />
            <WrapPanel>
                <Button Style="{StaticResource PrimaryActionButtonStyle}" helpers:ButtonHelper.IsLoading="True" helpers:ButtonHelper.LoadingText="Guardando..." Margin="0,0,8,8" />
                <Button Style="{StaticResource KeycapButtonStyle}" helpers:ButtonHelper.IsLoading="True" helpers:ButtonHelper.LoadingText="Consultando..." Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock Text="Mostrador: atajo de teclado en una pastilla (solo en el POS y la caja)" Style="{StaticResource GaleriaRotuloStyle}" Margin="0,8,0,8" />
            <WrapPanel>
                <Button Style="{StaticResource PrimaryActionButtonStyle}" MinHeight="{StaticResource ControlHeightLg}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cobrar venta" VerticalAlignment="Center" />
                        <Border Style="{StaticResource KeycapPrimaryBadgeStyle}">
                            <TextBlock Text="F12" Style="{StaticResource TextBlockKeycap}" Foreground="{DynamicResource PrimaryForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource KeycapButtonStyle}" MinHeight="{StaticResource ControlHeightLg}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Buscar artículo" VerticalAlignment="Center" />
                        <Border Style="{StaticResource KeycapBadgeStyle}">
                            <TextBlock Text="F1" Style="{StaticResource TextBlockKeycap}" />
                        </Border>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- B.2 Entradas -->
            <TextBlock Text="Entradas de datos" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Etiqueta arriba en texto secundario; solo los obligatorios llevan *. El error se muestra debajo del campo, en rojo, con el mensaje del validador."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ColumnGap}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Descripción *" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                    <ui:TextBox PlaceholderText="ej. Cuaderno Universitario A4 80 hojas" Margin="{StaticResource StackMd}" />
                    <TextBlock Text="Contraseña" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                    <ui:PasswordBox Password="secreto" Margin="{StaticResource StackMd}" />
                    <TextBlock Text="Stock mínimo" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                    <ui:TextBox Text="-15" BorderBrush="{DynamicResource DangerBrush}" Margin="{StaticResource StackXs}" />
                    <TextBlock Text="El stock mínimo no puede ser negativo." Style="{StaticResource TextBlockCaption}" Foreground="{DynamicResource DangerForegroundBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Condición frente al IVA" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                    <ComboBox SelectedIndex="0" Margin="{StaticResource StackMd}">
                        <ComboBoxItem Content="Consumidor final" />
                        <ComboBoxItem Content="Responsable inscripto" />
                        <ComboBoxItem Content="Monotributista" />
                    </ComboBox>
                    <CheckBox Content="Habilitar cuenta corriente" IsChecked="True" Margin="{StaticResource StackSm}" />
                    <CheckBox Content="Es un servicio (no descuenta stock)" Margin="{StaticResource StackSm}" />
                    <CheckBox Content="Bloqueado por perfil" IsChecked="True" IsEnabled="False" Margin="{StaticResource StackMd}" />
                    <ui:ToggleSwitch Content="Modo mostrador (activa o desactiva un modo, no elige entre opciones)" IsChecked="True" />
                </StackPanel>
            </Grid>

            <!-- B.3 Selección -->
            <TextBlock Text="Elegir entre opciones" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Dos o tres opciones fijas: selector segmentado, con un único indicador que se desliza (probalo con el mouse y con las flechas). Muchas opciones que pueden pasar de línea: píldoras."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <WrapPanel>
                <components:SelectorSegmentado Margin="0,0,24,16">
                    <UniformGrid Columns="2">
                        <RadioButton GroupName="TipoArticuloGaleria" IsChecked="True" AutomationProperties.Name="Producto" Style="{StaticResource SegmentedRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularCube" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Producto" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="TipoArticuloGaleria" AutomationProperties.Name="Servicio" Style="{StaticResource SegmentedRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularMagicWand" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Servicio" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </components:SelectorSegmentado>
                <components:SelectorSegmentado Margin="0,0,24,16">
                    <UniformGrid Columns="3">
                        <RadioButton GroupName="PeriodoGaleria" Content="Día" IsChecked="True" Style="{StaticResource SegmentedRadioButtonStyle}" />
                        <RadioButton GroupName="PeriodoGaleria" Content="Semana" Style="{StaticResource SegmentedRadioButtonStyle}" />
                        <RadioButton GroupName="PeriodoGaleria" Content="Mes" Style="{StaticResource SegmentedRadioButtonStyle}" />
                    </UniformGrid>
                </components:SelectorSegmentado>
                <components:SelectorSegmentado Margin="0,0,0,16">
                    <UniformGrid Columns="2">
                        <RadioButton GroupName="DeshabilitadaGaleria" Content="Producto" IsChecked="True" Style="{StaticResource SegmentedRadioButtonStyle}" />
                        <RadioButton GroupName="DeshabilitadaGaleria" Content="Servicio" IsEnabled="False" ToolTip="Este artículo tiene stock: no puede ser un servicio" ToolTipService.ShowOnDisabled="True" Style="{StaticResource SegmentedRadioButtonStyle}" />
                    </UniformGrid>
                </components:SelectorSegmentado>
            </WrapPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="Reportes" Content="Tablero" IsChecked="True" Style="{StaticResource PillRadioButtonStyle}" />
                <RadioButton GroupName="Reportes" Content="Ranking" Style="{StaticResource PillRadioButtonStyle}" />
                <RadioButton GroupName="Reportes" Content="Stock crítico" Style="{StaticResource PillRadioButtonStyle}" />
            </StackPanel>

            <!-- B.4 Insignias -->
            <TextBlock Text="Insignias" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Rectangulares (radio 4) y sin borde. La neutra clasifica (categoría, distribuidor); las de color comunican un estado de negocio. La de selección reemplaza a &quot;Limpiar filtros&quot; con filas marcadas."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <WrapPanel>
                <Border Style="{StaticResource BadgeNeutralStyle}" Margin="0,0,8,8">
                    <TextBlock Text="Cuadernos" Style="{StaticResource BadgeNeutralTextStyle}" />
                </Border>
                <Border Style="{StaticResource BadgeNeutralStyle}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Distribuidora Sur" Style="{StaticResource BadgeNeutralTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BadgeNeutralStyle}" Margin="0,0,24,8">
                    <TextBlock Text="+2" Style="{StaticResource BadgeNeutralTextStyle}" />
                </Border>
                <Border Style="{StaticResource BadgeWarningStyle}" Margin="0,0,8,8">
                    <TextBlock Text="Stock bajo" Style="{StaticResource BadgeNeutralTextStyle}" Foreground="{DynamicResource WarningForegroundBrush}" />
                </Border>
                <Border Style="{StaticResource BadgeDangerStyle}" Margin="0,0,8,8">
                    <TextBlock Text="Error fiscal" Style="{StaticResource BadgeNeutralTextStyle}" Foreground="{DynamicResource DangerForegroundBrush}" />
                </Border>
                <Border Style="{StaticResource BadgeSuccessStyle}" Margin="0,0,24,8">
                    <TextBlock Text="CAE aprobado" Style="{StaticResource BadgeNeutralTextStyle}" Foreground="{DynamicResource SuccessForegroundBrush}" />
                </Border>
                <components:BulkActionBar CantidadSeleccionados="3" Margin="0,0,0,8" />
            </WrapPanel>

            <!-- B.5 Menús y filtros -->
            <TextBlock Text="Menú de acciones y filtro de columna" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Los dos son botones que quedan presionados mientras su panel está abierto; un segundo clic, un clic afuera o Esc lo cierran. El filtro aplica con &quot;Aplicar&quot; (o Enter) y se resalta cuando está activo. Probalos: son los reales."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,48,0">
                    <TextBlock Text="Menú de la fila" Style="{StaticResource GaleriaRotuloStyle}" />
                    <ToggleButton Style="{StaticResource RowMenuButtonStyle}"
                                  helpers:MenuDesplegableHelper.AbrirAlHacerClic="True"
                                  HorizontalAlignment="Left"
                                  ToolTip="Acciones del artículo"
                                  AutomationProperties.Name="Acciones del artículo">
                        <iconPacks:PackIconBoxIcons Kind="RegularDotsVerticalRounded" Width="14" Height="14" />
                        <ToggleButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Editar artículo">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconBoxIcons Kind="RegularPencil" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Crear presentación">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconBoxIcons Kind="RegularGitBranch" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Dar de baja" Style="{StaticResource MenuItemDangerStyle}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconBoxIcons Kind="RegularTrash"
                                                                    Width="14"
                                                                    Height="14"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ToggleButton.ContextMenu>
                    </ToggleButton>
                </StackPanel>
                <StackPanel Margin="0,0,48,0">
                    <TextBlock Text="Filtro de columna (agrupado por rubro)" Style="{StaticResource GaleriaRotuloStyle}" />
                    <components:FiltroColumna Filtro="{Binding FiltroCategoria}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Filtro activo" Style="{StaticResource GaleriaRotuloStyle}" />
                    <components:FiltroColumna Filtro="{Binding FiltroStock}" />
                </StackPanel>
            </StackPanel>

            <!-- B.6 Superficie flotante -->
            <TextBlock Text="Superficie flotante (resultados de búsqueda del POS)" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Lo que flota sobre la página lleva sombra; nada más la lleva. En el desplegable del mostrador, la fila elegida (teclado o hover) va en carmín completo."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <Border Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="0,4"
                    Margin="0,0,0,8"
                    Width="480"
                    HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource ElevationShadowColor}" Opacity="0.18" BlurRadius="16" ShadowDepth="4" Direction="270" />
                </Border.Effect>
                <ListBox ItemContainerStyle="{StaticResource SearchResultListBoxItemStyle}" BorderThickness="0" Padding="0" Background="Transparent">
                    <ListBoxItem IsSelected="True">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <TextBlock Text="$300,00" Style="{StaticResource SearchResultAmountTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="Stock: 5" Style="{StaticResource SearchResultMetaTextStyle}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Lápiz HB (fila elegida)" Style="{StaticResource SearchResultTitleTextStyle}" />
                                <TextBlock Text="7790001" Style="{StaticResource SearchResultMetaTextStyle}" FontFamily="{StaticResource FontFamilyMonospace}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <TextBlock Text="$350,00" Style="{StaticResource SearchResultAmountTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="Stock: 8" Style="{StaticResource SearchResultMetaTextStyle}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Lápiz 2B" Style="{StaticResource SearchResultTitleTextStyle}" />
                                <TextBlock Text="7790002" Style="{StaticResource SearchResultMetaTextStyle}" FontFamily="{StaticResource FontFamilyMonospace}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- ============================================================================================ -->
            <!-- C. PATRONES DE PANTALLA                                                                      -->
            <!-- ============================================================================================ -->
            <TextBlock Text="C. Patrones de pantalla" Style="{StaticResource GaleriaBloqueStyle}" />
            <TextBlock Text="Cómo se combinan los componentes. Cada pantalla tiene una sola superficie (la tabla o las secciones del modal); el resto va sobre el fondo."
                       Style="{StaticResource GaleriaNotaStyle}" />

            <!-- C.1 Listado -->
            <TextBlock Text="Página de listado" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Encabezado y buscador sobre el fondo; la tabla es la única superficie y la paginación su continuación. Filtros en la cabecera de cada columna. La paginación de esta muestra funciona."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <components:PageHeader Titulo="Catálogo de Artículos e Inventario" Margin="{StaticResource StackLg}">
                <Button Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nuevo Artículo" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </components:PageHeader>
            <components:ListToolbar PlaceholderText="Buscar por código, descripción o marca..."
                                    TotalResultados="248"
                                    Margin="{StaticResource StackMd}" />
            <Border Style="{StaticResource TablaListadoStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding ArticulosEjemplo}"
                              Style="{StaticResource DataGridListadoStyle}"
                              AutoGenerateColumns="False"
                              BorderThickness="0"
                              helpers:EsquinasHelper.Esquinas="7,7,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Artículo"
                                                Binding="{Binding Descripcion}"
                                                Width="*"
                                                MinWidth="200"
                                                ElementStyle="{StaticResource TextBlockTextCell}" />
                            <DataGridTemplateColumn Width="176">
                                <DataGridTemplateColumn.Header>
                                    <components:FiltroColumna Filtro="{Binding DataContext.FiltroCategoria, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeNeutralStyle}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Categoria}" Style="{StaticResource BadgeNeutralTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="120" ElementStyle="{StaticResource TextBlockTextCell}" />
                            <DataGridTemplateColumn Header="Distribuidor" Width="176">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Border x:Name="Insignia" Style="{StaticResource BadgeNeutralStyle}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Distribuidor}" Style="{StaticResource BadgeNeutralTextStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="Manual" Text="(Manual)" FontStyle="Italic" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Distribuidor}" Value="{x:Null}">
                                                <Setter TargetName="Insignia" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Manual" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Precio de venta"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                                Binding="{Binding PrecioVenta, StringFormat={}{0:C2}}"
                                                Width="132"
                                                ElementStyle="{StaticResource TextBlockPriceCell}" />
                            <DataGridTemplateColumn Width="88">
                                <DataGridTemplateColumn.Header>
                                    <components:FiltroColumna Filtro="{Binding DataContext.FiltroStock, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRightListadoStyle}">
                                        <Setter Property="Padding" Value="12,0,8,0" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                        <Setter Property="Padding" Value="12,8,8,8" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="Guion" Text="—" Foreground="{DynamicResource TextMutedBrush}" ToolTip="Servicio: no lleva stock" Visibility="Collapsed" />
                                            <StackPanel x:Name="Cantidad" Orientation="Horizontal">
                                                <Ellipse x:Name="Punto" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <iconPacks:PackIconBoxIcons x:Name="Aviso" Kind="RegularAlertTriangle" Width="14" Height="14" Foreground="{DynamicResource WarningBrush}" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                <TextBlock Text="{Binding Stock}" Style="{StaticResource TextBlockNumericCell}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                <Setter TargetName="Punto" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Aviso" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EsServicio}" Value="True">
                                                <Setter TargetName="Guion" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Cantidad" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="36" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource RowMenuButtonStyle}" HorizontalAlignment="Left" ToolTip="Acciones del artículo" AutomationProperties.Name="Acciones del artículo">
                                            <iconPacks:PackIconBoxIcons Kind="RegularDotsVerticalRounded" Width="14" Height="14" />
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                        <components:PaginationBar DataContext="{Binding Paginacion}" />
                    </Border>
                </Grid>
            </Border>

            <!-- C.2 Modal -->
            <TextBlock Text="Modal" Style="{StaticResource GaleriaSeccionStyle}" />
            <TextBlock Text="Una sola superficie gris: título continuo con la barra, secciones blancas sin borde (con su ícono y título), pie sin franja. Minimizar y cerrar son íconos. Esc cierra, Enter acepta. El modal real se abre con el botón (no se incrusta acá: su Esc cerraría esta ventana)."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <Button Click="BtnAbrirModalMuestra_Click" Style="{StaticResource KeycapButtonStyle}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconBoxIcons Kind="RegularWindow" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Abrir modal de muestra" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- ============================================================================================ -->
            <!-- D. DESARROLLO                                                                                -->
            <!-- ============================================================================================ -->
            <TextBlock Text="D. Herramientas de desarrollo" Style="{StaticResource GaleriaBloqueStyle}" />
            <TextBlock Text="No son parte del sistema de diseño. Abren módulos fuera del shell y provocan excepciones no controladas para verificar el manejo global (Etapa 0.8): la app no debe cerrarse y debe registrar el error en %LOCALAPPDATA%\Retail POS\logs."
                       Style="{StaticResource GaleriaNotaStyle}" />
            <WrapPanel Margin="0,0,0,32">
                <Button x:Name="BtnAbrirUsuariosDev" Click="BtnAbrirUsuariosDev_Click" Content="Usuarios (ventana aparte)" Style="{StaticResource KeycapButtonStyle}" Margin="0,0,8,8" />
                <Button x:Name="BtnAbrirArticulosDev" Click="BtnAbrirArticulosDev_Click" Content="Artículos (ventana aparte)" Style="{StaticResource KeycapButtonStyle}" Margin="0,0,8,8" />
                <Button x:Name="BtnAbrirClientesDev" Click="BtnAbrirClientesDev_Click" Content="Clientes (ventana aparte)" Style="{StaticResource KeycapButtonStyle}" Margin="0,0,24,8" />
                <Button x:Name="BtnTestDispatcherException" Click="BtnTestDispatcherException_Click" Content="Excepción en el Dispatcher" Style="{StaticResource GhostNeutralButtonStyle}" Margin="0,0,8,8" />
                <Button x:Name="BtnTestTaskException" Click="BtnTestTaskException_Click" Content="Excepción en una Task" Style="{StaticResource GhostNeutralButtonStyle}" Margin="0,0,8,8" />
                <Button x:Name="BtnTestAppDomainException" Click="BtnTestAppDomainException_Click" Content="Excepción en un hilo de fondo" Style="{StaticResource GhostNeutralButtonStyle}" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
