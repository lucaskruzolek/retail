<UserControl x:Class="Retail.App.Views.Dev.StyleGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1800" d:DesignWidth="1050"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="1000">

            <!-- ========================================================= -->
            <!-- ENCABEZADO DE LA GALERÍA                                  -->
            <!-- ========================================================= -->
            <Border Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,0,0,24">
                <StackPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Galería de Controles y Guía de Estilos"
                                       Style="{StaticResource TextBlockHeader1}" />
                            <TextBlock Text="Etapa 0.6: Sistema de Diseño WPF-UI (Fluent Windows 11) + Tokens Semánticos para Retail POS"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BadgeSuccessStyle}">
                            <TextBlock Text="Etapa 0.6 Activa"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 1: PALETA DE COLORES SEMÁNTICOS                  -->
            <!-- ========================================================= -->
            <TextBlock Text="1. Paleta Semántica y Tokens de Color"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <WrapPanel Orientation="Horizontal">
                    <!-- Carmín Primario -->
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Width="140" Height="80" Margin="8" Padding="10">
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Primario" Foreground="White" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="#9D0F33" Foreground="#FCE7EC" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" />
                        </StackPanel>
                    </Border>
                    <!-- Carmín Hover -->
                    <Border Background="{DynamicResource PrimaryHoverBrush}" CornerRadius="6" Width="140" Height="80" Margin="8" Padding="10">
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Primario Hover" Foreground="White" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="#850C2A" Foreground="#FCE7EC" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" />
                        </StackPanel>
                    </Border>
                    <!-- Carmín Selección Suave -->
                    <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="6" Width="140" Height="80" Margin="8" Padding="10">
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Selección / Light" Foreground="{DynamicResource PrimaryPressedBrush}" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="#FDF2F4" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" />
                        </StackPanel>
                    </Border>
                    <!-- Ámbar Advertencia -->
                    <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Width="140" Height="80" Margin="8" Padding="10">
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Alerta Stock" Foreground="{DynamicResource WarningForegroundBrush}" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="#D97706" Foreground="{DynamicResource WarningForegroundBrush}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" />
                        </StackPanel>
                    </Border>
                    <!-- Rojo Peligro -->
                    <Border Background="{DynamicResource DangerBackgroundBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6" Width="140" Height="80" Margin="8" Padding="10">
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Error Fiscal" Foreground="{DynamicResource DangerForegroundBrush}" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="#DC2626" Foreground="{DynamicResource DangerForegroundBrush}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" />
                        </StackPanel>
                    </Border>
                    <!-- Verde Éxito -->
                    <Border Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Width="140" Height="80" Margin="8" Padding="10">
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Cobro Éxito" Foreground="{DynamicResource SuccessForegroundBrush}" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="#059669" Foreground="{DynamicResource SuccessForegroundBrush}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 2: TIPOGRAFÍA Y MOSTRADOR FINANCIERO              -->
            <!-- ========================================================= -->
            <TextBlock Text="2. Tipografía y Alineación Decimal Financiera"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Jerarquía de Textos (Segoe UI Variable):" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Encabezado H1: Título de Pantalla de Venta" Style="{StaticResource TextBlockHeader1}" Margin="0,0,0,6" />
                        <TextBlock Text="Encabezado H2: Subtítulo y Secciones de Formulario" Style="{StaticResource TextBlockHeader2}" Margin="0,0,0,6" />
                        <TextBlock Text="Cuerpo: Descripción de artículos, datos del cliente y condiciones tributarias." Style="{StaticResource TextBlockBody}" Margin="0,0,0,6" />
                        <TextBlock Text="Leyenda secundaria: Búsqueda indexada por código de barras o descripción." Style="{StaticResource TextBlockCaption}" />
                    </StackPanel>

                    <!-- Caja de Total POS (Monospace) -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="TOTAL VENTA MOSTRADOR:"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="$ 43.350,50"
                                       Style="{StaticResource TextBlockDisplayCurrency}"
                                       Foreground="{DynamicResource PrimaryPressedBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="(Alineación decimal fija con Cascadia Code)"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 3: ICONOGRAFÍA (Microsoft Fluent System Icons)     -->
            <!-- ========================================================= -->
            <TextBlock Text="3. Iconografía Fluent System Icons y Vectores"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Path Data="{StaticResource GeometryBarcode}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Código Barras" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlockBody}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Path Data="{StaticResource GeometrySearch}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Búsqueda" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlockBody}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Path Data="{StaticResource GeometryReceipt}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Comprobante Fiscal" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlockBody}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Path Data="{StaticResource GeometryCash}" Fill="{DynamicResource SuccessBrush}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Efectivo" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlockBody}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Path Data="{StaticResource GeometryCard}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Tarjeta" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlockBody}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Path Data="{StaticResource GeometryBox}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Artículos" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlockBody}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Path Data="{StaticResource GeometryWarning}" Fill="{DynamicResource WarningBrush}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Alerta Stock" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlockBody}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Path Data="{StaticResource GeometryLock}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Seguridad / Rol" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlockBody}" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 4: BOTONES Y ACCIONES DE MOSTRADOR (F1 a F12)     -->
            <!-- ========================================================= -->
            <TextBlock Text="4. Botones y Acciones de Mostrador (Atajos F1 - F12)"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <!-- Botón Primario de Cobro con [F12] -->
                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeometryCash}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Cobrar Venta" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KeycapPrimaryBadgeStyle}">
                                    <TextBlock Text="F12" Style="{StaticResource TextBlockKeycap}" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Botón Buscar con [F1] -->
                        <Button Style="{StaticResource KeycapButtonStyle}" Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeometrySearch}" Fill="{DynamicResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Buscar Artículo" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KeycapBadgeStyle}">
                                    <TextBlock Text="F1" Style="{StaticResource TextBlockKeycap}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Botón Cancelar con [F4] -->
                        <Button Style="{StaticResource KeycapButtonStyle}" Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Anular Línea" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KeycapBadgeStyle}">
                                    <TextBlock Text="F4" Style="{StaticResource TextBlockKeycap}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Botón Deshabilitado -->
                        <Button Style="{StaticResource KeycapButtonStyle}" IsEnabled="False" Margin="0,0,12,8">
                            <TextBlock Text="Acción Bloqueada" VerticalAlignment="Center" />
                        </Button>
                    </WrapPanel>

                    <!-- Botones Nativos de WPF-UI -->
                    <TextBlock Text="Botones Fluent de WPF-UI:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,8" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="WPF-UI Primary" Appearance="Primary" Margin="0,0,12,8" />
                        <ui:Button Content="WPF-UI Secondary" Appearance="Secondary" Margin="0,0,12,8" />
                        <ui:Button Content="WPF-UI Danger" Appearance="Danger" Margin="0,0,12,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 5: FORMULARIOS, INPUTS Y VALIDACIONES             -->
            <!-- ========================================================= -->
            <TextBlock Text="5. Entradas de Datos y Validación de Entrada"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Entrada con Placeholder y Botón de Limpieza:" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,6" />
                        <ui:TextBox PlaceholderText="Escanear código de barras o ingresar texto..."
                                    ClearButtonEnabled="True"
                                    Margin="0,0,0,16" />

                        <TextBlock Text="Contraseña con Ocultamiento:" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,6" />
                        <ui:PasswordBox Password="SuperSecret123"
                                        Margin="0,0,0,16" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Simulación de Error de Validación (FluentValidation):" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,6" />
                        <TextBox Text="-15"
                                 BorderBrush="{DynamicResource DangerBrush}"
                                 BorderThickness="1.5"
                                 Padding="8,6"
                                 Margin="0,0,0,4" />
                        <TextBlock Text="El stock mínimo no puede ser negativo."
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,16" />

                        <TextBlock Text="Selector Desplegable (Condición IVA):" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,6" />
                        <ComboBox SelectedIndex="0" Padding="8,6">
                            <ComboBoxItem Content="Consumidor Final" />
                            <ComboBoxItem Content="Responsable Inscripto (Factura A)" />
                            <ComboBoxItem Content="Monotributista" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 6: BADGES Y ETIQUETAS SEMÁFORO                    -->
            <!-- ========================================================= -->
            <TextBlock Text="6. Etiquetas y Badges Semáforo de Estado"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource BadgeWarningStyle}" Margin="8">
                        <TextBlock Text="Stock Crítico (3 un.)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WarningForegroundBrush}" />
                    </Border>
                    <Border Style="{StaticResource BadgeDangerStyle}" Margin="8">
                        <TextBlock Text="Error Fiscal ARCA (Reintentable)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource DangerForegroundBrush}" />
                    </Border>
                    <Border Style="{StaticResource BadgeSuccessStyle}" Margin="8">
                        <TextBlock Text="Facturado CAE Aprobado" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SuccessForegroundBrush}" />
                    </Border>
                    <Border Style="{StaticResource BadgeSuccessStyle}" Margin="8">
                        <TextBlock Text="Turno Caja Abierto" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SuccessForegroundBrush}" />
                    </Border>
                </WrapPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 7: GRILLA DE ARTÍCULOS (DataGridRetailStyle)       -->
            <!-- ========================================================= -->
            <TextBlock Text="7. Grilla de Artículos (DataGrid con Precios Monoespaciados)"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <DataGrid Style="{StaticResource DataGridRetailStyle}"
                          ItemsSource="{Binding ArticulosEjemplo}">
                    <DataGrid.Columns>
                        <!-- Código de Barras -->
                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding CodigoBarras}"
                                            Width="160" />

                        <!-- Descripción -->
                        <DataGridTextColumn Header="Descripción del Artículo"
                                            Binding="{Binding Descripcion}"
                                            Width="*" />

                        <!-- Categoría -->
                        <DataGridTextColumn Header="Categoría"
                                            Binding="{Binding Categoria}"
                                            Width="130" />

                        <!-- Stock con Alerta Visual -->
                        <DataGridTemplateColumn Header="Stock" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Stock}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <!-- Badge de Alerta si el stock es bajo -->
                                        <Border Style="{StaticResource BadgeWarningStyle}"
                                                Visibility="{Binding StockBajo, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Bajo"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Precio de Venta (Alineado a la derecha con Cascadia Code) -->
                        <DataGridTemplateColumn Header="Precio Venta" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrecioVentaFormateado}"
                                               Style="{StaticResource TextBlockCurrencyCell}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 8: RESILIENCIA Y MANEJO DE EXCEPCIONES (ETAPA 0.8)-->
            <!-- ========================================================= -->
            <TextBlock Text="8. Pruebas de Resiliencia y Manejo Global de Excepciones (Etapa 0.8)"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Verificación en Vivo del Criterio de Aceptación (Etapa 0.8):"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border HorizontalAlignment="Right"
                                Style="{StaticResource BadgeDangerStyle}">
                            <TextBlock Text="Manejo Global Activo"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DangerForegroundBrush}" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="Los siguientes botones provocan deliberadamente excepciones no controladas para comprobar que el sistema no aborta el proceso, asienta el diagnóstico en logs/retail-.log y presenta el diálogo amigable de mostrador al operador."
                               Style="{StaticResource TextBlockBodySecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <WrapPanel Orientation="Horizontal">
                        <!-- Botón 1: Dispatcher Exception -->
                        <Button x:Name="BtnTestDispatcherException"
                                Click="BtnTestDispatcherException_Click"
                                Style="{StaticResource KeycapButtonStyle}"
                                Margin="0,0,12,12"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24"
                                               Foreground="{DynamicResource DangerForegroundBrush}"
                                               Margin="0,0,8,0" />
                                <TextBlock Text="Provocar Excepción en UI Dispatcher"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Botón 2: TaskScheduler Unobserved Exception -->
                        <Button x:Name="BtnTestTaskException"
                                Click="BtnTestTaskException_Click"
                                Style="{StaticResource KeycapButtonStyle}"
                                Margin="0,0,12,12"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24"
                                               Foreground="{DynamicResource WarningForegroundBrush}"
                                               Margin="0,0,8,0" />
                                <TextBlock Text="Provocar Excepción en Task Asíncrona"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Botón 3: AppDomain Background Thread Exception -->
                        <Button x:Name="BtnTestAppDomainException"
                                Click="BtnTestAppDomainException_Click"
                                Style="{StaticResource KeycapButtonStyle}"
                                Margin="0,0,12,12"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,8,0" />
                                <TextBlock Text="Provocar Excepción en Hilo de Fondo"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN 8: MÓDULOS DE NEGOCIO EN DESARROLLO (SANDBOX)     -->
            <!-- ========================================================= -->
            <TextBlock Text="8. Módulos de Negocio en Desarrollo (Sandbox &amp; Vista Previa)"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,32">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Módulo 1.2: Administración de Usuarios y Roles RBAC"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Responsable: Lucas Kruzolek • Visualización desacoplada sin depender del Shell de Mostrador"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BadgeSuccessStyle}">
                            <TextBlock Text="Etapa 1.2 Lista"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="Permite probar de forma interactiva la grilla de usuarios, filtros de activos/inactivos, alta y edición modal de operadores y blanqueo de contraseña, resolviendo dependencias desde DI sin invadir MainWindow."
                               Style="{StaticResource TextBlockBodySecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <Button x:Name="BtnAbrirUsuariosDev"
                            Click="BtnAbrirUsuariosDev_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir Vista de Usuarios (Ventana Sandbox)" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,32">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Módulo 2.1: Catálogo Propio de Artículos y Alertas de Stock"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Responsable: Lucas Kruzolek • Visualización desacoplada del catálogo y cálculo dinámico de markup"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BadgeSuccessStyle}">
                            <TextBlock Text="Etapa 2.1 Activa"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="Permite verificar la grilla reactiva de artículos con los 20 ítems del semillero, cálculo instantáneo de markup sobre costo, filtro de stock crítico (RF-08), alta de artesanías sin código de barras y soft delete."
                               Style="{StaticResource TextBlockBodySecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <Button x:Name="BtnAbrirArticulosDev"
                            Click="BtnAbrirArticulosDev_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Tag24" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir Catálogo de Artículos (Ventana Sandbox)" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,32">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Módulo 3.2: Padrón de Clientes y Cuentas Corrientes (Fase 1)"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Responsable: Lucas Kruzolek • Gestión de clientes comerciales, condiciones IVA y saldos deudores (RF-20)"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BadgeSuccessStyle}">
                            <TextBlock Text="Etapa 3.2 Activa"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="Permite verificar el padrón general de clientes, búsqueda multicriterio con push-down a SQL, altas y modificaciones con modal reactivo, habilitación de cuenta corriente comercial y verificación de saldo deudor."
                               Style="{StaticResource TextBlockBodySecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <Button x:Name="BtnAbrirClientesDev"
                            Click="BtnAbrirClientesDev_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir Padrón de Clientes (Ventana Sandbox)" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
