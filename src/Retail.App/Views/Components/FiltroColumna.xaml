<UserControl x:Class="Retail.App.Views.Components.FiltroColumna"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:Retail.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Raiz">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
    </UserControl.Resources>

    <!-- Todo el control trabaja sobre el FiltroColumnaViewModel (propiedad Filtro); el DataContext del UserControl sigue
         siendo el de la grilla, que es el que enlaza Filtro. -->
    <StackPanel Orientation="Horizontal" DataContext="{Binding Filtro, ElementName=Raiz}">
        <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center" />

        <!-- El embudo refleja si el panel está abierto. Con el panel abierto, el clic sobre el embudo lo intercepta la
             ventana para cerrar (ver el code-behind): no llega ni al embudo ni a la cabecera. -->
        <ToggleButton x:Name="BotonFiltro"
                      Margin="4,0,0,0"
                      IsChecked="{Binding EstaAbierto, Mode=TwoWay}"
                      ToolTip="{Binding Titulo, StringFormat='Filtrar por {0}'}"
                      AutomationProperties.Name="{Binding Titulo, StringFormat='Filtrar por {0}'}"
                      Style="{StaticResource FiltroColumnaBotonStyle}">
            <iconPacks:PackIconBoxIcons Kind="RegularMenuFilter" Width="14" Height="14" />
        </ToggleButton>

        <!-- Lo abre y lo cierra el code-behind (StaysOpen=True): así el clic que cierra no sigue de largo y la salida
             se puede animar -->
        <Popup x:Name="Panel"
               StaysOpen="True"
               PlacementTarget="{Binding ElementName=BotonFiltro}"
               Placement="Bottom"
               HorizontalOffset="-8"
               AllowsTransparency="True"
               PopupAnimation="None">
            <Border x:Name="Tarjeta" Style="{StaticResource FiltroColumnaPanelStyle}" Width="264">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Con 6 opciones o menos el buscador y los atajos se ocultan (MostrarBusqueda) -->
                    <!-- Buscar dentro de las opciones (no consulta la base: oculta casillas) -->
                    <ui:TextBox x:Name="Busqueda"
                                Grid.Row="0"
                                Margin="8,8,8,4"
                                Visibility="{Binding MostrarBusqueda, Converter={StaticResource BoolToVisConverter}}"
                                Height="{StaticResource ControlHeight}"
                                FontSize="{StaticResource FontSizeBase}"
                                Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar…"
                                ClearButtonEnabled="False">
                        <ui:TextBox.Icon>
                            <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                          Width="16"
                                          Height="16" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,4"
                                Visibility="{Binding MostrarBusqueda, Converter={StaticResource BoolToVisConverter}}">
                        <Button Content="Seleccionar todo"
                                Command="{Binding SeleccionarTodoCommand}"
                                Style="{StaticResource GhostNeutralButtonStyle}" />
                        <Button Content="Limpiar"
                                Command="{Binding LimpiarCommand}"
                                Style="{StaticResource GhostNeutralButtonStyle}" />
                    </StackPanel>

                    <!-- Casillas, agrupadas si el filtro tiene grupos (rubros de las categorías) -->
                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="280"
                                  Padding="4,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Grupos}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Visibility="{Binding Visible, Converter={StaticResource BoolToVisConverter}}">
                                        <CheckBox Content="{Binding Nombre}"
                                                  IsChecked="{Binding TodasSeleccionadas, Mode=TwoWay}"
                                                  FontWeight="SemiBold"
                                                  Visibility="{Binding TieneEncabezado, Converter={StaticResource BoolToVisConverter}}"
                                                  Style="{StaticResource CheckBoxOpcionFiltroStyle}" />
                                        <ItemsControl ItemsSource="{Binding Opciones}" Focusable="False">
                                            <ItemsControl.Style>
                                                <!-- Bajo el encabezado de su grupo, las opciones van sangradas (16 de la casilla + 8) -->
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TieneEncabezado}" Value="True">
                                                            <Setter Property="Margin" Value="24,0,0,0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox x:Name="Opcion"
                                                              Content="{Binding Nombre}"
                                                              IsChecked="{Binding Seleccionada, Mode=TwoWay}"
                                                              Visibility="{Binding Visible, Converter={StaticResource BoolToVisConverter}}"
                                                              Style="{StaticResource CheckBoxOpcionFiltroStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3"
                               Margin="12,8"
                               Text="Sin coincidencias"
                               Style="{StaticResource TextBlockCaptionSecondary}"
                               Visibility="{Binding HayCoincidencias, Converter={StaticResource BooleanToInverseVisibilityConverter}}" />

                    <!-- Pie: Cancelar descarta el borrador; Aplicar consulta -->
                    <Border Grid.Row="4"
                            Margin="0,4,0,0"
                            Padding="8"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar"
                                    Command="{Binding CancelarCommand}"
                                    Style="{StaticResource KeycapButtonStyle}" />
                            <Button Content="Aplicar"
                                    Margin="8,0,0,0"
                                    Command="{Binding AplicarCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
