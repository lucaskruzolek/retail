<UserControl x:Class="Retail.App.Views.Components.AsociarValoresPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:Retail.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />

        <!-- Título de columna de la tabla de valores -->
        <Style x:Key="PasoColumnaStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockCaption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- DataContext: TraducirValoresPasoViewModel (lo hereda del paso o del diálogo que lo aloja) -->
    <StackPanel>
        <Border Style="{StaticResource BadgeWarningStyle}"
                HorizontalAlignment="Left"
                Margin="0,0,0,12"
                Visibility="{Binding SoloLectura, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Un Gerente o un Encargado puede asociar estas categorías y marcas."
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{DynamicResource WarningForegroundBrush}" />
        </Border>

        <Border Background="{DynamicResource DangerBackgroundBrush}"
                BorderBrush="{DynamicResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="{DynamicResource DangerForegroundBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Tabla de valores: encabezado de columnas y una fila por valor, como una grilla -->
        <Border>
            <StackPanel>
                <Border Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tipo" Style="{StaticResource PasoColumnaStyle}" />
                        <TextBlock Grid.Column="1" Text="Nombre en la planilla" Style="{StaticResource PasoColumnaStyle}" />
                        <TextBlock Grid.Column="2" Text="Artículos" Style="{StaticResource PasoColumnaStyle}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="3" Text="Equivale a" Style="{StaticResource PasoColumnaStyle}" />
                    </Grid>
                </Border>

                <TextBlock Text="No quedan categorías ni marcas por asociar."
                   Style="{StaticResource TextBlockBodyMuted}"
                   Margin="0,0,0,12"
                   Visibility="{Binding HasItems, ElementName=ListaValores, Converter={StaticResource BooleanToInverseVisibilityConverter}}" />

        <ItemsControl x:Name="ListaValores" ItemsSource="{Binding Valores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,8">
                    <Grid MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource BadgeNeutralStyle}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TipoTexto}" FontSize="{StaticResource FontSizeXs}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Texto}"
                                   Style="{StaticResource TextBlockTextCell}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Texto}"
                                   Margin="0,0,8,0" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource TextBlockNumericCell}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,12,0"
                                   Text="{Binding CantidadDeItems, StringFormat='{}{0} art.'}" />

                        <Grid Grid.Column="3"
                              Visibility="{Binding Pendiente, Converter={StaticResource BoolToVisConverter}}"
                              IsEnabled="{Binding DataContext.PuedeAdministrar, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <ComboBox ItemsSource="{Binding DataContext.Categorias, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      DisplayMemberPath="NombreCategoria"
                                      SelectedItem="{Binding CategoriaDestino}"
                                      MinHeight="34"
                                      Margin="0,0,8,0"
                                      Visibility="{Binding EsCategoria, Converter={StaticResource BoolToVisConverter}}" />
                            <ComboBox ItemsSource="{Binding DataContext.Marcas, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      DisplayMemberPath="NombreMarca"
                                      SelectedItem="{Binding MarcaDestino}"
                                      MinHeight="34"
                                      Margin="0,0,8,0"
                                      Visibility="{Binding EsCategoria, Converter={StaticResource BooleanToInverseVisibilityConverter}}" />
                        </Grid>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    Visibility="{Binding Pendiente, Converter={StaticResource BoolToVisConverter}}"
                                    IsEnabled="{Binding DataContext.PuedeAdministrar, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Button Command="{Binding DataContext.TraducirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    ToolTip="Asociar con la categoría o marca elegida">
                                <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="16" Height="16" />
                            </Button>
                            <Button Command="{Binding DataContext.IgnorarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    ToolTip="Ignorar: no es una categoría ni una marca útil, se deja de ofrecer en esta y en las próximas importaciones">
                                <iconPacks:PackIconBoxIcons Kind="RegularEyeSlash" Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="3"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource BadgeSuccessStyle}"
                                HorizontalAlignment="Left"
                                Visibility="{Binding Resuelto, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding Resultado}" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                    </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
