<UserControl xmlns:components="clr-namespace:Retail.App.Views.Components"
             x:Class="Retail.App.Views.Components.ListToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Raiz">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Búsqueda rápida -->
        <ui:TextBox x:Name="CuadroBusqueda"
                    Grid.Column="0"
                    IsEnabled="{Binding BuscadorHabilitado, ElementName=Raiz}"
                    Text="{Binding Texto, ElementName=Raiz, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{Binding PlaceholderText, ElementName=Raiz}"
                    Width="390"
                    Height="{StaticResource ControlHeight}"
                    FontSize="{StaticResource FontSizeMd}"
                    VerticalAlignment="Center">
            <ui:TextBox.Icon>
                <components:IconoBoxIcons Kind="RegularSearch" Foreground="{DynamicResource TextMutedBrush}" Width="16" Height="16" />
            </ui:TextBox.Icon>
        </ui:TextBox>

        <!-- Limpiar filtros: se deshabilita sola cuando no hay nada que limpiar (CanExecute del comando) -->
        <Button Grid.Column="1"
                Command="{Binding ComandoLimpiar, ElementName=Raiz}"
                Margin="8,0,0,0"
                VerticalAlignment="Center">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostNeutralButtonStyle}">
                    <Style.Triggers>
                        <!-- Una página sin filtros no enlaza ComandoLimpiar: el botón no se muestra -->
                        <DataTrigger Binding="{Binding ComandoLimpiar, ElementName=Raiz}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconBoxIcons Kind="RegularFilter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Limpiar filtros" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Acciones masivas de la página (una BulkActionBar): siempre a la vista; el badge de cantidad y los botones
             reaccionan a la selección -->
        <ContentPresenter x:Name="PanelSeleccion"
                          Grid.Column="2"
                          Margin="12,0,0,0"
                          Content="{Binding AccionesDeSeleccion, ElementName=Raiz}" />
    </Grid>
</UserControl>
