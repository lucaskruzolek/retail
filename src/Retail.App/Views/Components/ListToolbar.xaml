<UserControl x:Class="Retail.App.Views.Components.ListToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Raiz">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Búsqueda rápida -->
        <ui:TextBox Grid.Column="0"
                    Text="{Binding Texto, ElementName=Raiz, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{Binding PlaceholderText, ElementName=Raiz}"
                    Width="390"
                    Height="40"
                    VerticalAlignment="Center">
            <ui:TextBox.Icon>
                <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                              Width="16"
                              Height="16" />
            </ui:TextBox.Icon>
        </ui:TextBox>

        <!-- Limpiar filtros: se deshabilita sola cuando no hay nada que limpiar (CanExecute del comando) -->
        <Button Grid.Column="1"
                Command="{Binding ComandoLimpiar, ElementName=Raiz}"
                Style="{StaticResource GhostNeutralButtonStyle}"
                Margin="8,0,0,0"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconBoxIcons Kind="RegularFilter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Limpiar filtros" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Indicador de carga asíncrona -->
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"
                    Visibility="{Binding EstaCargando, ElementName=Raiz, Converter={StaticResource BoolToVisConverter}}">
            <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
            <TextBlock Text="Cargando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Cantidad de resultados -->
        <TextBlock Grid.Column="4"
                   Text="{Binding TextoContador, ElementName=Raiz}"
                   Style="{StaticResource TextBlockBodySecondary}"
                   FontSize="12"
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>
