<UserControl xmlns:components="clr-namespace:Retail.App.Views.Components"
             x:Class="Retail.App.Views.Components.FiltroFechaColumna"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Raiz">
    <UserControl.Resources>
        <!-- Con un rango aplicado, el tooltip del botón lo dice -->
        <Style x:Key="BotonFechaStyle" TargetType="ToggleButton" BasedOn="{StaticResource FiltroColumnaBotonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HayFiltroActivo}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding TextoAplicado}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Igual que FiltroColumna: el DataContext del UserControl sigue siendo el de la grilla; todo lo demás trabaja sobre el
         FiltroFechaColumnaViewModel (propiedad Filtro) -->
    <StackPanel Orientation="Horizontal" DataContext="{Binding Filtro, ElementName=Raiz}">
        <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center" />

        <ToggleButton x:Name="BotonFiltro"
                      Margin="4,0,0,0"
                      IsChecked="{Binding EstaAbierto, Mode=TwoWay}"
                      ToolTip="{Binding Titulo, StringFormat='Filtrar por {0}'}"
                      AutomationProperties.Name="{Binding Titulo, StringFormat='Filtrar por {0}'}"
                      Style="{StaticResource BotonFechaStyle}">
            <iconPacks:PackIconBoxIcons Kind="RegularCalendar" Width="14" Height="14" />
        </ToggleButton>

        <Popup x:Name="Panel"
               StaysOpen="True"
               PlacementTarget="{Binding ElementName=BotonFiltro}"
               Placement="Bottom"
               HorizontalOffset="-8"
               AllowsTransparency="True"
               PopupAnimation="None">
            <Border x:Name="Tarjeta" Style="{StaticResource FiltroColumnaPanelStyle}">
                <components:SelectorRangoFecha />
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
