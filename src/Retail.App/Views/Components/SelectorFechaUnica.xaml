<UserControl x:Class="Retail.App.Views.Components.SelectorFechaUnica"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Raiz">

    <!-- Un botón con la fecha elegida ("03/11/2026") que abre un calendario. Es el hermano de fecha única de
         FiltroRangoFecha: mismo botón (RangoFechaBotonStyle), mismo panel flotante (FiltroColumnaPanelStyle) y el mismo
         calendario (CalendarioStyle). Elegir un día lo cierra. -->
    <Grid>
        <ToggleButton x:Name="Boton"
                      IsChecked="{Binding Estado.EstaAbierto, ElementName=Raiz, Mode=TwoWay}"
                      ToolTip="Elegir fecha"
                      AutomationProperties.Name="{Binding NombreAutomatizacion, ElementName=Raiz}"
                      Style="{StaticResource RangoFechaBotonStyle}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconBoxIcons Kind="RegularCalendar" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Fecha, ElementName=Raiz, StringFormat='{}{0:dd/MM/yyyy}', ConverterCulture=es-AR}" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="Panel"
               StaysOpen="True"
               PlacementTarget="{Binding ElementName=Boton}"
               Placement="Bottom"
               HorizontalOffset="-8"
               AllowsTransparency="True"
               PopupAnimation="None">
            <Border x:Name="Tarjeta" Style="{StaticResource FiltroColumnaPanelStyle}" Padding="8">
                <Calendar x:Name="Calendario"
                          Style="{StaticResource CalendarioStyle}"
                          FirstDayOfWeek="Monday" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
