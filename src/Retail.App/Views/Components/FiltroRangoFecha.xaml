<UserControl xmlns:components="clr-namespace:Retail.App.Views.Components"
             x:Class="Retail.App.Views.Components.FiltroRangoFecha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Raiz">

    <!-- Un botón con el rango elegido ("01/11/2026 – 03/11/2026") que abre el mismo panel de FiltroFechaColumna
         (SelectorRangoFecha). Para barras de filtros fuera de una grilla, como las del tablero. El DataContext del
         UserControl sigue siendo el de la página; todo lo demás trabaja sobre el FiltroFechaColumnaViewModel (Filtro). -->
    <Grid DataContext="{Binding Filtro, ElementName=Raiz}">
        <ToggleButton x:Name="Boton"
                      IsChecked="{Binding EstaAbierto, Mode=TwoWay}"
                      ToolTip="{Binding Titulo, StringFormat='Elegir {0}'}"
                      AutomationProperties.Name="{Binding Titulo, StringFormat='Elegir {0}'}"
                      Style="{StaticResource RangoFechaBotonStyle}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconBoxIcons Kind="RegularCalendar" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TextoAplicado}" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="Panel"
               StaysOpen="True"
               PlacementTarget="{Binding ElementName=Boton}"
               Placement="Bottom"
               HorizontalOffset="-8"
               AllowsTransparency="True"
               PopupAnimation="None">
            <Border x:Name="Tarjeta" Style="{StaticResource FiltroColumnaPanelStyle}">
                <components:SelectorRangoFecha />
            </Border>
        </Popup>
    </Grid>
</UserControl>
