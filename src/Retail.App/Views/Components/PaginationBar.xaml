<UserControl x:Class="Retail.App.Views.Components.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Raiz">
    <DockPanel LastChildFill="False" Margin="16,10">
        <!-- Izquierda: dónde estoy y cuántas filas veo -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Página" Style="{StaticResource PaginacionTextoStyle}" />
            <!-- Editable: un número y Enter (o salir del cuadro) va a esa página -->
            <TextBox x:Name="CuadroPagina"
                     Style="{StaticResource PaginacionCuadroStyle}"
                     Margin="8,0"
                     AutomationProperties.Name="Página actual" />
            <TextBlock Style="{StaticResource PaginacionTextoStyle}">
                <Run Text="de" />
                <Run Text="{Binding TotalPaginas, Mode=OneWay}" />
            </TextBlock>

            <Rectangle Width="1" Height="16" Margin="16,0" Fill="{DynamicResource SurfaceBorderBrush}" VerticalAlignment="Center" />

            <TextBlock Text="Filas por página" Style="{StaticResource PaginacionTextoStyle}" Margin="0,0,8,0" />
            <!-- El ComboBox de WPF-UI fija su borde visible con el texto más el relleno vertical (no Height) y reserva ~32 px
                 para la flecha además del relleno derecho: por eso el relleno derecho es 0 y el ancho, 64 -->
            <ComboBox ItemsSource="{Binding TamanosPaginaDisponibles}"
                      SelectedItem="{Binding TamanoPagina, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxFiltroStyle}"
                      Width="64"
                      Height="{StaticResource ControlHeightSm}"
                      MinHeight="{StaticResource ControlHeightSm}"
                      FontSize="{StaticResource FontSizeSm}"
                      Padding="10,4,0,4"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Filas por página" />
        </StackPanel>

        <!-- Derecha: navegación. Los chevrons van con contorno; los números, sin él (la actual, con fondo suave) -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding PrimeraPaginaCommand}"
                    IsEnabled="{Binding PuedeRetrocederPagina}"
                    Style="{StaticResource PaginacionFlechaStyle}"
                    ToolTip="Primera página"
                    AutomationProperties.Name="Primera página">
                <Path Data="{StaticResource GeometryChevronsLeft}" Style="{StaticResource PaginacionChevronStyle}" />
            </Button>
            <Button Command="{Binding PaginaAnteriorCommand}"
                    IsEnabled="{Binding PuedeRetrocederPagina}"
                    Style="{StaticResource PaginacionFlechaStyle}"
                    Margin="4,0,12,0"
                    ToolTip="Página anterior"
                    AutomationProperties.Name="Página anterior">
                <Path Data="{StaticResource GeometryChevronLeft}" Style="{StaticResource PaginacionChevronStyle}" />
            </Button>

            <ItemsControl ItemsSource="{Binding Elementos, ElementName=Raiz}" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Button x:Name="Numero"
                                    Content="{Binding Numero}"
                                    Command="{Binding ComandoIrAPagina, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Numero}"
                                    Style="{StaticResource PaginacionNumeroStyle}" />
                            <TextBlock x:Name="Salto"
                                       Text="…"
                                       Width="{StaticResource ControlHeightSm}"
                                       TextAlignment="Center"
                                       Style="{StaticResource PaginacionTextoStyle}"
                                       Visibility="Collapsed" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding EsSalto}" Value="True">
                                <Setter TargetName="Numero" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Salto" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Command="{Binding PaginaSiguienteCommand}"
                    IsEnabled="{Binding PuedeAvanzarPagina}"
                    Style="{StaticResource PaginacionFlechaStyle}"
                    Margin="12,0,4,0"
                    ToolTip="Página siguiente"
                    AutomationProperties.Name="Página siguiente">
                <Path Data="{StaticResource GeometryChevronRight}" Style="{StaticResource PaginacionChevronStyle}" />
            </Button>
            <Button Command="{Binding UltimaPaginaCommand}"
                    IsEnabled="{Binding PuedeAvanzarPagina}"
                    Style="{StaticResource PaginacionFlechaStyle}"
                    ToolTip="Última página"
                    AutomationProperties.Name="Última página">
                <Path Data="{StaticResource GeometryChevronsRight}" Style="{StaticResource PaginacionChevronStyle}" />
            </Button>
        </StackPanel>
    </DockPanel>
</UserControl>
