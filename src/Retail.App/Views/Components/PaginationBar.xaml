<UserControl x:Class="Retail.App.Views.Components.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <DockPanel LastChildFill="False" Margin="16,10">
        <!-- Resumen de registros a la izquierda (la página que ya muestra la cantidad en otro lado lo oculta) -->
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding InformacionPaginacion}"
                   Visibility="{Binding MostrarResumen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                   Style="{StaticResource TextBlockBodySecondary}"
                   FontSize="12"
                   VerticalAlignment="Center" />

        <!-- Controles de navegación a la derecha -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Selector de Filas por Página -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Filas:" Style="{StaticResource TextBlockBodySecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                <!-- El ComboBox de WPF-UI tiene dos particularidades: su borde visible lo fija el texto más el relleno vertical
                     (no Height; 5.7 lo iguala a los botones de al lado, 32) y reserva ~32 px para la flecha además del relleno
                     derecho (por eso este es 0: con más, el texto quedaba en 0 px de ancho y no se veía). Las opciones tienen dos
                     cifras: 64 de ancho alcanzan. -->
                <ComboBox ItemsSource="{Binding TamanosPaginaDisponibles}"
                          SelectedItem="{Binding TamanoPagina, Mode=TwoWay}"
                          Style="{StaticResource ComboBoxFiltroStyle}"
                          Width="64"
                          Height="32"
                          FontSize="12"
                          Padding="10,5.7,0,5.7"
                          VerticalAlignment="Center" />
            </StackPanel>

            <!-- Botón Primera Página -->
            <Button Command="{Binding PrimeraPaginaCommand}"
                    IsEnabled="{Binding PuedeRetrocederPagina}"
                    Style="{StaticResource KeycapButtonStyle}"
                    Padding="8,0" Height="32" MinWidth="32"
                    Margin="0,0,4,0"
                    ToolTip="Primera página">
                <iconPacks:PackIconBoxIcons Kind="RegularChevronsLeft" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>

            <!-- Botón Página Anterior -->
            <Button Command="{Binding PaginaAnteriorCommand}"
                    IsEnabled="{Binding PuedeRetrocederPagina}"
                    Style="{StaticResource KeycapButtonStyle}"
                    Padding="8,0" Height="32" MinWidth="32"
                    Margin="0,0,6,0"
                    ToolTip="Página anterior">
                <iconPacks:PackIconBoxIcons Kind="RegularChevronLeft" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>

            <!-- Indicador de Página Actual -->
            <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SurfaceCardBrush}"
                    MinWidth="64"
                    Height="32"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TextBlockBodySecondary}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12"
                           Padding="10,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} de {1}">
                            <Binding Path="PaginaActual" />
                            <Binding Path="TotalPaginas" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>

            <!-- Botón Página Siguiente -->
            <Button Command="{Binding PaginaSiguienteCommand}"
                    IsEnabled="{Binding PuedeAvanzarPagina}"
                    Style="{StaticResource KeycapButtonStyle}"
                    Padding="8,0" Height="32" MinWidth="32"
                    Margin="0,0,4,0"
                    ToolTip="Página siguiente">
                <iconPacks:PackIconBoxIcons Kind="RegularChevronRight" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>

            <!-- Botón Última Página -->
            <Button Command="{Binding UltimaPaginaCommand}"
                    IsEnabled="{Binding PuedeAvanzarPagina}"
                    Style="{StaticResource KeycapButtonStyle}"
                    Padding="8,0" Height="32" MinWidth="32"
                    ToolTip="Última página">
                <iconPacks:PackIconBoxIcons Kind="RegularChevronsRight" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
        </StackPanel>
    </DockPanel>
</UserControl>
