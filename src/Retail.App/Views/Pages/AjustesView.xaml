<UserControl x:Class="Retail.App.Views.Pages.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Ajustes"
                               Descripcion="Preferencias de la aplicación: apariencia y otras configuraciones." />

        <!-- Secciones de Ajustes -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Left" MinWidth="400" MaxWidth="560">
            <!-- Apariencia: tema claro u oscuro, se aplica al instante y queda guardado para el próximo inicio -->
            <Border Style="{StaticResource DialogSectionStyle}"
                    Margin="{StaticResource StackLg}">
                <StackPanel>
                    <TextBlock Text="Apariencia" Style="{StaticResource CardHeaderTextStyle}" Margin="{StaticResource StackMd}" />

                    <TextBlock Text="Tema"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="{StaticResource StackSm}" />

                    <components:SelectorSegmentado>
                        <UniformGrid Columns="2">
                            <RadioButton
                                         IsChecked="{Binding TemaClaro, Mode=TwoWay}"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         Content="Claro" />
                            <RadioButton
                                         IsChecked="{Binding TemaOscuro, Mode=TwoWay}"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         Content="Oscuro" />
                        </UniformGrid>
                    </components:SelectorSegmentado>
                </StackPanel>
            </Border>

            <!-- Precios (solo Gerente, D-38): redondeo global del precio de venta calculado con el markup. Se guarda con
                 "Aplicar" y no al elegir, porque cambia los precios que calcula todo el comercio. -->
            <Border Style="{StaticResource DialogSectionStyle}"
                    Margin="{StaticResource StackLg}"
                    Visibility="{Binding MostrarPrecios, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Text="Precios" Style="{StaticResource CardHeaderTextStyle}" Margin="{StaticResource StackMd}" />

                    <TextBlock Text="Redondeo del precio de venta"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="{StaticResource StackSm}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding OpcionesRedondeo}"
                                  SelectedItem="{Binding RedondeoSeleccionado}"
                                  DisplayMemberPath="Texto"
                                  Height="{StaticResource ControlHeight}"
                                  AutomationProperties.Name="Redondeo del precio de venta" />
                        <Button Grid.Column="1"
                                Command="{Binding AplicarRedondeoCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Margin="12,0,0,0"
                                Content="Aplicar" />
                    </Grid>

                    <TextBlock Text="{Binding EjemploRedondeo}"
                               Style="{StaticResource TextBlockCaption}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="Se aplica en los próximos recálculos (alta o edición de artículos, compras e importaciones). Los precios actuales no cambian. El precio nunca queda por debajo del costo: si el redondeo inferior lo dejara así, se usa el superior."
                               Style="{StaticResource TextBlockCaption}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock Text="{Binding MensajeRedondeo}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeSm}"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensajeRedondeoEsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MensajeRedondeo}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Documentación y ayuda: manual de usuario en PDF y resumen de atajos de teclado -->
            <Border Style="{StaticResource DialogSectionStyle}">
                <StackPanel>
                    <TextBlock Text="Documentación y ayuda" Style="{StaticResource CardHeaderTextStyle}" Margin="{StaticResource StackMd}" />

                    <TextBlock Text="Acceda al manual de usuario operativo o consulte el resumen rápido de atajos de teclado."
                               Style="{StaticResource TextBlockBodySecondary}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource StackMd}" />

                    <WrapPanel>
                        <Button Command="{Binding AbrirManualPdfCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularBookOpen" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Abrir manual (PDF)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AbrirCentroAyudaCommand}"
                                Style="{StaticResource KeycapButtonStyle}"
                                ToolTip="Abrir el centro de ayuda [Ctrl+H]">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularHelpCircle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Centro de ayuda" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
