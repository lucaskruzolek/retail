<UserControl x:Class="Retail.App.Views.Pages.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Ajustes"
                               Descripcion="Preferencias de la aplicación: apariencia y otras configuraciones." />

        <!-- Apariencia: tema claro u oscuro, se aplica al instante y queda guardado para el próximo inicio -->
        <Border Grid.Row="1"
                Style="{StaticResource DialogSectionStyle}"
                HorizontalAlignment="Left"
                MinWidth="400">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                    <iconPacks:PackIconBoxIcons Kind="RegularPalette" Style="{StaticResource CardHeaderIconStyle}" />
                    <TextBlock Text="Apariencia" Style="{StaticResource CardHeaderTextStyle}" />
                </StackPanel>

                <TextBlock Text="Tema"
                           Style="{StaticResource TextBlockBodySecondary}"
                           Margin="{StaticResource StackSm}" />

                <components:SelectorSegmentado>
                    <UniformGrid Columns="2">
                        <RadioButton
                                     IsChecked="{Binding TemaClaro, Mode=TwoWay}"
                                     Style="{StaticResource SegmentedRadioButtonStyle}"
                                     Content="Claro" />
                        <RadioButton
                                     IsChecked="{Binding TemaOscuro, Mode=TwoWay}"
                                     Style="{StaticResource SegmentedRadioButtonStyle}"
                                     Content="Oscuro" />
                    </UniformGrid>
                </components:SelectorSegmentado>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
