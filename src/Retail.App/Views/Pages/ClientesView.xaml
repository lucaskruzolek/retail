<UserControl x:Class="Retail.App.Views.Pages.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NuevoClienteCommand}" />
        <KeyBinding Key="F3" Command="{Binding AlternarSoloConDeudaCommand}" />
        <KeyBinding Key="F4" Command="{Binding CobrarCuentaCorrienteCommand}" />
        <KeyBinding Key="F5" Command="{Binding CargarClientesCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Padrón de Clientes y Cuentas Corrientes"
                                   Style="{StaticResource TextBlockHeader1}" />
                    </StackPanel>

                    <TextBlock Text="Gestión integral de clientes comerciales y saldos de cuentas corrientes"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Botón Refrescar (F5) -->
                    <Button Command="{Binding CargarClientesCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="12,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refrescar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Cobrar Cta Cte (F4) -->
                    <Button Command="{Binding CobrarCuentaCorrienteCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            IsEnabled="{Binding PuedeCobrar}"
                            Padding="14,8"
                            Margin="0,0,10,0"
                            ToolTip="Registrar cobranza de cuenta corriente para el cliente seleccionado (F4)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="SolidCreditCard" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Cobrar Deuda" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Nuevo Cliente (F2) -->
                    <Button Command="{Binding NuevoClienteCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="SolidUserPlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Nuevo Cliente" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. PANEL UNIFICADO: FILTROS + TABLA + PAGINACIÓN              -->
        <!-- ============================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Barra de Búsqueda y Filtros (Mismo surface, solo espaciado) -->
                    <RowDefinition Height="Auto" />
                    <!-- Grilla Principal DataGrid -->
                    <RowDefinition Height="*" />
                    <!-- Barra de Paginación al final de la tabla -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- 2.1 BARRA DE HERRAMIENTAS Y FILTROS                       -->
                <!-- ========================================================= -->
                <DockPanel Grid.Row="0"
                           LastChildFill="True"
                           Margin="16,14,16,12">
                    <!-- Búsqueda rápida por nombre, DNI o CUIT -->
                    <ui:TextBox DockPanel.Dock="Left"
                                Width="360"
                                PlaceholderText="Buscar por Razón Social, CUIT, DNI o Email..."
                                Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                        <ui:TextBox.Icon>
                            <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                          Width="16"
                                          Height="16" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Toggle Solo con Cuenta Corriente -->
                    <CheckBox DockPanel.Dock="Left"
                              IsChecked="{Binding SoloConCuentaCorriente, Mode=TwoWay}"
                              Content="Solo con Cta. Cte."
                              Margin="0,0,14,0"
                              VerticalAlignment="Center" />

                    <!-- Toggle Solo con Deuda (F3) con KeycapToggleButtonStyle -->
                    <ToggleButton DockPanel.Dock="Left"
                                  IsChecked="{Binding SoloConDeuda, Mode=TwoWay}"
                                  Style="{StaticResource KeycapToggleButtonStyle}"
                                  Padding="10,6"
                                  VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="SolidDollarCircle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                            <TextBlock Text="Solo con Deuda" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Indicador de Carga Asíncrona -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                        <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
                        <TextBlock Text="Cargando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- ========================================================= -->
                <!-- 2.2 GRILLA PRINCIPAL DE CLIENTES                          -->
                <!-- ========================================================= -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Clientes}"
                          SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0,1,0,1">
                    <DataGrid.Columns>
                        <!-- ID Cliente -->
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding IdCliente, StringFormat=#{0:D4}}"
                                            Width="65"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                        <!-- Razón Social o Nombre -->
                        <DataGridTextColumn Header="Razón Social / Nombre"
                                            Binding="{Binding RazonSocialONombre}"
                                            Width="2*"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />

                        <!-- Tipo y Número de Documento -->
                        <DataGridTemplateColumn Header="Documento / CUIT" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding TipoDocumento}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NumeroDocumento}" FontFamily="{StaticResource FontFamilyMonospace}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Condición frente al IVA -->
                        <DataGridTemplateColumn Header="Condición IVA" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeNeutralStyle}">
                                        <TextBlock Text="{Binding CondicionIva}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Teléfono / Contacto -->
                        <DataGridTextColumn Header="Teléfono"
                                            Binding="{Binding Telefono, TargetNullValue='-'}"
                                            Width="120"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />

                        <!-- Cuenta Corriente Status (Badge Semántico Canónico) -->
                        <DataGridTemplateColumn Header="Cta. Cte." Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Border x:Name="BadgeCtaHabilitada" Style="{StaticResource BadgeSuccessStyle}" Visibility="Collapsed">
                                            <TextBlock Text="Habilitada" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        </Border>
                                        <Border x:Name="BadgeCtaInactiva" Style="{StaticResource BadgeNeutralStyle}" Visibility="Visible">
                                            <TextBlock Text="No activa" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TieneCuentaCorriente}" Value="True">
                                            <Setter TargetName="BadgeCtaHabilitada" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="BadgeCtaInactiva" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Límite de Crédito -->
                        <DataGridTextColumn Header="Límite Crédito"
                                            Binding="{Binding LimiteCredito, StringFormat={}{0:C}}"
                                            Width="120"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                        <!-- Saldo Deudor -->
                        <DataGridTemplateColumn Header="Saldo Deudor" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SaldoCuentaCorriente, StringFormat={}{0:C}}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               TextAlignment="Right"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TieneDeuda}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Crédito Disponible -->
                        <DataGridTemplateColumn Header="Crédito Disp." Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreditoDisponible, StringFormat={}{0:C}}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                               TextAlignment="Right"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Columna de Acciones Contextuales -->
                        <DataGridTemplateColumn Header="Acciones" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Cobrar Cta Cte -->
                                        <Button Command="{Binding DataContext.CobrarCuentaCorrienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="6,4"
                                                Margin="0,0,4,0"
                                                ToolTip="Registrar Cobranza de Cuenta Corriente (F4)">
                                            <iconPacks:PackIconBoxIcons Kind="RegularDollarCircle" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" />
                                        </Button>

                                        <!-- Modificar -->
                                        <Button Command="{Binding DataContext.EditarClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="6,4"
                                                Margin="0,0,4,0"
                                                ToolTip="Modificar Datos del Cliente">
                                            <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Button>

                                        <!-- Dar de Baja -->
                                        <Button Command="{Binding DataContext.DarDeBajaClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="6,4"
                                                ToolTip="Dar de Baja Lógica al Cliente (Soft Delete)">
                                            <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ========================================================= -->
                <!-- 2.3 BARRA DE PAGINACIÓN AL FINAL DE LA TABLA               -->
                <!-- ========================================================= -->
                <components:PaginationBar Grid.Row="2" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
