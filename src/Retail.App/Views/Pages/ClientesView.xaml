<UserControl x:Class="Retail.App.Views.Pages.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NuevoClienteCommand}" />
        <KeyBinding Key="F4" Command="{Binding CobrarCuentaCorrienteCommand}" />
        <KeyBinding Key="F5" Command="{Binding CargarClientesCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Búsqueda, directo sobre el fondo -->
            <RowDefinition Height="Auto" />
            <!-- Tabla + paginación: la única superficie de la página -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO DE LA PÁGINA (sin tarjeta)                      -->
        <!-- ============================================================= -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Padrón de Clientes y Cuentas Corrientes">
            <StackPanel Orientation="Horizontal">
                <!-- Cobrar Cta Cte (F4): secundaria con contorno; el único acento carmín de la vista es "Nuevo Cliente" -->
                <Button Command="{Binding CobrarCuentaCorrienteCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsEnabled="{Binding PuedeCobrar}"
                        Margin="0,0,8,0"
                        ToolTip="Registrar cobranza de cuenta corriente para el cliente seleccionado (F4)">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCreditCard" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cobrar Deuda" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Nuevo Cliente (F2) -->
                <Button Command="{Binding NuevoClienteCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="Registrar un cliente nuevo (F2)">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularUserPlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nuevo Cliente" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </components:PageHeader>

        <!-- ============================================================= -->
        <!-- 2. BÚSQUEDA Y CARGA (sin tarjeta)                             -->
        <!--    Los filtros de Cta. Cte. y deuda viven en las cabeceras.   -->
        <!-- ============================================================= -->
        <components:ListToolbar Grid.Row="1"
                                Margin="0,0,0,12"
                                Texto="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar por Razón Social, CUIT, DNI o Email..."
                                ComandoLimpiar="{Binding LimpiarFiltrosCommand}"
                                EstaCargando="{Binding IsBusy}" />

        <!-- ============================================================= -->
        <!-- 3. TABLA: GRILLA Y, COMO CONTINUACIÓN, LA PAGINACIÓN          -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Style="{StaticResource TablaListadoStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Clientes}"
                          SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridListadoStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          helpers:EsquinasHelper.Esquinas="7,7,0,0">
                    <DataGrid.Columns>
                        <!-- ID Cliente -->
                        <DataGridTextColumn Header="ID"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                            Binding="{Binding IdCliente, StringFormat=#{0:D4}}"
                                            Width="80"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                        <!-- Razón Social o Nombre -->
                        <DataGridTextColumn Header="Razón Social / Nombre"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                            Binding="{Binding RazonSocialONombre}"
                                            Width="2*"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />

                        <!-- Tipo y Número de Documento -->
                        <DataGridTemplateColumn Header="Documento / CUIT"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                                Width="152">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TipoDocumento, Converter={StaticResource EnumATextoConverter}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NumeroDocumento}" Style="{StaticResource TextBlockMonospaceCell}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Condición frente al IVA -->
                        <DataGridTemplateColumn Header="Condición IVA"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                                Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeNeutralStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CondicionIva, Converter={StaticResource EnumATextoConverter}}"
                                                   Style="{StaticResource BadgeNeutralTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Teléfono / Contacto -->
                        <DataGridTextColumn Header="Teléfono"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                            Binding="{Binding Telefono, TargetNullValue='-'}"
                                            Width="144"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />

                        <!-- Cuenta corriente: su cabecera lleva el filtro de selección múltiple (FiltroColumna). Una columna no
                             está en el árbol visual: el filtro toma el DataContext de la página buscando el UserControl ancestro. -->
                        <DataGridTemplateColumn Width="140">
                            <DataGridTemplateColumn.Header>
                                <components:FiltroColumna Filtro="{Binding DataContext.FiltroCuentaCorriente, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Border x:Name="BadgeCtaHabilitada" Style="{StaticResource BadgeSuccessStyle}" HorizontalAlignment="Left" Visibility="Collapsed">
                                            <TextBlock Text="Habilitada"
                                                       FontSize="{StaticResource FontSizeXs}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        </Border>
                                        <Border x:Name="BadgeCtaInactiva" Style="{StaticResource BadgeNeutralStyle}" HorizontalAlignment="Left" Visibility="Visible">
                                            <TextBlock Text="No activa" Style="{StaticResource BadgeNeutralTextStyle}" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TieneCuentaCorriente}" Value="True">
                                            <Setter TargetName="BadgeCtaHabilitada" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="BadgeCtaInactiva" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Límite de Crédito -->
                        <DataGridTextColumn Header="Límite Crédito"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                            Binding="{Binding LimiteCredito, StringFormat={}{0:C}}"
                                            Width="124"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                        <!-- Saldo Deudor: su cabecera lleva el filtro con deuda / sin deuda -->
                        <DataGridTemplateColumn Width="136"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}">
                            <DataGridTemplateColumn.Header>
                                <components:FiltroColumna Filtro="{Binding DataContext.FiltroDeuda, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SaldoCuentaCorriente, StringFormat={}{0:C}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockPriceCell}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TieneDeuda}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Crédito Disponible -->
                        <DataGridTextColumn Header="Crédito Disp."
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                            Binding="{Binding CreditoDisponible, StringFormat={}{0:C}}"
                                            Width="124"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                        <!-- Acciones de la fila: solo íconos (R4), sin título; 3 x 36 + 8 de ancho -->
                        <DataGridTemplateColumn Header=""
                                                HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                                Width="116"
                                                CanUserResize="False"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Cobrar Cta Cte -->
                                        <Button Command="{Binding DataContext.CobrarCuentaCorrienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                ToolTip="Registrar cobranza de cuenta corriente (F4)"
                                                AutomationProperties.Name="Cobrar cuenta corriente">
                                            <iconPacks:PackIconBoxIcons Kind="RegularDollarCircle" Width="14" Height="16" />
                                        </Button>

                                        <!-- Modificar -->
                                        <Button Command="{Binding DataContext.EditarClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                ToolTip="Modificar los datos del cliente"
                                                AutomationProperties.Name="Modificar cliente">
                                            <iconPacks:PackIconBoxIcons Kind="RegularPencil" Width="14" Height="14" />
                                        </Button>

                                        <!-- Baja lógica (soft delete) -->
                                        <Button Command="{Binding DataContext.DarDeBajaClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconDangerButtonStyle}"
                                                ToolTip="Dar de baja al cliente"
                                                AutomationProperties.Name="Dar de baja al cliente">
                                            <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Paginación pegada a la grilla, separada por una línea -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                    <components:PaginationBar />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
