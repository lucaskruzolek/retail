<UserControl x:Class="Retail.App.Views.Pages.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NuevoClienteCommand}" />
        <KeyBinding Key="F3" Command="{Binding AlternarSoloConDeudaCommand}" />
        <KeyBinding Key="F4" Command="{Binding CobrarCuentaCorrienteCommand}" />
        <KeyBinding Key="F5" Command="{Binding CargarClientesCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Padrón de Clientes y Cuentas Corrientes"
                                   Style="{StaticResource TextBlockHeader1}" />
                        <!-- Badges de Métricas -->
                        <Border Style="{StaticResource BadgeNeutralStyle}" Margin="16,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalClientes, StringFormat={}{0} Clientes}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <Border Style="{StaticResource BadgeWarningStyle}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding TotalClientesConDeuda, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding TotalClientesConDeuda, StringFormat={}💳 {0} con Deuda}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                        </Border>

                        <Border Style="{StaticResource BadgePrimaryStyle}"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding TotalClientesConDeuda, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding TotalDeudaCartera, StringFormat={}Cartera: {0:C}}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Gestión integral de clientes comerciales, condición tributaria IVA y saldos de cuentas corrientes (RF-20)"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Botón Refrescar (F5) -->
                    <Button Command="{Binding CargarClientesCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="12,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refrescar (F5)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Cobrar Cta Cte (F4) -->
                    <Button Command="{Binding CobrarCuentaCorrienteCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            IsEnabled="{Binding PuedeCobrar}"
                            Padding="14,8"
                            Margin="0,0,10,0"
                            ToolTip="Registrar cobranza de cuenta corriente para el cliente seleccionado (F4)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Payment24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Cobrar Deuda (F4)" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Nuevo Cliente (F2) -->
                    <Button Command="{Binding NuevoClienteCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Nuevo Cliente (F2)" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. BARRA DE HERRAMIENTAS Y FILTROS                            -->
        <!-- ============================================================= -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="16,12"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <!-- Búsqueda rápida por nombre, DNI o CUIT -->
                <ui:TextBox DockPanel.Dock="Left"
                            Width="360"
                            PlaceholderText="Buscar por Razón Social, CUIT, DNI o Email..."
                            Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"
                            Margin="0,0,16,0" />

                <!-- Filtros a la derecha -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Toggle Solo con Cuenta Corriente -->
                    <CheckBox IsChecked="{Binding SoloConCuentaCorriente, Mode=TwoWay}"
                              Content="Solo con Cta. Cte."
                              Margin="0,0,16,0"
                              VerticalAlignment="Center" />

                    <!-- Toggle Solo con Deuda (F3) -->
                    <ToggleButton IsChecked="{Binding SoloConDeuda, Mode=TwoWay}"
                                  Padding="12,6"
                                  Margin="0,0,0,0"
                                  VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MoneyHand24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Solo con Deuda (F3)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 3. GRILLA PRINCIPAL DE CLIENTES                               -->
        <!-- ============================================================= -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="0"
                Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding Clientes}"
                      SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <!-- ID Cliente -->
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding IdCliente, StringFormat=#{0:D4}}"
                                        Width="65"
                                        FontFamily="{StaticResource FontFamilyMonospace}" />

                    <!-- Razón Social o Nombre -->
                    <DataGridTextColumn Header="Razón Social / Nombre"
                                        Binding="{Binding RazonSocialONombre}"
                                        Width="2*"
                                        FontWeight="SemiBold" />

                    <!-- Tipo y Número de Documento -->
                    <DataGridTemplateColumn Header="Documento / CUIT" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding TipoDocumento}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" FontSize="11" />
                                    <TextBlock Text="{Binding NumeroDocumento}" FontFamily="{StaticResource FontFamilyMonospace}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Condición frente al IVA -->
                    <DataGridTemplateColumn Header="Condición IVA" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeNeutralStyle}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CondicionIva}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Teléfono / Contacto -->
                    <DataGridTextColumn Header="Teléfono"
                                        Binding="{Binding Telefono}"
                                        Width="120" />

                    <!-- Cuenta Corriente Status -->
                    <DataGridTemplateColumn Header="Cta. Cte." Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TieneCuentaCorriente}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="4" />
                                                    <Setter Property="Padding" Value="6,2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TieneCuentaCorriente}" Value="False">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Padding" Value="6,2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TieneCuentaCorriente}" Value="True">
                                                        <Setter Property="Text" Value="HABILITADA" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TieneCuentaCorriente}" Value="False">
                                                        <Setter Property="Text" Value="No activa" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Límite de Crédito -->
                    <DataGridTextColumn Header="Límite Crédito"
                                        Binding="{Binding LimiteCredito, StringFormat={}{0:C}}"
                                        Width="120"
                                        FontFamily="{StaticResource FontFamilyMonospace}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Saldo Deudor -->
                    <DataGridTemplateColumn Header="Saldo Deudor" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SaldoCuentaCorriente, StringFormat={}{0:C}}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           FontWeight="Bold"
                                           TextAlignment="Right"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SaldoCuentaCorriente, ConverterParameter=0, Converter={StaticResource BoolToVisConverter}}" Value="Visible">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Crédito Disponible -->
                    <DataGridTextColumn Header="Crédito Disp."
                                        Binding="{Binding CreditoDisponible, StringFormat={}{0:C}}"
                                        Width="120"
                                        FontFamily="{StaticResource FontFamilyMonospace}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Columna de Acciones Contextuales -->
                    <DataGridTemplateColumn Header="Acciones" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Cobrar Cta Cte -->
                                    <Button Command="{Binding DataContext.CobrarCuentaCorrienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Registrar Cobranza de Cuenta Corriente"
                                            Padding="6,4"
                                            Margin="0,0,4,0">
                                        <ui:SymbolIcon Symbol="Payment24" FontSize="14" Foreground="{DynamicResource SuccessForegroundBrush}" />
                                    </Button>

                                    <!-- Modificar -->
                                    <Button Command="{Binding DataContext.EditarClienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ToolTip="Modificar Datos del Cliente"
                                            Padding="6,4"
                                            Margin="0,0,4,0">
                                        <ui:SymbolIcon Symbol="Edit24" FontSize="14" />
                                    </Button>

                                    <!-- Dar de Baja -->
                                    <Button Command="{Binding DataContext.DarDeBajaClienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ToolTip="Dar de Baja Lógica al Cliente"
                                            Padding="6,4">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="{DynamicResource DangerForegroundBrush}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================================================= -->
        <!-- 4. BARRA DE ESTADO INFERIOR                                   -->
        <!-- ============================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,8">
            <DockPanel LastChildFill="False">
                <!-- Indicador de Carga -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="Procesando padrón de clientes..."
                               Style="{StaticResource TextBlockBodySecondary}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Mensaje de Estado / Resultados -->
                <TextBlock Text="{Binding MensajeEstado}"
                           Style="{StaticResource TextBlockBodySecondary}"
                           FontSize="12"
                               VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}" />

                <!-- Atajos rápidos al pie -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="[F2] Nuevo Cliente  |  [F3] Solo con Deuda  |  [F4] Cobrar Deuda  |  [F5] Refrescar"
                               Style="{StaticResource TextBlockBodyMuted}"
                               FontFamily="{StaticResource FontFamilyMonospace}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
