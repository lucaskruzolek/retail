<UserControl x:Class="Retail.App.Views.Pages.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NuevoProveedorCommand}" />
        <KeyBinding Key="F4" Command="{Binding EditarProveedorCommand}" />
        <KeyBinding Key="F5" Command="{Binding CargarProveedoresCommand}" />
        <KeyBinding Key="F6" Command="{Binding AbrirImportadorCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Búsqueda y carga, directo sobre el fondo -->
            <RowDefinition Height="Auto" />
            <!-- Mensajes de estado y de error -->
            <RowDefinition Height="Auto" />
            <!-- Tabla + paginación: la única superficie de la página -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO DE LA PÁGINA (sin tarjeta)                      -->
        <!-- ============================================================= -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Proveedores">
            <StackPanel Orientation="Horizontal">
                <!-- Botón Nuevo Proveedor (F2) -->
                <Button x:Name="BtnNuevoProveedor"
                        Command="{Binding NuevoProveedorCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nuevo Proveedor" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </components:PageHeader>

        <!-- ============================================================= -->
        <!-- 2. BÚSQUEDA Y CARGA (sin tarjeta, sin contador)               -->
        <!-- ============================================================= -->
        <components:ListToolbar Grid.Row="1"
                                Margin="{StaticResource StackMd}"
                                Texto="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar por razón social, CUIT o email..."
                                EstaCargando="{Binding IsBusy}" />

        <!-- ============================================================= -->
        <!-- 3. MENSAJES DE ESTADO Y ERROR                                 -->
        <!-- ============================================================= -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="{StaticResource StackMd}">
            <Border Style="{StaticResource BadgeSuccessStyle}"
                    Visibility="{Binding TieneMensajeEstado, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding MensajeEstado}"
                           Style="{StaticResource BadgeNeutralTextStyle}"
                           Foreground="{DynamicResource SuccessForegroundBrush}" />
            </Border>
            <Border Style="{StaticResource BadgeDangerStyle}"
                    Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding MensajeError}"
                           Style="{StaticResource BadgeNeutralTextStyle}"
                           Foreground="{DynamicResource DangerForegroundBrush}" />
            </Border>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- 4. TABLA: GRILLA Y, COMO CONTINUACIÓN, LA PAGINACIÓN          -->
        <!-- ============================================================= -->
        <Border Grid.Row="3" Style="{StaticResource TablaListadoStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="GrillaProveedores"
                          Grid.Row="0"
                          ItemsSource="{Binding Proveedores}"
                          SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridListadoStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          helpers:EsquinasHelper.Esquinas="7,7,0,0">
                    <DataGrid.Columns>

                        <!-- Razón Social -->
                        <DataGridTextColumn Header="Razón Social"
                                            Binding="{Binding RazonSocial}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*" />

                        <!-- CUIT -->
                        <DataGridTemplateColumn Header="CUIT" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cuit}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Teléfono -->
                        <DataGridTextColumn Header="Teléfono"
                                            Binding="{Binding Telefono}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="150" />

                        <!-- Email -->
                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="272" />

                        <!-- Acciones de la fila: solo íconos (4 x 36 + 8); la columna no lleva título -->
                        <DataGridTemplateColumn Width="152" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <!-- Editar -->
                                        <Button Command="{Binding DataContext.EditarProveedorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                Margin="0,0,8,0"
                                                ToolTip="Editar proveedor [F4]">
                                            <iconPacks:PackIconBoxIcons Kind="RegularPencil" Width="14" Height="14" />
                                        </Button>
                                        <!-- Catálogo / Importar -->
                                        <Button Command="{Binding DataContext.AbrirImportadorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                Margin="0,0,8,0"
                                                ToolTip="Ver y gestionar catálogo [F6]">
                                            <iconPacks:PackIconBoxIcons Kind="RegularFileDetail" Width="14" Height="14" />
                                        </Button>
                                        <!-- Equivalencias de clasificación (Track 6.6) -->
                                        <Button Command="{Binding DataContext.AbrirEquivalenciasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                Margin="0,0,8,0"
                                                ToolTip="Equivalencias de clasificación del proveedor">
                                            <iconPacks:PackIconBoxIcons Kind="RegularTranslate" Width="14" Height="14" />
                                        </Button>
                                        <!-- Eliminar (soft delete) -->
                                        <Button Command="{Binding DataContext.EliminarProveedorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconDangerButtonStyle}"
                                                ToolTip="Dar de baja proveedor">
                                            <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Paginación pegada a la grilla, separada por una línea -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                    <components:PaginationBar />
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
