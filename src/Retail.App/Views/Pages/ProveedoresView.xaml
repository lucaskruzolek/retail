<UserControl x:Class="Retail.App.Views.Pages.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NuevoProveedorCommand}" />
        <KeyBinding Key="F4" Command="{Binding EditarProveedorCommand}" />
        <KeyBinding Key="F5" Command="{Binding CargarProveedoresCommand}" />
        <KeyBinding Key="F6" Command="{Binding AbrirImportadorCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="SolidTruck"
                                                    Width="22" Height="22"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />
                        <TextBlock Text="Proveedores y Distribuidores"
                                   Style="{StaticResource TextBlockHeader1}" />
                    </StackPanel>
                    <TextBlock Text="Padrón de proveedores mayoristas. Importación de catálogos y curación de artículos."
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Botón Refrescar (F5) -->
                    <Button Command="{Binding CargarProveedoresCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="12,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refrescar" VerticalAlignment="Center" />
                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                <TextBlock Text="F5" Style="{StaticResource TextBlockKeycap}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Botón Importar Catálogo (F6) -->
                    <Button x:Name="BtnImportador"
                            Command="{Binding AbrirImportadorCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="12,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Importar Catálogo" VerticalAlignment="Center" />
                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                <TextBlock Text="F6" Style="{StaticResource TextBlockKeycap}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Botón Nuevo Proveedor (F2) -->
                    <Button x:Name="BtnNuevoProveedor"
                            Command="{Binding NuevoProveedorCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="SolidPlusCircle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Nuevo Proveedor" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource KeycapPrimaryBadgeStyle}">
                                <TextBlock Text="F2" Style="{StaticResource TextBlockKeycap}" Foreground="{DynamicResource PrimaryForegroundBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. PANEL UNIFICADO: FILTROS + TABLA + ACCIONES                -->
        <!-- ============================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===================================================== -->
                <!-- 2.1 BARRA DE BÚSQUEDA                                  -->
                <!-- ===================================================== -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="16,14,16,12">
                    <ui:TextBox DockPanel.Dock="Left"
                                Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar por razón social, CUIT o email..."
                                Width="380"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                        <ui:TextBox.Icon>
                            <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                          Width="16" Height="16" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Indicador de carga -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                        <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
                        <TextBlock Text="Cargando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Resumen -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding TotalProveedores, StringFormat={}{0} proveedor(es) registrado(s)}"
                                   Style="{StaticResource TextBlockBodySecondary}" />
                    </StackPanel>
                </DockPanel>

                <!-- ===================================================== -->
                <!-- 2.2 GRILLA PRINCIPAL DE PROVEEDORES                    -->
                <!-- ===================================================== -->
                <DataGrid x:Name="GrillaProveedores"
                          Grid.Row="1"
                          ItemsSource="{Binding Proveedores}"
                          SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0,1,0,1">
                    <DataGrid.Columns>

                        <!-- Razón Social -->
                        <DataGridTextColumn Header="Razón Social"
                                            Binding="{Binding RazonSocial}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*" />

                        <!-- CUIT -->
                        <DataGridTemplateColumn Header="CUIT" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cuit}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Teléfono -->
                        <DataGridTextColumn Header="Teléfono"
                                            Binding="{Binding Telefono}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="150" />

                        <!-- Email -->
                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="220" />

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="Acciones" Width="180" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <!-- Editar -->
                                        <Button Command="{Binding DataContext.EditarProveedorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="8,5"
                                                Margin="0,0,6,0"
                                                ToolTip="Editar proveedor [F4]">
                                            <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="13" Height="13" />
                                        </Button>
                                        <!-- Importar catálogo -->
                                        <Button Command="{Binding DataContext.AbrirImportadorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="8,5"
                                                Margin="0,0,6,0"
                                                ToolTip="Importar catálogo [F6]">
                                            <iconPacks:PackIconBoxIcons Kind="RegularImport" Width="13" Height="13" />
                                        </Button>
                                        <!-- Eliminar (soft delete) -->
                                        <Button Command="{Binding DataContext.EliminarProveedorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="8,5"
                                                ToolTip="Dar de baja proveedor">
                                            <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="13" Height="13"
                                                                         Foreground="{DynamicResource DangerForegroundBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- ===================================================== -->
                <!-- 2.3 PIE: MENSAJES DE ESTADO Y ERROR                   -->
                <!-- ===================================================== -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        Padding="16,10">
                    <DockPanel LastChildFill="False">
                        <!-- Mensaje de estado (éxito) -->
                        <Border DockPanel.Dock="Left"
                                Style="{StaticResource BadgeSuccessStyle}"
                                Visibility="{Binding MensajeEstado, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding MensajeEstado}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>

                        <!-- Mensaje de error -->
                        <Border DockPanel.Dock="Left"
                                Style="{StaticResource BadgeDangerStyle}"
                                Visibility="{Binding MensajeError, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding MensajeError}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerForegroundBrush}" />
                        </Border>

                        <!-- Total a la derecha -->
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding TotalProveedores, StringFormat={}{0} proveedor(es) en el padrón}"
                                   Style="{StaticResource TextBlockCaption}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </DockPanel>
                </Border>

            </Grid>
        </Border>

    </Grid>
</UserControl>
