<UserControl x:Class="Retail.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:Retail.App.Converters"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:Retail.App.ViewModels.Reportes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="960"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />
        <converters:IgualAParametroConverter x:Key="IgualAParametroConverter" />

        <!-- Selector de fecha con el aspecto del sistema de diseño. WPF-UI 4.0.0 no trae estilo para el DatePicker de WPF
             (solo para su CalendarDatePicker, que no permite fijar el formato dd/MM/yyyy): se redefine la plantilla con
             los tokens semánticos. El calendario desplegable conserva el estilo predeterminado de WPF. -->
        <Style TargetType="{x:Type components:SelectorFechaCorta}">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Marco"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Padding="0,7,0,0"
                                                   HorizontalContentAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   TextAlignment="Center"
                                                   Focusable="{TemplateBinding Focusable}" />
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="32"
                                        Cursor="Hand"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fondo" Background="Transparent" CornerRadius="0,5,5,0">
                                                <iconPacks:PackIconBoxIcons x:Name="Icono"
                                                                            Kind="RegularCalendar"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                                                    <Setter TargetName="Icono" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=Marco}"
                                       StaysOpen="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Marco" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de período junto a las fechas -->
        <Style x:Key="PeriodoButtonStyle" TargetType="Button" BasedOn="{StaticResource KeycapButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Celdas de grilla: texto recortado con puntos suspensivos y números alineados a la derecha -->
        <Style x:Key="CeldaTextoRecortada" TargetType="TextBlock" BasedOn="{StaticResource TextBlockTextCell}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />

            <!-- El texto cortado con "…" se lee completo al pasar el mouse -->
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="CeldaNumericaDerecha" TargetType="TextBlock" BasedOn="{StaticResource TextBlockNumericCell}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Celdas y encabezados con menos relleno: en las grillas con gráfico cada píxel cuenta para no cortar importes -->
        <Style x:Key="CeldaCompacta" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
            <Setter Property="Padding" Value="8,8" />
        </Style>
        <Style x:Key="CeldaMuyCompacta" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
            <Setter Property="Padding" Value="6,8" />
        </Style>
        <Style x:Key="EncabezadoMuyCompacto" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRetailStyle}">
            <Setter Property="Padding" Value="6,10" />
        </Style>
        <Style x:Key="CeldaMonedaChica" TargetType="TextBlock" BasedOn="{StaticResource TextBlockCurrencyCell}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="EncabezadoCompacto" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRetailStyle}">
            <Setter Property="Padding" Value="8,10" />
        </Style>
        <Style x:Key="EncabezadoMuyCompactoDerecha" TargetType="DataGridColumnHeader" BasedOn="{StaticResource EncabezadoMuyCompacto}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="EncabezadoCompactoDerecha" TargetType="DataGridColumnHeader" BasedOn="{StaticResource EncabezadoCompacto}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!-- Variación contra el período anterior: flecha y signo en el texto; el color refuerza pero no es la única señal -->
        <DataTemplate x:Key="VariacionTemplate">
            <Border x:Name="Badge"
                    Style="{StaticResource BadgeNeutralStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0">
                <TextBlock x:Name="Texto"
                           Text="{Binding Texto}"
                           FontSize="11"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="{x:Static vm:EstadoVariacionEnum.Sube}">
                    <Setter TargetName="Badge" Property="Style" Value="{StaticResource BadgeSuccessStyle}" />
                    <Setter TargetName="Texto" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="{x:Static vm:EstadoVariacionEnum.Baja}">
                    <Setter TargetName="Badge" Property="Style" Value="{StaticResource BadgeDangerStyle}" />
                    <Setter TargetName="Texto" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Dato de la franja de totales al pie de una grilla -->
        <DataTemplate x:Key="DatoResumenTemplate">
            <StackPanel Margin="0,0,28,0">
                <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource TextBlockCaption}" />
                <TextBlock Text="{Binding Valor}"
                           Style="{StaticResource TextBlockCurrencyCell}"
                           TextAlignment="Left" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y EXPORTACIÓN (Excel y PDF)                    -->
        <!-- ============================================================= -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ExportarExcelCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="{Binding TooltipExportar}"
                        ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularTable" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Exportar a Excel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportarPdfCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="{Binding TooltipExportar}"
                        ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularFile" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Exportar a PDF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Tablero gerencial" Style="{StaticResource TextBlockHeader1}" />
                <TextBlock Text="Ventas, rentabilidad e inventario del negocio."
                           Style="{StaticResource TextBlockCaption}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- ============================================================= -->
        <!-- 2. SELECTOR DE REPORTE                                        -->
        <!-- ============================================================= -->
        <components:SelectorSegmentado Grid.Row="1" HorizontalAlignment="Left" Margin="0,0,0,12">
            <UniformGrid Rows="1">
                <RadioButton GroupName="Reporte" Content="Tablero" Style="{StaticResource SegmentedRadioButtonStyle}"
                             IsChecked="{Binding ReporteSeleccionado, Mode=TwoWay, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={x:Static vm:TipoReporteEnum.Tablero}}" />
                <RadioButton GroupName="Reporte" Content="Ventas por período" Style="{StaticResource SegmentedRadioButtonStyle}"
                             IsChecked="{Binding ReporteSeleccionado, Mode=TwoWay, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={x:Static vm:TipoReporteEnum.VentasPorPeriodo}}" />
                <RadioButton GroupName="Reporte" Content="Ranking" Style="{StaticResource SegmentedRadioButtonStyle}"
                             IsChecked="{Binding ReporteSeleccionado, Mode=TwoWay, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={x:Static vm:TipoReporteEnum.Ranking}}" />
                <RadioButton GroupName="Reporte" Content="Rentabilidad" Style="{StaticResource SegmentedRadioButtonStyle}"
                             IsChecked="{Binding ReporteSeleccionado, Mode=TwoWay, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={x:Static vm:TipoReporteEnum.Rentabilidad}}" />
                <RadioButton GroupName="Reporte" Content="Stock crítico" Style="{StaticResource SegmentedRadioButtonStyle}"
                             IsChecked="{Binding ReporteSeleccionado, Mode=TwoWay, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={x:Static vm:TipoReporteEnum.StockCritico}}" />
                <RadioButton GroupName="Reporte" Content="Sin movimiento" Style="{StaticResource SegmentedRadioButtonStyle}"
                             IsChecked="{Binding ReporteSeleccionado, Mode=TwoWay, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={x:Static vm:TipoReporteEnum.SinMovimiento}}" />
            </UniformGrid>
        </components:SelectorSegmentado>

        <!-- ============================================================= -->
        <!-- 3. FILTROS (una fila; se parte en dos solo si no entran)      -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12,6" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <!-- Período -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,12,4"
                            Visibility="{Binding MostrarFechas, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Desde" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <components:SelectorFechaCorta SelectedDate="{Binding Desde}"
                                Language="es-AR"
                                SelectedDateFormat="Short"
                                DisplayDateStart="{Binding FechaMinima, Mode=OneWay}"
                                DisplayDateEnd="{Binding FechaMaxima, Mode=OneWay}"
                                Width="135"
                                Height="35"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                    <TextBlock Text="Hasta" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <components:SelectorFechaCorta SelectedDate="{Binding Hasta}"
                                Language="es-AR"
                                SelectedDateFormat="Short"
                                DisplayDateStart="{Binding FechaMinima, Mode=OneWay}"
                                DisplayDateEnd="{Binding FechaMaxima, Mode=OneWay}"
                                Width="135"
                                Height="35"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                    <Button Command="{Binding EsteMesCommand}" Style="{StaticResource PeriodoButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularCalendar" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Este mes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding MesAnteriorCommand}" Style="{StaticResource PeriodoButtonStyle}" VerticalAlignment="Center"
                            ToolTip="{Binding TooltipMesAnterior}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularCalendar" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mes anterior" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EsteAnioCommand}" Style="{StaticResource PeriodoButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularCalendar" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Este año" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Ventas por período -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,12,4"
                            Visibility="{Binding MostrarAgrupacion, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Agrupar por" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Agrupaciones}"
                              SelectedItem="{Binding Agrupacion}"
                              ItemTemplate="{StaticResource EnumTextoItemTemplate}"
                              Width="110"
                              Height="35" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,12,4"
                            Visibility="{Binding MostrarCajero, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Cajero" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Cajeros}"
                              SelectedItem="{Binding CajeroSeleccionado}"
                              DisplayMemberPath="Nombre"
                              Width="170"
                              Height="35" />
                </StackPanel>

                <!-- Categoría y marca -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,12,4"
                            Visibility="{Binding MostrarCategoriaYMarca, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Categoría" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding CategoriaSeleccionada}"
                              DisplayMemberPath="Nombre"
                              Width="150"
                              Height="35"
                              Margin="0,0,10,0" />
                    <TextBlock Text="Marca" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Marcas}"
                              SelectedItem="{Binding MarcaSeleccionada}"
                              DisplayMemberPath="Nombre"
                              Width="150"
                              Height="35" />
                </StackPanel>

                <!-- Ranking -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,12,4"
                            Visibility="{Binding MostrarRankingFiltros, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Ordenar por" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Criterios}"
                              SelectedItem="{Binding Criterio}"
                              ItemTemplate="{StaticResource EnumTextoItemTemplate}"
                              Width="110"
                              Height="35"
                              Margin="0,0,10,0" />
                    <TextBlock Text="Cantidad" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                             Width="55"
                             Height="35"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Rentabilidad -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,12,4"
                            Visibility="{Binding MostrarAgruparPor, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Agrupar por" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AgrupacionesRentabilidad}"
                              SelectedItem="{Binding AgrupacionRentabilidad}"
                              ItemTemplate="{StaticResource EnumTextoItemTemplate}"
                              Width="120"
                              Height="35" />
                </StackPanel>

                <!-- Sin movimiento -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,12,4"
                            Visibility="{Binding MostrarDias, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Días sin ventas" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Dias, UpdateSourceTrigger=PropertyChanged}"
                             Width="60"
                             Height="35"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Consultar e indicador de carga -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center">
                    <Button Command="{Binding ConsultarCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            ToolTip="Consultar el reporte con los filtros elegidos">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Consultar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisConverter}}">
                        <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
                        <TextBlock Text="Consultando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 4. ERRORES DE VALIDACIÓN, DE AUTORIZACIÓN O DE SISTEMA        -->
        <!-- ============================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource DangerBackgroundBrush}"
                BorderBrush="{DynamicResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="{DynamicResource DangerForegroundBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <!-- ============================================================= -->
        <!-- 5. CONTENIDO DEL REPORTE                                      -->
        <!-- ============================================================= -->
        <Grid Grid.Row="4">
            <!-- Estados sin contenido: todavía sin consultar, o consultado sin datos (D-25) -->
            <TextBlock Text="Todavía no se consultó este reporte. Elija los filtros y presione Consultar."
                       Style="{StaticResource TextBlockBody}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding SinConsultar, Converter={StaticResource BoolToVisConverter}}" />
            <TextBlock Text="{Binding MensajeVacio}"
                       Style="{StaticResource TextBlockBody}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding EstaVacio, Converter={StaticResource BoolToVisConverter}}" />

            <!-- ========================================================= -->
            <!-- 5.1 TABLERO: cuatro tarjetas y dos gráficos               -->
            <!-- ========================================================= -->
            <!-- Sin ScrollViewer: la fila de gráficos es "*" y ocupa todo el alto que sobra; con poco alto, MinHeight. -->
            <Grid Visibility="{Binding MostrarTablero, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="150" />
                </Grid.RowDefinitions>

                    <!-- Contra qué fechas se comparan las variaciones de las tarjetas (D-31): va entre los filtros y las tarjetas -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding TextoComparacion}"
                               Style="{StaticResource TextBlockCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />

                    <UniformGrid Grid.Row="1" Columns="4" Margin="-4,0,-4,8">
                        <!-- Total vendido -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Total vendido" Style="{StaticResource TextBlockBodySecondary}" />
                                <!-- Achica la fuente solo si el importe no entra: ninguna tarjeta corta cifras -->
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding TotalVendidoTexto}" Style="{StaticResource TextBlockCurrencyLarge}" />
                                </Viewbox>
                                <ContentControl Content="{Binding TotalVendidoVariacion}" ContentTemplate="{StaticResource VariacionTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- Ventas -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Ventas" Style="{StaticResource TextBlockBodySecondary}" />
                                <!-- Achica la fuente solo si el importe no entra: ninguna tarjeta corta cifras -->
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CantidadVentasTexto}" Style="{StaticResource TextBlockCurrencyLarge}" />
                                </Viewbox>
                                <ContentControl Content="{Binding CantidadVentasVariacion}" ContentTemplate="{StaticResource VariacionTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- Margen bruto: importe y variación (el margen porcentual por grupo está en el reporte de Rentabilidad) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Margen bruto" Style="{StaticResource TextBlockBodySecondary}" />
                                <!-- Achica la fuente solo si el importe no entra: ninguna tarjeta corta cifras -->
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding MargenBrutoTexto}" Style="{StaticResource TextBlockCurrencyLarge}" />
                                </Viewbox>
                                <ContentControl Content="{Binding MargenBrutoVariacion}" ContentTemplate="{StaticResource VariacionTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- Inventario: valorización a costo y artículos bajo el mínimo -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Inventario a costo" Style="{StaticResource TextBlockBodySecondary}" />
                                <!-- Achica la fuente solo si el importe no entra: ninguna tarjeta corta cifras -->
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ValorizacionTexto}" Style="{StaticResource TextBlockCurrencyLarge}" />
                                </Viewbox>
                                <Border Style="{StaticResource BadgeWarningStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding HayBajoMinimo, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{Binding BajoMinimoTexto}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WarningForegroundBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeNeutralStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding HayBajoMinimo, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <TextBlock Text="{Binding BajoMinimoTexto}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Evolución de las ventas" Style="{StaticResource TextBlockHeader2}" Margin="0,0,0,4" />
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding GraficoEvolucion.Series}"
                                                    XAxes="{Binding GraficoEvolucion.EjesX}"
                                                    YAxes="{Binding GraficoEvolucion.EjesY}"
                                                    LegendPosition="Hidden" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding TituloMargenCategoria}" Style="{StaticResource TextBlockHeader2}" Margin="0,0,0,4" />
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding GraficoMargenCategoria.Series}"
                                                    XAxes="{Binding GraficoMargenCategoria.EjesX}"
                                                    YAxes="{Binding GraficoMargenCategoria.EjesY}"
                                                    LegendPosition="Hidden" />
                            </Grid>
                        </Border>
                    </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- 5.2 OTROS REPORTES: grilla al 60 % y gráfico al 40 %      -->
            <!-- ========================================================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <!-- Grillas (stock crítico y sin movimiento ocupan todo el ancho: no tienen gráfico) -->
                <Grid Grid.Column="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MostrarGraficoReporte}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- Ventas por período: total y desglose por medio de pago (D-34). Los importes van en letra de 12 pt
                             y con poco relleno para que los de 9 cifras entren en 960 px sin cortarse. -->
                        <DataGrid x:Name="GrillaVentas"
                                  ItemsSource="{Binding FilasVentasPorPeriodo}"
                                  CellStyle="{StaticResource CeldaMuyCompacta}"
                                  ColumnHeaderStyle="{StaticResource EncabezadoMuyCompacto}"
                                  Style="{StaticResource DataGridRetailStyle}"
                                  AutoGenerateColumns="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding MostrarVentasPorPeriodo, Converter={StaticResource BoolToVisConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Período"
                                                    Binding="{Binding InicioPeriodo, StringFormat='{}{0:dd/MM/yyyy}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource TextBlockNumericCell}"
                                                    Width="92" />
                                <DataGridTextColumn Header="Ventas"
                                                    HeaderStyle="{StaticResource EncabezadoMuyCompactoDerecha}"
                                                    Binding="{Binding CantidadVentas, StringFormat='{}{0:N0}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                    Width="60" />
                                <DataGridTextColumn Header="Total"
                                                    HeaderStyle="{StaticResource EncabezadoMuyCompactoDerecha}"
                                                    Binding="{Binding TotalVendido, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaMonedaChica}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Efectivo"
                                                    HeaderStyle="{StaticResource EncabezadoMuyCompactoDerecha}"
                                                    Binding="{Binding Efectivo, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaMonedaChica}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Débito"
                                                    HeaderStyle="{StaticResource EncabezadoMuyCompactoDerecha}"
                                                    Binding="{Binding TarjetaDebito, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaMonedaChica}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Crédito"
                                                    HeaderStyle="{StaticResource EncabezadoMuyCompactoDerecha}"
                                                    Binding="{Binding TarjetaCredito, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaMonedaChica}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Transf./QR"
                                                    HeaderStyle="{StaticResource EncabezadoMuyCompactoDerecha}"
                                                    Binding="{Binding TransferenciaQr, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaMonedaChica}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Cta. cte."
                                                    HeaderStyle="{StaticResource EncabezadoMuyCompactoDerecha}"
                                                    Binding="{Binding CuentaCorriente, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaMonedaChica}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Descuentos"
                                                    HeaderStyle="{StaticResource EncabezadoMuyCompactoDerecha}"
                                                    Binding="{Binding Descuentos, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaMonedaChica}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Ranking: más vendidos y menos vendidos lado a lado, cada uno a todo el alto (D-33).
                             Sin columna Código: en media pantalla (~460 px) el código de 13 dígitos le quitaba a la
                             descripción más de un cuarto del ancho; el código sigue en los archivos exportados. -->
                        <Grid Visibility="{Binding MostrarRanking, Converter={StaticResource BoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Más vendidos" Style="{StaticResource TextBlockHeader2}" Margin="0,0,0,6" />
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding MasVendidos}"
                                          CellStyle="{StaticResource CeldaCompacta}"
                                          ColumnHeaderStyle="{StaticResource EncabezadoCompacto}"
                                          Style="{StaticResource DataGridRetailStyle}"
                                          AutoGenerateColumns="False"
                                          HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Descripción"
                                                            Binding="{Binding Descripcion}"
                                                            ElementStyle="{StaticResource CeldaTextoRecortada}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Unid."
                                                            HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                            Binding="{Binding Unidades, StringFormat='{}{0:N0}', ConverterCulture=es-AR}"
                                                            ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                            Width="60" />
                                        <DataGridTextColumn Header="Importe"
                                                            HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                            Binding="{Binding IngresoNeto, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                            Width="135" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <Grid Grid.Column="1" Margin="6,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Menos vendidos" Style="{StaticResource TextBlockHeader2}" Margin="0,0,0,6" />
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding MenosVendidos}"
                                          CellStyle="{StaticResource CeldaCompacta}"
                                          ColumnHeaderStyle="{StaticResource EncabezadoCompacto}"
                                          Style="{StaticResource DataGridRetailStyle}"
                                          AutoGenerateColumns="False"
                                          HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Descripción"
                                                            Binding="{Binding Descripcion}"
                                                            ElementStyle="{StaticResource CeldaTextoRecortada}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Unid."
                                                            HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                            Binding="{Binding Unidades, StringFormat='{}{0:N0}', ConverterCulture=es-AR}"
                                                            ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                            Width="60" />
                                        <DataGridTextColumn Header="Importe"
                                                            HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                            Binding="{Binding IngresoNeto, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                            Width="135" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>

                        <!-- Rentabilidad (la fila Total va aparte, en la franja del pie) -->
                        <DataGrid x:Name="GrillaRentabilidad"
                                  ItemsSource="{Binding FilasRentabilidad}"
                                  CellStyle="{StaticResource CeldaCompacta}"
                                  ColumnHeaderStyle="{StaticResource EncabezadoCompacto}"
                                  Style="{StaticResource DataGridRetailStyle}"
                                  AutoGenerateColumns="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding MostrarRentabilidad, Converter={StaticResource BoolToVisConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Grupo"
                                                    Binding="{Binding Grupo}"
                                                    ElementStyle="{StaticResource CeldaTextoRecortada}"
                                                    MinWidth="120"
                                                    Width="*" />
                                <DataGridTextColumn Header="Unid."
                                                    HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                    Binding="{Binding Unidades, StringFormat='{}{0:N0}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                    Width="60" />
                                <DataGridTextColumn Header="Ingreso neto"
                                                    HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                    Binding="{Binding IngresoNeto, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                    Width="125" />
                                <DataGridTextColumn Header="Costo"
                                                    HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                    Binding="{Binding Costo, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                    Width="125" />
                                <DataGridTextColumn Header="Margen bruto"
                                                    HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                    Binding="{Binding MargenBruto, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                    Width="125" />
                                <DataGridTextColumn Header="Margen %"
                                                    HeaderStyle="{StaticResource EncabezadoCompactoDerecha}"
                                                    Binding="{Binding MargenPorcentual, StringFormat='{}{0:N2} %', ConverterCulture=es-AR, TargetNullValue='n/d'}"
                                                    ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                    Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Stock crítico -->
                        <DataGrid ItemsSource="{Binding FilasStockCritico}"
                                  Style="{StaticResource DataGridRetailStyle}"
                                  AutoGenerateColumns="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding MostrarStockCritico, Converter={StaticResource BoolToVisConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding CodigoBarras}"
                                                    ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                                    Width="125" />
                                <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding Descripcion}"
                                                    ElementStyle="{StaticResource CeldaTextoRecortada}"
                                                    MinWidth="150"
                                                    Width="*" />
                                <DataGridTextColumn Header="Categoría"
                                                    Binding="{Binding Categoria}"
                                                    ElementStyle="{StaticResource CeldaTextoRecortada}"
                                                    Width="120" />
                                <DataGridTextColumn Header="Stock"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                    Binding="{Binding StockActual, StringFormat='{}{0:N0}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                    Width="60" />
                                <DataGridTextColumn Header="Mín."
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                    Binding="{Binding StockMinimo, StringFormat='{}{0:N0}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                    Width="60" />
                                <DataGridTemplateColumn Header="Faltante" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeWarningStyle}">
                                                <TextBlock Text="{Binding Faltante, StringFormat='{}{0:N0}', ConverterCulture=es-AR}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource WarningForegroundBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Costo rep."
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                    Binding="{Binding CostoReposicion, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                    Width="135" />
                                <DataGridTextColumn Header="Precio venta"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                    Binding="{Binding PrecioVenta, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                    Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Sin movimiento -->
                        <DataGrid ItemsSource="{Binding FilasSinMovimiento}"
                                  Style="{StaticResource DataGridRetailStyle}"
                                  AutoGenerateColumns="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding MostrarSinMovimiento, Converter={StaticResource BoolToVisConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding CodigoBarras}"
                                                    ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                                    Width="125" />
                                <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding Descripcion}"
                                                    ElementStyle="{StaticResource CeldaTextoRecortada}"
                                                    MinWidth="150"
                                                    Width="*" />
                                <DataGridTextColumn Header="Categoría"
                                                    Binding="{Binding Categoria}"
                                                    ElementStyle="{StaticResource CeldaTextoRecortada}"
                                                    Width="120" />
                                <DataGridTextColumn Header="Stock"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                    Binding="{Binding StockActual, StringFormat='{}{0:N0}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                    Width="60" />
                                <DataGridTextColumn Header="Costo rep."
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                    Binding="{Binding CostoReposicion, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                    Width="135" />
                                <DataGridTextColumn Header="Últ. venta"
                                                    Binding="{Binding UltimaVenta, StringFormat='{}{0:dd/MM/yyyy}', ConverterCulture=es-AR, TargetNullValue='Nunca'}"
                                                    ElementStyle="{StaticResource TextBlockNumericCell}"
                                                    Width="95" />
                                <DataGridTextColumn Header="Capital inmov."
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                    Binding="{Binding CapitalInmovilizado, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}"
                                                    ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                    Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Los totales pueden tener más cifras que una fila (hasta 11): el Viewbox achica la letra solo si no entran.
                         Fila de totales de Ventas por período: mismas columnas y anchos que la grilla (los anchos se enlazan al
                         ActualWidth de cada DataGridColumn, así sigue alineada con la barra de desplazamiento visible o no) y fuera
                         del scroll vertical de las filas. Mismo fondo que el encabezado de la grilla. -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,6,6"
                            Visibility="{Binding MostrarVentasPorPeriodo, Converter={StaticResource BoolToVisConverter}}">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Columns[0].ActualWidth, ElementName=GrillaVentas}" />
                            <ColumnDefinition Width="{Binding Columns[1].ActualWidth, ElementName=GrillaVentas}" />
                            <ColumnDefinition Width="{Binding Columns[2].ActualWidth, ElementName=GrillaVentas}" />
                            <ColumnDefinition Width="{Binding Columns[3].ActualWidth, ElementName=GrillaVentas}" />
                            <ColumnDefinition Width="{Binding Columns[4].ActualWidth, ElementName=GrillaVentas}" />
                            <ColumnDefinition Width="{Binding Columns[5].ActualWidth, ElementName=GrillaVentas}" />
                            <ColumnDefinition Width="{Binding Columns[6].ActualWidth, ElementName=GrillaVentas}" />
                            <ColumnDefinition Width="{Binding Columns[7].ActualWidth, ElementName=GrillaVentas}" />
                            <ColumnDefinition Width="{Binding Columns[8].ActualWidth, ElementName=GrillaVentas}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource TextBlockNumericCell}" FontWeight="Bold" Margin="6,8" />
                            <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="6,8">
                                <TextBlock Text="{Binding TotalesVentas.CantidadVentas, StringFormat='{}{0:N0}', ConverterCulture=es-AR}" Style="{StaticResource CeldaNumericaDerecha}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="6,8">
                                <TextBlock Text="{Binding TotalesVentas.TotalVendido, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource CeldaMonedaChica}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="3" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="6,8">
                                <TextBlock Text="{Binding TotalesVentas.Efectivo, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource CeldaMonedaChica}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="4" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="6,8">
                                <TextBlock Text="{Binding TotalesVentas.TarjetaDebito, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource CeldaMonedaChica}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="5" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="6,8">
                                <TextBlock Text="{Binding TotalesVentas.TarjetaCredito, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource CeldaMonedaChica}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="6" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="6,8">
                                <TextBlock Text="{Binding TotalesVentas.TransferenciaQr, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource CeldaMonedaChica}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="7" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="6,8">
                                <TextBlock Text="{Binding TotalesVentas.CuentaCorriente, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource CeldaMonedaChica}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="8" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="6,8">
                                <TextBlock Text="{Binding TotalesVentas.Descuentos, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource CeldaMonedaChica}" FontWeight="Bold" />
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- Fila Total de Rentabilidad alineada bajo las columnas de su grilla (misma técnica que Ventas por período) -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,6,6"
                            Visibility="{Binding MostrarRentabilidad, Converter={StaticResource BoolToVisConverter}}">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Columns[0].ActualWidth, ElementName=GrillaRentabilidad}" />
                            <ColumnDefinition Width="{Binding Columns[1].ActualWidth, ElementName=GrillaRentabilidad}" />
                            <ColumnDefinition Width="{Binding Columns[2].ActualWidth, ElementName=GrillaRentabilidad}" />
                            <ColumnDefinition Width="{Binding Columns[3].ActualWidth, ElementName=GrillaRentabilidad}" />
                            <ColumnDefinition Width="{Binding Columns[4].ActualWidth, ElementName=GrillaRentabilidad}" />
                            <ColumnDefinition Width="{Binding Columns[5].ActualWidth, ElementName=GrillaRentabilidad}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource CeldaTextoRecortada}" FontWeight="Bold" Margin="8,8" />
                            <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="8,8">
                                <TextBlock Text="{Binding TotalRentabilidad.Unidades, StringFormat='{}{0:N0}', ConverterCulture=es-AR}" Style="{StaticResource CeldaNumericaDerecha}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="8,8">
                                <TextBlock Text="{Binding TotalRentabilidad.IngresoNeto, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource TextBlockCurrencyCell}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="3" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="8,8">
                                <TextBlock Text="{Binding TotalRentabilidad.Costo, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource TextBlockCurrencyCell}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="4" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="8,8">
                                <TextBlock Text="{Binding TotalRentabilidad.MargenBruto, StringFormat='$ {0:#,##0.00}', ConverterCulture=es-AR}" Style="{StaticResource TextBlockCurrencyCell}" FontWeight="Bold" />
                            </Viewbox>
                            <Viewbox Grid.Column="5" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="8,8">
                                <TextBlock Text="{Binding TotalRentabilidad.MargenPorcentual, StringFormat='{}{0:N2} %', ConverterCulture=es-AR, TargetNullValue='n/d'}" Style="{StaticResource CeldaNumericaDerecha}" FontWeight="Bold" />
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- Totales del reporte (valorización del inventario y capital inmovilizado) -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="14,8"
                            Margin="0,8,0,0"
                            Visibility="{Binding TieneResumen, Converter={StaticResource BoolToVisConverter}}">
                        <ItemsControl ItemsSource="{Binding Resumen}" ItemTemplate="{StaticResource DatoResumenTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </Grid>

                <!-- Gráfico de una sola serie en carmín, sin leyenda (D-27) -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="14,12"
                        Margin="12,0,0,0"
                        Visibility="{Binding MostrarGraficoReporte, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{Binding TituloGraficoReporte}"
                                   Style="{StaticResource TextBlockHeader2}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <lvc:CartesianChart Grid.Row="1"
                                            MinHeight="200"
                                            Series="{Binding GraficoReporte.Series}"
                                            XAxes="{Binding GraficoReporte.EjesX}"
                                            YAxes="{Binding GraficoReporte.EjesY}"
                                            LegendPosition="Hidden" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
