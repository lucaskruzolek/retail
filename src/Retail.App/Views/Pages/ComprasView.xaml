<UserControl x:Class="Retail.App.Views.Pages.ComprasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding AgregarItemCommand}" />
        <KeyBinding Key="F12" Command="{Binding RegistrarCompraCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO DE MÓDULO                                       -->
        <!-- ============================================================= -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20,14" Margin="{StaticResource SectionSpacing}">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="SolidPackage" Width="20" Height="20"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Compras" Style="{StaticResource TextBlockHeader1}" />
                    </StackPanel>
                    <TextBlock Text="Registro de facturas, actualización de stock físico y recálculo automático de precios por markup (RF-19)."
                               Style="{StaticResource TextBlockBodySecondary}" Margin="0,4,0,0" />
                    <components:NavegadorSeccion SeccionId="compras" Margin="0,12,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. CABECERA DE LA FACTURA / REMITO                            -->
        <!-- ============================================================= -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20,16" Margin="{StaticResource SectionSpacing}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Proveedor -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Distribuidor / Proveedor" Style="{StaticResource TextBlockCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Proveedores}"
                                  SelectedItem="{Binding ProveedorSeleccionado}"
                                  DisplayMemberPath="RazonSocial"
                                  Height="35" />
                    </StackPanel>

                    <!-- Nro Factura -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Nro. Factura / Remito" Style="{StaticResource TextBlockCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NumeroComprobante, UpdateSourceTrigger=PropertyChanged}" Height="35" FontFamily="{StaticResource FontFamilyMonospace}" />
                    </StackPanel>

                    <!-- Botón Importar Pedido (P2.4) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,12,0">
                        <Button Command="{Binding ImportarPedidoCommand}"
                                Style="{StaticResource KeycapButtonStyle}"
                                Height="35"
                                Padding="12,0"
                                ToolTip="Importar pedido emitido al distribuidor">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPackage" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Importar Pedido" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Botón Agregar Ítem -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <Button Command="{Binding AgregarItemCommand}" Style="{StaticResource KeycapButtonStyle}" Height="35">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Agregar Artículo" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KeycapBadgeStyle}">
                                    <TextBlock Text="F2" Style="{StaticResource TextBlockKeycap}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Indicador de Pedido Vinculado (P2.4) -->
                <Border Grid.Row="1"
                        Visibility="{Binding TienePedidoOrigen, Converter={StaticResource BoolToVisConverter}}"
                        Background="{DynamicResource PrimaryLightBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="SolidPackage" Width="14" Height="14"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding InformacionPedidoOrigen}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" (Precios y cantidades cargados desde el pedido)"
                                   FontSize="{StaticResource FontSizeXs}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="4,0,12,0" />
                        <Button Command="{Binding DesvincularPedidoCommand}"
                                Style="{StaticResource IconDangerButtonStyle}"
                                Width="22" Height="22"
                                ToolTip="Desvincular pedido (vuelve a compra manual)">
                            <iconPacks:PackIconBoxIcons Kind="RegularX" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- 3. GRILLA DE ÍTEMS DE COMPRA                                  -->
        <!-- ============================================================= -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding DetalleCompraItems}"
                  Style="{StaticResource DataGridRetailStyle}"
                  AutoGenerateColumns="False"
                  BorderThickness="0,1,0,1"
                  helpers:EsquinasHelper.Esquinas="0"
                  Margin="{StaticResource SectionSpacing}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoArticulo}" ElementStyle="{StaticResource TextBlockTextCell}" Width="140" />
                <DataGridTextColumn Header="Descripción del Artículo" Binding="{Binding DescripcionArticulo}" ElementStyle="{StaticResource TextBlockTextCell}" Width="*" MinWidth="200" />
                
                <!-- Costo Reposición Unitario (Monospace Cascadia Code) -->
                <DataGridTextColumn Header="Costo Unitario" HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}" Binding="{Binding CostoUnitario, StringFormat=C2}" ElementStyle="{StaticResource TextBlockCurrencyCell}" Width="130" />
                
                <!-- Cantidad Adquirida -->
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" ElementStyle="{StaticResource TextBlockTextCell}" Width="100" />
                
                <!-- Subtotal Ítem -->
                <DataGridTextColumn Header="Subtotal" HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}" Binding="{Binding Subtotal, StringFormat=C2}" ElementStyle="{StaticResource TextBlockCurrencyCell}" Width="130" />

                <!-- Precio Venta Sugerido Recalculado por Markup -->
                <DataGridTextColumn Header="Nuevo Precio Venta" HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}" Binding="{Binding NuevoPrecioVentaSugerido, StringFormat=C2}" ElementStyle="{StaticResource TextBlockCurrencyCell}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ============================================================= -->
        <!-- 4. PANEL INFERIOR DE TOTALES Y CONFIRMACIÓN                   -->
        <!-- ============================================================= -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Total de la Compra a Proveedor:" Style="{StaticResource TextBlockCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalCompra, StringFormat=C2}" FontFamily="{StaticResource FontFamilyNumeric}" Typography.NumeralAlignment="Tabular" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <Button DockPanel.Dock="Right" Command="{Binding RegistrarCompraCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Padding="20,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="SolidCheckCircle" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Registrar Compra y Actualizar Precios" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource KeycapPrimaryBadgeStyle}">
                            <TextBlock Text="F12" Style="{StaticResource TextBlockKeycap}" Foreground="{DynamicResource PrimaryForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
