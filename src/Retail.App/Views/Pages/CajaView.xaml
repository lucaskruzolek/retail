<UserControl x:Class="Retail.App.Views.Pages.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:converters="clr-namespace:Retail.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{DynamicResource SurfaceBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Encabezado y acciones principales (sin tarjeta) -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Gestión de Caja y Tesorería"
                               Subtitulo="Control de turno actual, arqueos y movimientos de efectivo.">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AbrirTurnoCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularWallet" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Abrir Turno (F2)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding RegistrarMovimientoCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="{StaticResource InlineSm}"
                        Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularSwapHorizontal" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Registrar Movimiento (F3)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding CerrarTurnoCommand}"
                        Style="{StaticResource DangerActionButtonStyle}"
                        Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularLock" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Arqueo y Cierre (F12)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </components:PageHeader>

        <!-- 2. Estado del turno / resumen de saldos: una sola superficie -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource SectionSpacing}">
            <Grid>
                <!-- Si NO hay turno abierto -->
                <StackPanel Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{StaticResource InsetCard}">
                    <TextBlock Text="No hay ningún turno de caja abierto en este momento."
                               Style="{StaticResource TextBlockHeader2}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Haga clic en 'Abrir Turno' o presione F2 para comenzar las operaciones."
                               Style="{StaticResource TextBlockCaption}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Si SÍ hay turno abierto (saldos) -->
                <Grid Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Saldo inicial -->
                    <StackPanel Grid.Column="0" Margin="{StaticResource InsetCompact}">
                        <TextBlock Text="SALDO INICIAL" Style="{StaticResource TextBlockCaptionSecondary}" />
                        <TextBlock Text="{Binding TurnoActivo.SaldoInicial, StringFormat={}{0:C2}}"
                                   Style="{StaticResource TextBlockCurrencyLarge}"
                                   Language="es-AR"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Ventas en efectivo -->
                    <StackPanel Grid.Column="1" Margin="{StaticResource InsetCompact}">
                        <TextBlock Text="VENTAS EFECTIVO" Style="{StaticResource TextBlockCaptionSecondary}" />
                        <TextBlock Text="{Binding TurnoActivo.TotalVentasEfectivo, StringFormat={}{0:C2}}"
                                   Style="{StaticResource TextBlockCurrencyLarge}"
                                   Language="es-AR"
                                   Foreground="{DynamicResource SuccessForegroundBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Ventas electrónicas -->
                    <StackPanel Grid.Column="2" Margin="{StaticResource InsetCompact}">
                        <TextBlock Text="VENTAS ELECTRÓNICAS" Style="{StaticResource TextBlockCaptionSecondary}" />
                        <TextBlock Text="{Binding TurnoActivo.TotalVentasElectronicas, StringFormat={}{0:C2}}"
                                   Style="{StaticResource TextBlockCurrencyLarge}"
                                   Language="es-AR"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Saldo teórico actual (el importe destacado, en el color de marca del estilo) -->
                    <StackPanel Grid.Column="3" Margin="{StaticResource InsetCompact}">
                        <TextBlock Text="SALDO TEÓRICO EN CAJA" Style="{StaticResource TextBlockCaptionSecondary}" />
                        <TextBlock Text="{Binding TurnoActivo.SaldoTeoricoEfectivo, StringFormat={}{0:C2}}"
                                   Style="{StaticResource TextBlockCurrencyLarge}"
                                   Language="es-AR"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Detalle de movimientos del turno -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <TextBlock Text="Detalle de movimientos y operaciones del turno en curso se listarán aquí."
                       Style="{StaticResource TextBlockBodyMuted}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
