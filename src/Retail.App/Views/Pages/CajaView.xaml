<UserControl x:Class="Retail.App.Views.Pages.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:converters="clr-namespace:Retail.App.Converters" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F3F3F3">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#CCCCCC" BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Encabezado y Acciones Principales -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Gestión de Caja y Tesorería" FontSize="22" FontWeight="Bold" Foreground="#1F1F1F"/>
                <TextBlock Text="Control de turno actual, arqueos y movimientos de efectivo." FontSize="13" Foreground="#606060" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Botonera de control rápido -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abrir Turno (F2)" Command="{Binding AbrirTurnoCommand}" 
                        Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                        Background="#0067C0" Foreground="White" FontWeight="SemiBold" Height="36" Padding="15,0" Margin="5,0"/>

                <Button Content="Registrar Movimiento (F3)" Command="{Binding RegistrarMovimientoCommand}" 
                        Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Height="36" Padding="15,0" Margin="5,0"/>

                <Button Content="Arqueo y Cierre (F12)" Command="{Binding CerrarTurnoCommand}" 
                        Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#D13438" Foreground="White" FontWeight="SemiBold" Height="36" Padding="15,0" Margin="5,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Estado del Turno / Tarjetas de Resumen -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <!-- Si NO hay turno abierto -->
                <StackPanel Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="No hay ningún turno de caja abierto en este momento." FontSize="16" Foreground="#555" HorizontalAlignment="Center"/>
                    <TextBlock Text="Haga clic en 'Abrir Turno' o presione F2 para comenzar las operaciones." FontSize="12" Foreground="#888" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Si SÍ hay turno abierto (Tarjetas de saldos) -->
                <Grid Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Saldo Inicial -->
                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="SALDO INICIAL" FontSize="11" FontWeight="Bold" Foreground="#707070"/>
                        <TextBlock Text="{Binding TurnoActivo.SaldoInicial, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Ventas Efectivo -->
                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Text="VENTAS EFECTIVO" FontSize="11" FontWeight="Bold" Foreground="#707070"/>
                        <TextBlock Text="{Binding TurnoActivo.TotalVentasEfectivo, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" Foreground="#107C41" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Ventas Electrónicas -->
                    <StackPanel Grid.Column="2" Margin="10">
                        <TextBlock Text="VENTAS ELECTRÓNICAS" FontSize="11" FontWeight="Bold" Foreground="#707070"/>
                        <TextBlock Text="{Binding TurnoActivo.TotalVentasElectronicas, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Saldo Teórico Actual -->
                    <StackPanel Grid.Column="3" Margin="10">
                        <TextBlock Text="SALDO TEÓRICO EN CAJA" FontSize="11" FontWeight="Bold" Foreground="#707070"/>
                        <TextBlock Text="{Binding TurnoActivo.SaldoTeoricoEfectivo, StringFormat={}{0:C2}}" FontSize="22" FontWeight="Bold" Foreground="#004578" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Panel Inferior / Historial o Detalle del Turno -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Detalle de movimientos y operaciones del turno en curso se listarán aquí." 
                           VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#888" FontStyle="Italic"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>