<UserControl x:Class="Retail.App.Views.Pages.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:converters="clr-namespace:Retail.App.Converters"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{DynamicResource SurfaceBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Encabezado y acciones principales (sin tarjeta) -->
        <StackPanel Grid.Row="0">
            <components:PageHeader
                                   Margin="{StaticResource SectionSpacing}"
                                   Titulo="Ventas"
                                   Descripcion="Control de turno actual, arqueos y movimientos de efectivo.">
                <components:PageHeader.Navegacion>
                    <components:NavegadorSeccion SeccionId="ventas" />
                </components:PageHeader.Navegacion>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding AbrirTurnoCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Visibility="{Binding PuedeAbrirTurno, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularWallet" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Abrir Turno (F2)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RegistrarMovimientoCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Margin="{StaticResource InlineSm}"
                            Visibility="{Binding PuedeOperar, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularSwapHorizontal" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Registrar Movimiento (F3)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CerrarTurnoCommand}"
                            Style="{StaticResource DangerActionButtonStyle}"
                            Visibility="{Binding PuedeCerrar, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularLock" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Arqueo y Cierre (F12)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </components:PageHeader>
        </StackPanel>

        <!-- 2. Turno de otro cajero sin cerrar (MT-14): mismo patrón que la franja "La caja está cerrada" del POS.
             Quien no es dueño del turno no ve sus saldos: solo puede cerrarlo con arqueo si es Gerente. -->
        <Border Grid.Row="1"
                Background="{DynamicResource WarningBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}"
                Padding="16,12"
                Margin="{StaticResource SectionSpacing}"
                Visibility="{Binding EsTurnoAjeno, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="True">
                <iconPacks:PackIconBoxIcons Kind="RegularLock"
                                            Width="18"
                                            Height="18"
                                            Margin="{StaticResource InlineMd}"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource WarningForegroundBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TituloTurnoAjeno}"
                               Style="{StaticResource TextBlockBody}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningForegroundBrush}" />
                    <TextBlock Text="Solo esa persona puede continuarlo. Un Gerente puede cerrarlo con arqueo."
                               Style="{StaticResource TextBlockBody}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningForegroundBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Estado del turno / resumen de saldos: una sola superficie (solo con el turno propio o sin turno) -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Margin="{StaticResource SectionSpacing}"
                Visibility="{Binding EsTurnoAjeno, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
            <Grid>
                <!-- Si NO hay turno abierto -->
                <StackPanel Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{StaticResource InsetCard}">
                    <TextBlock Text="No hay ningún turno de caja abierto en este momento."
                               Style="{StaticResource TextBlockHeader2}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Haga clic en 'Abrir Turno' o presione F2 para comenzar las operaciones."
                               Style="{StaticResource TextBlockCaption}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Si SÍ hay turno abierto (saldos) -->
                <Grid Visibility="{Binding IsTurnoAbierto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Saldo inicial -->
                    <StackPanel Grid.Column="0" Margin="{StaticResource InsetCompact}">
                        <TextBlock Text="SALDO INICIAL" Style="{StaticResource TextBlockCaptionSecondary}" />
                        <TextBlock Text="{Binding TurnoActivo.SaldoInicial, StringFormat={}{0:C2}}"
                                   Style="{StaticResource TextBlockCurrencyLarge}"
                                   Language="es-AR"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Ventas en efectivo -->
                    <StackPanel Grid.Column="1" Margin="{StaticResource InsetCompact}">
                        <TextBlock Text="VENTAS EFECTIVO" Style="{StaticResource TextBlockCaptionSecondary}" />
                        <TextBlock Text="{Binding TurnoActivo.TotalVentasEfectivo, StringFormat={}{0:C2}}"
                                   Style="{StaticResource TextBlockCurrencyLarge}"
                                   Language="es-AR"
                                   Foreground="{DynamicResource SuccessForegroundBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Ventas electrónicas -->
                    <StackPanel Grid.Column="2" Margin="{StaticResource InsetCompact}">
                        <TextBlock Text="VENTAS ELECTRÓNICAS" Style="{StaticResource TextBlockCaptionSecondary}" />
                        <TextBlock Text="{Binding TurnoActivo.TotalVentasElectronicas, StringFormat={}{0:C2}}"
                                   Style="{StaticResource TextBlockCurrencyLarge}"
                                   Language="es-AR"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Saldo teórico actual (el importe destacado, en el color de marca del estilo) -->
                    <StackPanel Grid.Column="3" Margin="{StaticResource InsetCompact}">
                        <TextBlock Text="SALDO TEÓRICO EN CAJA" Style="{StaticResource TextBlockCaptionSecondary}" />
                        <TextBlock Text="{Binding TurnoActivo.SaldoTeoricoEfectivo, StringFormat={}{0:C2}}"
                                   Style="{StaticResource TextBlockCurrencyLarge}"
                                   Language="es-AR"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Solo para un Gerente: turnos abiertos en las otras terminales, que puede cerrar con arqueo (MT-14) -->
        <StackPanel Grid.Row="3"
                    Margin="{StaticResource SectionSpacing}"
                    Visibility="{Binding EsGerente, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Turnos abiertos en otras terminales"
                       Style="{StaticResource TextBlockHeader2}"
                       Margin="{StaticResource StackSm}" />

            <Border Style="{StaticResource TablaListadoStyle}"
                    Visibility="{Binding NoHayTurnosEnOtrasTerminales, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding TurnosEnOtrasTerminales}"
                          Style="{StaticResource DataGridListadoStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          MaxHeight="224"
                          helpers:EsquinasHelper.Esquinas="7">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Terminal"
                                            Binding="{Binding NombreTerminal}"
                                            Width="*"
                                            MinWidth="160"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />
                        <DataGridTextColumn Header="Cajero"
                                            Binding="{Binding NombreCajero}"
                                            Width="*"
                                            MinWidth="160"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />
                        <DataGridTextColumn Header="Apertura"
                                            Binding="{Binding FechaApertura, StringFormat='{}{0:dd/MM HH:mm}'}"
                                            Width="140"
                                            ElementStyle="{StaticResource TextBlockNumericCell}" />
                        <DataGridTemplateColumn Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.CerrarTurnoDeOtraTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            ToolTip="Cerrar con arqueo">
                                        <iconPacks:PackIconBoxIcons Kind="RegularLock" Width="14" Height="14" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="No hay turnos abiertos en otras terminales."
                       Style="{StaticResource TextBlockBodyMuted}"
                       Visibility="{Binding NoHayTurnosEnOtrasTerminales, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- 5. Detalle de movimientos del turno -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
            <TextBlock Text="Detalle de movimientos y operaciones del turno en curso se listarán aquí."
                       Style="{StaticResource TextBlockBodyMuted}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
