<UserControl x:Class="Retail.App.Views.Pages.ArticulosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             xmlns:converters="clr-namespace:Retail.App.Converters"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:AMayusculasConverter x:Key="AMayusculasConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NuevoArticuloCommand}" />
        <KeyBinding Key="F5" Command="{Binding CargarArticulosCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Búsqueda (o acciones masivas si hay filas marcadas), directo sobre el fondo -->
            <RowDefinition Height="Auto" />
            <!-- Tabla + paginación: la única superficie de la página -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO DE LA PÁGINA (sin tarjeta)                      -->
        <!-- ============================================================= -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Catálogo de Artículos e Inventario">
            <StackPanel Orientation="Horizontal">
                <!-- Administrar rubros, categorías y marcas (solo Gerente y Encargado; sin atajo, D-27) -->
                <Button Command="{Binding AdministrarClasificacionCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,8,0"
                        Visibility="{Binding PuedeAdministrarClasificacion, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularFolderOpen" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Clasificación" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Botón Nuevo Artículo (F2) -->
                <Button Command="{Binding NuevoArticuloCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nuevo Artículo" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </components:PageHeader>

        <!-- ============================================================= -->
        <!-- 2. BÚSQUEDA, CONTADOR DE RESULTADOS Y CARGA (sin tarjeta)     -->
        <!--    Con filas marcadas, las acciones masivas ocupan el lugar   -->
        <!--    de "Limpiar filtros" y del contador.                       -->
        <!-- ============================================================= -->
        <components:ListToolbar x:Name="BarraBusqueda"
                                Grid.Row="1"
                                Margin="0,0,0,12"
                                Texto="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar por código, descripción o marca..."
                                ComandoLimpiar="{Binding LimpiarFiltrosCommand}"
                                EstaCargando="{Binding IsBusy}"
                                TotalResultados="{Binding TotalRegistrosFiltrados}"
                                HaySeleccion="{Binding TieneArticulosSeleccionados}">
            <components:ListToolbar.AccionesDeSeleccion>
                <components:BulkActionBar CantidadSeleccionados="{Binding CantidadSeleccionados}"
                                          ComandoCancelar="{Binding LimpiarSeleccionCommand}">
                    <!-- Acciones sobre los seleccionados: botones sueltos a la derecha, sin recuadro que los agrupe -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Pedir los seleccionados (Track 4.3, A-17): solo Encargado y Gerente (A-14). Con borde, por ser
                             la acción con lógica; el único acento carmín de la vista sigue siendo "Nuevo Artículo" -->
                        <Button Command="{Binding PedirSeleccionadosCommand}"
                                Style="{StaticResource KeycapButtonStyle}"
                                Padding="12,4"
                                Margin="0,0,4,0"
                                Visibility="{Binding PuedePedir, Converter={StaticResource BoolToVisConverter}}"
                                ToolTip="Agregar los artículos seleccionados al borrador de pedido de su proveedor">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularCart" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pedir seleccionados" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Eliminar seleccionados: todavía sin lógica; queda a la vista, deshabilitado y con su tooltip -->
                        <Button Style="{StaticResource GhostNeutralButtonStyle}"
                                IsEnabled="False"
                                Padding="12,4"
                                Margin="0,0,4,0"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Disponible próximamente: dar de baja los artículos seleccionados en una sola operación">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularTrash"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Eliminar seleccionados" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Más acciones (último: el menú abre alineado a su borde derecho). Todavía sin lógica: quedan
                             deshabilitadas en el menú, con su tooltip, hasta implementar cada una -->
                        <ToggleButton Style="{StaticResource GhostNeutralToggleButtonStyle}"
                                helpers:MenuDesplegableHelper.AbrirAlHacerClic="True"
                                ToolTip="Más acciones sobre los artículos seleccionados"
                                AutomationProperties.Name="Más acciones">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Más" VerticalAlignment="Center" />
                                <!-- Flecha liviana dibujada a mano: el chevron del pack de íconos es grueso para este tamaño -->
                                <Path Data="M 0,0 L 4,4 L 8,0"
                                      Width="8"
                                      Height="4"
                                      Margin="4,1,0,0"
                                      Stretch="None"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                            <ToggleButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Cambiar rubro"
                                              FontWeight="Normal"
                                              IsEnabled="False"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="Disponible próximamente: cambiar el rubro de los artículos seleccionados">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconBoxIcons Kind="RegularBookmarks" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Cambiar categoría"
                                              FontWeight="Normal"
                                              IsEnabled="False"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="Disponible próximamente: cambiar la categoría de los artículos seleccionados">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconBoxIcons Kind="RegularTag" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ToggleButton.ContextMenu>
                        </ToggleButton>
                    </StackPanel>
                </components:BulkActionBar>
            </components:ListToolbar.AccionesDeSeleccion>
        </components:ListToolbar>

        <!-- ============================================================= -->
        <!-- 3. TABLA: GRILLA Y, COMO CONTINUACIÓN, LA PAGINACIÓN          -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Style="{StaticResource TablaListadoStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sin borde propio (lo pone la superficie) y con las esquinas de arriba de 7: radio 8 menos el borde -->
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Articulos}"
                          SelectedValuePath="Articulo"
                          SelectedValue="{Binding ArticuloSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridListadoStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          helpers:EsquinasHelper.Esquinas="7,7,0,0">
                <!-- Doble clic en la fila abre la edición; el estilo base conserva el aspecto de fila del listado.
                     El tinte carmín sigue a la casilla (la selección sobre la que actúan las acciones masivas) y no a la
                     fila actual de la grilla: un clic en una fila no cambia su aspecto; el gris es solo del hover. Estos
                     triggers se aplican después de los del estilo base, así que ganan (el último que se cumple manda). -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowListadoStyle}">
                        <EventSetter Event="MouseDoubleClick" Handler="Fila_MouseDoubleClick" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding EstaSeleccionado}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Selección para pedir (Track 4.3, A-17): la casilla vive en ArticuloFila, no en el DTO -->
                    <!-- Su visibilidad la fija el code-behind: una columna no está en el árbol visual y no hereda el DataContext -->
                    <DataGridTemplateColumn x:Name="ColumnaSeleccion"
                                            Width="44"
                                            CanUserResize="False"
                                            CanUserSort="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRetailStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.SeleccionarTodos, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Style="{StaticResource CheckBoxCompactStyle}"
                                      ToolTip="Seleccionar / deseleccionar todos los de esta página" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EstaSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource CheckBoxCompactStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Artículo: solo la descripción (el código no es dato relevante para el mostrador; la búsqueda por código
                         sigue disponible y el dato se ve al editar el artículo) -->
                    <DataGridTextColumn Header="Artículo"
                                        HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                        Binding="{Binding Articulo.Descripcion, Converter={StaticResource AMayusculasConverter}}"
                                        Width="*"
                                        MinWidth="200"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Categoría. Las cabeceras de Categoría, Marca, Distribuidor y Stock llevan su filtro de selección
                         múltiple (FiltroColumna); el filtro de rubro es el grupo de sus categorías. Una columna no está en el
                         árbol visual: el filtro toma el DataContext de la página buscando el UserControl ancestro. -->
                    <DataGridTemplateColumn Width="150">
                        <DataGridTemplateColumn.Header>
                            <components:FiltroColumna Filtro="{Binding DataContext.FiltroCategoria, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeNeutralStyle}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Articulo.CategoriaNombre}" Style="{StaticResource BadgeNeutralTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Marca -->
                    <DataGridTextColumn Binding="{Binding Articulo.MarcaNombre}"
                                        Width="130"
                                        ElementStyle="{StaticResource TextBlockTextCell}">
                        <DataGridTextColumn.Header>
                            <components:FiltroColumna Filtro="{Binding DataContext.FiltroMarca, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- Distribuidor / Enlace (RF-05) -->
                    <DataGridTemplateColumn Width="184">
                        <DataGridTemplateColumn.Header>
                            <components:FiltroColumna Filtro="{Binding DataContext.FiltroDistribuidor, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid VerticalAlignment="Center">
                                    <!-- Caso 1: Vinculado a Distribuidor -->
                                    <Border x:Name="BadgeVinculado"
                                            Style="{StaticResource BadgeNeutralStyle}"
                                            HorizontalAlignment="Left"
                                            Visibility="Collapsed">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Articulo.ProveedorNombre}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Articulo.CodigoProveedor, StringFormat={}Cód: {0}}" />
                                                    <TextBlock Text="{Binding Articulo.DescripcionProveedor}" FontStyle="Italic" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Articulo.ProveedorNombre}"
                                                       Style="{StaticResource BadgeNeutralTextStyle}"
                                                       MaxWidth="96" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Caso 2: Manual / No Vinculado -->
                                    <TextBlock x:Name="TextoManual"
                                               Text="(Manual)"
                                               FontStyle="Italic"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Visible" />

                                    <!-- Caso 2b: tiene fuentes pero ninguna es la principal (Track 4.3, A-19) -->
                                    <TextBlock x:Name="TextoSinPrincipal"
                                               Text="Sin principal"
                                               FontStyle="Italic"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />

                                    <!-- Caso 3: Presentación derivada (RF-21): su costo sale del artículo de origen -->
                                    <Border x:Name="BadgePresentacion"
                                            Style="{StaticResource BadgeNeutralStyle}"
                                            HorizontalAlignment="Left"
                                            ToolTip="Costo derivado del artículo de origen: se actualiza cuando cambia el costo del origen."
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularGitBranch" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Articulo.UnidadesPorOrigen, StringFormat={}Presentación ×{0}}"
                                                       Style="{StaticResource BadgeNeutralTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Fuentes adicionales (Track 4.3, A-19): solo informa; las fuentes se ven y se cambian al abrir el artículo -->
                                <Border x:Name="ChipFuentesAdicionales"
                                        Style="{StaticResource BadgeNeutralStyle}"
                                        Margin="4,0,0,0"
                                        ToolTip="{Binding TooltipFuentes}"
                                        Visibility="Collapsed">
                                    <TextBlock Text="{Binding TextoFuentesAdicionales}" Style="{StaticResource BadgeNeutralTextStyle}" />
                                </Border>
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Articulo.EstaVinculadoAProveedor}" Value="True">
                                        <Setter TargetName="BadgeVinculado" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TextoManual" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TieneFuentesSinPrincipal}" Value="True">
                                        <Setter TargetName="TextoSinPrincipal" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TextoManual" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TieneFuentesAdicionales}" Value="True">
                                        <Setter TargetName="ChipFuentesAdicionales" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- Un derivado no tiene fuentes propias (RF-21): nunca muestra "+n" -->
                                    <DataTrigger Binding="{Binding Articulo.EsDerivado}" Value="True">
                                        <Setter TargetName="BadgePresentacion" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TextoManual" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="TextoSinPrincipal" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ChipFuentesAdicionales" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Costo de reposición -->
                    <DataGridTextColumn Header="Costo"
                                        HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                        Binding="{Binding Articulo.CostoReposicion, StringFormat={}{0:C2}}"
                                        Width="110"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Margen de ganancia -->
                    <DataGridTextColumn Header="Margen"
                                        HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                        Binding="{Binding Articulo.PorcentajeGanancia, StringFormat={}{0:0.##}%}"
                                        Width="80"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Precio de venta (en negrita; el carmín queda para la marca y las acciones) -->
                    <DataGridTextColumn Header="Precio de venta"
                                        HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                        Binding="{Binding Articulo.PrecioVenta, StringFormat={}{0:C2}}"
                                        Width="132"
                                        ElementStyle="{StaticResource TextBlockPriceCell}" />

                    <!-- Stock (RF-08): punto de color + cantidad; con alerta, el ícono de advertencia en lugar del punto -->
                    <!-- Alineado a la derecha como las demás columnas numéricas, con 8 de relleno derecho: el aire entre
                         el stock y el "⋮" es igual al del "⋮" hasta el borde de la grilla. Mide lo justo para su título
                         (el mínimo no se muestra); el ancho que no usa lo absorbe la descripción -->
                    <DataGridTemplateColumn Width="88">
                        <DataGridTemplateColumn.Header>
                            <components:FiltroColumna Filtro="{Binding DataContext.FiltroEstadoStock, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRightListadoStyle}">
                                <Setter Property="Padding" Value="12,10,8,10" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                <Setter Property="Padding" Value="12,8,8,8" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <!-- Servicio: no lleva stock. Un guion, porque la insignia "Servicio" no entra en la columna -->
                                    <TextBlock x:Name="BadgeServicio"
                                               Text="—"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               ToolTip="Servicio: no lleva stock"
                                               Visibility="Collapsed" />

                                    <StackPanel x:Name="PanelStock" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse x:Name="PuntoStock"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="{DynamicResource SuccessBrush}"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center" />
                                        <iconPacks:PackIconBoxIcons x:Name="AvisoStock"
                                                                    Kind="RegularAlertTriangle"
                                                                    Width="14"
                                                                    Height="14"
                                                                    Foreground="{DynamicResource WarningBrush}"
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="Stock en o por debajo del mínimo"
                                                                    Visibility="Collapsed" />
                                        <TextBlock Text="{Binding Articulo.StockActual}"
                                                   Style="{StaticResource TextBlockNumericCell}" />
                                    </StackPanel>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Articulo.StockBajo}" Value="True">
                                        <!-- El ícono de advertencia reemplaza al punto: la alerta no depende solo del color -->
                                        <Setter TargetName="PuntoStock" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="AvisoStock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Articulo.EsServicio}" Value="True">
                                        <Setter TargetName="BadgeServicio" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="PanelStock" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones de la fila: un solo "⋮" con menú (el doble clic en la fila ya abre la edición). La columna no
                         lleva título para no gastar ancho. -->
                    <DataGridTemplateColumn Width="36"
                                            CanUserResize="False"
                                            CanUserSort="False"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Tag lleva el ViewModel de la página: el ContextMenu no está en el árbol visual de la vista -->
                                <ToggleButton Style="{StaticResource RowMenuButtonStyle}"
                                        helpers:MenuDesplegableHelper.AbrirAlHacerClic="True"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        HorizontalAlignment="Left"
                                        ToolTip="Acciones del artículo"
                                        AutomationProperties.Name="Acciones del artículo">
                                    <iconPacks:PackIconBoxIcons Kind="RegularDotsVerticalRounded" Width="14" Height="14" />
                                    <ToggleButton.ContextMenu>
                                        <ContextMenu>
                                            <!-- Pedir al proveedor (A-17, G4): deshabilitado con su motivo si no tiene fuente -->
                                            <MenuItem Header="Pedir al proveedor"
                                                      Command="{Binding PlacementTarget.Tag.PedirArticuloCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.SePuedePedir, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      ToolTip="{Binding PlacementTarget.DataContext.MotivoNoSePuedePedir, RelativeSource={RelativeSource AncestorType=ContextMenu}, StringFormat=No se puede pedir: {0}}"
                                                      ToolTipService.ShowOnDisabled="True">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconBoxIcons Kind="RegularCart" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.Tag.PuedePedir, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <!-- Crear presentación (RF-21): solo en artículos de compra que no son servicios -->
                                            <MenuItem Header="Crear presentación"
                                                      Command="{Binding PlacementTarget.Tag.CrearPresentacionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Articulo, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconBoxIcons Kind="RegularGitBranch" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Articulo.EsDerivado, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Articulo.EsServicio, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <!-- Fraccionar (RF-21): solo en presentaciones derivadas -->
                                            <MenuItem Header="Fraccionar"
                                                      Command="{Binding PlacementTarget.Tag.FraccionarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Articulo, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconBoxIcons Kind="RegularCut" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Articulo.EsDerivado, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <MenuItem Header="Editar artículo"
                                                      Command="{Binding PlacementTarget.Tag.EditarArticuloCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Articulo, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <Separator />

                                            <!-- Baja lógica (soft delete) -->
                                            <MenuItem Header="Dar de baja"
                                                      Style="{StaticResource MenuItemDangerStyle}"
                                                      Command="{Binding PlacementTarget.Tag.BajaArticuloCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Articulo, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ToggleButton.ContextMenu>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

                <!-- Paginación pegada a la grilla, separada por una línea -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                    <components:PaginationBar MostrarResumen="False" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
