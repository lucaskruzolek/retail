<UserControl x:Class="Retail.App.Views.Pages.ArticulosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NuevoArticuloCommand}" />
        <KeyBinding Key="F3" Command="{Binding AlternarSoloStockCriticoCommand}" />
        <KeyBinding Key="F5" Command="{Binding CargarArticulosCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Catálogo de Artículos e Inventario"
                                   Style="{StaticResource TextBlockHeader1}" />
                        <!-- Badges de Métricas -->
                        <Border Style="{StaticResource BadgeNeutralStyle}" Margin="16,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalArticulos, StringFormat={}{0} Artículos}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <Border x:Name="BadgeStockAlertas"
                                Style="{StaticResource BadgeWarningStyle}"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding TotalAlertasStock, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding TotalAlertasStock, StringFormat={}⚠ {0} Stock Crítico}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Padrón central de productos, cálculo dinámico de markup, alertas de stock mínimo y soporte artesanal (RF-04, RF-08)"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Botón Refrescar (F5) -->
                    <Button Command="{Binding CargarArticulosCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="12,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refrescar (F5)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Nuevo Artículo (F2) -->
                    <Button Command="{Binding NuevoArticuloCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Nuevo Artículo (F2)" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. BARRA DE HERRAMIENTAS Y FILTROS                            -->
        <!-- ============================================================= -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="16,12"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <!-- Búsqueda rápida por texto o código de barras -->
                <ui:TextBox DockPanel.Dock="Left"
                            Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Buscar por código de barras, descripción o marca..."
                            Width="360"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" Foreground="{DynamicResource TextMutedBrush}" />
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <!-- Filtro por Categoría -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Categoría:"
                               Style="{StaticResource TextBlockBodySecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding CategoriasFiltro}"
                              SelectedValue="{Binding IdCategoriaFiltro}"
                              SelectedValuePath="IdCategoria"
                              DisplayMemberPath="NombreCategoria"
                              Width="180"
                              Height="35"
                              VerticalAlignment="Center" />
                </StackPanel>

                <!-- ToggleButton para Alertas de Stock Mínimo -->
                <ToggleButton DockPanel.Dock="Left"
                              IsChecked="{Binding SoloStockCritico}"
                              Style="{StaticResource KeycapToggleButtonStyle}"
                              Padding="10,6"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠ " Foreground="{DynamicResource WarningForegroundBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="Solo Stock Crítico (F3)" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Indicador de Carga Asíncrona -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
                    <TextBlock Text="Cargando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 3. GRILLA PRINCIPAL DE ARTÍCULOS                              -->
        <!-- ============================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid ItemsSource="{Binding Articulos}"
                      SelectedItem="{Binding ArticuloSeleccionado, Mode=TwoWay}"
                      Style="{StaticResource DataGridRetailStyle}"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <!-- Código de Barras -->
                    <DataGridTemplateColumn Header="Código de Barras" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CodigoBarras}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <!-- Placeholder si es null -->
                                    <TextBlock Text="(Artesanal / Sin Código)"
                                               FontStyle="Italic"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CodigoBarras}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CodigoBarras}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Descripción -->
                    <DataGridTextColumn Header="Descripción"
                                        Binding="{Binding Descripcion}"
                                        Width="*"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Categoría -->
                    <DataGridTemplateColumn Header="Categoría" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeNeutralStyle}">
                                    <TextBlock Text="{Binding CategoriaNombre}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Marca -->
                    <DataGridTextColumn Header="Marca"
                                        Binding="{Binding MarcaNombre}"
                                        Width="110"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Costo de Reposición -->
                    <DataGridTextColumn Header="Costo ($)"
                                        Binding="{Binding CostoReposicion, StringFormat={}{0:N2}}"
                                        Width="95"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Margen Ganancia -->
                    <DataGridTextColumn Header="Margen (%)"
                                        Binding="{Binding PorcentajeGanancia, StringFormat={}{0:N1}%}"
                                        Width="85"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Precio de Venta (Destacado Carmín) -->
                    <DataGridTemplateColumn Header="Precio Venta ($)" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PrecioVenta, StringFormat={}{0:N2}}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Stock y Alerta (RF-08) -->
                    <DataGridTemplateColumn Header="Stock Físico" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <!-- Caso 1: Servicio (Sin Stock) -->
                                    <Border x:Name="BadgeServicio"
                                            Style="{StaticResource BadgeNeutralStyle}"
                                            Visibility="Collapsed">
                                        <TextBlock Text="Servicio"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>

                                    <!-- Caso 2: Stock Crítico / Bajo (Alerta RF-08) -->
                                    <Border x:Name="BadgeAlerta"
                                            Style="{StaticResource BadgeWarningStyle}"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠ " Foreground="{DynamicResource WarningForegroundBrush}" FontWeight="Bold" FontSize="11" />
                                            <TextBlock Text="{Binding StockActual}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource WarningForegroundBrush}" />
                                            <TextBlock Text="{Binding StockMinimo, StringFormat={} (Mín: {0})}" FontSize="10" Foreground="{DynamicResource WarningForegroundBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Caso 3: Stock Normal -->
                                    <Border x:Name="BadgeNormal"
                                            Style="{StaticResource BadgeSuccessStyle}"
                                            Visibility="Visible">
                                        <TextBlock Text="{Binding StockActual, StringFormat={}{0} unid.}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessForegroundBrush}" />
                                    </Border>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding EsServicio}" Value="True">
                                        <Setter TargetName="BadgeServicio" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="BadgeAlerta" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="BadgeNormal" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                        <Setter TargetName="BadgeAlerta" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="BadgeNormal" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="BadgeServicio" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones Contextuales -->
                    <DataGridTemplateColumn Header="Acciones" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Editar -->
                                    <Button Command="{Binding DataContext.EditarArticuloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            ToolTip="Modificar artículo">
                                        <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>

                                    <!-- Baja Lógica -->
                                    <Button Command="{Binding DataContext.BajaArticuloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            ToolTip="Dar de baja artículo (Soft Delete)">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="{DynamicResource DangerBrush}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================================================= -->
        <!-- 4. BARRA DE ESTADO INFERIOR                                   -->
        <!-- ============================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Margin="0,12,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MensajeEstado, FallbackValue='Catálogo listo'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Text="Retail POS • Latencia de Catálogo &lt; 15 ms"
                           FontSize="12"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
