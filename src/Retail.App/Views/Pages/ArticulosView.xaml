<UserControl x:Class="Retail.App.Views.Pages.ArticulosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NuevoArticuloCommand}" />
        <KeyBinding Key="F5" Command="{Binding CargarArticulosCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="{StaticResource SectionSpacing}">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Catálogo de Artículos e Inventario"
                                   Style="{StaticResource TextBlockHeader1}" />
                        

                        <Border x:Name="BadgeStockAlertas"
                                Style="{StaticResource BadgeWarningStyle}"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding TotalAlertasStock, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding TotalAlertasStock, StringFormat={}⚠ {0} Stock Crítico}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Padrón central de productos."
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Administrar rubros, categorías y marcas (solo Gerente y Encargado; sin atajo, D-27) -->
                    <Button Command="{Binding AdministrarClasificacionCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="16,8"
                            Margin="0,0,10,0"
                            Visibility="{Binding PuedeAdministrarClasificacion, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularFolderOpen" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Clasificación" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Pedir los seleccionados (Track 4.3, A-17): solo Encargado y Gerente (A-14) -->
                    <Button Command="{Binding PedirSeleccionadosCommand}"
                            IsEnabled="{Binding TieneArticulosSeleccionados}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="16,8"
                            Margin="0,0,10,0"
                            Visibility="{Binding PuedePedir, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="Agregar los artículos seleccionados al borrador de pedido de su proveedor">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularPackage" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pedir Seleccionados" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Nuevo Artículo (F2) -->
                    <Button Command="{Binding NuevoArticuloCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="SolidPlusCircle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Nuevo Artículo" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. PANEL UNIFICADO: FILTROS + TABLA + PAGINACIÓN              -->
        <!-- ============================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Barra de Búsqueda y Filtros (Mismo surface, solo espaciado) -->
                    <RowDefinition Height="Auto" />
                    <!-- Grilla Principal DataGrid -->
                    <RowDefinition Height="*" />
                    <!-- Barra de Paginación al final de la tabla -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- 2.1 BARRA DE HERRAMIENTAS Y FILTROS                       -->
                <!-- ========================================================= -->
                <WrapPanel Grid.Row="0"
                           Orientation="Horizontal"
                           Margin="16,14,16,8"
                           VerticalAlignment="Center">
                    <!-- Búsqueda rápida por texto o código de barras -->
                    <ui:TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar por código, descripción o marca..."
                                Width="260"
                                Margin="0,0,12,6"
                                VerticalAlignment="Center">
                        <ui:TextBox.Icon>
                            <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                          Width="16"
                                          Height="16" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Filtro por Rubro (RF-04): acota las opciones de Categoría a las del rubro -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                        <TextBlock Text="Rubro:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding RubrosFiltro}"
                                  SelectedValue="{Binding IdRubroFiltro}"
                                  SelectedValuePath="IdRubro"
                                  DisplayMemberPath="NombreRubro"
                                  Width="150"
                                  Height="35"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Filtro por Categoría (del rubro elegido, o todas) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                        <TextBlock Text="Categoría:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding CategoriasFiltro}"
                                  SelectedValue="{Binding IdCategoriaFiltro}"
                                  SelectedValuePath="IdCategoria"
                                  DisplayMemberPath="NombreCategoria"
                                  Width="150"
                                  Height="35"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Filtro por Marca -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                        <TextBlock Text="Marca:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding MarcasFiltro}"
                                  SelectedValue="{Binding IdMarcaFiltro}"
                                  SelectedValuePath="IdMarca"
                                  DisplayMemberPath="NombreMarca"
                                  Width="140"
                                  Height="35"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Filtro por Distribuidor -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                        <TextBlock Text="Distribuidor:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding DistribuidoresFiltro}"
                                  SelectedValue="{Binding IdDistribuidorFiltro}"
                                  SelectedValuePath="IdProveedor"
                                  DisplayMemberPath="Nombre"
                                  Width="160"
                                  Height="35"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Filtro por Stock -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                        <TextBlock Text="Stock:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding OpcionesStockFiltro}"
                                  SelectedValue="{Binding FiltroStock}"
                                  SelectedValuePath="Valor"
                                  DisplayMemberPath="Descripcion"
                                  Width="130"
                                  Height="35"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Botón Limpiar Filtros -->
                    <Button Command="{Binding LimpiarFiltrosCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Height="35"
                            Padding="12,0"
                            Margin="0,0,12,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularEraser"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="Limpiar"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Indicador de Carga Asíncrona -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,0,0,6"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                        <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
                        <TextBlock Text="Cargando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>

                <!-- ========================================================= -->
                <!-- 2.2 GRILLA PRINCIPAL DE ARTÍCULOS                         -->
                <!-- ========================================================= -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Articulos}"
                          SelectedValuePath="Articulo"
                          SelectedValue="{Binding ArticuloSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="1"
                          Margin="16,0,16,8">
                <DataGrid.Columns>
                    <!-- Selección para pedir (Track 4.3, A-17): la casilla vive en ArticuloFila, no en el DTO -->
                    <!-- Su visibilidad la fija el code-behind: una columna no está en el árbol visual y no hereda el DataContext -->
                    <DataGridTemplateColumn x:Name="ColumnaSeleccion"
                                            Width="48"
                                            CanUserResize="False"
                                            CanUserSort="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRetailStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.SeleccionarTodos, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="Seleccionar / deseleccionar todos los de esta página"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Padding="0"
                                      Margin="0" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EstaSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          MinWidth="0"
                                          MinHeight="0"
                                          Padding="0"
                                          Margin="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Descripción (el código de barras no se muestra en la grilla para aliviarla;
                         la búsqueda por código sigue disponible y el dato se ve al editar el artículo) -->
                    <DataGridTextColumn Header="Descripción"
                                        Binding="{Binding Articulo.Descripcion}"
                                        Width="*"
                                        MinWidth="240"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Categoría -->
                    <DataGridTemplateColumn Header="Categoría" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeNeutralStyle}">
                                    <TextBlock Text="{Binding Articulo.CategoriaNombre}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Marca -->
                    <DataGridTextColumn Header="Marca"
                                        Binding="{Binding Articulo.MarcaNombre}"
                                        Width="110"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Distribuidor / Enlace (RF-05) -->
                    <DataGridTemplateColumn Header="Distribuidor" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <!-- Caso 1: Vinculado a Distribuidor -->
                                    <Border x:Name="BadgeVinculado"
                                            Background="{DynamicResource PrimaryLightBrush}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Articulo.ProveedorNombre}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Articulo.CodigoProveedor, StringFormat={}Cód: {0}}" />
                                                    <TextBlock Text="{Binding Articulo.DescripcionProveedor}" FontStyle="Italic" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="11" Height="11" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Articulo.ProveedorNombre}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryPressedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="105"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Caso 2: Manual / No Vinculado -->
                                    <TextBlock x:Name="TextoManual"
                                               Text="(Manual)"
                                               FontStyle="Italic"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Visible" />

                                    <!-- Caso 3: Presentación derivada (RF-21): su costo sale del artículo de origen -->
                                    <Border x:Name="BadgePresentacion"
                                            Style="{StaticResource BadgeNeutralStyle}"
                                            HorizontalAlignment="Left"
                                            ToolTip="Costo derivado del artículo de origen: se actualiza cuando cambia el costo del origen."
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularGitBranch" Width="11" Height="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Articulo.UnidadesPorOrigen, StringFormat={}Presentación ×{0}}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Articulo.EstaVinculadoAProveedor}" Value="True">
                                        <Setter TargetName="BadgeVinculado" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TextoManual" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Articulo.EsDerivado}" Value="True">
                                        <Setter TargetName="BadgePresentacion" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TextoManual" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Costo de Reposición -->
                    <DataGridTextColumn Header="Costo ($)"
                                        HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                        Binding="{Binding Articulo.CostoReposicion, StringFormat={}{0:N2}}"
                                        Width="95"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Margen Ganancia -->
                    <DataGridTextColumn Header="Margen (%)"
                                        HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                        Binding="{Binding Articulo.PorcentajeGanancia, StringFormat={}{0:N1}}"
                                        Width="85"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Precio de Venta (Destacado Carmín) -->
                    <DataGridTemplateColumn Header="Precio Venta ($)" HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Articulo.PrecioVenta, StringFormat={}{0:N2}}"
                                           FontFamily="{StaticResource FontFamilyNumeric}"
                                           Typography.NumeralAlignment="Tabular"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Stock y Alerta (RF-08) -->
                    <DataGridTemplateColumn Header="Stock" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <!-- Caso 1: Servicio (Sin Stock) -->
                                    <Border x:Name="BadgeServicio"
                                            Style="{StaticResource BadgeNeutralStyle}"
                                            Visibility="Collapsed">
                                        <TextBlock Text="Servicio"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>

                                    <!-- Caso 2: Stock Crítico / Bajo (Alerta RF-08) -->
                                    <Border x:Name="BadgeAlerta"
                                            Style="{StaticResource BadgeWarningStyle}"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠ " Foreground="{DynamicResource WarningForegroundBrush}" FontWeight="Bold" FontSize="11" />
                                            <TextBlock Text="{Binding Articulo.StockActual}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource WarningForegroundBrush}" />
                                            <TextBlock Text="{Binding Articulo.StockMinimo, StringFormat={} (Mín: {0})}" FontSize="10" Foreground="{DynamicResource WarningForegroundBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Caso 3: Stock Normal -->
                                    <Border x:Name="BadgeNormal"
                                            Style="{StaticResource BadgeSuccessStyle}"
                                            Visibility="Visible">
                                        <TextBlock Text="{Binding Articulo.StockActual, StringFormat={}{0} unid.}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessForegroundBrush}" />
                                    </Border>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Articulo.EsServicio}" Value="True">
                                        <Setter TargetName="BadgeServicio" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="BadgeAlerta" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="BadgeNormal" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Articulo.StockBajo}" Value="True">
                                        <Setter TargetName="BadgeAlerta" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="BadgeNormal" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="BadgeServicio" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones Contextuales -->
                    <DataGridTemplateColumn Header="Acciones" Width="172">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Pedir al proveedor (A-17, G4): deshabilitado con su motivo si no tiene fuente -->
                                    <Button Command="{Binding DataContext.PedirArticuloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding SePuedePedir}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            ToolTipService.ShowOnDisabled="True"
                                            Visibility="{Binding DataContext.PuedePedir, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Agregar al borrador de pedido del proveedor" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SePuedePedir}" Value="False">
                                                                <Setter Property="Text" Value="{Binding MotivoNoSePuedePedir, StringFormat=No se puede pedir: {0}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.ToolTip>
                                        <iconPacks:PackIconBoxIcons Kind="RegularPackage" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>

                                    <!-- Crear presentación (RF-21): solo en artículos de compra que no son servicios -->
                                    <Button x:Name="BtnCrearPresentacion"
                                            Command="{Binding DataContext.CrearPresentacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Articulo}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            ToolTip="Crear presentación de venta (por ejemplo, la unidad suelta)">
                                        <iconPacks:PackIconBoxIcons Kind="RegularGitBranch" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>

                                    <!-- Fraccionar (RF-21): solo en presentaciones derivadas -->
                                    <Button x:Name="BtnFraccionar"
                                            Command="{Binding DataContext.FraccionarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Articulo}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            Visibility="Collapsed"
                                            ToolTip="Fraccionar: abrir unidades del artículo de origen">
                                        <iconPacks:PackIconBoxIcons Kind="RegularCut" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}" />
                                    </Button>

                                    <!-- Editar -->
                                    <Button Command="{Binding DataContext.EditarArticuloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Articulo}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            ToolTip="Modificar artículo">
                                        <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>

                                    <!-- Baja Lógica -->
                                    <Button Command="{Binding DataContext.BajaArticuloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Articulo}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            ToolTip="Dar de baja artículo (Soft Delete)">
                                        <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                                    </Button>
                                </StackPanel>

                                <!-- Un derivado no puede ser origen de otro (un solo nivel) y un servicio no tiene presentaciones -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Articulo.EsDerivado}" Value="True">
                                        <Setter TargetName="BtnCrearPresentacion" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="BtnFraccionar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Articulo.EsServicio}" Value="True">
                                        <Setter TargetName="BtnCrearPresentacion" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ========================================================= -->
            <!-- 2.3 BARRA DE PAGINACIÓN AL FINAL DE LA TABLA               -->
            <!-- ========================================================= -->
            <components:PaginationBar Grid.Row="2" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
