<UserControl x:Class="Retail.App.Views.Pages.ModuloEnConstruccionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <Grid Margin="{StaticResource PageMargin}">
        <Border Style="{StaticResource CardBorderStyle}"
                MaxWidth="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32">
            <StackPanel HorizontalAlignment="Center">
                <!-- Icono de Trabajo en Progreso -->
                <Border Background="{DynamicResource PrimaryLightBrush}"
                        CornerRadius="40"
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Center"
                        Margin="{StaticResource StackLg}">
                    <iconPacks:PackIconBoxIcons Kind="RegularCode"
                                                Width="36"
                                                Height="36"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                </Border>

                <!-- Título del Módulo -->
                <TextBlock x:Name="TxtTituloModulo"
                           Text="Módulo en Desarrollo"
                           Style="{StaticResource TextBlockHeader1}"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource StackSm}" />

                <!-- Badge de Estado en Roadmap -->
                <Border Style="{StaticResource BadgeWarningStyle}"
                        HorizontalAlignment="Center"
                        Margin="{StaticResource StackLg}">
                    <TextBlock x:Name="TxtEtapaBadge"
                               Text="Próximamente según Roadmap"
                               Style="{StaticResource BadgeNeutralTextStyle}"
                               Foreground="{DynamicResource WarningForegroundBrush}" />
                </Border>

                <!-- Descripción Informativa -->
                <TextBlock x:Name="TxtDescripcion"
                           Text="Esta funcionalidad se encuentra planificada en el cronograma oficial de la cátedra."
                           Style="{StaticResource TextBlockBody}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           Margin="{StaticResource StackMd}" />

                <TextBlock x:Name="TxtDetalles"
                           Text="Responsable y Especificación Técnica según ERS v3.2."
                           Style="{StaticResource TextBlockCaption}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           Margin="{StaticResource StackXl}" />

                <!-- Separador -->
                <Border Height="1"
                        Background="{DynamicResource SurfaceBorderBrush}"
                        Margin="{StaticResource StackXl}" />

                <!-- Botón para regresar a Catálogo -->
                <Button x:Name="BtnVolverCatalogo"
                        Click="BtnVolverCatalogo_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularPackage" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ir al Catálogo de Artículos" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
