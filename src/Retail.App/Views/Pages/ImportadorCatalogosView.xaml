<UserControl x:Class="Retail.App.Views.Pages.ImportadorCatalogosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding ImportarPlanillaCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Búsqueda (o acciones masivas si hay filas marcadas), directo sobre el fondo -->
            <RowDefinition Height="Auto" />
            <!-- Tabla + paginación: la única superficie de la página -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO DE LA PÁGINA (sin tarjeta)                      -->
        <!-- ============================================================= -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Catálogos Mayoristas"
                               Subtitulo="Consulta de listas de distribuidores e importación asistida de artículos a tienda.">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <!-- Selector de Distribuidor: elige QUÉ catálogo se carga (no filtra la tabla) y muestra la antigüedad de su lista -->
                <StackPanel VerticalAlignment="Top" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Distribuidor:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ProveedoresDisponibles}"
                                  SelectedItem="{Binding ProveedorActivo, Mode=TwoWay}"
                                  DisplayMemberPath="RazonSocial"
                                  Width="220"
                                  MinHeight="{StaticResource ControlHeight}"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Fecha de la última planilla del proveedor; en ámbar si supera el umbral (A-2) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                Visibility="{Binding TieneProveedorActivo, Converter={StaticResource BoolToVisConverter}}">
                        <iconPacks:PackIconBoxIcons Kind="RegularAlertTriangle"
                                                    Width="12" Height="12"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource WarningForegroundBrush}"
                                                    ToolTip="{Binding AvisoListaDesactualizada}"
                                                    Visibility="{Binding ListaDesactualizada, Converter={StaticResource BoolToVisConverter}}" />
                        <TextBlock Text="{Binding TextoUltimaPlanilla}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockCaptionSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ListaDesactualizada}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="ToolTip" Value="{Binding AvisoListaDesactualizada}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Importar Planilla (F9) -->
                <Button Command="{Binding ImportarPlanillaCommand}"
                        IsEnabled="{Binding TieneProveedorActivo}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularFilePlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Importar Planilla" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </components:PageHeader>

        <!-- ============================================================= -->
        <!-- 2. BÚSQUEDA Y CARGA (sin tarjeta). Con filas marcadas, las    -->
        <!--    acciones masivas ocupan el lugar de "Limpiar filtros".     -->
        <!-- ============================================================= -->
        <components:ListToolbar Grid.Row="1"
                                Margin="0,0,0,12"
                                Texto="{Binding TextoBusquedaCatalogo, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar código o descripción..."
                                ComandoLimpiar="{Binding LimpiarFiltrosCommand}"
                                EstaCargando="{Binding IsBusy}"
                                HaySeleccion="{Binding TieneItemsSeleccionados}">
            <components:ListToolbar.AccionesDeSeleccion>
                <components:BulkActionBar CantidadSeleccionados="{Binding CantidadSeleccionados}"
                                          ComandoCancelar="{Binding LimpiarSeleccionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Pedir los seleccionados al proveedor (Track 4.3, A-17): solo Encargado y Gerente (A-14) -->
                        <Button Style="{StaticResource KeycapButtonStyle}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Command="{Binding PedirSeleccionadosCommand}"
                                Visibility="{Binding PuedePedir, Converter={StaticResource BoolToVisConverter}}"
                                ToolTip="Agregar los ítems seleccionados al borrador de pedido del proveedor">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularCart" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pedir seleccionados" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Incorporar los seleccionados a la tienda (RF-05) -->
                        <Button
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                VerticalAlignment="Center"
                                Click="BtnIncorporar_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Incorporar seleccionados a tienda" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </components:BulkActionBar>
            </components:ListToolbar.AccionesDeSeleccion>
        </components:ListToolbar>

        <!-- ============================================================= -->
        <!-- 3. TABLA: GRILLA Y, COMO CONTINUACIÓN, LA PAGINACIÓN          -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Style="{StaticResource TablaListadoStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="GrillaCatalogo"
                          Grid.Row="0"
                          ItemsSource="{Binding ItemsCatalogo}"
                          Style="{StaticResource DataGridListadoStyle}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionChanged="GrillaCatalogo_SelectionChanged"
                          BorderThickness="0"
                          helpers:EsquinasHelper.Esquinas="7,7,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowListadoStyle}">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>

                        <!-- Selección múltiple por CheckBox -->
                        <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRetailStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.SeleccionarTodos, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Style="{StaticResource CheckBoxCompactStyle}"
                                          ToolTip="Seleccionar / deseleccionar todos los de esta página" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding EstaSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckBoxCompactStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Código de proveedor -->
                        <DataGridTextColumn Header="Código"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                            Binding="{Binding CodigoProveedor}"
                                            ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                            Width="110" />

                        <!-- Descripción proveedor -->
                        <DataGridTextColumn Header="Descripción (Proveedor)"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                            Binding="{Binding DescripcionProveedor}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*"
                                            MinWidth="240" />

                        <!-- Precio de costo -->
                        <DataGridTextColumn Header="Costo Reposición"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                            Binding="{Binding CostoReposicion, StringFormat=C2}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="160" />

                        <!-- Estado de vinculación. Su filtro (Sin incorporar / Ya en tienda) vive en la cabecera. Una columna no
                             está en el árbol visual: el filtro toma el DataContext de la página buscando el UserControl ancestro. -->
                        <DataGridTemplateColumn Width="180" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <components:FiltroColumna Filtro="{Binding DataContext.FiltroEstadoVinculacion, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                                Visibility="{Binding EstaVinculado, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="En Tienda"
                                                       FontSize="{StaticResource FontSizeXs}" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                                Margin="4,0,0,0"
                                                Visibility="{Binding CoincideConArticuloTienda, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Coincide EAN"
                                                       FontSize="{StaticResource FontSizeXs}" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        </Border>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeWarningStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstaVinculado}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Sin Incorporar"
                                                       FontSize="{StaticResource FontSizeXs}" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Artículo vinculado en tienda -->
                        <DataGridTextColumn Header="Artículo en Tienda"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}"
                                            Binding="{Binding NombreArticuloTienda}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="240" />

                        <!-- Acciones de la fila: vincular (RF-05) y pedir (A-17, G4). Solo íconos y sin título; 2 acciones =
                             36 x 2 + 8 de ancho -->
                        <DataGridTemplateColumn Width="80"
                                                CanUserResize="False"
                                                CanUserSort="False"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderListadoStyle}">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                    <Setter Property="Padding" Value="4,0" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.VincularArticuloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                ToolTip="Vincular a artículo en tienda (RF-05)"
                                                AutomationProperties.Name="Vincular a artículo en tienda">
                                            <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="16" Height="16" />
                                        </Button>
                                        <Button Command="{Binding DataContext.PedirItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding DataContext.PuedePedir, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                                ToolTip="Agregar este ítem al borrador de pedido del proveedor; si no está en la tienda, se ofrece incorporarlo primero"
                                                AutomationProperties.Name="Pedir al proveedor">
                                            <iconPacks:PackIconBoxIcons Kind="RegularCart" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Paginación pegada a la grilla, separada por una línea; los avisos de estado van centrados sobre ella -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <components:PaginationBar />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Border Style="{StaticResource BadgeSuccessStyle}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding TieneMensajeEstado, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding MensajeEstado}"
                                           FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                            </Border>
                            <Border Style="{StaticResource BadgeDangerStyle}"
                                    Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding MensajeError}"
                                           FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerForegroundBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
