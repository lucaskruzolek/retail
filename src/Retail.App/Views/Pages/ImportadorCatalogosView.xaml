<UserControl x:Class="Retail.App.Views.Pages.ImportadorCatalogosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:Retail.Domain.Enums;assembly=Retail.Domain"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding ImportarPlanillaCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y CONTEXTO DEL PROVEEDOR                        -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,14"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconBoxIcons Kind="RegularFileDetail"
                                                Width="22" Height="22"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Catálogos Mayoristas"
                                   Style="{StaticResource TextBlockHeader1}" />
                        <TextBlock Text="Consulta de listas de distribuidores e importación asistida de artículos a tienda."
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Selector de Distribuidor -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Distribuidor:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ProveedoresDisponibles}"
                                  SelectedItem="{Binding ProveedorActivo, Mode=TwoWay}"
                                  DisplayMemberPath="RazonSocial"
                                  Width="220"
                                  Height="36"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Importar Planilla (F9) -->
                    <Button Command="{Binding ImportarPlanillaCommand}"
                            IsEnabled="{Binding TieneProveedorActivo}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularFilePlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Importar Planilla" FontWeight="Bold" VerticalAlignment="Center" />
                            
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. CATÁLOGO DEL DISTRIBUIDOR: FILTROS + GRILLA + PAGINACIÓN   -->
        <!-- ============================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 2.1 Barra superior de herramientas y filtros -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="16,14,16,12">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Catálogo del Proveedor"
                               Style="{StaticResource TextBlockHeader2}"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />

                    <ui:TextBox DockPanel.Dock="Left"
                                Text="{Binding TextoBusquedaCatalogo, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar código o descripción..."
                                Width="260"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                        <ui:TextBox.Icon>
                            <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                          Width="16" Height="16" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Filtro estado de vinculación -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Estado:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding OpcionesEstado}"
                                  SelectedItem="{Binding FiltroEstado}"
                                  Width="150"
                                  Height="35"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static enums:EstadoVinculacionCatalogoEnum.Todos}">
                                                        <Setter Property="Text" Value="Todos" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static enums:EstadoVinculacionCatalogoEnum.SinIncorporar}">
                                                        <Setter Property="Text" Value="Sin incorporar" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static enums:EstadoVinculacionCatalogoEnum.YaEnTienda}">
                                                        <Setter Property="Text" Value="Ya en tienda" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Acciones a la derecha: Contador + Botón Incorporar Seleccionados -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Total de ítems -->
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Style="{StaticResource TextBlockCaption}">
                            <Run Text="{Binding TotalItemsCatalogo, Mode=OneWay}" />
                            <Run Text=" ítem(s)" />
                        </TextBlock>

                        <!-- Botón incorporar seleccionados a tienda -->
                        <Button x:Name="BtnIncorporar"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Padding="14,8"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding TieneItemsSeleccionados}"
                                Click="BtnIncorporar_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="SolidPlusCircle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Incorporar Seleccionados a Tienda" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- 2.2 Grilla de datos del catálogo -->
                <DataGrid x:Name="GrillaCatalogo"
                          Grid.Row="1"
                          ItemsSource="{Binding ItemsCatalogo}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionChanged="GrillaCatalogo_SelectionChanged"
                          BorderThickness="1"
                          Margin="16,0,16,8">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowRetailStyle}">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>

                        <!-- Selección múltiple por CheckBox -->
                        <DataGridTemplateColumn Width="60" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRetailStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.SeleccionarTodos, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ToolTip="Seleccionar / Deseleccionar todos"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          MinWidth="0"
                                          MinHeight="0"
                                          Padding="0"
                                          Margin="0" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding EstaSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              MinHeight="0"
                                              Padding="0"
                                              Margin="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Código de proveedor -->
                        <DataGridTemplateColumn Header="Código" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CodigoProveedor}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Código de barras -->
                        <DataGridTextColumn Header="Cód. Barras"
                                            Binding="{Binding CodigoBarras}"
                                            ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                            Width="120" />

                        <!-- Descripción proveedor -->
                        <DataGridTextColumn Header="Descripción (Proveedor)"
                                            Binding="{Binding DescripcionProveedor}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*" />

                        <!-- Precio de costo -->
                        <DataGridTextColumn Header="Costo Reposición"
                                            Binding="{Binding CostoReposicion, StringFormat=C2}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="130" />

                        <!-- Estado vinculación -->
                        <DataGridTemplateColumn Header="Estado" Width="150" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,0" Orientation="Horizontal">
                                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                                Visibility="{Binding EstaVinculado, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="En Tienda"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                                Margin="4,0,0,0"
                                                Visibility="{Binding CoincideConArticuloTienda, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Coincide EAN"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        </Border>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeWarningStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstaVinculado}" Value="False">
                                                             <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Sin Incorporar"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Artículo vinculado en tienda -->
                        <DataGridTextColumn Header="Artículo en Tienda"
                                            Binding="{Binding NombreArticuloTienda}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="180" />

                        <!-- Precio de venta tienda -->
                        <DataGridTextColumn Header="Precio Venta"
                                            Binding="{Binding PrecioVentaTienda, StringFormat=C2}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="110" />

                        <!-- Acción vinculación manual (RF-05) -->
                        <DataGridTemplateColumn Header="Acción" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.VincularArticuloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="8,4"
                                            ToolTip="Vincular a artículo en tienda (RF-05)">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Vincular" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- 2.3 Barra de paginación en servidor y mensajes de estado -->
                <Grid Grid.Row="2">
                    <components:PaginationBar />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding TieneMensajeEstado, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding MensajeEstado}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDangerStyle}"
                                Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding MensajeError}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</UserControl>
