<UserControl x:Class="Retail.App.Views.Pages.ImportadorCatalogosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ExaminarArchivoCommand}" />
        <KeyBinding Key="F3" Command="{Binding CargarCatalogoCommand}" />
        <KeyBinding Key="F9" Command="{Binding ImportarPlanillaCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO                                                  -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,14"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularImport"
                                                    Width="20" Height="20"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />
                        <TextBlock Text="Importador de Catálogos"
                                   Style="{StaticResource TextBlockHeader1}" />
                        <!-- Badge nombre de proveedor activo -->
                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding ProveedorActivo, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding ProveedorActivo.RazonSocial}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryPressedBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Carga masiva en streaming desde planillas Excel/CSV de distribuidores."
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Actualizar catálogo (F3) -->
                    <Button Command="{Binding CargarCatalogoCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="12,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Actualizar" VerticalAlignment="Center" />
                            <Border Style="{StaticResource KeycapBadgeStyle}">
                                <TextBlock Text="F3" Style="{StaticResource TextBlockKeycap}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. PANEL DE IMPORTACIÓN                                        -->
        <!-- ============================================================= -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Título de sección -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="Configuración de Importación"
                           Style="{StaticResource TextBlockHeader2}"
                           Margin="0,0,0,14" />

                <!-- Fila 1: Archivo + columnas -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,12">
                    <!-- Ruta del archivo -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Planilla de proveedor"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtRutaArchivo"
                                     Text="{Binding RutaArchivo, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Width="300"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" />
                            <Button Command="{Binding ExaminarArchivoCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularFolder" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Examinar" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource KeycapBadgeStyle}">
                                        <TextBlock Text="F1" Style="{StaticResource TextBlockKeycap}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Col. Código -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Columna Código"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding ColumnaCodigo, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="13" />
                    </StackPanel>

                    <!-- Col. Descripción -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Columna Descripción"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding ColumnaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="13" />
                    </StackPanel>

                    <!-- Col. Precio -->
                    <StackPanel>
                        <TextBlock Text="Columna Precio"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding ColumnaPrecio, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <!-- Botón Importar -->
                <Button Grid.Row="1" Grid.Column="1"
                        x:Name="BtnImportar"
                        Command="{Binding ImportarPlanillaCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="20,10"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularImport" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Importar Planilla" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource KeycapPrimaryBadgeStyle}">
                            <TextBlock Text="F9" Style="{StaticResource TextBlockKeycap}" Foreground="{DynamicResource PrimaryForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Fila 2: Barra de progreso + resultado -->
                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Progreso -->
                    <StackPanel Grid.Column="0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="Procesando planilla en streaming..."
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <ProgressBar Value="{Binding ProgresoImportacion}"
                                     Minimum="0" Maximum="100"
                                     Height="6"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     Background="{DynamicResource SurfaceBorderBrush}" />
                    </StackPanel>

                    <!-- Resultado de última importación -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Visibility="{Binding UltimoResultado, Converter={StaticResource BoolToVisConverter}}">
                        <Border Style="{StaticResource BadgeSuccessStyle}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding UltimoResultado.NuevosRegistros, StringFormat={}✚ {0} nuevos}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                        <Border Style="{StaticResource BadgeWarningStyle}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding UltimoResultado.PreciosActualizados, StringFormat={}↑ {0} precios}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDangerStyle}">
                            <TextBlock Text="{Binding UltimoResultado.FilasConError, StringFormat={}✕ {0} errores}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- 3. CATÁLOGO IMPORTADO: FILTROS + GRILLA + INCORPORACIÓN       -->
        <!-- ============================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 3.1 Barra de filtros del catálogo -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="16,14,16,12">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Catálogo del Proveedor"
                               Style="{StaticResource TextBlockHeader2}"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />

                    <ui:TextBox DockPanel.Dock="Left"
                                Text="{Binding TextoBusquedaCatalogo, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar código o descripción..."
                                Width="280"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                        <ui:TextBox.Icon>
                            <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                          Width="16" Height="16" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Filtro estado de vinculación -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Estado:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding OpcionesEstado}"
                                  SelectedItem="{Binding FiltroEstado}"
                                  Width="160"
                                  Height="35"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Total de ítems -->
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Style="{StaticResource TextBlockCaption}">
                        <Run Text="{Binding TotalItemsCatalogo, Mode=OneWay}" />
                        <Run Text=" ítem(s) en catálogo" />
                    </TextBlock>
                </DockPanel>

                <!-- 3.2 Grilla del catálogo -->
                <DataGrid x:Name="GrillaCatalogo"
                          Grid.Row="1"
                          ItemsSource="{Binding ItemsCatalogo}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          SelectionMode="Extended"
                          BorderThickness="0,1,0,1">
                    <DataGrid.Columns>

                        <!-- Código de proveedor -->
                        <DataGridTemplateColumn Header="Código Proveedor" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CodigoProveedor}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Descripción proveedor -->
                        <DataGridTextColumn Header="Descripción (Proveedor)"
                                            Binding="{Binding DescripcionProveedor}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*" />

                        <!-- Precio de costo -->
                        <DataGridTextColumn Header="Costo Reposición"
                                            Binding="{Binding CostoReposicion, StringFormat=C2}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="140" />

                        <!-- Estado vinculación -->
                        <DataGridTemplateColumn Header="Estado" Width="140" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,0">
                                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                                Visibility="{Binding EstaVinculado, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="En Tienda"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        </Border>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeWarningStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstaVinculado}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Sin Incorporar"
                                                    FontSize="11" FontWeight="Bold"
                                                    Foreground="{DynamicResource WarningForegroundBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Artículo vinculado en tienda -->
                        <DataGridTextColumn Header="Artículo en Tienda"
                                            Binding="{Binding NombreArticuloTienda}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="200" />

                        <!-- Precio de venta tienda -->
                        <DataGridTextColumn Header="Precio Venta"
                                            Binding="{Binding PrecioVentaTienda, StringFormat=C2}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="120" />

                    </DataGrid.Columns>
                </DataGrid>

                <!-- 3.3 Panel de incorporación a tienda -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        Padding="16,12">
                    <DockPanel LastChildFill="False">
                        <!-- Configuración de incorporación -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="% Ganancia sugerido"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding PorcentajeGananciaSugerido, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"
                                         Width="90"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         FontSize="14" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Mensajes de estado/error -->
                        <Border DockPanel.Dock="Left"
                                Style="{StaticResource BadgeSuccessStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding MensajeEstado, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding MensajeEstado}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                        <Border DockPanel.Dock="Left"
                                Style="{StaticResource BadgeDangerStyle}"
                                Visibility="{Binding MensajeError, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding MensajeError}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerForegroundBrush}" />
                        </Border>

                        <!-- Botón incorporar seleccionados -->
                        <Button DockPanel.Dock="Right"
                                x:Name="BtnIncorporar"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Padding="16,8"
                                Click="BtnIncorporar_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="SolidPlusCircle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Incorporar Seleccionados a Tienda" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

            </Grid>
        </Border>

    </Grid>
</UserControl>
