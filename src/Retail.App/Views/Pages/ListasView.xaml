<UserControl x:Class="Retail.App.Views.Pages.ListasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Conteos alineados a la derecha, igual que su encabezado (DataGridColumnHeaderRightListadoStyle) -->
        <Style x:Key="CeldaNumericaDerecha" TargetType="TextBlock" BasedOn="{StaticResource TextBlockNumericCell}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Búsqueda, directo sobre el fondo -->
            <RowDefinition Height="Auto" />
            <!-- Tabla + paginación: la única superficie de la página -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO DE LA PÁGINA (sin tarjeta). "Nueva lista" es el  -->
        <!--    único acento carmín de la vista; sin atajo de teclado (L-04) -->
        <!-- ============================================================= -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Ventas"
                               Descripcion="Listas · Conjuntos de artículos de uso frecuente, como la lista de útiles de un grado. Se venden desde el Punto de venta a precio de catálogo."
                               EstaCargando="{Binding IsBusy}">
            <components:PageHeader.Navegacion>
                <components:NavegadorSeccion SeccionId="ventas" />
            </components:PageHeader.Navegacion>
            <Button Command="{Binding NuevaListaCommand}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    ToolTip="Crear una lista de artículos nueva">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Nueva lista" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </components:PageHeader>

        <!-- ============================================================= -->
        <!-- 2. BÚSQUEDA POR NOMBRE (sin tarjeta)                          -->
        <!-- ============================================================= -->
        <components:ListToolbar Grid.Row="1"
                                Margin="0,0,0,12"
                                Texto="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar lista por nombre..."
                                ComandoLimpiar="{Binding LimpiarFiltrosCommand}" />

        <!-- ============================================================= -->
        <!-- 3. TABLA: GRILLA Y, COMO CONTINUACIÓN, LA PAGINACIÓN          -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Style="{StaticResource TablaListadoStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <!-- Doble clic y Enter abren el editor (code-behind: la grilla se queda con Enter si no se lo intercepta) -->
                    <DataGrid x:Name="Grilla"
                              ItemsSource="{Binding Listas}"
                              SelectedItem="{Binding ListaSeleccionada, Mode=TwoWay}"
                              Style="{StaticResource DataGridListadoStyle}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              BorderThickness="0"
                              helpers:EsquinasHelper.Esquinas="7,7,0,0"
                              MouseDoubleClick="OnGrillaMouseDoubleClick"
                              PreviewKeyDown="OnGrillaPreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nombre" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nombre}"
                                                   Style="{StaticResource TextBlockTextCell}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Nombre}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Artículos"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                                Binding="{Binding CantidadArticulos}"
                                                ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                Width="104" />

                            <!-- Total de hoy: a los precios de catálogo vigentes, no a los de cuando se armó la lista -->
                            <DataGridTextColumn Header="Total de hoy"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                                Binding="{Binding TotalDeHoy, StringFormat=C0}"
                                                ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                Width="136" />

                            <DataGridTextColumn Header="Ventas"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                                Binding="{Binding CantidadVentas}"
                                                ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                Width="96" />

                            <DataGridTextColumn Header="Modificada"
                                                Binding="{Binding ModificadaLocal, StringFormat={}{0:dd/MM/yyyy}}"
                                                ElementStyle="{StaticResource TextBlockNumericCell}"
                                                Width="120" />

                            <!-- Acciones de la fila: solo íconos, sin título (como Presupuestos) -->
                            <DataGridTemplateColumn Header=""
                                                    Width="148"
                                                    CanUserResize="False"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    ToolTip="Editar la lista"
                                                    AutomationProperties.Name="Editar lista">
                                                <iconPacks:PackIconBoxIcons Kind="RegularPencil" Width="14" Height="14" />
                                            </Button>

                                            <Button Command="{Binding DataContext.ImprimirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    ToolTip="Imprimir el ticket de la lista"
                                                    AutomationProperties.Name="Imprimir ticket">
                                                <iconPacks:PackIconBoxIcons Kind="RegularPrinter" Width="14" Height="14" />
                                            </Button>

                                            <Button Command="{Binding DataContext.ExportarPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    ToolTip="Exportar la lista a PDF"
                                                    AutomationProperties.Name="Exportar PDF">
                                                <iconPacks:PackIconBoxIcons Kind="RegularFile" Width="14" Height="14" />
                                            </Button>

                                            <Button Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconDangerButtonStyle}"
                                                    ToolTip="Dar de baja la lista"
                                                    AutomationProperties.Name="Dar de baja lista">
                                                <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vacío: orienta al usuario hacia "Nueva lista" -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,36,0,0"
                                Visibility="{Binding EstaVacio, Converter={StaticResource BoolToVisConverter}}">
                        <iconPacks:PackIconBoxIcons Kind="RegularListUl" Width="40" Height="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TextoVacio}"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Error de carga, con la salida de volver a intentar -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,36,0,0"
                                Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                        <Border Style="{StaticResource BadgeDangerStyle}">
                            <TextBlock Text="{Binding MensajeError}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Button Command="{Binding RecargarCommand}"
                                Style="{StaticResource KeycapButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0"
                                ToolTip="Volver a consultar las listas">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="{StaticResource InlineXs}" VerticalAlignment="Center" />
                                <TextBlock Text="Reintentar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Paginación pegada a la grilla, separada por una línea -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                    <components:PaginationBar />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
