<UserControl x:Class="Retail.App.Views.Pages.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:Retail.Domain.Enums;assembly=Retail.Domain"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Búsqueda y carga, directo sobre el fondo -->
            <RowDefinition Height="Auto" />
            <!-- Tabla + paginación: la única superficie de la página -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Administración de Usuarios y Roles (RBAC)">
            <StackPanel Orientation="Horizontal">
                <!-- Desbloquear la cuenta de Administrador seleccionada (solo Gerente, D-31) -->
                <Button Command="{Binding DesbloquearCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Desbloquear la cuenta seleccionada (bloqueada por autorizaciones fallidas)"
                        Visibility="{Binding PuedeDesbloquear, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularLockOpenAlt" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Desbloquear" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NuevoUsuarioCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularUserPlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nuevo Operador" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </components:PageHeader>

        <!-- ============================================================= -->
        <!-- 2. BÚSQUEDA Y CARGA (sin tarjeta, sin contador)               -->
        <!-- ============================================================= -->
        <components:ListToolbar Grid.Row="1"
                                Margin="{StaticResource StackMd}"
                                Texto="{Binding FiltroBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar por usuario o nombre completo..."
                                EstaCargando="{Binding IsBusy}" />

        <!-- ============================================================= -->
        <!-- 3. TABLA: GRILLA Y, COMO CONTINUACIÓN, LA PAGINACIÓN          -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Style="{StaticResource TablaListadoStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Usuarios}"
                          SelectedItem="{Binding UsuarioSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridListadoStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          helpers:EsquinasHelper.Esquinas="7,7,0,0">
                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="ID"
                                        HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                        Binding="{Binding IdUsuario}"
                                        Width="60"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Nombre de Usuario -->
                    <DataGridTextColumn Header="Usuario"
                                        Binding="{Binding NombreUsuario}"
                                        Width="140"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Nombre Completo -->
                    <DataGridTextColumn Header="Nombre y Apellido"
                                        Binding="{Binding NombreCompleto}"
                                        Width="*"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Rol RBAC con Badge Semántico -->
                    <DataGridTemplateColumn Header="Rol RBAC" Width="130"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderCenterListadoStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="RolBadge" Style="{StaticResource BadgeNeutralStyle}" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtRol"
                                               Text="{Binding Rol}"
                                               Style="{StaticResource BadgeNeutralTextStyle}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Rol}" Value="{x:Static enums:RolUsuarioEnum.Gerente}">
                                        <Setter TargetName="RolBadge" Property="Style" Value="{StaticResource BadgePrimaryStyle}" />
                                        <Setter TargetName="TxtRol" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rol}" Value="{x:Static enums:RolUsuarioEnum.Encargado}">
                                        <Setter TargetName="RolBadge" Property="Style" Value="{StaticResource BadgeWarningStyle}" />
                                        <Setter TargetName="TxtRol" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rol}" Value="{x:Static enums:RolUsuarioEnum.Cajero}">
                                        <Setter TargetName="RolBadge" Property="Style" Value="{StaticResource BadgeNeutralStyle}" />
                                        <Setter TargetName="TxtRol" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Estado (Activo / Inactivo) con Badge Semáforo -->
                    <DataGridTemplateColumn Header="Estado" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                <Border x:Name="EstadoBadge" Style="{StaticResource BadgeSuccessStyle}">
                                    <TextBlock x:Name="TxtEstado"
                                               Text="Activo"
                                               Style="{StaticResource BadgeNeutralTextStyle}"
                                               Foreground="{DynamicResource SuccessForegroundBrush}" />
                                </Border>
                                <!-- Bloqueada por autorizaciones de restauración fallidas (D-31) -->
                                <Border Style="{StaticResource BadgeWarningStyle}"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding EstaBloqueada, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="Bloqueada"
                                               Style="{StaticResource BadgeNeutralTextStyle}"
                                               Foreground="{DynamicResource WarningForegroundBrush}" />
                                </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                        <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeDangerStyle}" />
                                        <Setter TargetName="TxtEstado" Property="Text" Value="Inactivo" />
                                        <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Fecha de Alta -->
                    <DataGridTextColumn Header="Fecha Alta"
                                        HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                        Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}"
                                        Width="110"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Acciones de la fila: solo íconos (3 x 36 + 8); la columna no lleva título -->
                    <DataGridTemplateColumn Width="116" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellRetailStyle}">
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <!-- Editar -->
                                    <Button Command="{Binding DataContext.EditarUsuarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            Margin="0,0,8,0"
                                            ToolTip="Modificar datos y rol">
                                        <iconPacks:PackIconBoxIcons Kind="RegularPencil" Width="14" Height="14" />
                                    </Button>

                                    <!-- Restablecer Contraseña -->
                                    <Button Command="{Binding DataContext.RestablecerPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            Margin="0,0,8,0"
                                            ToolTip="Restablecer contraseña">
                                        <iconPacks:PackIconBoxIcons Kind="RegularKey" Width="14" Height="14" />
                                    </Button>

                                    <!-- Baja Lógica -->
                                    <Button Command="{Binding DataContext.BajaUsuarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconDangerButtonStyle}"
                                            IsEnabled="{Binding Activo}"
                                            ToolTip="Dar de baja operador">
                                        <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                </DataGrid>

                <!-- Paginación pegada a la grilla, separada por una línea -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                    <components:PaginationBar />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
