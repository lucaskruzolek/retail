<UserControl x:Class="Retail.App.Views.Pages.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:Retail.Domain.Enums;assembly=Retail.Domain"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Administración de Usuarios y Roles (RBAC)"
                               Style="{StaticResource TextBlockHeader1}" />
                    <TextBlock Text="Panel de gestión de operadores, credenciales y control de acceso del punto de venta (RF-03)"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Command="{Binding CargarUsuariosCommand}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="12,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refrescar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NuevoUsuarioCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="SolidUserPlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Nuevo Operador" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. PANEL UNIFICADO: FILTROS + TABLA + PAGINACIÓN              -->
        <!-- ============================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Barra de Búsqueda y Filtros (Mismo surface, solo espaciado) -->
                    <RowDefinition Height="Auto" />
                    <!-- Grilla Principal DataGrid -->
                    <RowDefinition Height="*" />
                    <!-- Barra de Paginación al final de la tabla -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- 2.1 BARRA DE HERRAMIENTAS Y FILTROS                       -->
                <!-- ========================================================= -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="16,14,16,12">
                    <!-- Búsqueda rápida por texto -->
                    <ui:TextBox DockPanel.Dock="Left"
                                Text="{Binding FiltroBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Buscar por usuario o nombre completo..."
                                Width="360"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                        <ui:TextBox.Icon>
                            <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                          Width="16"
                                          Height="16" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Indicador de Carga Asíncrona -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                        <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
                        <TextBlock Text="Cargando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- ========================================================= -->
                <!-- 2.2 GRILLA PRINCIPAL DE USUARIOS                          -->
                <!-- ========================================================= -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Usuarios}"
                          SelectedItem="{Binding UsuarioSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0,1,0,1">
                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding IdUsuario}"
                                        Width="60"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Nombre de Usuario -->
                    <DataGridTextColumn Header="Usuario"
                                        Binding="{Binding NombreUsuario}"
                                        Width="140"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Nombre Completo -->
                    <DataGridTextColumn Header="Nombre y Apellido"
                                        Binding="{Binding NombreCompleto}"
                                        Width="*"
                                        ElementStyle="{StaticResource TextBlockTextCell}" />

                    <!-- Rol RBAC con Badge Semántico -->
                    <DataGridTemplateColumn Header="Rol RBAC" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="RolBadge" Style="{StaticResource BadgeNeutralStyle}">
                                    <TextBlock x:Name="TxtRol"
                                               Text="{Binding Rol}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Rol}" Value="{x:Static enums:RolUsuarioEnum.Gerente}">
                                        <Setter TargetName="RolBadge" Property="Style" Value="{StaticResource BadgePrimaryStyle}" />
                                        <Setter TargetName="TxtRol" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rol}" Value="{x:Static enums:RolUsuarioEnum.Encargado}">
                                        <Setter TargetName="RolBadge" Property="Style" Value="{StaticResource BadgeWarningStyle}" />
                                        <Setter TargetName="TxtRol" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rol}" Value="{x:Static enums:RolUsuarioEnum.Cajero}">
                                        <Setter TargetName="RolBadge" Property="Style" Value="{StaticResource BadgeNeutralStyle}" />
                                        <Setter TargetName="TxtRol" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Estado (Activo / Inactivo) con Badge Semáforo -->
                    <DataGridTemplateColumn Header="Estado" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="EstadoBadge" Style="{StaticResource BadgeSuccessStyle}">
                                    <TextBlock x:Name="TxtEstado"
                                               Text="Activo"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessForegroundBrush}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                        <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeDangerStyle}" />
                                        <Setter TargetName="TxtEstado" Property="Text" Value="Inactivo" />
                                        <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Fecha de Alta -->
                    <DataGridTextColumn Header="Fecha Alta"
                                        Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}"
                                        Width="110"
                                        ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                    <!-- Acciones de Fila -->
                    <DataGridTemplateColumn Header="Acciones" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Editar -->
                                    <Button Command="{Binding DataContext.EditarUsuarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            ToolTip="Modificar datos y rol">
                                        <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Button>

                                    <!-- Restablecer Contraseña -->
                                    <Button Command="{Binding DataContext.RestablecerPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            ToolTip="Restablecer contraseña">
                                        <iconPacks:PackIconBoxIcons Kind="RegularKey" Width="14" Height="14" Foreground="{DynamicResource WarningBrush}" />
                                    </Button>

                                    <!-- Baja Lógica -->
                                    <Button Command="{Binding DataContext.BajaUsuarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource KeycapButtonStyle}"
                                            Padding="6,4"
                                            IsEnabled="{Binding Activo}"
                                            ToolTip="Dar de baja operador">
                                        <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ========================================================= -->
            <!-- 2.3 BARRA DE PAGINACIÓN AL FINAL DE LA TABLA               -->
            <!-- ========================================================= -->
            <components:PaginationBar Grid.Row="2" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
