<UserControl x:Class="Retail.App.Views.Pages.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:Retail.Domain.Enums;assembly=Retail.Domain"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y ACCIONES (solo el Gerente opera, D-3)         -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Copias de Seguridad y Restauración"
                               Style="{StaticResource TextBlockHeader1}" />
                    <TextBlock Text="Historial de copias completas de la base de datos y restauración desde una copia verificada (RF-22)"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Modo solo lectura: únicamente un Gerente puede crear o restaurar copias."
                               Style="{StaticResource TextBlockBodyMuted}"
                               Margin="0,4,0,0"
                               Visibility="{Binding EsSoloLectura, Converter={StaticResource BoolToVisConverter}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding PuedeOperar, Converter={StaticResource BoolToVisConverter}}">
                    <Button Command="{Binding RestaurarCopiaCommand}"
                            Style="{StaticResource DangerActionButtonStyle}"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            ToolTip="Restaurar la copia seleccionada (solo copias verificadas)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Restaurar" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CrearBackupManualCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="16,8"
                            ToolTip="Crear una copia de seguridad ahora">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularSave" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Crear copia" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. AVISO DE LA ÚLTIMA RESTAURACIÓN (R-20) Y ERRORES           -->
        <!-- ============================================================= -->
        <StackPanel Grid.Row="1">
            <Border Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding TieneUltimaRestauracion, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding UltimaRestauracionTexto}"
                           Foreground="{DynamicResource WarningForegroundBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerForegroundBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- 3. HISTORIAL DE COPIAS                                        -->
        <!-- ============================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="16,14,16,12">
                    <TextBlock Text="{Binding MensajeEstado}"
                               Style="{StaticResource TextBlockBodySecondary}"
                               VerticalAlignment="Center" />

                    <!-- Indicador de carga o de operación en curso -->
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                        <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
                        <TextBlock Text="Procesando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Copias}"
                          SelectedItem="{Binding CopiaSeleccionada, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="1"
                          Margin="16,0,16,16">
                    <DataGrid.Columns>
                        <!-- Fecha local de inicio -->
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding FechaLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                            Width="150"
                                            ElementStyle="{StaticResource TextBlockNumericCell}" />

                        <!-- Tipo -->
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo, Converter={StaticResource EnumATextoConverter}}"
                                            Width="170"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />

                        <!-- Operador -->
                        <DataGridTextColumn Header="Operador"
                                            Binding="{Binding Operador}"
                                            Width="*"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />

                        <!-- Estado con badge semáforo -->
                        <DataGridTemplateColumn Header="Estado" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="EstadoBadge"
                                            Style="{StaticResource BadgeNeutralStyle}"
                                            ToolTip="{Binding MensajeError}">
                                        <TextBlock x:Name="TxtEstado"
                                                   Text="{Binding Estado, Converter={StaticResource EnumATextoConverter}}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Verificado}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeSuccessStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Fallido}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeDangerStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.EnCurso}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeWarningStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Exitoso}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeWarningStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tamaño del archivo -->
                        <DataGridTextColumn Header="Tamaño"
                                            Binding="{Binding TamanoTexto}"
                                            Width="110"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                        <!-- Restaurable: verificada y con el archivo en disco -->
                        <DataGridTemplateColumn Header="Restaurable" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="TxtRestaurable"
                                               Text="No"
                                               Style="{StaticResource TextBlockTextCell}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EsRestaurable}" Value="True">
                                            <Setter TargetName="TxtRestaurable" Property="Text" Value="Sí" />
                                            <Setter TargetName="TxtRestaurable" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
