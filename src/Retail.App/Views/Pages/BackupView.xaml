<UserControl x:Class="Retail.App.Views.Pages.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             xmlns:enums="clr-namespace:Retail.Domain.Enums;assembly=Retail.Domain"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Avisos (errores) -->
            <RowDefinition Height="Auto" />
            <!-- Selector de vista y estado, directo sobre el fondo -->
            <RowDefinition Height="Auto" />
            <!-- Tabla: la única superficie de la página -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y ACCIONES (Gerente y Administrador operan, D-30 y D-32), sin tarjeta -->
        <!-- ============================================================= -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Copias de Seguridad y Restauración"
                               Subtitulo="Historial de copias completas de la base de datos y restauración desde una copia verificada (RF-22)">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding PuedeOperar, Converter={StaticResource BoolToVisConverter}}">
                <Button Command="{Binding RestaurarCopiaCommand}"
                        Style="{StaticResource DangerActionButtonStyle}"
                        Margin="{StaticResource InlineSm}"
                        ToolTip="Restaurar la copia seleccionada (solo copias verificadas)">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Restaurar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CrearBackupManualCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="Crear una copia de seguridad ahora">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularSave" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Crear copia" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </components:PageHeader>

        <!-- ============================================================= -->
        <!-- 2. AVISOS: modo solo lectura y errores -->
        <!-- ============================================================= -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Modo solo lectura: únicamente un Gerente o un Administrador pueden crear o restaurar copias."
                       Style="{StaticResource TextBlockBodyMuted}"
                       Margin="{StaticResource StackMd}"
                       Visibility="{Binding EsSoloLectura, Converter={StaticResource BoolToVisConverter}}" />

            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="{StaticResource InsetCompact}"
                    Margin="{StaticResource StackMd}"
                    Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerForegroundBrush}"
                           FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- 3. SELECTOR DE VISTA (D-34, R9), ESTADO Y CARGA, sin tarjeta   -->
        <!-- ============================================================= -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="{StaticResource StackMd}">
            <components:SelectorSegmentado DockPanel.Dock="Left"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource InlineMd}">
                <UniformGrid Columns="2">
                    <RadioButton GroupName="VistaRespaldos"
                                 IsChecked="{Binding MostrandoCopias, Mode=TwoWay}"
                                 Style="{StaticResource SegmentedRadioButtonStyle}"
                                 Content="Copias" />
                    <RadioButton GroupName="VistaRespaldos"
                                 IsChecked="{Binding MostrandoRestauraciones, Mode=TwoWay}"
                                 Style="{StaticResource SegmentedRadioButtonStyle}"
                                 Content="Restauraciones" />
                </UniformGrid>
            </components:SelectorSegmentado>

            <TextBlock Text="{Binding MensajeEstado}"
                       Style="{StaticResource TextBlockBodySecondary}"
                       VerticalAlignment="Center" />

            <!-- Indicador de carga o de operación en curso -->
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                <ui:ProgressRing Width="20" Height="20" Margin="{StaticResource InlineSm}" IsIndeterminate="True" />
                <TextBlock Text="Procesando..." Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- ============================================================= -->
        <!-- 4. TABLA: una sola superficie con la vista elegida             -->
        <!-- ============================================================= -->
        <Border Grid.Row="3" Style="{StaticResource TablaListadoStyle}">
            <Grid>
                <!-- Historial de copias -->
                <DataGrid Visibility="{Binding MostrandoCopias, Converter={StaticResource BoolToVisConverter}}"
                          ItemsSource="{Binding Copias}"
                          SelectedItem="{Binding CopiaSeleccionada, Mode=TwoWay}"
                          Style="{StaticResource DataGridListadoStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          helpers:EsquinasHelper.Esquinas="7">
                    <DataGrid.Columns>
                        <!-- Fecha local de inicio -->
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding FechaLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                            Width="150"
                                            ElementStyle="{StaticResource TextBlockNumericCell}" />

                        <!-- Tipo -->
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo, Converter={StaticResource EnumATextoConverter}}"
                                            Width="170"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />

                        <!-- Operador -->
                        <DataGridTextColumn Header="Operador"
                                            Binding="{Binding Operador}"
                                            Width="*"
                                            ElementStyle="{StaticResource TextBlockTextCell}" />

                        <!-- Estado con badge semáforo -->
                        <DataGridTemplateColumn Header="Estado" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="EstadoBadge"
                                            Style="{StaticResource BadgeNeutralStyle}"
                                            HorizontalAlignment="Left"
                                            ToolTip="{Binding MensajeError}">
                                        <TextBlock x:Name="TxtEstado"
                                                   Text="{Binding Estado, Converter={StaticResource EnumATextoConverter}}"
                                                   Style="{StaticResource BadgeNeutralTextStyle}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Verificado}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeSuccessStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Fallido}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeDangerStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.EnCurso}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeWarningStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Exitoso}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeWarningStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tamaño del archivo -->
                        <DataGridTextColumn Header="Tamaño"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                            Binding="{Binding TamanoTexto}"
                                            Width="110"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                        <!-- Restaurable: verificada y con el archivo en disco -->
                        <DataGridTemplateColumn Header="Restaurable" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="TxtRestaurable"
                                               Text="No"
                                               Style="{StaticResource TextBlockTextCell}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EsRestaurable}" Value="True">
                                            <Setter TargetName="TxtRestaurable" Property="Text" Value="Sí" />
                                            <Setter TargetName="TxtRestaurable" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Historial de restauraciones (D-34): solo lectura -->
                <Grid Visibility="{Binding MostrandoRestauraciones, Converter={StaticResource BoolToVisConverter}}">
                    <DataGrid ItemsSource="{Binding Restauraciones}"
                              Style="{StaticResource DataGridListadoStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              helpers:EsquinasHelper.Esquinas="7">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding FechaLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                Width="150"
                                                ElementStyle="{StaticResource TextBlockNumericCell}" />
                            <DataGridTextColumn Header="Origen"
                                                Binding="{Binding OrigenTexto}"
                                                Width="110"
                                                ElementStyle="{StaticResource TextBlockTextCell}" />
                            <DataGridTextColumn Header="Ejecutada por"
                                                Binding="{Binding EjecutadaPor}"
                                                Width="*"
                                                ElementStyle="{StaticResource TextBlockTextCell}" />
                            <DataGridTextColumn Header="Autorizada por"
                                                Binding="{Binding AutorizadaPor}"
                                                Width="*"
                                                ElementStyle="{StaticResource TextBlockTextCell}" />
                            <DataGridTextColumn Header="Copia restaurada"
                                                Binding="{Binding ArchivoCopia}"
                                                Width="2*"
                                                ElementStyle="{StaticResource TextBlockMonospaceCell}" />
                <DataGridTextColumn Header="Base anterior"
                                                Binding="{Binding BaseAnteriorTexto}"
                                                Width="2*"
                                                ElementStyle="{StaticResource TextBlockMonospaceCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No se registraron restauraciones"
                               Style="{StaticResource TextBlockBodyMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding NoHayRestauraciones, Converter={StaticResource BoolToVisConverter}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
