<UserControl x:Class="Retail.App.Views.Pages.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Retail.App.Views.Components"
             xmlns:helpers="clr-namespace:Retail.App.Helpers"
             xmlns:enums="clr-namespace:Retail.Domain.Enums;assembly=Retail.Domain"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Avisos (errores) -->
            <RowDefinition Height="Auto" />
            <!-- Estado y carga, directo sobre el fondo -->
            <RowDefinition Height="Auto" />
            <!-- Tabla: la única superficie de la página -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y ACCIONES (Gerente y Administrador operan, D-30 y D-32), sin tarjeta -->
        <!-- ============================================================= -->
        <StackPanel Grid.Row="0">
            <!-- La descripción sigue a la página abierta (Copias o Restauraciones): el título es el de la sección -->
            <components:PageHeader Margin="{StaticResource SectionSpacing}"
                                   Titulo="Administración"
                                   EstaCargando="{Binding IsBusy}">
                <components:PageHeader.Navegacion>
                    <components:NavegadorSeccion SeccionId="administracion" />
                </components:PageHeader.Navegacion>
                <components:PageHeader.Style>
                    <Style TargetType="components:PageHeader" BasedOn="{StaticResource {x:Type components:PageHeader}}">
                        <Setter Property="Descripcion" Value="Copias · Historial de copias completas de la base de datos; permite crear una y restaurar desde una verificada (RF-22)" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoRestauraciones}" Value="True">
                                <Setter Property="Descripcion" Value="Restauraciones · Registro de las restauraciones de la base de datos: quién las ejecutó, quién las autorizó y desde qué copia" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </components:PageHeader.Style>
                <StackPanel Orientation="Horizontal">
                    <!-- Quita los filtros de columna de la grilla que se está mostrando; se deshabilita sola si no hay ninguno -->
                    <Button Command="{Binding LimpiarFiltrosCommand}"
                            Style="{StaticResource GhostNeutralButtonStyle}"
                            Margin="{StaticResource InlineSm}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularFilter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Limpiar filtros" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding PuedeOperar, Converter={StaticResource BoolToVisConverter}}">
                    <Button Command="{Binding RestaurarCopiaCommand}"
                            Visibility="{Binding MostrandoCopias, Converter={StaticResource BoolToVisConverter}}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Margin="{StaticResource InlineSm}"
                            ToolTip="Restaurar la copia seleccionada (solo copias verificadas)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Restaurar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CrearBackupManualCommand}"
                            Visibility="{Binding MostrandoCopias, Converter={StaticResource BoolToVisConverter}}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            ToolTip="Crear una copia de seguridad ahora">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularSave" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Crear copia" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </StackPanel>
            </components:PageHeader>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- 2. AVISOS: modo solo lectura y errores -->
        <!-- ============================================================= -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Modo solo lectura: únicamente un Gerente o un Administrador pueden crear o restaurar copias."
                       Style="{StaticResource TextBlockBodyMuted}"
                       Margin="{StaticResource StackMd}"
                       Visibility="{Binding EsSoloLectura, Converter={StaticResource BoolToVisConverter}}" />

            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="{StaticResource InsetCompact}"
                    Margin="{StaticResource StackMd}"
                    Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerForegroundBrush}"
                           FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- 4. TABLA: una sola superficie con la vista elegida             -->
        <!-- ============================================================= -->
        <Border Grid.Row="3" Style="{StaticResource TablaListadoStyle}">
            <Grid>
                <!-- Historial de copias -->
                <Grid Visibility="{Binding MostrandoCopias, Converter={StaticResource BoolToVisConverter}}">
                <DataGrid ItemsSource="{Binding Copias}"
                          SelectedItem="{Binding CopiaSeleccionada, Mode=TwoWay}"
                          Style="{StaticResource DataGridListadoStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          helpers:EsquinasHelper.Esquinas="7">
                    <DataGrid.Columns>
                        <!-- Fecha local de inicio; las cabeceras llevan filtros de columna (el DataContext de la página se toma del
                             UserControl ancestro: una columna no está en el árbol visual) -->
                        <DataGridTextColumn Binding="{Binding FechaLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                            Width="190"
                                            ElementStyle="{StaticResource TextBlockNumericCell}">
                            <DataGridTextColumn.Header>
                                <components:FiltroFechaColumna Filtro="{Binding DataContext.FiltroCopiaFecha, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- Tipo -->
                        <DataGridTextColumn Binding="{Binding Tipo, Converter={StaticResource EnumATextoConverter}}"
                                            Width="190"
                                            ElementStyle="{StaticResource TextBlockTextCell}">
                            <DataGridTextColumn.Header>
                                <components:FiltroColumna Filtro="{Binding DataContext.FiltroCopiaTipo, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- Operador -->
                        <DataGridTextColumn Binding="{Binding Operador}"
                                            Width="*"
                                            ElementStyle="{StaticResource TextBlockTextCell}">
                            <DataGridTextColumn.Header>
                                <components:FiltroColumna Filtro="{Binding DataContext.FiltroCopiaOperador.Filtro, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- Estado con badge semáforo -->
                        <DataGridTemplateColumn Width="170" SortMemberPath="Estado">
                            <DataGridTemplateColumn.Header>
                                <components:FiltroColumna Filtro="{Binding DataContext.FiltroCopiaEstado, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="EstadoBadge"
                                            Style="{StaticResource BadgeNeutralStyle}"
                                            HorizontalAlignment="Left"
                                            ToolTip="{Binding MensajeError}">
                                        <TextBlock x:Name="TxtEstado"
                                                   Text="{Binding Estado, Converter={StaticResource EnumATextoConverter}}"
                                                   Style="{StaticResource BadgeNeutralTextStyle}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Verificado}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeSuccessStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Fallido}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeDangerStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.EnCurso}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeWarningStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static enums:EstadoBackupEnum.Exitoso}">
                                            <Setter TargetName="EstadoBadge" Property="Style" Value="{StaticResource BadgeWarningStyle}" />
                                            <Setter TargetName="TxtEstado" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tamaño del archivo -->
                        <DataGridTextColumn Header="Tamaño"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                            Binding="{Binding TamanoTexto}"
                                            Width="110"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}" />

                        <!-- Restaurable: verificada y con el archivo en disco -->
                        <DataGridTemplateColumn Header="Restaurable" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="TxtRestaurable"
                                               Text="No"
                                               Style="{StaticResource TextBlockTextCell}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EsRestaurable}" Value="True">
                                            <Setter TargetName="TxtRestaurable" Property="Text" Value="Sí" />
                                            <Setter TargetName="TxtRestaurable" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding MensajeSinCopias}"
                           Style="{StaticResource TextBlockBodyMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding NoHayCopias, Converter={StaticResource BoolToVisConverter}}" />
                </Grid>

                <!-- Historial de restauraciones (D-34): solo lectura -->
                <Grid Visibility="{Binding MostrandoRestauraciones, Converter={StaticResource BoolToVisConverter}}">
                    <DataGrid ItemsSource="{Binding Restauraciones}"
                              Style="{StaticResource DataGridListadoStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              helpers:EsquinasHelper.Esquinas="7">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding FechaLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                Width="190"
                                                ElementStyle="{StaticResource TextBlockNumericCell}">
                                <DataGridTextColumn.Header>
                                    <components:FiltroFechaColumna Filtro="{Binding DataContext.FiltroRestauracionFecha, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding OrigenTexto}"
                                                Width="140"
                                                ElementStyle="{StaticResource TextBlockTextCell}">
                                <DataGridTextColumn.Header>
                                    <components:FiltroColumna Filtro="{Binding DataContext.FiltroRestauracionOrigen, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding EjecutadaPor}"
                                                Width="*"
                                                ElementStyle="{StaticResource TextBlockTextCell}">
                                <DataGridTextColumn.Header>
                                    <components:FiltroColumna Filtro="{Binding DataContext.FiltroRestauracionEjecutadaPor.Filtro, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding AutorizadaPor}"
                                                Width="*"
                                                ElementStyle="{StaticResource TextBlockTextCell}">
                                <DataGridTextColumn.Header>
                                    <components:FiltroColumna Filtro="{Binding DataContext.FiltroRestauracionAutorizadaPor.Filtro, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Copia restaurada"
                                                Binding="{Binding ArchivoCopia}"
                                                Width="2*"
                                                ElementStyle="{StaticResource TextBlockMonospaceCell}" />
                <DataGridTextColumn Header="Base anterior"
                                                Binding="{Binding BaseAnteriorTexto}"
                                                Width="2*"
                                                ElementStyle="{StaticResource TextBlockMonospaceCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding MensajeSinRestauraciones}"
                               Style="{StaticResource TextBlockBodyMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding NoHayRestauraciones, Converter={StaticResource BoolToVisConverter}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
