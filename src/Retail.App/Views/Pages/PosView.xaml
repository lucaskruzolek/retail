<UserControl xmlns:components="clr-namespace:Retail.App.Views.Components"
             x:Class="Retail.App.Views.Pages.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Retail.App.Converters"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <!-- El conversor de WPF ignora ConverterParameter: para ocultar con true hace falta el inverso propio -->
        <converters:InverseBooleanToVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />

        <!-- Fila del resumen de la venta: concepto a la izquierda, importe a la derecha -->
        <Style x:Key="ResumenValorStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBody}">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumeric}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <!-- Los atajos se anuncian solo en los tooltips; la descripción del encabezado los resume -->
    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding SeleccionarClienteCommand}" />
        <KeyBinding Key="F8" Command="{Binding LimpiarVentaCommand}" />
        <KeyBinding Key="F12" Command="{Binding CobrarVentaCommand}" />
        <KeyBinding Key="Delete" Command="{Binding EliminarItemCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO (sin tarjeta, como el resto de las páginas)     -->
        <!-- ============================================================= -->
        <!-- El operador ya figura en el menú lateral: no se repite acá. A la derecha, el turno abierto. -->
        <components:PageHeader Grid.Row="0"
                               Margin="{StaticResource SectionSpacing}"
                               Titulo="Punto de venta"
                               Descripcion="Punto de venta · Escanee o busque artículos, ajuste cantidades y cobre. Atajos: F4 cliente, F8 cancelar, F12 cobrar, Supr quitar la línea seleccionada."
                               EstaCargando="{Binding IsBusy}">
            <Border Style="{StaticResource BadgeSuccessStyle}"
                    Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconBoxIcons Kind="SolidCheckCircle"
                                                Width="12"
                                                Height="12"
                                                Margin="{StaticResource InlineXs}"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource SuccessForegroundBrush}" />
                    <TextBlock Text="{Binding TurnoActivo.IdTurno, StringFormat={}Turno #{0}}"
                               Style="{StaticResource TextBlockCaptionSecondary}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessForegroundBrush}" />
                </StackPanel>
            </Border>
        </components:PageHeader>

        <!-- ============================================================= -->
        <!-- 2. AVISO DE CAJA CERRADA (RF-13)                              -->
        <!-- ============================================================= -->
        <!-- Con la caja cerrada no se puede cobrar: el buscador se bloquea y la acción principal de la página pasa a ser
             "Abrir caja", con el mismo diálogo de apertura de la pantalla de Caja. -->
        <Border Grid.Row="1"
                Background="{DynamicResource WarningBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}"
                Padding="16,12"
                Margin="{StaticResource StackLg}"
                Visibility="{Binding MostrarAvisoCajaCerrada, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Command="{Binding AbrirCajaCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        MinHeight="{StaticResource ControlHeightLg}"
                        Content="Abrir caja"
                        ToolTip="Abrir el turno de caja para empezar a vender" />
                <iconPacks:PackIconBoxIcons Kind="RegularLock"
                                            Width="18"
                                            Height="18"
                                            Margin="{StaticResource InlineMd}"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource WarningForegroundBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="La caja está cerrada"
                               Style="{StaticResource TextBlockBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningForegroundBrush}" />
                    <TextBlock Text="Abra la caja para buscar artículos y cobrar."
                               Style="{StaticResource TextBlockBody}"
                               Foreground="{DynamicResource WarningForegroundBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 3. CUERPO: TICKET (70%) + PANEL DE LA VENTA (30%)             -->
        <!-- ============================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="{StaticResource ColumnGap}" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- 3.1 TICKET: BUSCADOR + GRILLA, directo sobre el fondo    -->
            <!-- ========================================================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- BUSCADOR UNIFICADO CON POPUP PREDICTIVO: bloqueado con la caja cerrada -->
                <Grid Grid.Row="0" Margin="{StaticResource StackMd}">
                    <ui:TextBox x:Name="TxtBuscador"
                                Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding CajaAbierta}"
                                IsEnabledChanged="OnTxtBuscadorIsEnabledChanged"
                                PlaceholderText="Escanear un código de barras o buscar por nombre"
                                FontSize="{StaticResource FontSizeMd}"
                                MinHeight="{StaticResource ControlHeightLg}"
                                ToolTip="Enter agrega el artículo resaltado; ↑ y ↓ recorren los resultados"
                                PreviewKeyDown="OnTxtBuscadorPreviewKeyDown">
                        <ui:TextBox.Icon>
                            <components:IconoBoxIcons Kind="RegularBarcode" Foreground="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- POPUP FLOTANTE DE RESULTADOS PREDICTIVOS -->
                    <Popup x:Name="PopupResultados"
                           IsOpen="{Binding MostrarPopupBusqueda, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=TxtBuscador}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           HorizontalOffset="-8"
                           PopupAnimation="Slide">
                        <!-- El margen deja lugar a la sombra, que despega el desplegable de la página y del ticket -->
                        <Border Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="0,4"
                                Margin="8,4,8,12"
                                Width="{Binding ActualWidth, ElementName=TxtBuscador}"
                                MaxHeight="300">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource ElevationShadowColor}"
                                                  Opacity="0.18"
                                                  BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Direction="270" />
                            </Border.Effect>
                            <ListBox x:Name="ListaResultados"
                                     ItemsSource="{Binding ResultadosBusqueda}"
                                     SelectedIndex="{Binding IndiceResultadoSeleccionado, Mode=TwoWay}"
                                     SelectionMode="Single"
                                     ItemContainerStyle="{StaticResource SearchResultListBoxItemStyle}"
                                     MouseMove="OnResultadosMouseMove"
                                     PreviewMouseLeftButtonDown="OnResultadosPreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="OnResultadosPreviewMouseLeftButtonUp"
                                     BorderThickness="0"
                                     Padding="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrecioVenta, StringFormat={}${0:N2}}"
                                                           Style="{StaticResource SearchResultAmountTextStyle}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding StockActual, StringFormat={}Stock: {0}}"
                                                           Style="{StaticResource SearchResultMetaTextStyle}"
                                                           FontFamily="{StaticResource FontFamilyNumeric}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Descripcion}"
                                                           Style="{StaticResource SearchResultTitleTextStyle}" />
                                                <TextBlock Text="{Binding CodigoBarras, FallbackValue='(Sin código)', TargetNullValue='(Sin código)'}"
                                                           Style="{StaticResource SearchResultMetaTextStyle}"
                                                           FontFamily="{StaticResource FontFamilyMonospace}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- GRILLA DEL TICKET DE MOSTRADOR (cada fila tiene su botón de eliminar; Supr elimina la seleccionada) -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding ItemSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          RowStyle="{StaticResource DataGridRowRetailStyle}"
                          CellStyle="{StaticResource DataGridCellRetailStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding NumeroItem}"
                                            ElementStyle="{StaticResource TextBlockNumericCell}"
                                            Width="44"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding IdentificadorVisual}"
                                            ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                            Width="132"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="Artículo"
                                            Binding="{Binding Descripcion}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*"
                                            IsReadOnly="True" />

                        <!-- Cantidad con pasos (SelectorCantidad): se tipea (100 hojas sueltas sin 100 clics) o se ajusta con
                             − y +, que no toman el foco, así el buscador lo conserva para seguir escaneando. Nunca baja de 1:
                             quitar un artículo es una acción explícita (papelera o Supr, D-25). Enter o Esc devuelven el foco
                             al buscador; Esc deshace lo escrito. -->
                        <DataGridTemplateColumn Header="Cantidad" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <components:SelectorCantidad Valor="{Binding Cantidad, Mode=TwoWay}"
                                                                 Minimo="1"
                                                                 NombreAutomatizacion="Cantidad"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 KeyDown="OnCantidadKeyDown" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Precio unit."
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                            Binding="{Binding PrecioUnitarioFormateado}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="112"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="Subtotal"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                            Binding="{Binding SubtotalItemFormateado}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="112"
                                            IsReadOnly="True" />

                        <DataGridTemplateColumn Width="52">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconDangerButtonStyle}"
                                            ToolTip="Quitar la línea [Supr]"
                                            HorizontalAlignment="Center">
                                        <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="16" Height="16" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Estado vacío: el primer paso de la venta, sobre la grilla sin filas. No intercepta clics. -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding TieneItems, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
                    <iconPacks:PackIconBoxIcons Kind="RegularBarcode"
                                                Width="32"
                                                Height="32"
                                                HorizontalAlignment="Center"
                                                Margin="{StaticResource StackMd}"
                                                Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="El ticket está vacío"
                               Style="{StaticResource TextBlockHeader2}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource StackXs}" />
                    <TextBlock Text="Escanee un código o busque un artículo para empezar la venta."
                               Style="{StaticResource TextBlockBodySecondary}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ========================================================= -->
            <!-- 3.2 PANEL DE LA VENTA: una sola superficie sin borde     -->
            <!-- ========================================================= -->
            <!-- Cliente y resumen arriba; el espacio flexible deja el total y las acciones siempre al pie de la columna. -->
            <Border Grid.Column="2" Style="{StaticResource DialogSectionStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cliente de la venta -->
                    <StackPanel Grid.Row="0">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding SeleccionarClienteCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    MinHeight="{StaticResource ControlHeightLg}"
                                    VerticalAlignment="Top"
                                    ToolTip="Cambiar el cliente de la venta [F4]">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPencil" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Cambiar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="{StaticResource InlineSm}">
                                <TextBlock Text="Cliente" Style="{StaticResource TextBlockCaption}" Margin="{StaticResource StackXs}" />
                                <TextBlock Text="{Binding ClienteNombre}"
                                           Style="{StaticResource TextBlockHeader1}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ClienteDocumento}"
                                           Style="{StaticResource TextBlockBodySecondary}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Cuenta corriente, si el cliente la tiene -->
                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="8,4"
                                Margin="0,12,0,0"
                                Visibility="{Binding ClienteTieneCtaCte, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="Cuenta corriente habilitada"
                                           Style="{StaticResource TextBlockCaptionSecondary}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                                <TextBlock Text="{Binding ClienteCreditoDisponibleFormateado, StringFormat={}Disponible: {0}}"
                                           Style="{StaticResource TextBlockCaption}"
                                           FontFamily="{StaticResource FontFamilyNumeric}"
                                           Typography.NumeralAlignment="Tabular"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Resumen de la venta, separado del cliente por una línea -->
                    <StackPanel Grid.Row="1">
                        <Separator Margin="0,16" />
                        <DockPanel Margin="{StaticResource StackSm}">
                            <TextBlock Text="Artículos" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CantidadTotalArticulos}" Style="{StaticResource ResumenValorStyle}" />
                        </DockPanel>
                        <DockPanel Margin="{StaticResource StackSm}">
                            <TextBlock Text="Subtotal" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SubtotalFormateado}" Style="{StaticResource ResumenValorStyle}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Descuentos" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DescuentoFormateado}"
                                       Style="{StaticResource ResumenValorStyle}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Total a cobrar: lo más destacado de la columna, alineado a la derecha con los importes del resumen -->
                    <StackPanel Grid.Row="3">
                        <Separator Margin="0,16" />
                        <TextBlock Text="Total" Style="{StaticResource TextBlockCaption}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TotalFormateado}"
                                   Style="{StaticResource TextBlockDisplayCurrency}"
                                   FontSize="{StaticResource FontSizeDisplayPos}"
                                   Margin="{StaticResource StackLg}" />
                    </StackPanel>

                    <!-- Acciones sobre la venta entera: cobrar [F12] y cancelar [F8] (atajos en los tooltips) -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding CobrarVentaCommand}"
                                IsEnabled="{Binding PuedeCobrar}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                MinHeight="{StaticResource RowHeightPos}"
                                Content="Cobrar venta"
                                ToolTip="Cobrar la venta [F12]" />

                        <Button Grid.Column="1"
                                Command="{Binding LimpiarVentaCommand}"
                                IsEnabled="{Binding TieneItems}"
                                Style="{StaticResource KeycapButtonStyle}"
                                MinHeight="{StaticResource RowHeightPos}"
                                Margin="8,0,0,0"
                                ToolTip="Cancelar la venta [F8]: vacía el ticket">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                                <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
