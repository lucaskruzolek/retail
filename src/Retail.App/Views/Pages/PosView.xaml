<UserControl x:Class="Retail.App.Views.Pages.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding SeleccionarClienteCommand}" />
        <KeyBinding Key="F8" Command="{Binding LimpiarVentaCommand}" />
        <KeyBinding Key="F12" Command="{Binding CobrarVentaCommand}" />
        <KeyBinding Key="Delete" Command="{Binding EliminarItemCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Punto de Venta"
                                   Style="{StaticResource TextBlockHeader1}" />

                        <!-- Badge de Estado de Caja -->
                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="SolidCheckCircle" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TurnoActivo.IdTurno, StringFormat={}Turno Activo #{0}}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Badge Alerta Caja Cerrada -->
                        <Border Style="{StaticResource BadgeWarningStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="SolidAlertTriangle" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Caja Cerrada (Apertura Requerida)"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource WarningForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Terminal de venta por mostrador."
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Ficha del Operador activo -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconBoxIcons Kind="SolidUser" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="{Binding OperadorNombre}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Operador de Mostrador" Style="{StaticResource TextBlockCaptionSecondary}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. CUERPO PRINCIPAL: GRILLA DE VENTA (70%) + PANEL LATERAL (30%)-->
        <!-- ============================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- 2.1 COLUMNA IZQUIERDA: BUSCADOR + TICKET + ATALOS        -->
            <!-- ========================================================= -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,16,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <!-- 1. SearchBar unificado -->
                        <RowDefinition Height="Auto" />
                        <!-- 2. Grilla del Ticket -->
                        <RowDefinition Height="*" />
                        <!-- 3. Barra de Atajos Keycaps -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BUSCADOR UNIFICADO CON POPUP PREDICTIVO -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <ui:TextBox x:Name="TxtBuscador"
                                    Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Escanear código de barras o buscar por nombre... [Enter]"
                                    FontSize="15"
                                    Padding="12,10"
                                    KeyDown="OnTxtBuscadorKeyDown">
                            <ui:TextBox.Icon>
                                <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularBarcode, Brush={StaticResource PrimaryBrush}}"
                                              Width="18"
                                              Height="18" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>

                        <!-- POPUP FLOTANTE DE RESULTADOS PREDICTIVOS -->
                        <Popup x:Name="PopupResultados"
                               IsOpen="{Binding MostrarPopupBusqueda, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=TxtBuscador}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4"
                                    Width="{Binding ActualWidth, ElementName=TxtBuscador}"
                                    MaxHeight="300">
                                <ListBox ItemsSource="{Binding ResultadosBusqueda}"
                                         SelectedIndex="{Binding IndiceResultadoSeleccionado, Mode=TwoWay}"
                                         SelectionMode="Single"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8"
                                                    Margin="0,2"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource SurfaceBackgroundBrush}">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PrecioVenta, StringFormat={}${0:N2}}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding StockActual, StringFormat={}Stock: {0}}"
                                                                   Style="{StaticResource TextBlockCaptionSecondary}"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Right" />
                                                    </StackPanel>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Descripcion}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CodigoBarras, FallbackValue='(Sin código)', TargetNullValue='(Sin código)'}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                                   Style="{StaticResource TextBlockCaptionSecondary}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- GRILLA PRINCIPAL DEL TICKET DE MOSTRADOR -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding ItemSeleccionado, Mode=TwoWay}"
                              Style="{StaticResource DataGridRetailStyle}"
                              RowStyle="{StaticResource DataGridRowRetailStyle}"
                              CellStyle="{StaticResource DataGridCellRetailStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <!-- # Fila -->
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding NumeroItem}"
                                                ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                                Width="45"
                                                IsReadOnly="True" />

                            <!-- Código -->
                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding IdentificadorVisual}"
                                                ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                                Width="130"
                                                IsReadOnly="True" />

                            <!-- Descripción -->
                            <DataGridTextColumn Header="Descripción del Artículo"
                                                Binding="{Binding Descripcion}"
                                                ElementStyle="{StaticResource TextBlockTextCell}"
                                                Width="*"
                                                IsReadOnly="True" />

                            <!-- Cantidad con botones + / - -->
                            <DataGridTemplateColumn Header="Cantidad" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.DecrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KeycapButtonStyle}"
                                                    Padding="6,2"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="-" FontWeight="Bold" FontSize="13" />
                                            </Button>
                                            <TextBlock Text="{Binding Cantidad}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0" />
                                            <Button Command="{Binding DataContext.IncrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KeycapButtonStyle}"
                                                    Padding="6,2"
                                                    Margin="4,0,0,0">
                                                <TextBlock Text="+" FontWeight="Bold" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Precio Unitario -->
                            <DataGridTextColumn Header="Precio Unit."
                                                Binding="{Binding PrecioUnitarioFormateado}"
                                                ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                Width="130"
                                                IsReadOnly="True" />

                            <!-- Subtotal Línea -->
                            <DataGridTextColumn Header="Subtotal"
                                                Binding="{Binding SubtotalItemFormateado}"
                                                ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                Width="130"
                                                IsReadOnly="True" />

                            <!-- Eliminar Línea -->
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="6,4"
                                                HorizontalAlignment="Center">
                                            <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" Foreground="{DynamicResource DangerForegroundBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- BARRA INFERIOR DE KEYCAPS Y ATAJOS -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                        <WrapPanel>
                           

                            <!-- [Supr] Eliminar Fila -->
                            <Button Command="{Binding EliminarItemCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Eliminar Ítem" VerticalAlignment="Center" />
                                    
                                </StackPanel>
                            </Button>

                            <!-- [F8] Limpiar Venta -->
                            <Button Command="{Binding LimpiarVentaCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Limpiar Venta" VerticalAlignment="Center" />
                                   
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2.2 COLUMNA DERECHA: CLIENTE + TOTALIZADOR + COBRAR      -->
            <!-- ========================================================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Tarjeta Cliente de Mostrador -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding SeleccionarClienteCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cambiar" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="CLIENTE ASOCIADO" Style="{StaticResource TextBlockCaptionSecondary}" FontWeight="Bold" />
                        </DockPanel>

                        <TextBlock Text="{Binding ClienteNombre}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding ClienteDocumento}"
                                   Style="{StaticResource TextBlockCaptionSecondary}"
                                   Margin="0,2,0,6" />

                        <!-- Estado Cta Cte si aplica -->
                        <Border Visibility="{Binding ClienteTieneCtaCte, Converter={StaticResource BoolToVisConverter}}"
                                Background="{DynamicResource SuccessBackgroundBrush}"
                                BorderBrush="{DynamicResource SuccessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Cuenta Corriente Habilitada"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                                <TextBlock Text="{Binding ClienteCreditoDisponibleFormateado, StringFormat={}Disponible: {0}}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Tarjeta Resumen y Gran Totalizador de Venta -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="20"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Resumen Ítems -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Cantidad de Artículos:" Style="{StaticResource TextBlockBodySecondary}" />
                            <TextBlock Text="{Binding CantidadTotalArticulos}"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- Subtotal -->
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Subtotal Bruto:" Style="{StaticResource TextBlockBodySecondary}" />
                            <TextBlock Text="{Binding SubtotalFormateado}"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- Descuento -->
                        <DockPanel Grid.Row="2" Margin="0,0,0,12">
                            <TextBlock Text="Descuentos:" Style="{StaticResource TextBlockBodySecondary}" />
                            <TextBlock Text="{Binding DescuentoFormateado}"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- Separador -->
                        <Separator Grid.Row="3" VerticalAlignment="Top" Margin="0,0,0,12" />

                        <!-- DISPLAY GIGANTE DE TOTAL DE MOSTRADOR -->
                        <Border Grid.Row="4"
                                Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="0,12,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL GENERAL"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TotalFormateado}"
                                           Style="{StaticResource TextBlockDisplayCurrency}"
                                           FontSize="32"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Gran Botón Primario de Cobro [F12] -->
                <Button Grid.Row="2"
                        Command="{Binding CobrarVentaCommand}"
                        IsEnabled="{Binding PuedeCobrar}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="56"
                        Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeometryCash}"
                              Fill="White"
                              Width="20"
                              Height="20"
                              Stretch="Uniform"
                              Margin="0,0,10,0" />
                        <TextBlock Text="Cobrar Venta"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                        
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
