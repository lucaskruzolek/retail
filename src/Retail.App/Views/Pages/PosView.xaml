<UserControl x:Class="Retail.App.Views.Pages.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Retail.App.Converters"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource SurfaceBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <!-- El conversor de WPF ignora ConverterParameter: para ocultar con true hace falta el inverso propio -->
        <converters:InverseBooleanToVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding SeleccionarClienteCommand}" />
        <KeyBinding Key="F8" Command="{Binding LimpiarVentaCommand}" />
        <KeyBinding Key="F12" Command="{Binding CobrarVentaCommand}" />
        <KeyBinding Key="Delete" Command="{Binding EliminarItemCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- 1. ENCABEZADO Y TÍTULO DEL MÓDULO                             -->
        <!-- ============================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Punto de Venta"
                                   Style="{StaticResource TextBlockHeader1}" />

                        <!-- Badge de Estado de Caja -->
                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="SolidCheckCircle" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TurnoActivo.IdTurno, StringFormat={}Turno Activo #{0}}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Badge Alerta Caja Cerrada -->
                        <Border Style="{StaticResource BadgeWarningStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="SolidAlertTriangle" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Caja Cerrada (Apertura Requerida)"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource WarningForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Terminal de venta por mostrador."
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Ficha del Operador activo -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconBoxIcons Kind="SolidUser" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="{Binding OperadorNombre}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Operador de Mostrador" Style="{StaticResource TextBlockCaptionSecondary}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. CUERPO PRINCIPAL: GRILLA DE VENTA (70%) + PANEL LATERAL (30%)-->
        <!-- ============================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- 2.1 COLUMNA IZQUIERDA: BUSCADOR + TICKET + ATALOS        -->
            <!-- ========================================================= -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,16,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <!-- 1. SearchBar unificado -->
                        <RowDefinition Height="Auto" />
                        <!-- 2. Grilla del Ticket (cada fila tiene su botón de eliminar; Supr elimina la seleccionada) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- BUSCADOR UNIFICADO CON POPUP PREDICTIVO -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <ui:TextBox x:Name="TxtBuscador"
                                    Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Escanear código de barras o buscar por nombre... [Enter]"
                                    FontSize="15"
                                    Padding="12,10"
                                    PreviewKeyDown="OnTxtBuscadorPreviewKeyDown">
                            <ui:TextBox.Icon>
                                <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularBarcode, Brush={StaticResource PrimaryBrush}}"
                                              Width="18"
                                              Height="18" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>

                        <!-- POPUP FLOTANTE DE RESULTADOS PREDICTIVOS -->
                        <Popup x:Name="PopupResultados"
                               IsOpen="{Binding MostrarPopupBusqueda, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=TxtBuscador}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               HorizontalOffset="-8"
                               PopupAnimation="Slide">
                            <!-- El margen deja lugar a la sombra, que despega el desplegable de la página y del ticket -->
                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="0,4"
                                    Margin="8,4,8,12"
                                    Width="{Binding ActualWidth, ElementName=TxtBuscador}"
                                    MaxHeight="300">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource ElevationShadowColor}"
                                                      Opacity="0.18"
                                                      BlurRadius="16"
                                                      ShadowDepth="4"
                                                      Direction="270" />
                                </Border.Effect>
                                <ListBox x:Name="ListaResultados"
                                         ItemsSource="{Binding ResultadosBusqueda}"
                                         SelectedIndex="{Binding IndiceResultadoSeleccionado, Mode=TwoWay}"
                                         SelectionMode="Single"
                                         ItemContainerStyle="{StaticResource SearchResultListBoxItemStyle}"
                                         MouseMove="OnResultadosMouseMove"
                                         PreviewMouseLeftButtonDown="OnResultadosPreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="OnResultadosPreviewMouseLeftButtonUp"
                                         BorderThickness="0"
                                         Padding="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PrecioVenta, StringFormat={}${0:N2}}"
                                                               Style="{StaticResource SearchResultAmountTextStyle}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding StockActual, StringFormat={}Stock: {0}}"
                                                               Style="{StaticResource SearchResultMetaTextStyle}"
                                                               FontFamily="{StaticResource FontFamilyNumeric}"
                                                               Typography.NumeralAlignment="Tabular"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Descripcion}"
                                                               Style="{StaticResource SearchResultTitleTextStyle}" />
                                                    <TextBlock Text="{Binding CodigoBarras, FallbackValue='(Sin código)', TargetNullValue='(Sin código)'}"
                                                               Style="{StaticResource SearchResultMetaTextStyle}"
                                                               FontFamily="{StaticResource FontFamilyMonospace}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- GRILLA PRINCIPAL DEL TICKET DE MOSTRADOR -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding ItemSeleccionado, Mode=TwoWay}"
                              Style="{StaticResource DataGridRetailStyle}"
                              RowStyle="{StaticResource DataGridRowRetailStyle}"
                              CellStyle="{StaticResource DataGridCellRetailStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <!-- # Fila -->
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding NumeroItem}"
                                                ElementStyle="{StaticResource TextBlockNumericCell}"
                                                Width="45"
                                                IsReadOnly="True" />

                            <!-- Código -->
                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding IdentificadorVisual}"
                                                ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                                Width="130"
                                                IsReadOnly="True" />

                            <!-- Descripción -->
                            <DataGridTextColumn Header="Descripción del Artículo"
                                                Binding="{Binding Descripcion}"
                                                ElementStyle="{StaticResource TextBlockTextCell}"
                                                Width="*"
                                                IsReadOnly="True" />

                            <!-- Cantidad con botones + / - -->
                            <DataGridTemplateColumn Header="Cantidad" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.DecrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KeycapButtonStyle}"
                                                    Click="OnAjusteCantidadClick"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Restar una unidad">
                                                <iconPacks:PackIconBoxIcons Kind="RegularMinus" Width="12" Height="12" />
                                            </Button>
                                            <!-- Cantidad editable por teclado (100 hojas sueltas sin 100 clics). Se confirma con
                                                 Enter, Tab o al salir; un valor inválido vuelve al anterior (D-25). -->
                                            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}"
                                                     Width="56"
                                                     Height="24"
                                                     MinHeight="0"
                                                     Padding="2,0"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     Margin="2,0"
                                                     ToolTip="Escriba la cantidad y presione Enter"
                                                     PreviewMouseLeftButtonDown="OnCantidadPreviewMouseLeftButtonDown"
                                                     GotKeyboardFocus="OnCantidadGotKeyboardFocus"
                                                     PreviewKeyDown="OnCantidadPreviewKeyDown"
                                                     LostFocus="OnCantidadLostFocus" />
                                            <Button Command="{Binding DataContext.IncrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KeycapButtonStyle}"
                                                    Click="OnAjusteCantidadClick"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Sumar una unidad">
                                                <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="12" Height="12" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Precio Unitario -->
                            <DataGridTextColumn Header="Precio Unit."
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                Binding="{Binding PrecioUnitarioFormateado}"
                                                ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                Width="130"
                                                IsReadOnly="True" />

                            <!-- Subtotal Línea -->
                            <DataGridTextColumn Header="Subtotal"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                Binding="{Binding SubtotalItemFormateado}"
                                                ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                Width="130"
                                                IsReadOnly="True" />

                            <!-- Eliminar Línea -->
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconDangerButtonStyle}"
                                                ToolTip="Eliminar ítem [Supr]"
                                                HorizontalAlignment="Center">
                                            <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="16" Height="16" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2.2 COLUMNA DERECHA: CLIENTE + TOTALIZADOR + COBRAR      -->
            <!-- ========================================================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Tarjeta Cliente de Mostrador -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="20"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding SeleccionarClienteCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    Padding="12,6"
                                    ToolTip="Cambiar el cliente de la venta">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPencil" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cambiar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="CLIENTE ASOCIADO"
                                       Style="{StaticResource TextBlockCaptionSecondary}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="{Binding ClienteNombre}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="{Binding ClienteDocumento}"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,4,0,0" />

                        <!-- Estado Cta Cte si aplica -->
                        <Border Visibility="{Binding ClienteTieneCtaCte, Converter={StaticResource BoolToVisConverter}}"
                                Background="{DynamicResource SuccessBackgroundBrush}"
                                BorderBrush="{DynamicResource SuccessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Cuenta Corriente Habilitada"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                                <TextBlock Text="{Binding ClienteCreditoDisponibleFormateado, StringFormat={}Disponible: {0}}"
                                           FontFamily="{StaticResource FontFamilyNumeric}"
                                           Typography.NumeralAlignment="Tabular"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Tarjeta de la venta: resumen y total sobre la línea interna, acciones debajo. El espacio flexible
                     deja el total y los botones al pie de la columna, siempre en el mismo lugar. -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Resumen Ítems -->
                        <DockPanel Grid.Row="0" Margin="20,20,20,10">
                            <TextBlock Text="Cantidad de artículos:" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CantidadTotalArticulos}"
                                       FontFamily="{StaticResource FontFamilyNumeric}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- Subtotal -->
                        <DockPanel Grid.Row="1" Margin="20,0,20,10">
                            <TextBlock Text="Subtotal bruto:" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SubtotalFormateado}"
                                       FontFamily="{StaticResource FontFamilyNumeric}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- Descuento -->
                        <DockPanel Grid.Row="2" Margin="20,0,20,0">
                            <TextBlock Text="Descuentos:" Style="{StaticResource TextBlockBodySecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DescuentoFormateado}"
                                       FontFamily="{StaticResource FontFamilyNumeric}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- Total a cobrar -->
                        <StackPanel Grid.Row="4" Margin="20,16,20,20">
                            <Separator Margin="0,0,0,20" />
                            <TextBlock Text="TOTAL A COBRAR"
                                       Style="{StaticResource TextBlockCaptionSecondary}"
                                       FontSize="12"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalFormateado}"
                                       Style="{StaticResource TextBlockDisplayCurrency}"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       TextAlignment="Left"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Acciones sobre la venta entera, bajo una línea interna: cobrar [F12] y cancelar [F8] -->
                        <StackPanel Grid.Row="5" Margin="10,0,10,16">
                            <Separator Margin="0,0,0,16" />
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding CobrarVentaCommand}"
                                        IsEnabled="{Binding PuedeCobrar}"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Content="Cobrar venta"
                                        FontSize="15"
                                        Height="42"
                                        ToolTip="Cobrar venta [F12]" />

                                <Button Grid.Column="1"
                                        Command="{Binding LimpiarVentaCommand}"
                                        IsEnabled="{Binding TieneItems}"
                                        Style="{StaticResource KeycapButtonStyle}"
                                        Height="42"
                                        Padding="16,0"
                                        Margin="8,0,0,0"
                                        ToolTip="Cancelar venta [F8]: vacía el ticket">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
