<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.UsuarioFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="{Binding TituloVentana}"
                  Width="520"
                  Height="644"
                  MinWidth="480"
                  MinHeight="544"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="{Binding TituloVentana}" />

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Nombre de Usuario -->
                <TextBlock Text="Nombre de Usuario (Login)" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtNombreUsuario"
                            Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding EsAlta}"
                            PreviewKeyDown="TxtNombreUsuario_PreviewKeyDown"
                            PreviewTextInput="TxtNombreUsuario_PreviewTextInput"
                            PlaceholderText="ej. jperez"
                            Margin="0,0,0,14" />

                <!-- Nombre -->
                <TextBlock Text="Nombre" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="ej. Juan Carlos"
                            Margin="0,0,0,14" />

                <!-- Apellido -->
                <TextBlock Text="Apellido" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="ej. Pérez"
                            Margin="0,0,0,14" />

                <!-- Contraseña (Solo en Alta) -->
                <StackPanel Visibility="{Binding EsAlta, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Contraseña Inicial" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="TxtPasswordBox"
                                    PasswordChanged="TxtPasswordBox_PasswordChanged"
                                    PlaceholderText="Mínimo 6 caracteres"
                                    Margin="0,0,0,14" />

                    <TextBlock Text="Confirmar Contraseña" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="TxtConfirmarPasswordBox"
                                    PasswordChanged="TxtConfirmarPasswordBox_PasswordChanged"
                                    PlaceholderText="Repita la contraseña"
                                    Margin="0,0,0,14" />
                </StackPanel>


                <!-- Rol RBAC -->
                <TextBlock Text="Rol de Acceso (RBAC)" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding RolesDisponibles}"
                          SelectedItem="{Binding Rol}"
                          Margin="0,0,0,14"
                          Padding="8,6" />

                <!-- Email de Recuperación (obligatorio para Gerente, RF-03) -->
                <TextBlock Text="{Binding EtiquetaEmail}" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding EmailRecuperacion, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="ej. jperez@libreria.com"
                            Margin="0,0,0,4" />
                <TextBlock Text="Se usará para recuperar la contraseña cuando el envío de correos esté disponible."
                           Style="{StaticResource TextBlockCaption}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsCancel="True"
                        Style="{StaticResource KeycapButtonStyle}"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Width="100" />
                <Button Content="Guardar"
                        Click="BtnGuardar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right"
                        Width="110" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
