<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.UsuarioFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="{Binding TituloVentana}"
                  Width="520"
                  MinWidth="480"
                  MinHeight="0"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="{Binding TituloVentana}" />

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="{StaticResource InsetCompact}"
                        Margin="{StaticResource StackLg}"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Sección 1: identificación del operador -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularUser" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Datos del Operador" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <!-- Nombre de Usuario -->
                        <TextBlock Text="Nombre de Usuario (Login)" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                        <ui:TextBox x:Name="TxtNombreUsuario"
                                    Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding EsAlta}"
                                    PreviewKeyDown="TxtNombreUsuario_PreviewKeyDown"
                                    PreviewTextInput="TxtNombreUsuario_PreviewTextInput"
                                    PlaceholderText="ej. jperez"
                                    Margin="{StaticResource StackMd}" />

                        <!-- Nombre -->
                        <TextBlock Text="Nombre" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                        <ui:TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Juan Carlos"
                                    Margin="{StaticResource StackMd}" />

                        <!-- Apellido -->
                        <TextBlock Text="Apellido" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                        <ui:TextBox Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Pérez" />
                    </StackPanel>
                </Border>

                <!-- Sección 2: acceso y recuperación -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularLock" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Acceso y Seguridad" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <!-- Contraseña (Solo en Alta) -->
                        <StackPanel Visibility="{Binding EsAlta, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Contraseña Inicial" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                            <ui:PasswordBox x:Name="TxtPasswordBox"
                                            PasswordChanged="TxtPasswordBox_PasswordChanged"
                                            PlaceholderText="Mínimo 6 caracteres"
                                            Margin="{StaticResource StackMd}" />

                            <TextBlock Text="Confirmar Contraseña" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                            <ui:PasswordBox x:Name="TxtConfirmarPasswordBox"
                                            PasswordChanged="TxtConfirmarPasswordBox_PasswordChanged"
                                            PlaceholderText="Repita la contraseña"
                                            Margin="{StaticResource StackMd}" />
                        </StackPanel>

                        <!-- Rol RBAC -->
                        <TextBlock Text="Rol de Acceso (RBAC)" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                        <ComboBox ItemsSource="{Binding RolesDisponibles}"
                                  SelectedItem="{Binding Rol}"
                                  Margin="{StaticResource StackMd}" />

                        <!-- Email de Recuperación (obligatorio para Gerente, RF-03) -->
                        <TextBlock Text="{Binding EtiquetaEmail}" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                        <ui:TextBox Text="{Binding EmailRecuperacion, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. jperez@libreria.com"
                                    Margin="{StaticResource StackXs}" />
                        <TextBlock Text="Se usará para recuperar la contraseña cuando el envío de correos esté disponible."
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsCancel="True"
                        Style="{StaticResource KeycapButtonStyle}" />
                <Button Click="BtnGuardar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularSave" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Guardar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
