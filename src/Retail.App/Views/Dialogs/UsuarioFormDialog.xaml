<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.UsuarioFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="{Binding TituloVentana}"
                  Width="480"
                  Height="480"
                  MinWidth="440"
                  MinHeight="440"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding TituloVentana}"
                     Height="32"
                     Padding="8,0"
                     ShowMaximize="False"
                     CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=SolidUser, Brush={StaticResource PrimaryBrush}}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Nombre de Usuario -->
                <TextBlock Text="Nombre de Usuario (Login)" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtNombreUsuario"
                            Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding EsAlta}"
                            PreviewKeyDown="TxtNombreUsuario_PreviewKeyDown"
                            PreviewTextInput="TxtNombreUsuario_PreviewTextInput"
                            PlaceholderText="ej. jperez, admin"
                            Margin="0,0,0,14" />

                <!-- Nombre Completo -->
                <TextBlock Text="Nombre y Apellido Completo" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="ej. Juan Pérez"
                            Margin="0,0,0,14" />

                <!-- Contraseña (Solo en Alta) -->
                <StackPanel Visibility="{Binding EsAlta, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Contraseña Inicial" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="TxtPasswordBox"
                                    PasswordChanged="TxtPasswordBox_PasswordChanged"
                                    PlaceholderText="Mínimo 6 caracteres"
                                    Margin="0,0,0,14" />
                </StackPanel>


                <!-- Rol RBAC -->
                <TextBlock Text="Rol de Acceso (RBAC)" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding RolesDisponibles}"
                          SelectedItem="{Binding Rol}"
                          Margin="0,0,0,14"
                          Padding="8,6" />
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsCancel="True"
                        Style="{StaticResource KeycapButtonStyle}"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Width="100" />
                <Button Content="Guardar"
                        Click="BtnGuardar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right"
                        Width="110" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
