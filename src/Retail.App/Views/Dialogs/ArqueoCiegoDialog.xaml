<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ArqueoCiegoDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  Title="Arqueo Ciego de Caja"
                  Width="460"
                  Height="424"
                  MinWidth="420"
                  MinHeight="384"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Arqueo Ciego de Caja" />

        <!-- Contenido -->
        <Border Grid.Row="1" Padding="24,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cierre de Turno y Arqueo Ciego"
                           Style="{StaticResource TextBlockHeader2}"
                           Margin="0,0,0,6" />
                <TextBlock Text="Declare únicamente el dinero físico contado en la gaveta y el fondo a retener para el turno siguiente."
                           Style="{StaticResource TextBlockBodySecondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <!-- Saldo Declarado -->
                <TextBlock Text="Efectivo Contado en Gaveta ($):"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding SaldoDeclaradoEfectivo, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                         FontFamily="{StaticResource FontFamilyNumeric}"
                         Typography.NumeralAlignment="Tabular"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Height="38"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,16" />

                <!-- Monto Retenido -->
                <TextBlock Text="Monto Retenido en Caja para Próximo Turno ($):"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding MontoRetenidoEnCaja, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                         FontFamily="{StaticResource FontFamilyNumeric}"
                         Typography.NumeralAlignment="Tabular"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Height="38"
                         VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Botonera Inferior -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinHeight="{StaticResource ControlHeightLg}"
                        Width="100"
                        DockPanel.Dock="Left"
                        Click="Cancelar_Click" />

                <Button Content="Confirmar Cierre"
                        Style="{StaticResource DangerActionButtonStyle}"
                        MinHeight="{StaticResource ControlHeightLg}"
                        Width="140"
                        DockPanel.Dock="Right"
                        IsDefault="True"
                        Click="Aceptar_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>