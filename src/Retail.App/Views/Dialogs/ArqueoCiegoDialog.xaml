<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ArqueoCiegoDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  Title="Arqueo Ciego de Caja"
                  Width="460"
                  MinWidth="420"
                  MinHeight="0"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Arqueo Ciego de Caja" />

        <!-- Contenido: dos secciones sobre el fondo del diálogo -->
        <StackPanel Grid.Row="1" Margin="12,0,12,12">
            <!-- Saldo Declarado -->
            <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                        <iconPacks:PackIconBoxIcons Kind="RegularCalculator" Style="{StaticResource CardHeaderIconStyle}" />
                        <TextBlock Text="Efectivo contado" Style="{StaticResource CardHeaderTextStyle}" />
                    </StackPanel>

                    <TextBlock Text="Declare únicamente el dinero físico contado en la gaveta."
                               Style="{StaticResource TextBlockBodySecondary}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource StackMd}" />

                    <TextBlock Text="Efectivo Contado en Gaveta ($):"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="{StaticResource StackXs}" />
                    <TextBox Text="{Binding SaldoDeclaradoEfectivo, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             FontFamily="{StaticResource FontFamilyNumeric}"
                             Typography.NumeralAlignment="Tabular"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Monto Retenido -->
            <Border Style="{StaticResource DialogSectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                        <iconPacks:PackIconBoxIcons Kind="RegularWallet" Style="{StaticResource CardHeaderIconStyle}" />
                        <TextBlock Text="Fondo para el próximo turno" Style="{StaticResource CardHeaderTextStyle}" />
                    </StackPanel>

                    <TextBlock Text="Monto Retenido en Caja para Próximo Turno ($):"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="{StaticResource StackXs}" />
                    <TextBox Text="{Binding MontoRetenidoEnCaja, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             FontFamily="{StaticResource FontFamilyNumeric}"
                             Typography.NumeralAlignment="Tabular"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Botonera Inferior -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinWidth="100"
                        DockPanel.Dock="Left"
                        IsCancel="True"
                        Click="Cancelar_Click" />

                <Button Style="{StaticResource DangerActionButtonStyle}"
                        DockPanel.Dock="Right"
                        IsDefault="True"
                        Click="Aceptar_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularLock" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Confirmar Cierre" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
