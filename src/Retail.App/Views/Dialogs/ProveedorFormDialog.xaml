<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ProveedorFormDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:components="clr-namespace:Retail.App.Views.Components"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="{Binding TituloVentana}"
                   Width="480"
                   Height="484"
                   MinWidth="440"
                   MinHeight="424"
                   WindowStartupLocation="CenterOwner"
                   ExtendsContentIntoTitleBar="True"
                   Background="{DynamicResource DialogBackgroundBrush}"
                   ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="{Binding TituloVentana}" />

        <!-- Contenido Central -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Grupo de Datos del Distribuidor -->
                <Border Style="{StaticResource DialogSectionStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Razón Social -->
                        <TextBlock Text="Razón Social *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Distribuidora Papelera Austral S.A."
                                    Margin="0,0,0,12" />

                        <!-- CUIT -->
                        <TextBlock Text="CUIT (11 dígitos numéricos) *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Cuit, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. 30712345678"
                                    FontFamily="{StaticResource FontFamilyMonospace}"
                                    Margin="0,0,0,12" />

                        <!-- Teléfono -->
                        <TextBlock Text="Teléfono de Contacto"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. +54 11 4321-9876"
                                    Margin="0,0,0,12" />

                        <!-- Email -->
                        <TextBlock Text="Correo Electrónico"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. ventas@austral.com.ar" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,10,0"
                        IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding GuardarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        
                        <TextBlock Text="Guardar Proveedor" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
