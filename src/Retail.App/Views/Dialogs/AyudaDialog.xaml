<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.AyudaDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   xmlns:components="clr-namespace:Retail.App.Views.Components"
                   Title="Ayuda y Soporte"
                   Width="580"
                   MinWidth="520"
                   MinHeight="0"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   ExtendsContentIntoTitleBar="True"
                   Background="{DynamicResource DialogBackgroundBrush}"
                   ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Fila 0: Barra de título con EncabezadoDialogo -->
            <RowDefinition Height="Auto" />
            <!-- Fila 1: Contenido scrollable de tarjetas de ayuda -->
            <RowDefinition Height="*" />
            <!-- Fila 2: Pie del diálogo con versión y botón Entendido -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título estandarizada del sistema de diseño (Esc cierra el diálogo) -->
        <components:EncabezadoDialogo Titulo="{Binding Titulo}" />

        <!-- Cuerpo del diálogo -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="520"
                      Padding="12,0,12,12">
            <StackPanel>
                <!-- Aviso de error en caso de fallo al abrir el PDF -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="{StaticResource StackMd}"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Tarjeta 1: Manual de Usuario en PDF -->
                <Border Style="{StaticResource DialogSectionStyle}"
                        Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                            <iconPacks:PackIconBoxIcons Kind="RegularBookOpen" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Manual de Usuario en PDF" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <TextBlock Text="Consulte la guía completa de operación de mostrador, apertura y cierre de caja, control de inventario y facturación."
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource StackMd}" />

                        <Button Command="{Binding AbrirManualPdfCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconBoxIcons Kind="RegularBookOpen"
                                                            Width="16"
                                                            Height="16"
                                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="Abrir Manual de Usuario"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Atajos Rápidos de Mostrador -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                            <iconPacks:PackIconBoxIcons Kind="RegularHelpCircle" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Atajos Rápidos de Mostrador" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <TextBlock Text="Teclas rápidas asignadas para agilizar la atención comercial sin depender del ratón:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource StackSm}" />

                        <ItemsControl ItemsSource="{Binding Atajos}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource SurfaceBorderSubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="4,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Pastilla Keycap -->
                                            <Border Grid.Column="0"
                                                    Style="{StaticResource KeycapBadgeStyle}"
                                                    HorizontalAlignment="Left"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding Tecla}"
                                                           Style="{StaticResource TextBlockKeycap}"
                                                           HorizontalAlignment="Center" />
                                            </Border>

                                            <!-- Nombre de la Acción -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Accion}"
                                                       Style="{StaticResource TextBlockBody}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />

                                            <!-- Detalle explicativo -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Detalle}"
                                                       Style="{StaticResource TextBlockBodySecondary}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pie del Diálogo (DialogFooterStyle) -->
        <Border Grid.Row="2"
                Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="True">
                <!-- Botón de Cierre (IsDefault para responder a Enter) -->
                <Button Command="{Binding CerrarCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        DockPanel.Dock="Right"
                        Padding="16,8"
                        IsDefault="True"
                        Content="Entendido" />

                <!-- Información de versión y cátedra -->
                <TextBlock Text="{Binding VersionInfo}"
                           Style="{StaticResource TextBlockBodySecondary}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

