<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.PresentacionFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="Nueva Presentación de Venta"
                  Width="540"
                  Height="640"
                  MinWidth="500"
                  MinHeight="560"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="Nueva Presentación de Venta"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       IsHitTestVisible="False" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Grupo 1: Artículo de origen (solo lectura) -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <iconPacks:PackIconBoxIcons Kind="RegularPackage"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="Artículo de Origen (se compra)"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding DescripcionOrigen}"
                                   Style="{StaticResource TextBlockBody}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Costo: "
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CostoOrigen, StringFormat={}{0:C2}}"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <TextBlock Text="Stock: "
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StockOrigen, StringFormat={}{0} unid.}"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Grupo 2: Datos de la presentación -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Presentación (se vende)"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Descripción *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Sobre manila A4 (unidad)"
                                    Margin="0,0,0,12" />

                        <TextBlock Text="Código de Barras (Opcional)"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. 7791234567890"
                                    FontFamily="{StaticResource FontFamilyMonospace}"
                                    Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unidades por origen *"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding UnidadesPorOrigen, UpdateSourceTrigger=PropertyChanged}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="100" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Margen (%)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding PorcentajeGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="40.00" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Stock mínimo"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="La presentación arranca sin stock: recibe unidades al fraccionar el artículo de origen."
                                   Style="{StaticResource TextBlockCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Grupo 3: Vista previa de costo y precio -->
                <Border Background="{DynamicResource PrimaryLightBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,10">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock Text="COSTO UNITARIO"
                                       Foreground="{DynamicResource PrimaryPressedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding CostoUnitarioCalculado, StringFormat={}$ {0:N2}}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       Foreground="{DynamicResource PrimaryPressedBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="PRECIO DE VENTA"
                                       Foreground="{DynamicResource PrimaryPressedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding PrecioVentaCalculado, StringFormat={}$ {0:N2}}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        Width="100" />

                <Button Content="Crear Presentación"
                        Click="BtnGuardar_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        DockPanel.Dock="Right"
                        Padding="16,8" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
