<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.FraccionarDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="Fraccionar Artículo de Origen"
                  Width="480"
                  Height="564"
                  MinWidth="440"
                  MinHeight="524"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Fraccionar Artículo de Origen" />

        <Border Grid.Row="1" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="{StaticResource InsetCompact}"
                        Margin="{StaticResource StackMd}"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Sección 1: cantidad a fraccionar -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularCut" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Cantidad a Fraccionar" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <TextBlock Text="{Binding UnidadesPorOrigen, StringFormat={}Cada unidad del origen se abre en {0} unidades de la presentación.}"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource StackMd}" />

                        <TextBlock Text="Unidades del origen a abrir *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ui:TextBox Text="{Binding CantidadOrigen, UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="{StaticResource FontFamilyNumeric}"
                                    Typography.NumeralAlignment="Tabular"
                                    PlaceholderText="1" />
                    </StackPanel>
                </Border>

                <!-- Vista previa: stocks antes y después -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularPackage" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Stock Antes y Después" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding DescripcionOrigen}"
                                   Style="{StaticResource TextBlockBody}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,8">
                            <iconPacks:PackIconBoxIcons Kind="RegularPackage" Width="12" Height="12"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Margin="{StaticResource InlineXs}" VerticalAlignment="Center" />
                            <TextBlock Text="Origen" Style="{StaticResource TextBlockCaption}" />
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                   VerticalAlignment="Top"
                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                   Typography.NumeralAlignment="Tabular"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding StockOrigen, Mode=OneWay}" />
                            <Run Text=" → " />
                            <Run Text="{Binding StockOrigenResultante, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{Binding DescripcionDerivado}"
                                   Style="{StaticResource TextBlockBody}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,0">
                            <iconPacks:PackIconBoxIcons Kind="RegularCut" Width="12" Height="12"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Margin="{StaticResource InlineXs}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UnidadesResultantes, StringFormat={}Presentación (+{0} unid.)}"
                                       Style="{StaticResource TextBlockCaption}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.RowSpan="2" Grid.Column="1"
                                   VerticalAlignment="Top"
                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                   Typography.NumeralAlignment="Tabular"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}">
                            <Run Text="{Binding StockDerivado, Mode=OneWay}" />
                            <Run Text=" → " />
                            <Run Text="{Binding StockDerivadoResultante, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        IsCancel="True"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Button IsDefault="True"
                        Click="BtnConfirmar_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCut" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Fraccionar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
