<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.IncorporarArticulosModalDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    Title="Confirmar Incorporación de Artículos a Tienda"
                    Width="880"
                    Height="640"
                    MinWidth="720"
                    MinHeight="500"
                    WindowStartupLocation="CenterOwner"
                    ExtendsContentIntoTitleBar="True"
                    WindowBackdropType="Mica"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    ResizeMode="CanResizeWithGrip">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                          Padding="8,0"
                          Background="{DynamicResource SurfaceBackgroundBrush}"
                          ShowMaximize="True"
                          CanMaximize="True" />
            <TextBlock Text="Confirmar Incorporación de Artículos a Tienda"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Contenido Central -->
        <Grid Grid.Row="1" Margin="24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Alerta de Validación -->
            <Border Grid.Row="0"
                    Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerForegroundBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Parámetros Generales / Margen Global -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Margen Global + Botón Aplicar -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="% Ganancia Global"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding AplicarGananciaGlobalCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    Padding="10,6"
                                    Margin="8,0,0,0"
                                    ToolTip="Aplicar este porcentaje a todos los artículos seleccionados">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Aplicar a todos" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ui:TextBox Text="{Binding PorcentajeGananciaGlobal, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"
                                        FontFamily="{StaticResource FontFamilyMonospace}"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Height="34" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Categoría Destino -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Categoría Destino (Opcional)"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CategoriasDisponibles}"
                                  DisplayMemberPath="NombreCategoria"
                                  SelectedValuePath="IdCategoria"
                                  SelectedValue="{Binding IdCategoriaDestino}"
                                  Height="34" />
                    </StackPanel>

                    <!-- Marca Destino -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Marca Destino (Opcional)"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding MarcasDisponibles}"
                                  DisplayMemberPath="NombreMarca"
                                  SelectedValuePath="IdMarca"
                                  SelectedValue="{Binding IdMarcaDestino}"
                                  Height="34" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grilla Interactiva de Artículos Seleccionados -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0">
                <DataGrid ItemsSource="{Binding Items}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          BorderThickness="0">
                    <DataGrid.Columns>

                        <!-- Código Proveedor -->
                        <DataGridTemplateColumn Header="Cód. Proveedor" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CodigoProveedor}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Código Barras -->
                        <DataGridTextColumn Header="Cód. Barras"
                                            Binding="{Binding CodigoBarras}"
                                            ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                            Width="120"
                                            IsReadOnly="True" />

                        <!-- Descripción -->
                        <DataGridTextColumn Header="Descripción"
                                            Binding="{Binding Descripcion}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*"
                                            IsReadOnly="True" />

                        <!-- Costo Reposición -->
                        <DataGridTextColumn Header="Costo Reposición"
                                            Binding="{Binding CostoReposicion, StringFormat=C2}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="130"
                                            IsReadOnly="True" />

                        <!-- % Ganancia Editable -->
                        <DataGridTemplateColumn Header="% Ganancia" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PorcentajeGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"
                                             FontFamily="{StaticResource FontFamilyMonospace}"
                                             FontSize="13"
                                             TextAlignment="Right"
                                             Padding="4,2"
                                             Height="28"
                                             VerticalContentAlignment="Center"
                                             Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Precio Venta Final Calculado -->
                        <DataGridTemplateColumn Header="Precio Venta Final" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrecioVenta, StringFormat=C2}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="10,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </Grid>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="True">
                <!-- Conteo Total -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Artículos a incorporar:"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding TotalArticulos}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>

                <!-- Botones de Acción -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelarCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Margin="0,0,10,0"
                            IsCancel="True">
                        <StackPanel Orientation="Horizontal">
                            
                            <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AceptarCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            
                            <TextBlock Text="Confirmar Incorporación" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>