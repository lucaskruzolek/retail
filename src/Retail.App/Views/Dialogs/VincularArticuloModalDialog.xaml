<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.VincularArticuloModalDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="Vincular a Artículo Existente"
                   Width="580"
                   Height="540"
                   MinWidth="520"
                   MinHeight="480"
                   WindowStartupLocation="CenterOwner"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica"
                   Background="{DynamicResource SurfaceBackgroundBrush}"
                   ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="Vincular Ítem a Artículo de Tienda"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Contenido Central -->
        <Grid Grid.Row="1" Margin="20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Tarjeta resumen del ítem mayorista -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Ítem del Catálogo Mayorista" Style="{StaticResource TextBlockCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ItemCatalogo.DescripcionProveedor}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Código Prov: " Style="{StaticResource TextBlockBodySecondary}" FontSize="12" />
                        <TextBlock Text="{Binding ItemCatalogo.CodigoProveedor}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Text="Costo Reposición: " Style="{StaticResource TextBlockBodySecondary}" FontSize="12" />
                        <TextBlock Text="{Binding ItemCatalogo.CostoReposicion, StringFormat={}{0:C2}}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Buscador de artículos -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            Text="{Binding FiltroBusqueda, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Buscar por código de barras o descripción..."
                            Margin="0,0,8,0">
                    <ui:TextBox.Icon>
                        <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                      Width="16" Height="16" />
                    </ui:TextBox.Icon>
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding BuscarArticulosCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <Button Grid.Column="1"
                        Command="{Binding BuscarArticulosCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Buscar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 3. Resultados de búsqueda -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">
                <DataGrid ItemsSource="{Binding ResultadosBusqueda}"
                          SelectedItem="{Binding ArticuloSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cód. Barras"
                                             Binding="{Binding CodigoBarras}"
                                             ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                             Width="120" />
                        <DataGridTextColumn Header="Descripción en Tienda"
                                             Binding="{Binding Descripcion}"
                                             ElementStyle="{StaticResource TextBlockTextCell}"
                                             Width="*" />
                        <DataGridTextColumn Header="Precio Venta"
                                             Binding="{Binding PrecioVenta, StringFormat={}{0:C2}}"
                                             ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                             Width="100" />
                        <DataGridTextColumn Header="Stock"
                                             Binding="{Binding StockActual}"
                                             ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                             Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,10,0"
                        IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        
                        <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding AceptarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                       
                        <TextBlock Text="Confirmar Vinculación" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
