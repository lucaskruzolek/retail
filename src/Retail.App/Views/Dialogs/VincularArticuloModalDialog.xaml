<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.VincularArticuloModalDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:components="clr-namespace:Retail.App.Views.Components"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="Vincular a Artículo Existente"
                   Width="580"
                   Height="624"
                   MinWidth="520"
                   MinHeight="504"
                   WindowStartupLocation="CenterOwner"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica"
                   Background="{DynamicResource DialogBackgroundBrush}"
                   ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Vincular Ítem a Artículo de Tienda" />

        <!-- Contenido Central -->
        <Grid Grid.Row="1" Margin="20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Tarjeta resumen del ítem mayorista -->
            <Border Grid.Row="0" Style="{StaticResource DialogSectionStyle}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Ítem del Catálogo Mayorista" Style="{StaticResource TextBlockCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ItemCatalogo.DescripcionProveedor}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Código Prov: " Style="{StaticResource TextBlockBodySecondary}" FontSize="12" />
                        <TextBlock Text="{Binding ItemCatalogo.CodigoProveedor}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Text="Costo Reposición: " Style="{StaticResource TextBlockBodySecondary}" FontSize="12" />
                        <TextBlock Text="{Binding ItemCatalogo.CostoReposicion, StringFormat={}{0:C2}}" FontFamily="{StaticResource FontFamilyNumeric}" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Buscador de artículos -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Buscar por código de barras o descripción..."
                            Margin="0,0,8,0">
                    <ui:TextBox.Icon>
                        <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                      Width="16" Height="16" />
                    </ui:TextBox.Icon>
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding BuscarArticulosCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <Button Grid.Column="1"
                        Command="{Binding BuscarArticulosCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Buscar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 3. Resultados de búsqueda -->
            <Border Grid.Row="2"
                    Style="{StaticResource DialogSectionStyle}"
                    Padding="0">
                <DataGrid ItemsSource="{Binding ArticulosEncontrados}"
                          SelectedItem="{Binding ArticuloSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cód. Barras"
                                             Binding="{Binding CodigoBarras}"
                                             ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                             Width="120" />
                        <DataGridTextColumn Header="Descripción en Tienda"
                                             Binding="{Binding Descripcion}"
                                             ElementStyle="{StaticResource TextBlockTextCell}"
                                             Width="*" />
                        <DataGridTextColumn Header="Precio Venta"
                                             HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                             Binding="{Binding PrecioVenta, StringFormat={}{0:C2}}"
                                             ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                             Width="100" />
                        <DataGridTextColumn Header="Stock"
                                             HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                             Binding="{Binding StockActual}"
                                             ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                             Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. Rol de la fuente (Track 4.3, J4): adicional por defecto; la principal fija costo y precio (A-2) -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <CheckBox Content="Usar como fuente principal"
                          IsChecked="{Binding ComoPrincipal, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="La planilla de la fuente principal fija el costo y el precio del artículo. Si el artículo todavía no tiene una, este ítem lo será aunque no lo marque."
                           Style="{StaticResource TextBlockCaptionSecondary}"
                           TextWrapping="Wrap"
                           Margin="28,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,10,0"
                        IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        
                        <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding AceptarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                       
                        <TextBlock Text="Confirmar Vinculación" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
