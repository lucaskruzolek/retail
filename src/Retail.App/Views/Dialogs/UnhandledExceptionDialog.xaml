<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.UnhandledExceptionDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Incidencia en el Sistema - Retail POS"
                 Width="660"
                 Height="564"
                 MinWidth="560"
                 MinHeight="484"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Aviso de Incidencia - Retail POS" />

        <!-- ============================================================= -->
        <!-- CONTENIDO PRINCIPAL                                           -->
        <!-- ============================================================= -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,0,12,12">
            <StackPanel>
                <!-- Tarjeta de Advertencia Semántica de Peligro -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="{StaticResource StackMd}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                    Kind="RegularAlertCircle"
                                                    Width="36"
                                                    Height="36"
                                                    Foreground="{DynamicResource DangerForegroundBrush}"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTituloAlerta"
                                       Text="Ocurrió una incidencia inesperada"
                                       FontSize="{StaticResource FontSizeLg}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       Margin="{StaticResource StackXs}" />
                            <TextBlock x:Name="TxtMensajeOperador"
                                       Text="La operación en curso no pudo completarse. Para proteger la integridad de los datos de mostrador, el sistema continuará ejecutándose normalmente."
                                       FontSize="{StaticResource FontSizeBase}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Información del Archivo de Log -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                            <iconPacks:PackIconBoxIcons Kind="RegularFile" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Registro de auditoría local (log)" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="TxtLogFilePath"
                                   Text="logs/retail-YYYYMMDD.log"
                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Panel de Detalles Técnicos -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                            <iconPacks:PackIconBoxIcons Kind="RegularBug" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Diagnóstico técnico para soporte" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="TxtExceptionType"
                                   Text="System.Exception"
                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                   Margin="{StaticResource StackXs}" />

                        <TextBlock x:Name="TxtExceptionMessage"
                                   Text="Mensaje del error..."
                                   FontSize="{StaticResource FontSizeBase}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="{StaticResource StackMd}" />

                        <TextBox x:Name="TxtStackTrace"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Height="120"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeXs}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================= -->
        <!-- BARRA INFERIOR DE ACCIONES                                    -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel>
                <!-- Botón de Copiar Detalle Técnico -->
                <Button x:Name="BtnCopiarDetalles"
                        Click="BtnCopiarDetalles_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCopy"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="{StaticResource InlineSm}"
                                                    VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtBtnCopiar" Text="Copiar Detalle Técnico" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Botones de Continuar / Salir -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCerrarApp"
                            Click="BtnCerrarApp_Click"
                            Visibility="Collapsed"
                            Style="{StaticResource DangerActionButtonStyle}"
                            Margin="{StaticResource InlineSm}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                            <TextBlock Text="Cerrar Aplicación" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnContinuar"
                            Click="BtnContinuar_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                            <TextBlock Text="Continuar Operando" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
