<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.UnhandledExceptionDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Incidencia en el Sistema - Retail POS"
                 Width="660"
                 Height="540"
                 MinWidth="560"
                 MinHeight="460"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource SurfaceBackgroundBrush}"
                 ResizeMode="CanResizeWithGrip">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- BARRA SUPERIOR CON TÍTULO FLUENT                              -->
        <!-- ============================================================= -->
        <ui:TitleBar Grid.Row="0"
                     Title="Aviso de Incidencia - Retail POS"
                     Padding="8,0,0,0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource DangerForegroundBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============================================================= -->
        <!-- CONTENIDO PRINCIPAL                                           -->
        <!-- ============================================================= -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,12,24,12">
            <StackPanel>
                <!-- Tarjeta de Advertencia Semántica de Peligro -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="ErrorCircle24"
                                       FontSize="36"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTituloAlerta"
                                       Text="Ocurrió una incidencia inesperada"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtMensajeOperador"
                                       Text="La operación en curso no pudo completarse. Para proteger la integridad de los datos de mostrador, el sistema continuará ejecutándose normalmente."
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tarjeta con Información del Archivo de Log -->
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Registro de Auditoría Local (Log):"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6">
                            <TextBlock x:Name="TxtLogFilePath"
                                       Text="logs/retail-YYYYMMDD.log"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Panel de Detalles Técnicos -->
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="14"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Diagnóstico Técnico para Soporte:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock x:Name="TxtExceptionType"
                                   Text="System.Exception"
                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                   Margin="0,0,0,4" />

                        <TextBlock x:Name="TxtExceptionMessage"
                                   Text="Mensaje del error..."
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <TextBox x:Name="TxtStackTrace"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Height="120"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="11"
                                 Background="{DynamicResource SurfaceBackgroundBrush}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 BorderBrush="{DynamicResource SurfaceBorderBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================= -->
        <!-- BARRA INFERIOR DE ACCIONES                                    -->
        <!-- ============================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel>
                <!-- Botón de Copiar Detalle Técnico -->
                <Button x:Name="BtnCopiarDetalles"
                        Click="BtnCopiarDetalles_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentCopy24"
                                       FontSize="16"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtBtnCopiar" Text="Copiar Detalle Técnico" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Botones de Continuar / Salir -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCerrarApp"
                            Click="BtnCerrarApp_Click"
                            Visibility="Collapsed"
                            Style="{StaticResource KeycapButtonStyle}"
                            Margin="0,0,8,0">
                        <TextBlock Text="Cerrar Aplicación" Foreground="{DynamicResource DangerForegroundBrush}" />
                    </Button>

                    <Button x:Name="BtnContinuar"
                            Click="BtnContinuar_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Continuar Operando" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
