<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.SeleccionarCatalogoProveedorModalDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="Seleccionar Ítem de Catálogo Mayorista"
                  Width="860"
                  Height="560"
                  MinWidth="740"
                  MinHeight="480"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="CanResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="True"
                         CanMaximize="True" />
            <TextBlock Text="Seleccionar Ítem de Catálogo Mayorista"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Contenido Central -->
        <Grid Grid.Row="1" Margin="20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Alerta de Validación / Error -->
            <Border Grid.Row="0"
                    Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerForegroundBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Barra de Filtros y Búsqueda -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Selector de Proveedor -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Proveedores}"
                          SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay}"
                          DisplayMemberPath="RazonSocial"
                          Height="35"
                          VerticalAlignment="Center" />

                <!-- Buscador de texto o código -->
                <ui:TextBox Grid.Column="2"
                            Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Buscar por código de proveedor, barras o descripción..."
                            VerticalAlignment="Center">
                    <ui:TextBox.Icon>
                        <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                      Width="16" Height="16" />
                    </ui:TextBox.Icon>
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding BuscarCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <!-- Botón Buscar -->
                <Button Grid.Column="4"
                        Command="{Binding BuscarCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Buscar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Grilla de Ítems del Catálogo Mayorista -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid ItemsSource="{Binding ItemsCatalogo}"
                          SelectedItem="{Binding ItemSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          RowStyle="{StaticResource DataGridRowRetailStyle}"
                          CellStyle="{StaticResource DataGridCellRetailStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="OnDataGridMouseDoubleClick">
                    <DataGrid.Columns>
                        <!-- Distribuidor -->
                        <DataGridTextColumn Header="Distribuidor"
                                            Binding="{Binding ProveedorRazonSocial}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="160" />

                        <!-- Código Proveedor -->
                        <DataGridTextColumn Header="Cód. Prov."
                                            Binding="{Binding CodigoProveedor}"
                                            ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                            Width="105" />

                        <!-- Código de Barras -->
                        <DataGridTextColumn Header="Cód. Barras"
                                            Binding="{Binding CodigoBarras}"
                                            ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                            Width="120" />

                        <!-- Descripción Mayorista -->
                        <DataGridTextColumn Header="Descripción del Proveedor"
                                            Binding="{Binding DescripcionProveedor}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*" />

                        <!-- Costo Reposición -->
                        <DataGridTextColumn Header="Costo ($)"
                                            Binding="{Binding CostoReposicion, StringFormat={}{0:N2}}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="100" />

                        <!-- Estado Vinculación -->
                        <DataGridTemplateColumn Header="Estado" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Caso: Disponible -->
                                        <Border Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccessStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstaVinculado}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Disponible"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        </Border>

                                        <!-- Caso: Ya Vinculado -->
                                        <Border Style="{StaticResource BadgeWarningStyle}"
                                                Padding="6,2"
                                                Visibility="{Binding EstaVinculado, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="En uso en tienda"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Click="OnCancelarClick"
                        Content="Cancelar (Esc)"
                        Style="{StaticResource KeycapButtonStyle}"
                        Padding="16,8" />

                <Button DockPanel.Dock="Right"
                        Click="OnSeleccionarClick"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Seleccionar y Vincular" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
