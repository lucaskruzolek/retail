<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ConfirmarCredencialDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  Title="Confirmar con contraseña"
                  Width="500"
                  MinWidth="440"
                  MinHeight="0"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="{Binding Titulo}" />

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
            <StackPanel>
                <!-- Error (contraseña incorrecta, palabra de confirmación faltante) -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="{StaticResource StackMd}"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Aviso destacado (restauración: conciliación fiscal con ARCA) -->
                <Border Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="{StaticResource StackMd}"
                        Visibility="{Binding TieneAviso, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding Aviso}"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularKey" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Confirmación" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <!-- Qué va a pasar -->
                        <TextBlock Text="{Binding Mensaje}"
                                   Style="{StaticResource TextBlockBody}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource StackMd}" />

                        <!-- Palabra de confirmación (solo restauración) -->
                        <StackPanel Visibility="{Binding ExigeFrase, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Escriba RESTAURAR para confirmar" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                            <ui:TextBox Text="{Binding Frase, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="RESTAURAR"
                                        TabIndex="0"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Margin="{StaticResource StackMd}" />
                        </StackPanel>

                        <!-- Contraseña del Administrador que ejecuta (solo restauración autorizada, D-33) -->
                        <StackPanel Visibility="{Binding PideUsuarioAutorizante, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Su contraseña (Administrador)" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                            <ui:PasswordBox x:Name="TxtPasswordActor"
                                            PasswordChanged="TxtPasswordActor_PasswordChanged"
                                            PlaceholderText="Su contraseña"
                                            TabIndex="1"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Margin="{StaticResource StackMd}" />
                        </StackPanel>

                        <!-- Usuario del Gerente que autoriza (solo restauración ejecutada por un Administrador, D-30) -->
                        <StackPanel Visibility="{Binding PideUsuarioAutorizante, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Usuario del Gerente que autoriza" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                            <ui:TextBox x:Name="TxtUsuarioAutorizante"
                                        Text="{Binding NombreUsuarioAutorizante, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Usuario del Gerente"
                                        TabIndex="2"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Margin="{StaticResource StackMd}" />
                        </StackPanel>

                        <!-- Contraseña (propia, o la del Gerente que autoriza) -->
                        <TextBlock Text="{Binding EtiquetaPassword}" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                        <ui:PasswordBox x:Name="TxtPassword"
                                        PasswordChanged="TxtPassword_PasswordChanged"
                                        PlaceholderText="{Binding PlaceholderPassword}"
                                        TabIndex="3"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Margin="{StaticResource StackMd}" />
                    </StackPanel>
                </Border>

                <!-- Progreso de la operación -->
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progreso, Mode=OneWay}" Height="8" />
                    <TextBlock Style="{StaticResource TextBlockCaptionSecondary}" Margin="0,8,0,0">
                        <Run Text="{Binding Progreso, Mode=OneWay}" /><Run Text="% completado" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsCancel="True"
                        Style="{StaticResource KeycapButtonStyle}"
                        DockPanel.Dock="Left"
                        MinWidth="100" />
                <Button Click="BtnConfirmar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource DangerActionButtonStyle}"
                        DockPanel.Dock="Right"
                        Visibility="{Binding EsDestructiva, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TextoBoton}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="BtnConfirmar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right"
                        Visibility="{Binding NoEsDestructiva, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TextoBoton}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>