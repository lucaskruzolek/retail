<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ConfirmarCredencialDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  Title="Confirmar con contraseña"
                  Width="500"
                  MinWidth="440"
                  MinHeight="0"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="{Binding Titulo}" />

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Error (contraseña incorrecta, palabra de confirmación faltante) -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Qué va a pasar -->
                <TextBlock Text="{Binding Mensaje}"
                           Style="{StaticResource TextBlockBody}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- Aviso destacado (restauración: conciliación fiscal con ARCA) -->
                <Border Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding TieneAviso, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding Aviso}"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Palabra de confirmación (solo restauración) -->
                <StackPanel Visibility="{Binding ExigeFrase, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Escriba RESTAURAR para confirmar" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Frase, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="RESTAURAR"
                                TabIndex="0"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,0,10" />
                </StackPanel>

                <!-- Contraseña del Administrador que ejecuta (solo restauración autorizada, D-33) -->
                <StackPanel Visibility="{Binding PideUsuarioAutorizante, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Su contraseña (Administrador)" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="TxtPasswordActor"
                                    PasswordChanged="TxtPasswordActor_PasswordChanged"
                                    PlaceholderText="Su contraseña"
                                    TabIndex="1"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Margin="0,0,0,10" />
                </StackPanel>

                <!-- Usuario del Gerente que autoriza (solo restauración ejecutada por un Administrador, D-30) -->
                <StackPanel Visibility="{Binding PideUsuarioAutorizante, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Usuario del Gerente que autoriza" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="TxtUsuarioAutorizante"
                                Text="{Binding NombreUsuarioAutorizante, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Usuario del Gerente"
                                TabIndex="2"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,0,10" />
                </StackPanel>

                <!-- Contraseña (propia, o la del Gerente que autoriza) -->
                <TextBlock Text="{Binding EtiquetaPassword}" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:PasswordBox x:Name="TxtPassword"
                                PasswordChanged="TxtPassword_PasswordChanged"
                                PlaceholderText="{Binding PlaceholderPassword}"
                                TabIndex="3"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,0,10" />

                <!-- Progreso de la operación -->
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progreso, Mode=OneWay}" Height="6" />
                    <TextBlock Style="{StaticResource TextBlockCaptionSecondary}" Margin="0,6,0,0">
                        <Run Text="{Binding Progreso, Mode=OneWay}" /><Run Text="% completado" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsCancel="True"
                        Style="{StaticResource KeycapButtonStyle}"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Width="100" />
                <Button Content="{Binding TextoBoton}"
                        Click="BtnConfirmar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource DangerActionButtonStyle}"
                        DockPanel.Dock="Right"
                        Width="150"
                        Visibility="{Binding EsDestructiva, Converter={StaticResource BoolToVisConverter}}" />
                <Button Content="{Binding TextoBoton}"
                        Click="BtnConfirmar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right"
                        Width="150"
                        Visibility="{Binding NoEsDestructiva, Converter={StaticResource BoolToVisConverter}}" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
