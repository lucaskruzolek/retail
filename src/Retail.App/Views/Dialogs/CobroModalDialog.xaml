<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.CobroModalDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="Checkout y Cobro Multimedio"
                   Width="560"
                   Height="680"
                   MinWidth="520"
                   MinHeight="640"
                   WindowStartupLocation="CenterOwner"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica"
                   Background="{DynamicResource SurfaceBackgroundBrush}"
                   ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada (Título Centrado y Estilizado) -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="Checkout y Cobro Multimedio"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Contenido Central Scrollable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,12">
            <StackPanel>
                <!-- Alerta de Error si la hubiera -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding MensajeError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Tarjeta 1: Desglose del Total y Saldo Pendiente -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL A COBRAR"
                                       Style="{StaticResource TextBlockCaptionSecondary}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalVentaFormateado}"
                                       Style="{StaticResource TextBlockDisplayCurrency}"
                                       FontSize="28"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Cliente.RazonSocialONombre, FallbackValue='Consumidor Final', TargetNullValue='Consumidor Final'}"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Pastilla de Saldo Pendiente -->
                        <Border Grid.Column="1"
                                CornerRadius="6"
                                Padding="14,8"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1">
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="SALDO PENDIENTE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SaldoPendienteFormateado}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tarjeta 2: Selección del Medio de Pago e Imputación -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Medio de Pago" Style="{StaticResource TextBlockHeader2}" Margin="0,0,0,8" />

                        <!-- Selector de Medios de Pago -->
                        <ComboBox ItemsSource="{Binding MediosPagoDisponibles}"
                                  SelectedItem="{Binding MedioPagoSeleccionado, Mode=TwoWay}"
                                  Margin="0,0,0,12" />

                        <!-- Monto a Imputar -->
                        <TextBlock Text="Monto a Cancelar" Style="{StaticResource TextBlockCaptionSecondary}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding MontoImputar, UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="{StaticResource FontFamilyMonospace}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,12" />

                        <!-- VISTA DINÁMICA: Efectivo -->
                        <StackPanel Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Billetes Rápidos (Efectivo Recibido)" Style="{StaticResource TextBlockCaptionSecondary}" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Command="{Binding EstablecerPagoExactoCommand}"
                                        Style="{StaticResource KeycapButtonStyle}"
                                        Content="Exacto"
                                        Padding="10,6"
                                        Margin="0,0,6,6" />
                                <Button Command="{Binding SumarMilCommand}"
                                        Style="{StaticResource KeycapButtonStyle}"
                                        Content="+$1.000"
                                        Padding="10,6"
                                        Margin="0,0,6,6" />
                                <Button Command="{Binding SumarDosMilCommand}"
                                        Style="{StaticResource KeycapButtonStyle}"
                                        Content="+$2.000"
                                        Padding="10,6"
                                        Margin="0,0,6,6" />
                                <Button Command="{Binding SumarCincoMilCommand}"
                                        Style="{StaticResource KeycapButtonStyle}"
                                        Content="+$5.000"
                                        Padding="10,6"
                                        Margin="0,0,6,6" />
                                <Button Command="{Binding SumarDiezMilCommand}"
                                        Style="{StaticResource KeycapButtonStyle}"
                                        Content="+$10.000"
                                        Padding="10,6"
                                        Margin="0,0,6,6" />
                                <Button Command="{Binding SumarVeinteMilCommand}"
                                        Style="{StaticResource KeycapButtonStyle}"
                                        Content="+$20.000"
                                        Padding="10,6"
                                        Margin="0,0,6,6" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Efectivo Recibido" Style="{StaticResource TextBlockCaptionSecondary}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding EfectivoRecibido, UpdateSourceTrigger=PropertyChanged}"
                                                FontFamily="{StaticResource FontFamilyMonospace}"
                                                FontSize="15"
                                                FontWeight="SemiBold" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource SuccessBackgroundBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,6"
                                        VerticalAlignment="Bottom">
                                    <StackPanel>
                                        <TextBlock Text="VUELTO A ENTREGAR"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessForegroundBrush}" />
                                        <TextBlock Text="{Binding VueltoFormateado}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessForegroundBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- VISTA DINÁMICA: Cuenta Corriente -->
                        <StackPanel Visibility="{Binding EsCuentaCorriente, Converter={StaticResource BoolToVisConverter}}">
                            <Border Background="{DynamicResource WarningBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Crédito Disponible de Cuenta Corriente"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningForegroundBrush}" />
                                    <TextBlock Text="{Binding CreditoDisponibleFormateado}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WarningForegroundBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Campo Referencia opcional para tarjetas o transferencias -->
                        <StackPanel Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisConverter}}">
                            <!-- No se muestra para efectivo -->
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Nº de Referencia / Cupón / Operación (Opcional)"
                                       Style="{StaticResource TextBlockCaptionSecondary}"
                                       Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding ReferenciaPago, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Ej. Cupón 8492 o ID Transferencia..." />
                        </StackPanel>

                        <!-- Botón Imputar Pago Parcial / Total -->
                        <Button Command="{Binding ImputarPagoCommand}"
                                Style="{StaticResource KeycapButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Imputar Pago al Ticket" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Lista de Pagos Imputados -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Pagos Registrados en esta Operación" Style="{StaticResource TextBlockHeader2}" Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding PagosImputados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,0,0,6">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Command="{Binding DataContext.RemoverPagoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KeycapButtonStyle}"
                                                    Padding="6,4">
                                                <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" Foreground="{DynamicResource DangerForegroundBrush}" />
                                            </Button>

                                            <StackPanel DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Monto, StringFormat={}${0:N2}}"
                                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MedioPago}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ReferenciaPago, FallbackValue='Sin referencia'}"
                                                           Style="{StaticResource TextBlockCaptionSecondary}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox IsChecked="{Binding ImprimirTicket, Mode=TwoWay}"
                                  Content="Imprimir ticket de venta oficial al confirmar (FileDebugTicketPrinterService)"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior de Confirmación -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Click="OnCancelarClick"
                        Content="Volver (Esc)"
                        Style="{StaticResource KeycapButtonStyle}"
                        Padding="16,8" />

                <Button DockPanel.Dock="Right"
                        Click="OnConfirmarClick"
                        IsEnabled="{Binding PuedeConfirmar}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="SolidReceipt" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Confirmar Cobro" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource KeycapPrimaryBadgeStyle}" Margin="8,0,0,0">
                            <TextBlock Text="F12" Style="{StaticResource TextBlockKeycap}" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
