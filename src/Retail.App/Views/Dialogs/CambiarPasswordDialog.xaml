<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.CambiarPasswordDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Restablecer Contraseña de Operador"
                  Width="450"
                  Height="380"
                  MinWidth="400"
                  MinHeight="340"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <ui:TitleBar Grid.Row="0"
                     Title="Restablecer Contraseña"
                     Padding="8,0,0,0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Password24" Foreground="{DynamicResource PrimaryBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>


                <!-- Info Operador -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Operador Seleccionado:" Style="{StaticResource TextBlockBodySecondary}" FontSize="12" />
                        <TextBlock Style="{StaticResource TextBlockHeader2}" Margin="0,2,0,0">
                            <Run Text="{Binding NombreCompleto, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text=" (" Foreground="{DynamicResource TextMutedBrush}" />
                            <Run Text="{Binding NombreUsuario, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" FontFamily="{StaticResource FontFamilyMonospace}" />
                            <Run Text=")" Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Nueva Contraseña -->
                <TextBlock Text="Nueva Contraseña" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:PasswordBox x:Name="TxtNuevaPassword"
                                PasswordChanged="TxtNuevaPassword_PasswordChanged"
                                PlaceholderText="Mínimo 6 caracteres"
                                Margin="0,0,0,14" />

                <!-- Confirmar Contraseña -->
                <TextBlock Text="Confirmar Nueva Contraseña" Style="{StaticResource TextBlockBodySecondary}" Margin="0,0,0,4" />
                <ui:PasswordBox x:Name="TxtConfirmarPassword"
                                PasswordChanged="TxtConfirmarPassword_PasswordChanged"
                                PlaceholderText="Repita la nueva contraseña"
                                Margin="0,0,0,14" />
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsCancel="True"
                        Style="{StaticResource KeycapButtonStyle}"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Width="100" />
                <Button Content="Restablecer"
                        Click="BtnGuardar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right"
                        Width="120" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
