<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.CambiarPasswordDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="Restablecer Contraseña de Operador"
                  Width="460"
                  MinWidth="400"
                  MinHeight="0"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="{Binding TituloVentana}" />

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="{StaticResource InsetCompact}"
                        Margin="{StaticResource StackLg}"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>


                <!-- Aviso de Cambio Obligatorio (solo al iniciar sesión) -->
                <Border Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="{StaticResource InsetCompact}"
                        Margin="{StaticResource StackLg}"
                        Visibility="{Binding EsCambioObligatorio, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Su contraseña fue asignada por otra persona. Elija una nueva para continuar."
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Sección 1: operador -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularUser" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Operador" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <TextBlock Text="{Binding EtiquetaOperador}" Style="{StaticResource TextBlockBodySecondary}" FontSize="{StaticResource FontSizeSm}" />
                        <TextBlock Style="{StaticResource TextBlockHeader2}" Margin="0,2,0,0">
                            <Run Text="{Binding NombreCompleto, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text=" (" Foreground="{DynamicResource TextMutedBrush}" />
                            <Run Text="{Binding NombreUsuario, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" FontFamily="{StaticResource FontFamilyMonospace}" />
                            <Run Text=")" Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Sección 2: contraseñas -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularKey" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Contraseña" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <!-- Contraseña Actual (solo en el cambio voluntario de la propia contraseña) -->
                        <StackPanel Visibility="{Binding RequierePasswordActual, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Contraseña Actual" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                            <ui:PasswordBox x:Name="TxtPasswordActual"
                                            PasswordChanged="TxtPasswordActual_PasswordChanged"
                                            PlaceholderText="Su contraseña vigente"
                                            Margin="{StaticResource StackMd}" />
                        </StackPanel>

                        <!-- Nueva Contraseña -->
                        <TextBlock Text="Nueva Contraseña" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                        <ui:PasswordBox x:Name="TxtNuevaPassword"
                                        PasswordChanged="TxtNuevaPassword_PasswordChanged"
                                        PlaceholderText="Mínimo 6 caracteres"
                                        Margin="{StaticResource StackMd}" />

                        <!-- Confirmar Contraseña -->
                        <TextBlock Text="Confirmar Nueva Contraseña" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                        <ui:PasswordBox x:Name="TxtConfirmarPassword"
                                        PasswordChanged="TxtConfirmarPassword_PasswordChanged"
                                        PlaceholderText="Repita la nueva contraseña" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsCancel="True"
                        Style="{StaticResource KeycapButtonStyle}" />
                <Button Click="BtnGuardar_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularKey" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TextoBotonGuardar}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
