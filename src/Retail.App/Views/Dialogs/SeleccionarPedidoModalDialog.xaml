<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.SeleccionarPedidoModalDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:helpers="clr-namespace:Retail.App.Helpers"
                 Title="Recibir pedido emitido"
                 Width="540"
                 Height="620"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

            <!-- Números alineados a la derecha, con su título sobre los dígitos -->
            <Style x:Key="CeldaNumericaDerecha" TargetType="TextBlock" BasedOn="{StaticResource TextBlockNumericCell}">
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título estandarizada del sistema de diseño -->
        <components:EncabezadoDialogo Grid.Row="0" Titulo="Recibir pedido emitido" />

        <!-- Sección: pedidos emitidos del proveedor -->
        <Border Grid.Row="1" Style="{StaticResource DialogSectionStyle}" Margin="12,0,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding RazonSocialProveedor, TargetNullValue='Pedidos emitidos de todos los proveedores'}" Style="{StaticResource CardHeaderTextStyle}" Grid.Row="0" Margin="{StaticResource StackMd}" />

                <TextBlock Grid.Row="1"
                           Text="Elija el pedido que llegó: sus artículos se cargan en la compra para que ajuste cantidades y costos según el comprobante."
                           Style="{StaticResource TextBlockBodySecondary}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource StackMd}" />

                <!-- La sección ya es la superficie: la grilla va sin borde propio ni esquinas -->
                <Grid Grid.Row="2">
                    <DataGrid ItemsSource="{Binding Pedidos}"
                              SelectedItem="{Binding PedidoSeleccionado, Mode=TwoWay}"
                              Style="{StaticResource DataGridRetailStyle}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              BorderThickness="0"
                              helpers:EsquinasHelper.Esquinas="0"
                              MouseDoubleClick="OnDataGridMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.º"
                                                Binding="{Binding IdPedido, StringFormat='#{0}'}"
                                                ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                                Width="84" />
                            <!-- Solo cuando hay pedidos de varios proveedores (sin proveedor elegido en la compra) -->
                            <DataGridTextColumn x:Name="ColumnaProveedor"
                                                Header="Proveedor"
                                                Binding="{Binding RazonSocialProveedor}"
                                                ElementStyle="{StaticResource TextBlockTextCell}"
                                                Width="*"
                                                MinWidth="180" />
                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding FechaEmision, StringFormat='dd/MM/yyyy'}"
                                                ElementStyle="{StaticResource TextBlockNumericCell}"
                                                Width="116" />
                            <DataGridTextColumn Header="Artículos"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                Binding="{Binding CantidadRenglones}"
                                                ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                Width="104" />
                            <DataGridTextColumn Header="Total est."
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                                Binding="{Binding TotalEstimado, StringFormat=C0}"
                                                ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                Width="*"
                                                MinWidth="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estados de la carga: en curso, sin pedidos o con error -->
                    <TextBlock Text="Cargando pedidos…"
                               Style="{StaticResource TextBlockBodySecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,32,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />

                    <TextBlock Text="No hay pedidos emitidos para recibir."
                               Style="{StaticResource TextBlockBodySecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,32,0,0"
                               Visibility="{Binding EstaVacio, Converter={StaticResource BoolToVisConverter}}" />

                    <Border Style="{StaticResource BadgeDangerStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,32,0,0"
                            Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding MensajeError}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Pie: Cancelar a la izquierda y la acción primaria (Enter) a la derecha -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Click="OnCancelarClick"
                        Style="{StaticResource KeycapButtonStyle}">
                    <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                </Button>

                <Button DockPanel.Dock="Right"
                        IsDefault="True"
                        IsEnabled="{Binding TienePedidoSeleccionado}"
                        Click="OnSeleccionarClick"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Recibir pedido" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
