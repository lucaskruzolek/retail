<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.SeleccionarPedidoModalDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:components="clr-namespace:Retail.App.Views.Components"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="Importar Pedido a Proveedor"
                   Width="640"
                   Height="520"
                   MinWidth="520"
                   MinHeight="420"
                   WindowStartupLocation="CenterOwner"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica"
                   Background="{DynamicResource DialogBackgroundBrush}"
                   ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título estandarizada del sistema de diseño -->
        <components:EncabezadoDialogo Grid.Row="0" Titulo="Importar Pedido a Proveedor" />

        <!-- Contenido central: grilla de pedidos emitidos -->
        <Grid Grid.Row="1" Margin="20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Seleccione un pedido emitido para precargar los renglones en la factura de compra:"
                       Style="{StaticResource TextBlockBodySecondary}"
                       Margin="0,0,0,12" />

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid ItemsSource="{Binding Pedidos}"
                          SelectedItem="{Binding PedidoSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          RowStyle="{StaticResource DataGridRowRetailStyle}"
                          CellStyle="{StaticResource DataGridCellRetailStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="OnDataGridMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nro. Pedido"
                                            Binding="{Binding IdPedido, StringFormat='#{0}'}"
                                            ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                            Width="110" />
                        <DataGridTextColumn Header="Fecha Emisión"
                                            Binding="{Binding FechaEmision, StringFormat='dd/MM/yyyy HH:mm'}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="160" />
                        <DataGridTextColumn Header="Renglones"
                                            Binding="{Binding CantidadRenglones}"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                            ElementStyle="{StaticResource TextBlockNumericCell}"
                                            Width="100" />
                        <DataGridTextColumn Header="Total Estimado"
                                            Binding="{Binding TotalEstimado, StringFormat=C2}"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}"
                                            ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                            Width="*"
                                            MinWidth="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Barra inferior de acciones (DialogFooterStyle) -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Click="OnCancelarClick"
                        Content="Cancelar (Esc)"
                        Style="{StaticResource KeycapButtonStyle}"
                        Padding="16,8" />

                <Button DockPanel.Dock="Right"
                        IsDefault="True"
                        Click="OnSeleccionarClick"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Importar Pedido" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

