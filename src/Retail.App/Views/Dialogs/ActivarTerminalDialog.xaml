<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ActivarTerminalDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:converters="clr-namespace:Retail.App.Converters"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:terminales="clr-namespace:Retail.App.ViewModels.Terminales"
                 Title="Activar esta PC"
                 Width="520"
                 MinHeight="0"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:IgualAParametroConverter x:Key="IgualAParametroConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <components:EncabezadoDialogo Grid.Row="0" Titulo="Activar esta PC" />

        <Border Grid.Row="1" Style="{StaticResource DialogSectionStyle}" Margin="12,0,12,12">
            <StackPanel>
                <DockPanel Margin="{StaticResource StackMd}">
                    <components:IndicadorCarga DockPanel.Dock="Right" EstaCargando="{Binding IsBusy}" VerticalAlignment="Center" />
                    <TextBlock Text="Terminal" Style="{StaticResource CardHeaderTextStyle}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Text="{Binding TextoIntroduccion}"
                           Style="{StaticResource TextBlockBodySecondary}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource StackMd}" />

                <!-- Sin GroupName: las dos opciones comparten el UniformGrid, que ya las agrupa. -->
                <components:SelectorSegmentado Margin="{StaticResource StackMd}">
                    <UniformGrid Columns="2">
                        <RadioButton IsChecked="{Binding Modo, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={x:Static terminales:ModoActivacionTerminal.Nueva}}"
                                     AutomationProperties.Name="Terminal nueva"
                                     Style="{StaticResource SegmentedRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                                <TextBlock Text="Terminal nueva" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton IsChecked="{Binding Modo, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={x:Static terminales:ModoActivacionTerminal.Reemplazo}}"
                                     AutomationProperties.Name="Reemplazar una existente"
                                     Style="{StaticResource SegmentedRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularSwapHorizontal" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                                <TextBlock Text="Reemplazar una existente" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </components:SelectorSegmentado>

                <!-- Terminal nueva: solo el nombre del puesto -->
                <StackPanel Visibility="{Binding EsNueva, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Nombre de la terminal *" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                    <ui:TextBox x:Name="TxtNombre"
                                Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="100"
                                PlaceholderText="Mostrador 1"
                                AutomationProperties.Name="Nombre de la terminal" />
                </StackPanel>

                <!-- Reemplazo: la terminal elegida pasa a ser esta PC y conserva su historial -->
                <StackPanel Visibility="{Binding EsReemplazo, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Terminal a reemplazar *" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                    <ComboBox ItemsSource="{Binding Terminales}"
                              SelectedItem="{Binding TerminalElegida}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Terminal a reemplazar">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type terminales:OpcionTerminal}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nombre}" Style="{StaticResource TextBlockBody}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TextoEquipo}" Style="{StaticResource TextBlockCaptionSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="No hay terminales activas para reemplazar."
                               Style="{StaticResource TextBlockCaptionSecondary}"
                               Margin="0,4,0,0"
                               Visibility="{Binding NoHayTerminalesParaReemplazar, Converter={StaticResource BoolToVisConverter}}" />
                    <TextBlock Text="Use esta opción si cambió la PC de un mostrador: conserva el historial de turnos."
                               Style="{StaticResource TextBlockCaptionSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Style="{StaticResource BadgeDangerStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinWidth="100"
                        IsEnabled="{Binding NoEstaOcupado}"
                        Click="OnCancelarClick" />

                <Button DockPanel.Dock="Right"
                        Command="{Binding ActivarCommand}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Activar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
