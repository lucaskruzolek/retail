<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.GuardarListaDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:vm="clr-namespace:Retail.App.ViewModels.Listas"
                 Title="Guardar como lista"
                 Language="es-AR"
                 Width="460"
                 MinHeight="0"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <components:EncabezadoDialogo Grid.Row="0" Titulo="Guardar como lista" />

        <Border Grid.Row="1" Style="{StaticResource DialogSectionStyle}" Margin="12,0,12,12">
            <StackPanel>
                <DockPanel Margin="{StaticResource StackMd}">
                    <components:IndicadorCarga DockPanel.Dock="Right" EstaCargando="{Binding IsBusy}" VerticalAlignment="Center" />
                    <TextBlock Text="Datos de la lista" Style="{StaticResource CardHeaderTextStyle}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackMd}" TextWrapping="Wrap">
                    <Run Text="Se guardan los" />
                    <Run Text="{Binding TextoCantidadArticulos, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="del ticket con sus cantidades. La lista no guarda precios: se leen del catálogo cada vez." />
                </TextBlock>

                <!-- Con una lista vinculada (L-16): actualizarla o guardar una nueva. Sin lista, solo se pide el nombre. -->
                <StackPanel Margin="{StaticResource StackMd}"
                            Visibility="{Binding TieneListaVinculada, Converter={StaticResource BoolToVisConverter}}">
                    <!-- Sin GroupName: los dos comparten el StackPanel, que ya los agrupa. Un GroupName agrupa por raíz
                         visual, y dos instancias del diálogo sin ventana (capturas) compartirían el grupo. -->
                    <RadioButton x:Name="OpcionActualizar"
                                 Content="{Binding TextoActualizar}"
                                 IsChecked="{Binding ActualizarVinculada, Mode=TwoWay}"
                                 AutomationProperties.Name="Actualizar la lista cargada" />
                    <RadioButton x:Name="OpcionNueva"
                                 Content="Guardar como lista nueva"
                                 IsChecked="{Binding GuardarComoNueva, Mode=TwoWay}"
                                 AutomationProperties.Name="Guardar como lista nueva" />
                </StackPanel>

                <StackPanel Visibility="{Binding PideNombre, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Nombre de la lista" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                    <ui:TextBox x:Name="TxtNombre"
                                Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="{x:Static vm:GuardarListaViewModel.LongitudMaximaNombre}"
                                PlaceholderText="Ej.: 3.º grado, Colegio N"
                                AutomationProperties.Name="Nombre de la lista" />
                    <TextBlock Text="El nombre es obligatorio."
                               Style="{StaticResource TextBlockCaptionSecondary}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               Margin="0,4,0,0"
                               Visibility="{Binding TieneErrorNombre, Converter={StaticResource BoolToVisConverter}}" />
                    <TextBlock Text="Se imprime en el ticket y en el PDF de la lista"
                               Style="{StaticResource TextBlockCaptionSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Style="{StaticResource BadgeDangerStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinWidth="100"
                        IsCancel="True"
                        Click="OnCancelarClick" />

                <Button DockPanel.Dock="Right"
                        Command="{Binding GuardarCommand}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularSave" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Guardar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
