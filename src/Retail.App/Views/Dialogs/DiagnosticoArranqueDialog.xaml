<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.DiagnosticoArranqueDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Base de datos - Retail POS"
                 Width="680"
                 Height="520"
                 MinWidth="560"
                 MinHeight="420"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource SurfaceBackgroundBrush}"
                 ResizeMode="CanResizeWithGrip">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título estandarizada de diálogo modal -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="Base de datos - Retail POS"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,12,24,12">
            <StackPanel>
                <!-- Tarjeta de advertencia: la base no está lista -->
                <Border Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconBoxIcons Grid.Column="0"
                                                    Kind="SolidAlertTriangle"
                                                    Width="36"
                                                    Height="36"
                                                    Foreground="{DynamicResource WarningForegroundBrush}"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="La base de datos no está lista"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningForegroundBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtMensaje"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Comandos a ejecutar: solo se muestran, la aplicación no los ejecuta -->
                <Border x:Name="PanelComandos"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="14"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Comandos a ejecutar en PowerShell, en este orden:"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock x:Name="TxtNotaDesarrollo"
                                   Text="Ejecútelos parado en la raíz del repositorio."
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,8" />

                        <ItemsControl x:Name="ListaComandos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Linea, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 FontSize="12"
                                                 Background="{DynamicResource SurfaceBackgroundBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,8,0" />

                                        <Button Grid.Column="1"
                                                Click="BtnCopiarComando_Click"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                MinWidth="96"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <iconPacks:PackIconBoxIcons Kind="RegularCopy"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Foreground="{DynamicResource PrimaryBrush}"
                                                                            Margin="0,0,8,0"
                                                                            VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TextoBoton}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra inferior de acciones -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel>
                <Button x:Name="BtnCopiarTodos"
                        Click="BtnCopiarTodos_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCopy"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtBtnCopiarTodos" Text="Copiar todos" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCerrar"
                        Click="BtnCerrar_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        HorizontalAlignment="Right"
                        IsDefault="True">
                    <TextBlock Text="Cerrar" FontWeight="Bold" />
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
