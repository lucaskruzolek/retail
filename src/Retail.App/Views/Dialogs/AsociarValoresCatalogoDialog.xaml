<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.AsociarValoresCatalogoDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Asociar categorías y marcas del catálogo"
                 Width="700"
                 Height="660"
                 MinWidth="660"
                 MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Asociar categorías y marcas del catálogo" />

        <!-- Contenido Central -->
        <ScrollViewer Grid.Row="1" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource DialogSectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                        <iconPacks:PackIconBoxIcons Kind="RegularLink" Style="{StaticResource CardHeaderIconStyle}" />
                        <TextBlock Text="Valores del proveedor sin asociar" Style="{StaticResource CardHeaderTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="Asocie cada valor a una categoría o marca de la tienda. Lo que no asocie se clasifica con las reglas de descripción."
                               Style="{StaticResource TextBlockCaption}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource StackMd}" />

                    <components:AsociarValoresPanel DataContext="{Binding Paso}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Command="{Binding CancelarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsCancel="True">
                    <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                </Button>

                <Button DockPanel.Dock="Right"
                        Command="{Binding ClasificarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCategories" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Clasificar catálogo" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
