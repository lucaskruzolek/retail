<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ClienteFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  xmlns:helpers="clr-namespace:Retail.App.Helpers"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="{Binding TituloVentana}"
                  Width="540"
                  Height="664"
                  MinWidth="500"
                  MinHeight="604"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="{Binding TituloVentana}" />

        <!-- Formulario con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="{StaticResource InsetCompact}"
                        Margin="{StaticResource StackLg}"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Grupo 1: Identificación y Datos Fiscales -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularUser" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Identificación del Cliente" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <!-- Razón Social o Nombre -->
                        <TextBlock Text="Razón Social o Nombre Completo *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ui:TextBox Text="{Binding RazonSocialONombre, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Librería &amp; Papelería Belgrano S.A."
                                    Margin="{StaticResource StackMd}" />

                        <!-- Tipo y Número de Documento en 2 columnas -->
                        <Grid Margin="{StaticResource StackMd}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo Documento *"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="{StaticResource StackXs}" />
                                <ComboBox ItemsSource="{Binding TiposDocumentoDisponibles}"
                                          ItemTemplate="{StaticResource EnumTextoItemTemplate}"
                                          SelectedItem="{Binding TipoDocumento, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Número de Documento / CUIT *"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="{StaticResource StackXs}" />
                                <ui:TextBox Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged}"
                                            helpers:EntradaTextoHelper.Tipo="Documento"
                                            PlaceholderText="ej. 30-71234567-8"
                                            FontFamily="{StaticResource FontFamilyMonospace}" />
                            </StackPanel>
                        </Grid>

                        <!-- Condición de IVA -->
                        <TextBlock Text="Condición frente al IVA *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ComboBox ItemsSource="{Binding CondicionesIvaDisponibles}"
                                  ItemTemplate="{StaticResource EnumTextoItemTemplate}"
                                  SelectedItem="{Binding CondicionIva, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- Grupo 2: Contacto y Domicilio -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularMap" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Contacto y Domicilio Fiscal" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <TextBlock Text="Domicilio Fiscal"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ui:TextBox Text="{Binding DomicilioFiscal, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. San Martín 456, Piso 2, Dpto B"
                                    Margin="{StaticResource StackMd}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teléfono"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="{StaticResource StackXs}" />
                                <ui:TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                            helpers:EntradaTextoHelper.Tipo="Telefono"
                                            PlaceholderText="ej. 11-4567-8901" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Correo Electrónico"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="{StaticResource StackXs}" />
                                <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="ej. compras@empresa.com" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Grupo 3: Cuenta Corriente y Crédito Comercial -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource StackMd}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconBoxIcons Kind="RegularWallet" Style="{StaticResource CardHeaderIconStyle}" />
                                <TextBlock Text="Cuenta Corriente Comercial" Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding TieneCuentaCorriente, Mode=TwoWay}"
                                      Content="Habilitada"
                                      HorizontalAlignment="Right"
                                      FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Text="Límite de Crédito Autorizado ($) *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ui:TextBox Text="{Binding LimiteCredito, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                    helpers:EntradaTextoHelper.Tipo="NumeroDecimal"
                                    IsEnabled="{Binding TieneCuentaCorriente}"
                                    FontFamily="{StaticResource FontFamilyNumeric}"
                                    Typography.NumeralAlignment="Tabular"
                                    PlaceholderText="0.00" />
                        <TextBlock Text="Monto máximo que el cliente puede adeudar por ventas a crédito."
                                   Style="{StaticResource TextBlockBodyMuted}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel>
                <!-- Indicador de Operación Asíncrona -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="{StaticResource InlineSm}" />
                    <TextBlock Text="Guardando cliente..."
                               Style="{StaticResource TextBlockBodySecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Botones Guardar / Cancelar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            Click="BtnCancelar_Click"
                            IsCancel="True"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource KeycapButtonStyle}"
                            Margin="{StaticResource InlineSm}" />

                    <Button Click="BtnGuardar_Click"
                            IsDefault="True"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularSave" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                            <TextBlock Text="Guardar Cliente" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
