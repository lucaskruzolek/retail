<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ClienteFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{Binding TituloVentana}"
                  Width="560"
                  Height="660"
                  MinWidth="500"
                  MinHeight="600"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding TituloVentana}"
                     Padding="8,0,0,0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Person24" Foreground="{DynamicResource PrimaryBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Formulario con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Grupo 1: Identificación y Datos Fiscales -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Identificación del Cliente"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Razón Social o Nombre -->
                        <TextBlock Text="Razón Social o Nombre Completo *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding RazonSocialONombre, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Librería &amp; Papelería Belgrano S.A."
                                    Margin="0,0,0,12" />

                        <!-- Tipo y Número de Documento en 2 columnas -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo Documento *"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding TiposDocumentoDisponibles}"
                                          SelectedItem="{Binding TipoDocumento, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Número de Documento / CUIT *"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="ej. 30-71234567-8"
                                            FontFamily="{StaticResource FontFamilyMonospace}" />
                            </StackPanel>
                        </Grid>

                        <!-- Condición de IVA -->
                        <TextBlock Text="Condición frente al IVA *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CondicionesIvaDisponibles}"
                                  SelectedItem="{Binding CondicionIva, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- Grupo 2: Contacto y Domicilio -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Contacto y Domicilio Fiscal"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Domicilio Fiscal"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding DomicilioFiscal, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. San Martín 456, Piso 2, Dpto B"
                                    Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teléfono"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="ej. 11-4567-8901" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Correo Electrónico"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="ej. compras@empresa.com" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Grupo 3: Cuenta Corriente y Crédito Comercial -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Cuenta Corriente Comercial"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding TieneCuentaCorriente, Mode=TwoWay}"
                                      Content="Habilitada"
                                      HorizontalAlignment="Right"
                                      FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Text="Límite de Crédito Autorizado ($) *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding LimiteCredito, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                    IsEnabled="{Binding TieneCuentaCorriente}"
                                    FontFamily="{StaticResource FontFamilyMonospace}"
                                    PlaceholderText="0.00" />
                        <TextBlock Text="Monto máximo que el cliente puede adeudar por ventas a crédito."
                                   Style="{StaticResource TextBlockBodyMuted}"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <DockPanel>
                <!-- Indicador de Operación Asíncrona -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="Guardando cliente..."
                               Style="{StaticResource TextBlockBodySecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Botones Guardar / Cancelar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            Click="BtnCancelar_Click"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="16,6"
                            Margin="0,0,8,0" />

                    <Button Click="BtnGuardar_Click"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="20,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,6,0" />
                            <TextBlock Text="Guardar Cliente" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
