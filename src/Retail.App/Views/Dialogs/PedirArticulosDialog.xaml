<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.PedirArticulosDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Agregar al pedido"
                 Width="580"
                 Height="660"
                 MinWidth="540"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource SurfaceBackgroundBrush}"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="Agregar al pedido"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="1" Margin="20,8,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Revise las cantidades. Cada renglón se agrega al borrador de su proveedor; si el ítem ya figura en él, la cantidad se suma."
                       Style="{StaticResource TextBlockBodySecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <!-- Ítems que no se pueden pedir (A-17) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding TieneOmitidos, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="SolidAlertTriangle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource WarningForegroundBrush}" />
                        <TextBlock Text="Estos ítems no se pueden pedir y se omitirán:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WarningForegroundBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Omitidos}" Margin="20,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningForegroundBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Renglones agrupados por proveedor, con el destino informado (A-7) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Grupos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding RazonSocialProveedor}" Style="{StaticResource TextBlockHeader2}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Subtotal, StringFormat=C2}"
                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding TextoDestino}" Style="{StaticResource TextBlockCaptionSecondary}" Margin="0,2,0,8" />

                                    <!-- Encabezado de columnas -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ítem" Style="{StaticResource TextBlockCaptionSecondary}" />
                                        <TextBlock Grid.Column="1" Text="Stock / mín." Style="{StaticResource TextBlockCaptionSecondary}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Cant." Style="{StaticResource TextBlockCaptionSecondary}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Subtotal" Style="{StaticResource TextBlockCaptionSecondary}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Renglones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="32" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding CodigoProveedor}" FontFamily="{StaticResource FontFamilyMonospace}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Descripcion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Descripcion}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <Border Style="{StaticResource BadgeNeutralStyle}"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="0,3,0,0"
                                                                    Visibility="{Binding TieneCantidadEnBorrador, Converter={StaticResource BoolToVisConverter}}">
                                                                <TextBlock Text="{Binding CantidadEnBorrador, StringFormat=Ya en el borrador: {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Stock con alerta de mínimo (RF-08) -->
                                                        <TextBlock Grid.Column="1"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding StockActual, Mode=OneWay}" />
                                                            <Run Text="/" Foreground="{DynamicResource TextMutedBrush}" />
                                                            <Run Text="{Binding StockMinimo, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                                        </TextBlock>

                                                        <TextBox Grid.Column="2"
                                                                 Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="52"
                                                                 Height="28"
                                                                 MinHeight="0"
                                                                 Padding="2,0"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalContentAlignment="Center"
                                                                 VerticalContentAlignment="Center"
                                                                 FontFamily="{StaticResource FontFamilyNumeric}"
                                                                 Typography.NumeralAlignment="Tabular"
                                                                 FontWeight="SemiBold" />

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Subtotal, StringFormat=C2}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   FontWeight="SemiBold" />

                                                        <Button Grid.Column="4"
                                                                Style="{StaticResource IconDangerButtonStyle}"
                                                                HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.QuitarRenglonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Quitar este ítem del pedido">
                                                            <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Barra inferior: total y acciones -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Click="BtnCancelar_Click"
                        IsCancel="True"
                        Content="Cancelar (Esc)"
                        Style="{StaticResource KeycapButtonStyle}"
                        Padding="16,8" />

                <Button DockPanel.Dock="Right"
                        Click="BtnConfirmar_Click"
                        IsEnabled="{Binding PuedeConfirmar}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Agregar al pedido" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Total estimado" Style="{StaticResource TextBlockCaptionSecondary}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TotalEstimado, StringFormat=C2}" Style="{StaticResource TextBlockCurrencyLarge}" HorizontalAlignment="Right" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
