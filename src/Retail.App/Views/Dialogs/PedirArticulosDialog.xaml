<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.PedirArticulosDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Agregar al pedido"
                 Width="580"
                 Height="684"
                 MinWidth="540"
                 MinHeight="544"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Agregar al pedido" />

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Revise las cantidades y, si un artículo tiene varias fuentes, a qué proveedor pedirlo. Cada renglón se agrega al borrador de su proveedor; si el ítem ya figura en él, la cantidad se suma."
                       Style="{StaticResource TextBlockBodySecondary}"
                       TextWrapping="Wrap"
                       Margin="4,0,4,12" />

            <!-- Ítems que no se pueden pedir (A-17) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="{StaticResource StackMd}"
                    Visibility="{Binding TieneOmitidos, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularAlertTriangle" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource WarningForegroundBrush}" />
                        <TextBlock Text="Estos ítems no se pueden pedir y se omitirán:" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource WarningForegroundBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Omitidos}" Margin="20,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Foreground="{DynamicResource WarningForegroundBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Recorrido en dos pasos (A-17): incorporar con el modal existente y volver a este -->
                    <Button HorizontalAlignment="Left"
                            Margin="16,8,0,0"
                            Click="BtnIncorporarPrimero_Click"
                            Style="{StaticResource GhostPrimaryButtonStyle}"
                            Visibility="{Binding PuedeIncorporarPrimero, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="Abre el modal de incorporación con estos ítems y después vuelve a este pedido">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TextoIncorporarPrimero}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Renglones agrupados por proveedor, con el destino informado (A-7) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Grupos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularStore" Style="{StaticResource CardHeaderIconStyle}" />
                                            <TextBlock Text="{Binding RazonSocialProveedor}" Style="{StaticResource CardHeaderTextStyle}" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Subtotal, StringFormat=C2}"
                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding TextoDestino}" Style="{StaticResource TextBlockCaptionSecondary}" Margin="24,4,0,8" />

                                    <!-- Encabezado de columnas -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ítem" Style="{StaticResource TextBlockCaptionSecondary}" />
                                        <TextBlock Grid.Column="1" Text="Stock / mín." Style="{StaticResource TextBlockCaptionSecondary}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Cant." Style="{StaticResource TextBlockCaptionSecondary}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Subtotal" Style="{StaticResource TextBlockCaptionSecondary}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Renglones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="44" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding CodigoProveedor}" FontFamily="{StaticResource FontFamilyMonospace}" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Descripcion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Descripcion}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <!-- Fuente del renglón (Track 4.3, A-18): solo si el artículo tiene varias, ordenadas por costo; al cambiarla,
                                                                 el renglón pasa al grupo de su proveedor (K3) -->
                                                            <ComboBox Margin="0,4,0,0"
                                                                      Padding="8,4"
                                                                      HorizontalAlignment="Stretch"
                                                                      ItemsSource="{Binding Opciones}"
                                                                      SelectedValuePath="Fuente"
                                                                      SelectedValue="{Binding Fuente, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                                      SelectionChanged="ComboFuente_SelectionChanged"
                                                                      Visibility="{Binding TieneVariasFuentes, Converter={StaticResource BoolToVisConverter}}"
                                                                      ToolTip="Proveedor al que se pide este artículo: costo y fecha de su lista">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center">
                                                                                <Run Text="{Binding RazonSocialProveedor, Mode=OneWay}" FontWeight="SemiBold" />
                                                                                <Run Text=" · " Foreground="{DynamicResource TextMutedBrush}" />
                                                                                <Run Text="{Binding CostoActual, StringFormat=C2, Mode=OneWay}"
                                                                                     FontFamily="{StaticResource FontFamilyNumeric}"
                                                                                     Typography.NumeralAlignment="Tabular" />
                                                                                <Run Text=" · " Foreground="{DynamicResource TextMutedBrush}" />
                                                                                <Run Text="{Binding FechaLocal, StringFormat={}{0:dd/MM/yyyy}, Mode=OneWay}"
                                                                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            </TextBlock>
                                                                            <Border Style="{StaticResource BadgeNeutralStyle}"
                                                                                    Margin="8,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Visibility="{Binding EsPrincipal, Converter={StaticResource BoolToVisConverter}}">
                                                                                <TextBlock Text="Principal" FontSize="{StaticResource FontSize2Xs}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Border Style="{StaticResource BadgeNeutralStyle}"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="0,4,0,0"
                                                                    Visibility="{Binding TieneCantidadEnBorrador, Converter={StaticResource BoolToVisConverter}}">
                                                                <TextBlock Text="{Binding CantidadEnBorrador, StringFormat=Ya en el borrador: {0}}" FontSize="{StaticResource FontSizeXs}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Stock con alerta de mínimo (RF-08) -->
                                                        <TextBlock Grid.Column="1"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding StockActual, Mode=OneWay}" />
                                                            <Run Text="/" Foreground="{DynamicResource TextMutedBrush}" />
                                                            <Run Text="{Binding StockMinimo, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                                        </TextBlock>

                                                        <TextBox Grid.Column="2"
                                                                 Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="52"
                                                                 Height="28"
                                                                 MinHeight="0"
                                                                 Padding="2,0"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalContentAlignment="Center"
                                                                 VerticalContentAlignment="Center"
                                                                 FontFamily="{StaticResource FontFamilyNumeric}"
                                                                 Typography.NumeralAlignment="Tabular"
                                                                 FontWeight="SemiBold" />

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Subtotal, StringFormat=C2}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   FontWeight="SemiBold" />

                                                        <Button Grid.Column="4"
                                                                Style="{StaticResource IconDangerButtonStyle}"
                                                                HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.QuitarRenglonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Quitar este ítem del pedido">
                                                            <iconPacks:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Total del lote: es contenido del pedido, no una acción, por eso va fuera de la barra de botones -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,12,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Total estimado"
                               Style="{StaticResource TextBlockBodySecondary}"
                               VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding TotalEstimado, StringFormat=C2}"
                               Style="{StaticResource TextBlockCurrencyLarge}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Barra inferior: total y acciones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Click="BtnCancelar_Click"
                        IsCancel="True"
                        Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}" />

                <Button DockPanel.Dock="Right"
                        IsDefault="True"
                        Click="BtnConfirmar_Click"
                        IsEnabled="{Binding PuedeConfirmar}"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Agregar al pedido" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
