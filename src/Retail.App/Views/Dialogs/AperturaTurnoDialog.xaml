<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.AperturaTurnoDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  Title="Apertura de Turno de Caja"
                  Width="420"
                  Height="324"
                  MinWidth="380"
                  MinHeight="304"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Apertura de Turno de Caja" />

        <!-- Contenido -->
        <Border Grid.Row="1" Padding="24,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Apertura de Turno"
                           Style="{StaticResource TextBlockHeader2}"
                           Margin="0,0,0,6" />
                <TextBlock Text="Ingrese el efectivo inicial con el que arranca la gaveta."
                           Style="{StaticResource TextBlockBodySecondary}"
                           Margin="0,0,0,20" />

                <TextBlock Text="Saldo Inicial en Efectivo ($):"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding SaldoInicial, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                         FontFamily="{StaticResource FontFamilyNumeric}"
                         Typography.NumeralAlignment="Tabular"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Height="38"
                         VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Botonera Inferior -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinHeight="{StaticResource ControlHeightLg}"
                        Width="100"
                        DockPanel.Dock="Left"
                        Click="Cancelar_Click" />

                <Button Content="Abrir Turno"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        MinHeight="{StaticResource ControlHeightLg}"
                        Width="120"
                        DockPanel.Dock="Right"
                        IsDefault="True"
                        Click="Aceptar_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>