<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.AperturaTurnoDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  Title="Apertura de Turno de Caja"
                  Width="420"
                  MinWidth="380"
                  MinHeight="0"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Apertura de Turno de Caja" />

        <!-- Contenido: una sola sección sobre el fondo del diálogo -->
        <StackPanel Grid.Row="1" Margin="12,0,12,12">
            <Border Style="{StaticResource DialogSectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                        <iconPacks:PackIconBoxIcons Kind="RegularWallet" Style="{StaticResource CardHeaderIconStyle}" />
                        <TextBlock Text="Efectivo inicial" Style="{StaticResource CardHeaderTextStyle}" />
                    </StackPanel>

                    <TextBlock Text="Ingrese el efectivo inicial con el que arranca la gaveta."
                               Style="{StaticResource TextBlockBodySecondary}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource StackMd}" />

                    <TextBlock Text="Saldo Inicial en Efectivo ($):"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="{StaticResource StackXs}" />
                    <TextBox Text="{Binding SaldoInicial, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             FontFamily="{StaticResource FontFamilyNumeric}"
                             Typography.NumeralAlignment="Tabular"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Botonera Inferior -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinWidth="100"
                        DockPanel.Dock="Left"
                        IsCancel="True"
                        Click="Cancelar_Click" />

                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right"
                        IsDefault="True"
                        Click="Aceptar_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularLockOpen" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Abrir Turno" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
