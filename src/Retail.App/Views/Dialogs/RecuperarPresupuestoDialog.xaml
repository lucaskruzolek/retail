<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.RecuperarPresupuestoDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Recuperar presupuesto"
                 Language="es-AR"
                 Width="420"
                 MinHeight="0"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <components:EncabezadoDialogo Grid.Row="0" Titulo="Recuperar presupuesto" />

        <Border Grid.Row="1" Style="{StaticResource DialogSectionStyle}" Margin="12,0,12,12">
            <StackPanel>
                <DockPanel Margin="{StaticResource StackSm}">
                    <components:IndicadorCarga DockPanel.Dock="Right" EstaCargando="{Binding IsBusy}" VerticalAlignment="Center" />
                    <TextBlock Text="Presupuesto a cobrar" Style="{StaticResource CardHeaderTextStyle}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Text="Ingrese el número impreso en el ticket o el PDF del presupuesto."
                           Style="{StaticResource TextBlockBodySecondary}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource StackMd}" />

                <TextBlock Text="N.º de presupuesto" Style="{StaticResource TextBlockBodySecondary}" Margin="{StaticResource StackXs}" />
                <ui:TextBox x:Name="TxtNumero"
                            Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}"
                            MaxLength="9"
                            PlaceholderText="Ej.: 123"
                            FontFamily="{StaticResource FontFamilyMonospace}"
                            PreviewTextInput="OnNumeroPreviewTextInput"
                            AutomationProperties.Name="Número de presupuesto" />

                <Border Style="{StaticResource BadgeDangerStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinWidth="100"
                        IsCancel="True"
                        Click="OnCancelarClick" />

                <Button DockPanel.Dock="Right"
                        Command="{Binding RecuperarCommand}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Recuperar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
