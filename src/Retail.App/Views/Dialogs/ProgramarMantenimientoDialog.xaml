<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ProgramarMantenimientoDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Restaurar con terminales conectadas"
                 Language="es-AR"
                 Width="500"
                 MinHeight="0"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <components:EncabezadoDialogo Grid.Row="0" Titulo="Terminales conectadas" />

        <Border Grid.Row="1" Style="{StaticResource DialogSectionStyle}" Margin="12,0,12,12">
            <StackPanel>
                <TextBlock x:Name="TxtPregunta"
                           Style="{StaticResource TextBlockBody}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource StackMd}" />

                <TextBlock Text="Tiempo para terminar las ventas en curso"
                           Style="{StaticResource TextBlockBodySecondary}"
                           Margin="{StaticResource StackXs}" />
                <components:SelectorSegmentado HorizontalAlignment="Left" Margin="{StaticResource StackMd}">
                    <UniformGrid x:Name="OpcionesMinutos" Columns="4">
                        <RadioButton GroupName="MinutosMantenimiento" Content="Ahora" Tag="0" Style="{StaticResource SegmentedRadioButtonStyle}" />
                        <RadioButton GroupName="MinutosMantenimiento" Content="2 min" Tag="2" IsChecked="True" Style="{StaticResource SegmentedRadioButtonStyle}" />
                        <RadioButton GroupName="MinutosMantenimiento" Content="5 min" Tag="5" Style="{StaticResource SegmentedRadioButtonStyle}" />
                        <RadioButton GroupName="MinutosMantenimiento" Content="10 min" Tag="10" Style="{StaticResource SegmentedRadioButtonStyle}" />
                    </UniformGrid>
                </components:SelectorSegmentado>

                <TextBlock Text="Las terminales ven el aviso y no pueden iniciar cobros nuevos. Si pasado el plazo siguen conectadas, podrá elegir si restaura igual."
                           Style="{StaticResource TextBlockCaptionSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinWidth="100"
                        IsCancel="True"
                        Click="OnCancelarClick" />

                <Button DockPanel.Dock="Right"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="OnProgramarClick">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCog" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Programar y esperar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
