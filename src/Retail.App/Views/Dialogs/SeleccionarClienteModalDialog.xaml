<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.SeleccionarClienteModalDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="Seleccionar Cliente de Mostrador"
                   Width="520"
                   Height="580"
                   MinWidth="480"
                   MinHeight="500"
                   WindowStartupLocation="CenterOwner"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica"
                   Background="{DynamicResource SurfaceBackgroundBrush}"
                   ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada (Título Centrado y Estilizado) -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="Seleccionar Cliente de Mostrador"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Contenido Central -->
        <Grid Grid.Row="1" Margin="20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Buscador rápido -->
            <ui:TextBox Grid.Row="0"
                        Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Buscar por nombre, razón social o DNI/CUIT..."
                        Margin="0,0,0,12">
                <ui:TextBox.Icon>
                    <ui:ImageIcon Source="{iconPacks:BoxIconsImage Kind=RegularSearch, Brush={StaticResource TextMutedBrush}}"
                                  Width="16" Height="16" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <!-- 2. Botón rápido Consumidor Final -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Click="OnConsumidorFinalClick"
                            Style="{StaticResource KeycapButtonStyle}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Asignar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Consumidor Final" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Venta sin comprobante a nombre de cliente o cuenta corriente." Style="{StaticResource TextBlockCaptionSecondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. Lista de Clientes Encontrados -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid ItemsSource="{Binding Clientes}"
                          SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                          Style="{StaticResource DataGridRetailStyle}"
                          RowStyle="{StaticResource DataGridRowRetailStyle}"
                          CellStyle="{StaticResource DataGridCellRetailStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Documento"
                                            Binding="{Binding NumeroDocumento}"
                                            ElementStyle="{StaticResource TextBlockMonospaceCell}"
                                            Width="110" />
                        <DataGridTextColumn Header="Razón Social / Nombre"
                                            Binding="{Binding RazonSocialONombre}"
                                            ElementStyle="{StaticResource TextBlockTextCell}"
                                            Width="*" />
                        <DataGridTemplateColumn Header="Cta. Cte." Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Visibility="{Binding TieneCuentaCorriente, Converter={StaticResource BoolToVisConverter}}"
                                            Background="{DynamicResource SuccessBackgroundBrush}"
                                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="Habilitada"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessForegroundBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Click="OnCancelarClick"
                        Content="Cancelar (Esc)"
                        Style="{StaticResource KeycapButtonStyle}"
                        Padding="16,8" />

                <Button DockPanel.Dock="Right"
                        Click="OnSeleccionarClick"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Seleccionar Cliente" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
