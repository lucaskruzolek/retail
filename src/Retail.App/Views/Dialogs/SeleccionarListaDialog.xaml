<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.SeleccionarListaDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 xmlns:helpers="clr-namespace:Retail.App.Helpers"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Cargar lista"
                 Language="es-AR"
                 Width="760"
                 Height="600"
                 MinWidth="640"
                 MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

            <!-- Conteos alineados a la derecha, igual que su encabezado (DataGridColumnHeaderRightListadoStyle) -->
            <Style x:Key="CeldaNumericaDerecha" TargetType="TextBlock" BasedOn="{StaticResource TextBlockNumericCell}">
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <components:EncabezadoDialogo Grid.Row="0" Titulo="Cargar lista" />

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.RowDefinitions>
                <!-- Buscador -->
                <RowDefinition Height="Auto" />
                <!-- Lista -->
                <RowDefinition Height="*" />
                <!-- Aviso de más resultados -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                <components:IndicadorCarga DockPanel.Dock="Right" EstaCargando="{Binding IsBusy}" Margin="12,0,0,0" VerticalAlignment="Center" />

                <ui:TextBox x:Name="TxtBusqueda"
                            Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Buscar por nombre de la lista…"
                            PreviewKeyDown="OnBusquedaPreviewKeyDown"
                            AutomationProperties.Name="Buscar lista">
                    <ui:TextBox.Icon>
                        <components:IconoBoxIcons Kind="RegularSearch" Foreground="{DynamicResource TextMutedBrush}" Width="16" Height="16" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource TablaListadoStyle}">
                <Grid>
                    <!-- Doble clic y Enter eligen la fila (code-behind: la grilla se queda con Enter si no se lo intercepta) -->
                    <DataGrid x:Name="Grilla"
                              ItemsSource="{Binding Listas}"
                              SelectedItem="{Binding ListaSeleccionada, Mode=TwoWay}"
                              Style="{StaticResource DataGridListadoStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderThickness="0"
                              helpers:EsquinasHelper.Esquinas="7"
                              MouseDoubleClick="OnGrillaMouseDoubleClick"
                              PreviewKeyDown="OnGrillaPreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nombre" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nombre}"
                                                   Style="{StaticResource TextBlockTextCell}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Nombre}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Artículos"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                                Binding="{Binding CantidadArticulos}"
                                                ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                Width="104" />

                            <!-- Total de hoy: a los precios de catálogo vigentes, no a los de cuando se armó la lista -->
                            <DataGridTextColumn Header="Total de hoy"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                                Binding="{Binding TotalDeHoy, StringFormat=C0}"
                                                ElementStyle="{StaticResource TextBlockCurrencyCell}"
                                                Width="136" />

                            <DataGridTextColumn Header="Ventas"
                                                HeaderStyle="{StaticResource DataGridColumnHeaderRightListadoStyle}"
                                                Binding="{Binding CantidadVentas}"
                                                ElementStyle="{StaticResource CeldaNumericaDerecha}"
                                                Width="96" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vacío -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="460"
                                Visibility="{Binding EstaVacio, Converter={StaticResource BoolToVisConverter}}">
                        <iconPacks:PackIconBoxIcons Kind="RegularListUl" Width="40" Height="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TextoVacio}"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Error de carga, con la salida de volver a intentar -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding TieneErrorCarga, Converter={StaticResource BoolToVisConverter}}">
                        <Border Style="{StaticResource BadgeDangerStyle}">
                            <TextBlock Text="{Binding MensajeErrorCarga}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Button Command="{Binding RecargarCommand}"
                                Style="{StaticResource KeycapButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0"
                                ToolTip="Volver a consultar las listas">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="14" Height="14" Margin="{StaticResource InlineXs}" VerticalAlignment="Center" />
                                <TextBlock Text="Reintentar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="{Binding TextoLimite}"
                       Style="{StaticResource TextBlockCaptionSecondary}"
                       Margin="4,8,0,0"
                       Visibility="{Binding HayMasDeLosMostrados, Converter={StaticResource BoolToVisConverter}}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinWidth="100"
                        IsCancel="True"
                        Click="OnCancelarClick" />

                <Button DockPanel.Dock="Right"
                        Command="{Binding ElegirCommand}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Cargar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
