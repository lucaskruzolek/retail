<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.CobranzaModalDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:components="clr-namespace:Retail.App.Views.Components"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title="Cobranza de Cuenta Corriente"
                   Width="520"
                   Height="644"
                   MinWidth="480"
                   MinHeight="604"
                   WindowStartupLocation="CenterOwner"
                   ExtendsContentIntoTitleBar="True"
                   Background="{DynamicResource DialogBackgroundBrush}"
                   ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Cobranza de Cuenta Corriente" />

        <!-- Contenido Central con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
            <StackPanel>
                <!-- Alerta de Validación o Error -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="{StaticResource StackMd}"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Tarjeta 1: Información del Cliente y Saldo Deudor -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularUser" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Cliente" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <Grid Margin="{StaticResource StackSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Cliente.RazonSocialONombre}"
                                           FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeMd}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource TextBlockCaptionSecondary}">
                                    <Run Text="{Binding Cliente.TipoDocumento}" />: <Run Text="{Binding Cliente.NumeroDocumento}" />
                                    | <Run Text="{Binding Cliente.CondicionIva}" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource WarningBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="DEUDA ACTIVA"
                                           Foreground="{DynamicResource WarningForegroundBrush}"
                                           FontSize="{StaticResource FontSize2Xs}"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Separator Background="{DynamicResource SurfaceBorderBrush}" Margin="0,8,0,12" />

                        <!-- Deuda Actual en Cascadia Code -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Saldo Deudor Pendiente:"
                                           Style="{StaticResource TextBlockBodySecondary}" />
                                <TextBlock Style="{StaticResource TextBlockCaptionSecondary}">
                                    Límite asignado: <Run Text="{Binding Cliente.LimiteCredito, StringFormat='{}{0:C}', ConverterCulture='es-AR'}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding SaldoActual, StringFormat='{}{0:C}', ConverterCulture='es-AR'}"
                                       Style="{StaticResource TextBlockCurrencyLarge}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Detalle del Cobro -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularDollarCircle" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Liquidación del pago" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>

                        <!-- Medio de Pago -->
                        <TextBlock Text="Medio de Pago *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding MediosPagoDisponibles}"
                                  ItemTemplate="{StaticResource EnumTextoItemTemplate}"
                                  SelectedItem="{Binding MedioPago, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,12" />

                        <!-- Monto a Cobrar con Botón "Pagar Totalidad" -->
                        <TextBlock Text="Monto a Cobrar *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding MontoCobro, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}', ConverterCulture='es-AR'}"
                                        FontFamily="{StaticResource FontFamilyNumeric}"
                                        Typography.NumeralAlignment="Tabular"
                                        FontSize="{StaticResource FontSizeMd}"
                                        FontWeight="SemiBold"
                                        PlaceholderText="0,00" />

                            <Button Grid.Column="2"
                                    Command="{Binding PagarTotalidadCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    ToolTip="Copia la totalidad del saldo deudor a cobrar">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularDollar" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Pagar Todo" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Desglose de Efectivo y Vuelto (visible solo si Efectivo) -->
                        <Grid Margin="{StaticResource StackMd}"
                              Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Efectivo Recibido:"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding EfectivoRecibido, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}', ConverterCulture='es-AR'}"
                                            FontFamily="{StaticResource FontFamilyNumeric}"
                                            Typography.NumeralAlignment="Tabular"
                                            FontSize="{StaticResource FontSizeBase}"
                                            PlaceholderText="0,00" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Vuelto a Entregar:"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <Border Background="{DynamicResource SuccessBackgroundBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,4">
                                    <TextBlock Text="{Binding Vuelto, StringFormat='{}{0:C}', ConverterCulture='es-AR'}"
                                               FontFamily="{StaticResource FontFamilyNumeric}"
                                               Typography.NumeralAlignment="Tabular"
                                               FontSize="{StaticResource FontSizeMd}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                               HorizontalAlignment="Right" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Referencia / Observación -->
                        <TextBlock Text="Nº Comprobante / Referencia (Opcional)"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Transf. Nro 994812 o Recibo X-001"
                                    Margin="{StaticResource StackMd}" />

                        <!-- Checkbox Imprimir Recibo -->
                        <CheckBox IsChecked="{Binding ImprimirRecibo, Mode=TwoWay}"
                                  Content="Imprimir recibo oficial duplicado en impresora térmica" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior de Acciones con Keycaps -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Cancelar -->
                <Button Grid.Column="1"
                        Content="Cancelar"
                        Command="{Binding CancelarCommand}"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsCancel="True" />

                <!-- Confirmar Cobro -->
                <Button Grid.Column="3"
                        Command="{Binding CobrarCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Registrar Cobranza" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
