<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.MovimientoCajaDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  xmlns:helpers="clr-namespace:Retail.App.Helpers"
                  Title="Registrar Movimiento de Caja"
                  Width="480"
                  MinWidth="440"
                  MinHeight="0"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Registrar Movimiento de Caja" />

        <!-- Contenido: una sola sección sobre el fondo del diálogo -->
        <StackPanel Grid.Row="1" Margin="12,0,12,12">
            <Border Style="{StaticResource DialogSectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                        <iconPacks:PackIconBoxIcons Kind="RegularDollarCircle" Style="{StaticResource CardHeaderIconStyle}" />
                        <TextBlock Text="Movimiento extraordinario" Style="{StaticResource CardHeaderTextStyle}" />
                    </StackPanel>

                    <TextBlock Text="Registre un ingreso extraordinario o retiro de efectivo en la gaveta activa."
                               Style="{StaticResource TextBlockBodySecondary}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource StackMd}" />

                    <!-- Tipo de Movimiento -->
                    <TextBlock Text="Tipo de Movimiento:"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="{StaticResource StackXs}" />
                    <ComboBox x:Name="CbTipoMovimiento"
                              SelectedItem="{Binding TipoMovimiento, Mode=TwoWay}"
                              Margin="{StaticResource StackMd}" />

                    <!-- Monto -->
                    <TextBlock Text="Monto ($):"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="{StaticResource StackXs}" />
                    <TextBox Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             helpers:EntradaTextoHelper.Tipo="NumeroDecimal"
                             FontFamily="{StaticResource FontFamilyNumeric}"
                             Typography.NumeralAlignment="Tabular"
                             VerticalContentAlignment="Center"
                             Margin="{StaticResource StackMd}" />

                    <!-- Concepto -->
                    <TextBlock Text="Concepto / Observación Obligatoria:"
                               Style="{StaticResource TextBlockBodySecondary}"
                               Margin="{StaticResource StackXs}" />
                    <TextBox Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}"
                             Height="56"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Botonera Inferior -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinWidth="100"
                        DockPanel.Dock="Left"
                        IsCancel="True"
                        Click="Cancelar_Click" />

                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                        DockPanel.Dock="Right"
                        IsDefault="True"
                        Click="Aceptar_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Margin="{StaticResource InlineSm}" VerticalAlignment="Center" />
                        <TextBlock Text="Guardar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
