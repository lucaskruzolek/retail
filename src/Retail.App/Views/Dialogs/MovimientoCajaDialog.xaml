<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.MovimientoCajaDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  Title="Registrar Movimiento de Caja"
                  Width="480"
                  Height="464"
                  MinWidth="440"
                  MinHeight="424"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Registrar Movimiento de Caja" />

        <!-- Contenido -->
        <Border Grid.Row="1" Padding="24,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Movimiento Extraordinario"
                           Style="{StaticResource TextBlockHeader2}"
                           Margin="0,0,0,6" />
                <TextBlock Text="Registre un ingreso extraordinario o retiro de efectivo en la gaveta activa."
                           Style="{StaticResource TextBlockBodySecondary}"
                           Margin="0,0,0,18" />

                <!-- Tipo de Movimiento -->
                <TextBlock Text="Tipo de Movimiento:"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="CbTipoMovimiento"
                          SelectedItem="{Binding TipoMovimiento, Mode=TwoWay}"
                          Height="36"
                          Margin="0,0,0,14" />

                <!-- Monto -->
                <TextBlock Text="Monto ($):"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                         FontFamily="{StaticResource FontFamilyNumeric}"
                         Typography.NumeralAlignment="Tabular"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,14" />

                <!-- Concepto -->
                <TextBlock Text="Concepto / Observación Obligatoria:"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource FontFamilyText}"
                         Height="56"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Botonera Inferior -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        MinHeight="{StaticResource ControlHeightLg}"
                        Width="100"
                        DockPanel.Dock="Left"
                        Click="Cancelar_Click" />

                <Button Content="Guardar"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        MinHeight="{StaticResource ControlHeightLg}"
                        Width="110"
                        DockPanel.Dock="Right"
                        IsDefault="True"
                        Click="Aceptar_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>