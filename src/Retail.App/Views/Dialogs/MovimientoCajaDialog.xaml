<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.MovimientoCajaDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Registrar Movimiento de Caja"
                  Width="480"
                  Height="440"
                  MinWidth="440"
                  MinHeight="400"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="Registrar Movimiento de Caja"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Contenido -->
        <Border Grid.Row="1" Padding="24,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Movimiento Extraordinario"
                           Style="{StaticResource TextBlockHeader2}"
                           Margin="0,0,0,6" />
                <TextBlock Text="Registre un ingreso extraordinario o retiro de efectivo en la gaveta activa."
                           Style="{StaticResource TextBlockBodySecondary}"
                           Margin="0,0,0,18" />

                <!-- Tipo de Movimiento -->
                <TextBlock Text="Tipo de Movimiento:"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="CbTipoMovimiento"
                          SelectedItem="{Binding TipoMovimiento, Mode=TwoWay}"
                          Height="36"
                          Margin="0,0,0,14" />

                <!-- Monto -->
                <TextBlock Text="Monto ($):"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,14" />

                <!-- Concepto -->
                <TextBlock Text="Concepto / Observación Obligatoria:"
                           FontFamily="{StaticResource FontFamilyText}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource FontFamilyText}"
                         Height="56"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Botonera Inferior -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Style="{StaticResource KeycapButtonStyle}"
                        Width="100"
                        DockPanel.Dock="Left"
                        Click="Cancelar_Click" />

                <Button Content="Guardar"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Width="110"
                        DockPanel.Dock="Right"
                        Click="Aceptar_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>