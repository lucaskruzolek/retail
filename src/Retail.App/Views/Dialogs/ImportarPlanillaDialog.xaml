<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ImportarPlanillaDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:components="clr-namespace:Retail.App.Views.Components"
                    xmlns:helpers="clr-namespace:Retail.App.Helpers"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    Title="Importar Planilla de Proveedor"
                    Width="580"
                    Height="684"
                    MinWidth="480"
                    MinHeight="624"
                    WindowStartupLocation="CenterOwner"
                    ExtendsContentIntoTitleBar="True"
                    Background="{DynamicResource DialogBackgroundBrush}"
                    ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ExaminarArchivoCommand}" />
        <KeyBinding Key="F9" Command="{Binding ImportarPlanillaCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="Importar Planilla de Proveedor" />

        <!-- Contenido Central -->
        <ScrollViewer Grid.Row="1" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Alerta de Validación / Error -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Identificación del Proveedor -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularTruck" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Proveedor" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Proveedor.RazonSocial}"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource FontSizeMd}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Proveedor.Cuit, StringFormat={}CUIT: {0}}"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- Preferencia del proveedor (Track 6.6, M-75, M-79): arriba, para que se vea sin desplazar.
                             Solo se guarda; la clasificación la orquesta la página del explorador. -->
                        <DockPanel Margin="0,12,0,0" LastChildFill="True">
                            <ui:ToggleSwitch DockPanel.Dock="Right"
                                             IsChecked="{Binding ClasificarCatalogo}"
                                             IsEnabled="{Binding PuedeEditarClasificacion}"
                                             AutomationProperties.Name="Clasificar el catálogo al importar"
                                             VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Clasificar catálogo"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Sugiere categoría y marca a cada ítem con las reglas de la tienda. No incorpora artículos."
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Selección de Archivo -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularFile" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Archivo de planilla" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="Excel o CSV *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RutaArchivo, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Command="{Binding ExaminarArchivoCommand}"
                                    Style="{StaticResource KeycapButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularFolder" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Examinar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mapeo de Columnas -->
                <Border Style="{StaticResource DialogSectionStyle}" Margin="{StaticResource StackMd}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource StackMd}">
                            <iconPacks:PackIconBoxIcons Kind="RegularTableColumns" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="Mapeo de columnas" Style="{StaticResource CardHeaderTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="Nombres de las columnas tal como figuran en el archivo."
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackMd}" />

                        <!-- Fila de Encabezado (H-05): las planillas suelen traer filas de título antes de los encabezados.
                             Va primero porque define dónde se buscan todos los nombres de columna. -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Fila de Encabezado *"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding FilaEncabezado, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:EntradaTextoHelper.Tipo="Entero"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         Height="32" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Bottom"
                                       Text="Número de fila (como en Excel) donde están los nombres de las columnas."
                                       Style="{StaticResource TextBlockCaption}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <!-- Columnas obligatorias: sin ellas no se puede importar -->
                        <TextBlock Text="Columnas obligatorias"
                                   Style="{StaticResource TextBlockCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Código *"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding ColumnaCodigo, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         Height="32" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Descripción *"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding ColumnaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         Height="32" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Precio Costo *"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding ColumnaPrecio, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         Height="32" />
                            </StackPanel>
                        </Grid>

                        <!-- Columnas opcionales (M-12): si la planilla no las trae, se importa sin ese dato -->
                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Columnas opcionales"
                                           Style="{StaticResource TextBlockCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="Rubro, categoría y marca son la clasificación del proveedor: el sistema las traduce con las equivalencias del proveedor. Deje vacía la que la planilla no tenga."
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                        <TextBlock Text="Cód. Barras"
                                                   Style="{StaticResource TextBlockCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ColumnaCodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 Height="32" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                        <TextBlock Text="Rubro"
                                                   Style="{StaticResource TextBlockCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ColumnaRubro, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 Height="32" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Categoría"
                                                   Style="{StaticResource TextBlockCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ColumnaCategoria, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 Height="32" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Marca"
                                                   Style="{StaticResource TextBlockCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ColumnaMarca, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 Height="32" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>


                <!-- Feedback de Progreso / Estado -->
                <StackPanel Margin="0,0,0,8">
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding MensajeEstado}"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <!-- Indeterminada (H-04): con lectura streaming el total de filas no se conoce de antemano -->
                        <ProgressBar IsIndeterminate="True"
                                     Height="6"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     Background="{DynamicResource SurfaceBorderBrush}" />
                    </StackPanel>

                    <!-- Aviso de importación completada (verde) o con observaciones (ámbar) -->
                    <Border CornerRadius="6"
                            BorderThickness="1"
                            Padding="12,12"
                            Margin="0,0,0,4"
                            Visibility="{Binding ImportacionCompletada, Converter={StaticResource BoolToVisConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImportacionConObservaciones}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="True">
                            <iconPacks:PackIconBoxIcons Width="20" Height="20"
                                                        DockPanel.Dock="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="0,1,12,0">
                                <iconPacks:PackIconBoxIcons.Style>
                                    <Style TargetType="iconPacks:PackIconBoxIcons">
                                        <Setter Property="Kind" Value="RegularCheckCircle" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImportacionConObservaciones}" Value="True">
                                                <Setter Property="Kind" Value="RegularAlertTriangle" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconBoxIcons.Style>
                            </iconPacks:PackIconBoxIcons>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource FontSizeBase}" FontWeight="Bold" Margin="0,0,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Importación completada" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportacionConObservaciones}" Value="True">
                                                    <Setter Property="Text" Value="Importación completada con observaciones" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding MensajeExito}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding TieneResultado, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,4,0,0">
                        <Border Style="{StaticResource BadgeSuccessStyle}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding UltimoResultado.NuevosRegistros, StringFormat={}✚ {0} nuevos}"
                                       FontSize="{StaticResource FontSizeXs}" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                        <Border Style="{StaticResource BadgeWarningStyle}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding UltimoResultado.PreciosActualizados, StringFormat={}↑ {0} precios}"
                                       FontSize="{StaticResource FontSizeXs}" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDangerStyle}">
                            <TextBlock Text="{Binding UltimoResultado.FilasConError, StringFormat={}✕ {0} errores}"
                                       FontSize="{StaticResource FontSizeXs}" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerForegroundBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Detalle de Filas con Error (H-01) -->
                    <Border Style="{StaticResource DialogSectionStyle}"
                            Margin="0,8,0,0"
                            Visibility="{Binding TieneErroresDetalle, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource StackSm}">
                                <iconPacks:PackIconBoxIcons Kind="RegularAlertTriangle" Style="{StaticResource CardHeaderIconStyle}" />
                                <TextBlock Text="Detalle de filas con error" Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>
                            <ScrollViewer MaxHeight="96"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding UltimoResultado.ErroresDetalle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource TextBlockCaption}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CerrarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,8,0"
                        IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TextoBotonCerrar}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ImportarPlanillaCommand}"
                        IsDefault="True"
                        IsEnabled="{Binding PuedeImportar}"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularFilePlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Importar Planilla" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
