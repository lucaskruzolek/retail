<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ImportarPlanillaDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    Title="Importar Planilla de Proveedor"
                    Width="540"
                    Height="520"
                    MinWidth="480"
                    MinHeight="460"
                    WindowStartupLocation="CenterOwner"
                    ExtendsContentIntoTitleBar="True"
                    WindowBackdropType="Mica"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ExaminarArchivoCommand}" />
        <KeyBinding Key="F9" Command="{Binding ImportarPlanillaCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                          Padding="8,0"
                          Background="{DynamicResource SurfaceBackgroundBrush}"
                          ShowMaximize="False"
                          CanMaximize="False" />
            <TextBlock Text="Importar Planilla de Proveedor"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Contenido Central -->
        <Grid Grid.Row="1" Margin="24,12">
            <StackPanel>
                <!-- Alerta de Validación / Error -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Identificación del Proveedor -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <iconPacks:PackIconBoxIcons Kind="SolidTruck" Width="18" Height="18"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Proveedor.RazonSocial}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Proveedor.Cuit, StringFormat={}CUIT: {0}}"
                                       Style="{StaticResource TextBlockCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Selección de Archivo -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Archivo de Planilla (Excel o CSV) *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RutaArchivo, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Command="{Binding ExaminarArchivoCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularFolder" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Examinar" VerticalAlignment="Center" />
                                    
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mapeo de Columnas -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Mapeo de Nombres de Columnas en el Archivo"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Columna Código -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="Columna Código *"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding ColumnaCodigo, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         Height="32" />
                            </StackPanel>

                            <!-- Columna Código Barras -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Columna Cód. Barras (Opcional)"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding ColumnaCodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         Height="32" />
                            </StackPanel>

                            <!-- Columna Descripción -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Columna Descripción *"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding ColumnaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         Height="32" />
                            </StackPanel>

                            <!-- Columna Precio -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Columna Precio Costo *"
                                           Style="{StaticResource TextBlockCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding ColumnaPrecio, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         Height="32" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Feedback de Progreso / Estado -->
                <StackPanel Margin="0,0,0,8">
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,6">
                        <TextBlock Text="{Binding MensajeEstado}"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <ProgressBar Value="{Binding ProgresoImportacion}"
                                     Minimum="0" Maximum="100"
                                     Height="6"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     Background="{DynamicResource SurfaceBorderBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding TieneResultado, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,4,0,0">
                        <Border Style="{StaticResource BadgeSuccessStyle}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding UltimoResultado.NuevosRegistros, StringFormat={}✚ {0} nuevos}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </Border>
                        <Border Style="{StaticResource BadgeWarningStyle}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding UltimoResultado.PreciosActualizados, StringFormat={}↑ {0} precios}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDangerStyle}">
                            <TextBlock Text="{Binding UltimoResultado.FilasConError, StringFormat={}✕ {0} errores}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CerrarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,10,0"
                        IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        
                        <TextBlock Text="Cerrar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ImportarPlanillaCommand}"
                        IsEnabled="{Binding PuedeImportar}"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularFilePlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Importar Planilla" FontWeight="Bold" VerticalAlignment="Center" />
                        
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
