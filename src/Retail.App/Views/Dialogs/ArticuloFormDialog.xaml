<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ArticuloFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="{Binding TituloVentana}"
                  Width="580"
                  Height="720"
                  MinWidth="520"
                  MinHeight="600"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada (Título Centrado y Estilizado) -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="{Binding TituloVentana}"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Formulario con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Grupo 1: Datos de Identificación -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Identificación del Producto"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Descripción -->
                        <TextBlock Text="Descripción / Nombre del Artículo *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Cuaderno Universitario A4 80 Hojas Rayado"
                                    Margin="0,0,0,12" />

                        <!-- Código de Barras -->
                        <TextBlock Text="Código de Barras (Opcional)"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. 7791234567890"
                                    FontFamily="{StaticResource FontFamilyMonospace}"
                                    Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Categoría -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Categoría (Opcional)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Categorias}"
                                          SelectedValue="{Binding IdCategoria, Mode=TwoWay}"
                                          SelectedValuePath="IdCategoria"
                                          DisplayMemberPath="NombreCategoria"
                                          Height="35"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Marca -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Marca (Opcional)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Marcas}"
                                          SelectedValue="{Binding IdMarca, Mode=TwoWay}"
                                          SelectedValuePath="IdMarca"
                                          DisplayMemberPath="NombreMarca"
                                          Height="35"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Es Servicio (no aplica a una presentación derivada, RF-21) -->
                        <CheckBox Content="Es un servicio (no posee stock)"
                                  IsChecked="{Binding EsServicio}"
                                  Visibility="{Binding NoEsDerivado, Converter={StaticResource BoolToVisConverter}}"
                                  Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Grupo 2: Fuentes del artículo (Track 4.3, A-19, RF-28). Todo queda pendiente hasta Guardar; solo el
                     artículo de compra tiene fuentes (RF-21) -->
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding NoEsDerivado, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconBoxIcons Kind="RegularLink"
                                                            Width="16" Height="16"
                                                            Foreground="{DynamicResource PrimaryBrush}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                <TextBlock Text="Fuentes del artículo"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border DockPanel.Dock="Right"
                                    Style="{StaticResource BadgePrimaryStyle}"
                                    Visibility="{Binding TieneFuentes, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding TextoCantidadFuentes}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryPressedBrush}" />
                            </Border>

                            <Border DockPanel.Dock="Right"
                                    Style="{StaticResource BadgeNeutralStyle}"
                                    Visibility="{Binding NoTieneFuentes, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Costo manual"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </DockPanel>

                        <TextBlock Text="Ordenadas por costo. La principal fija el costo de reposición; los cambios se aplican al guardar."
                                   Style="{StaticResource TextBlockCaptionSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding TieneFuentes, Converter={StaticResource BoolToVisConverter}}" />
                        <TextBlock Text="Este artículo no tiene fuentes: el costo de reposición se carga a mano."
                                   Style="{StaticResource TextBlockCaptionSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding NoTieneFuentes, Converter={StaticResource BoolToVisConverter}}" />

                        <!-- Renglones de dos líneas (opción A): en 500 px una grilla truncaría el proveedor -->
                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6"
                                Margin="0,0,0,12"
                                Visibility="{Binding TieneFuentes, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl ItemsSource="{Binding Fuentes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- OneWay + comando: el clic no escribe EsPrincipal, lo decide el ViewModel (M2) -->
                                                <RadioButton Grid.Column="0"
                                                             IsChecked="{Binding EsPrincipal, Mode=OneWay}"
                                                             Command="{Binding DataContext.MarcarPrincipalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                             CommandParameter="{Binding}"
                                                             MinWidth="0"
                                                             Padding="0"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             ToolTip="Usar como fuente principal: su costo pasa a ser el costo de reposición" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RazonSocialProveedor}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Descripcion}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding CodigoProveedor}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text=" · lista "
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FechaLocal, StringFormat={}{0:dd/MM/yyyy}}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource BadgePrimaryStyle}"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                Visibility="{Binding EsPrincipal, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="Principal"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryPressedBrush}" />
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeWarningStyle}"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                ToolTip="{Binding AvisoListaDesactualizada}"
                                                                Visibility="{Binding ListaDesactualizada, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="Lista vieja"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CostoActual, StringFormat=C2}"
                                                           Style="{StaticResource TextBlockCurrencyCell}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0" />

                                                <Button Grid.Column="3"
                                                        Style="{StaticResource IconDangerButtonStyle}"
                                                        Command="{Binding DataContext.QuitarFuenteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Quitar esta fuente (se aplica al guardar)">
                                                    <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Command="{Binding AgregarFuenteCommand}"
                                Style="{StaticResource KeycapButtonStyle}"
                                Padding="12,6"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Agregar fuente..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Grupo 3: Precios y Markup -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cálculo de Precios"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Costo de Reposición -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Costo Reposición ($)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding CostoReposicion, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                            FontFamily="{StaticResource FontFamilyNumeric}"
                                            Typography.NumeralAlignment="Tabular"
                                            PlaceholderText="0.00" />
                            </StackPanel>

                            <!-- Porcentaje de Ganancia -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Margen Ganancia (%)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding PorcentajeGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                            FontFamily="{StaticResource FontFamilyNumeric}"
                                            Typography.NumeralAlignment="Tabular"
                                            PlaceholderText="40.00" />
                            </StackPanel>
                        </Grid>

                        <!-- Aviso de costo derivado (RF-21, regla 4): editable, pero el origen lo reemplaza -->
                        <Border Style="{StaticResource BadgeWarningStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12"
                                Visibility="{Binding EsDerivado, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding AvisoCostoDerivado}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                        </Border>

                        <!-- Tarjeta de Precio de Venta Calculado -->
                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,10">
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PRECIO DE VENTA"
                                               Foreground="{DynamicResource PrimaryPressedBrush}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="$"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyNumeric}"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PrecioVentaCalculado, StringFormat={}{0:N2}}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyNumeric}"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Grupo 3: Control de Stock -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Control de Stock"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stock Actual -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stock Actual (Unidades)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ManejaStockFisico}"
                                            FontFamily="{StaticResource FontFamilyNumeric}"
                                            Typography.NumeralAlignment="Tabular"
                                            PlaceholderText="0" />
                            </StackPanel>

                            <!-- Stock Mínimo -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stock Mínimo"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ManejaStockFisico}"
                                            FontFamily="{StaticResource FontFamilyNumeric}"
                                            Typography.NumeralAlignment="Tabular"
                                            PlaceholderText="5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        Width="100" />

                <Button Content="Guardar Artículo"
                        Click="BtnGuardar_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        DockPanel.Dock="Right"
                        Padding="16,8" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
