<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ArticuloFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:helpers="clr-namespace:Retail.App.Helpers"
                  xmlns:converters="clr-namespace:Retail.App.Converters"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  Title="{Binding TituloVentana}"
                  Width="960"
                  MinHeight="0"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <!-- Producto / Servicio: los dos botones enlazan EsServicio, como el selector de reportes del Tablero.
                 Desmarcarse no escribe nada; con dos propiedades inversas, el botón que se desmarca pisaba la elección -->
            <converters:IgualAParametroConverter x:Key="IgualAParametroConverter" />
            <sys:Boolean x:Key="Verdadero">True</sys:Boolean>
            <sys:Boolean x:Key="Falso">False</sys:Boolean>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada (Título Centrado y Estilizado) -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="{Binding TituloVentana}"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Formulario en dos columnas. El ScrollViewer externo es una red de seguridad para pantallas de 768p -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ColumnGap}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Alerta de Validación -->
                <Border Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- ===================== Columna izquierda: Identificación + Stock ===================== -->
                <StackPanel Grid.Row="1" Grid.Column="0">

                    <!-- Tarjeta Identificación -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <iconPacks:PackIconBoxIcons Kind="RegularTag" Style="{StaticResource CardHeaderIconStyle}" />
                                <TextBlock Text="Identificación" Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>

                            <!-- Tipo de artículo (no aplica a una presentación derivada, RF-21) -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding NoEsDerivado, Converter={StaticResource BoolToVisConverter}}">
                                <components:SelectorSegmentado>
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="OpcionProducto"
                                                     GroupName="TipoArticulo"
                                                     IsChecked="{Binding EsServicio, Mode=TwoWay, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={StaticResource Falso}}"
                                                     AutomationProperties.Name="Producto"
                                                     Style="{StaticResource SegmentedRadioButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconBoxIcons Kind="RegularCube" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Producto" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="OpcionServicio"
                                                     GroupName="TipoArticulo"
                                                     IsChecked="{Binding EsServicio, Mode=TwoWay, Converter={StaticResource IgualAParametroConverter}, ConverterParameter={StaticResource Verdadero}}"
                                                     AutomationProperties.Name="Servicio"
                                                     IsEnabled="{Binding PuedeSerServicio}"
                                                     ToolTip="{Binding AvisoNoPuedeSerServicio}"
                                                     ToolTipService.ShowOnDisabled="True"
                                                     Style="{StaticResource SegmentedRadioButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconBoxIcons Kind="RegularMagicWand" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Servicio" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </components:SelectorSegmentado>
                                <TextBlock Text="Los servicios no llevan stock."
                                           Style="{StaticResource TextBlockCaptionSecondary}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding EsServicio, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>

                            <!-- Descripción -->
                            <TextBlock Text="Descripción *"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="ej. Cuaderno Universitario A4 80 Hojas Rayado"
                                        Margin="0,0,0,12" />

                            <!-- Código de Barras -->
                            <!-- Una sola columna para el código de barras de fábrica o un código interno corto (M11) -->
                            <TextBlock Text="Código de barras o interno"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                        helpers:EntradaNumericaHelper.SoloDigitos="True"
                                        ToolTip="Escanee el código de barras o asigne un código corto (p. ej. 11) para cargarlo rápido en el mostrador"
                                        PlaceholderText="ej. 7791234567890 o 11"
                                        FontFamily="{StaticResource FontFamilyMonospace}"
                                        Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Categoría -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Categoría"
                                               Style="{StaticResource TextBlockBodySecondary}"
                                               Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Categorias}"
                                              SelectedValue="{Binding IdCategoria, Mode=TwoWay}"
                                              SelectedValuePath="IdCategoria"
                                              DisplayMemberPath="NombreCategoria"
                                              Height="35"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Marca -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Marca"
                                               Style="{StaticResource TextBlockBodySecondary}"
                                               Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Marcas}"
                                              SelectedValue="{Binding IdMarca, Mode=TwoWay}"
                                              SelectedValuePath="IdMarca"
                                              DisplayMemberPath="NombreMarca"
                                              Height="35"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta Stock: se oculta entera para los servicios -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="16"
                            Margin="0,12,0,0"
                            Visibility="{Binding ManejaStockFisico, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <iconPacks:PackIconBoxIcons Kind="RegularPackage" Style="{StaticResource CardHeaderIconStyle}" />
                                <TextBlock Text="Stock" Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Stock actual -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding EtiquetaStockActual}"
                                               Style="{StaticResource TextBlockBodySecondary}"
                                               Margin="0,0,0,4" />

                                    <!-- Modo lectura: el stock de un artículo existente se corrige con un ajuste explícito -->
                                    <!-- Misma altura que el cuadro de Stock mínimo, para que la fila quede alineada -->
                                    <DockPanel Height="{Binding ActualHeight, ElementName=TxtStockMinimo}"
                                               Visibility="{Binding MostrarStockSoloLectura, Converter={StaticResource BoolToVisConverter}}">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Command="{Binding AjustarStockCommand}"
                                                Padding="10,0"
                                                VerticalAlignment="Stretch"
                                                AutomationProperties.Name="Ajustar stock actual"
                                                ToolTip="Corregir el stock actual (se aplica al guardar)">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Ajustar" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding StockActual}"
                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Modo edición: artículo nuevo o ajuste en curso -->
                                    <StackPanel Visibility="{Binding StockActualEditable, Converter={StaticResource BoolToVisConverter}}">
                                        <ui:TextBox Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged}"
                                                    helpers:EntradaNumericaHelper.SoloDigitos="True"
                                                    FontFamily="{StaticResource FontFamilyNumeric}"
                                                    Typography.NumeralAlignment="Tabular"
                                                    PlaceholderText="0" />
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,6,0,0"
                                                    Visibility="{Binding MostrarAccionesAjusteStock, Converter={StaticResource BoolToVisConverter}}">
                                            <Button Style="{StaticResource GhostPrimaryButtonStyle}"
                                                    Command="{Binding ConfirmarAjusteStockCommand}"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Aceptar" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostPrimaryButtonStyle}"
                                                    Command="{Binding DescartarAjusteStockCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconBoxIcons Kind="RegularUndo" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Descartar" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding TextoAjusteStock}"
                                               Style="{StaticResource TextBlockCaptionSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding TieneAjusteStock, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>

                                <!-- Stock mínimo -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Stock mínimo"
                                               Style="{StaticResource TextBlockBodySecondary}"
                                               Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtStockMinimo"
                                                Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}"
                                                helpers:EntradaNumericaHelper.SoloDigitos="True"
                                                FontFamily="{StaticResource FontFamilyNumeric}"
                                                Typography.NumeralAlignment="Tabular"
                                                PlaceholderText="5" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Columna derecha: Fuentes + Precio ===================== -->
                <StackPanel Grid.Row="1" Grid.Column="2">

                    <!-- Tarjeta Fuentes del artículo (Track 4.3, A-19, RF-28). Todo queda pendiente hasta Guardar; solo el
                         artículo de compra tiene fuentes (RF-21) -->
                    <!-- El espacio hasta Precio va en esta tarjeta: si se oculta, Precio queda alineado con Identificación -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="{Binding MostrarFuentes, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconBoxIcons Kind="RegularLink" Style="{StaticResource CardHeaderIconStyle}" />
                                    <TextBlock Text="Fuentes del artículo" Style="{StaticResource CardHeaderTextStyle}" />
                                </StackPanel>


                                <Border DockPanel.Dock="Right"
                                        Style="{StaticResource BadgeNeutralStyle}"
                                        Visibility="{Binding NoTieneFuentes, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="Costo manual"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </DockPanel>

                            <TextBlock Text="La fuente principal fija el costo."
                                       Style="{StaticResource TextBlockCaptionSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Visibility="{Binding TieneFuentes, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="Este artículo no tiene fuentes: el costo de reposición se carga a mano."
                                       Style="{StaticResource TextBlockCaptionSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Visibility="{Binding NoTieneFuentes, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Renglones de dos líneas. Con más de 3 fuentes scrollea solo la lista y el precio sigue a la vista -->
                            <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="6"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding TieneFuentes, Converter={StaticResource BoolToVisConverter}}">
                                <!-- El recorte redondeado evita que el fondo rosa de la principal tape las esquinas del borde -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              MaxHeight="168"
                                              helpers:EsquinasHelper.RadioDelRecorte="5">
                                    <ItemsControl ItemsSource="{Binding Fuentes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="8">
                                                    <!-- La fuente principal se distingue con el carmín suave de selección -->
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsPrincipal}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- OneWay + comando: el clic no escribe EsPrincipal, lo decide el ViewModel (M2) -->
                                                        <RadioButton Grid.Column="0"
                                                                     IsChecked="{Binding EsPrincipal, Mode=OneWay}"
                                                                     Command="{Binding DataContext.MarcarPrincipalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     CommandParameter="{Binding}"
                                                                     MinWidth="0"
                                                                     Padding="0"
                                                                     Margin="0,0,8,0"
                                                                     VerticalAlignment="Center"
                                                                     AutomationProperties.Name="{Binding RazonSocialProveedor, StringFormat='Usar {0} como fuente principal'}"
                                                                     ToolTip="Usar como fuente principal: su costo pasa a ser el costo de reposición" />

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RazonSocialProveedor}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Descripcion}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="Cód. "
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CodigoProveedor}"
                                                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text=" · lista "
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding FechaLocal, StringFormat={}{0:dd/MM/yyyy}}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <Border Style="{StaticResource BadgePrimaryStyle}"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        Visibility="{Binding EsPrincipal, Converter={StaticResource BoolToVisConverter}}">
                                                                    <TextBlock Text="Principal"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PrimaryPressedBrush}" />
                                                                </Border>
                                                                <Border Style="{StaticResource BadgeWarningStyle}"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        ToolTip="{Binding AvisoListaDesactualizada}"
                                                                        Visibility="{Binding ListaDesactualizada, Converter={StaticResource BoolToVisConverter}}">
                                                                    <TextBlock Text="Lista vieja"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource WarningForegroundBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CostoActual, StringFormat=C2}"
                                                                   Style="{StaticResource TextBlockCurrencyCell}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0" />

                                                        <Button Grid.Column="3"
                                                                Style="{StaticResource IconDangerButtonStyle}"
                                                                Command="{Binding DataContext.QuitarFuenteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding RazonSocialProveedor, StringFormat='Quitar la fuente {0}'}"
                                                                ToolTip="Quitar esta fuente (se aplica al guardar)">
                                                            <iconPacks:PackIconBoxIcons Kind="RegularX" Width="10" Height="10" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Button Command="{Binding AgregarFuenteCommand}"
                                    Style="{StaticResource KeycapButtonStyle}"
                                    Padding="12,6"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Agregar fuente..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta Precio -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <iconPacks:PackIconBoxIcons Kind="RegularCalculator" Style="{StaticResource CardHeaderIconStyle}" />
                                <TextBlock Text="Precio" Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Costo de reposición: editable a mano o de solo lectura cuando lo fija la fuente principal -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Costo de reposición"
                                               Style="{StaticResource TextBlockBodySecondary}"
                                               Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding CostoReposicion, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                                helpers:EntradaNumericaHelper.SoloDecimal="True"
                                                FontFamily="{StaticResource FontFamilyNumeric}"
                                                Typography.NumeralAlignment="Tabular"
                                                PlaceholderText="0.00"
                                                Visibility="{Binding CostoEditable, Converter={StaticResource BoolToVisConverter}}" />
                                    <!-- Campo de solo lectura: misma altura y relleno que el cuadro de Margen, para que los
                                         dos valores queden en la misma línea; el fondo gris y el candado dicen que no se edita -->
                                    <StackPanel Visibility="{Binding CostoSoloLectura, Converter={StaticResource BoolToVisConverter}}">
                                        <Border Height="{Binding ActualHeight, ElementName=TxtMargen}"
                                                Background="{DynamicResource SurfaceBackgroundBrush}"
                                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,0"
                                                ToolTip="{Binding TextoOrigenCosto}">
                                            <DockPanel>
                                                <iconPacks:PackIconBoxIcons DockPanel.Dock="Right"
                                                                            Kind="RegularLock"
                                                                            Width="14"
                                                                            Height="14"
                                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                                            VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CostoReposicion, StringFormat=C2}"
                                                           FontFamily="{StaticResource FontFamilyNumeric}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="{Binding TextoOrigenCosto}"
                                                   Style="{StaticResource TextBlockCaptionSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Porcentaje de ganancia -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Margen de ganancia (%)"
                                               Style="{StaticResource TextBlockBodySecondary}"
                                               Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtMargen"
                                                Text="{Binding PorcentajeGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                                helpers:EntradaNumericaHelper.SoloDecimal="True"
                                                FontFamily="{StaticResource FontFamilyNumeric}"
                                                Typography.NumeralAlignment="Tabular"
                                                PlaceholderText="40.00" />
                                </StackPanel>
                            </Grid>

                            <!-- Aviso de costo derivado (RF-21, regla 4): editable, pero el origen lo reemplaza -->
                            <Border Style="{StaticResource BadgeWarningStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding EsDerivado, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding AvisoCostoDerivado}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningForegroundBrush}" />
                            </Border>

                            <!-- Resultado: precio de venta calculado. El carmín queda reservado al botón primario -->
                            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16,10"
                                    Margin="0,12,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Precio de venta"
                                               Style="{StaticResource TextBlockBodySecondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding PrecioVentaCalculado, StringFormat=C2}"
                                               Style="{StaticResource TextBlockCurrencyLarge}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        Width="100" />

                <Button Content="Guardar Artículo"
                        Click="BtnGuardar_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        DockPanel.Dock="Right"
                        Padding="16,8" />
            </DockPanel>
        </Border>
