<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ArticuloFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="{Binding TituloVentana}"
                  Width="580"
                  Height="720"
                  MinWidth="520"
                  MinHeight="600"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada (Título Centrado y Estilizado) -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Padding="8,0"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="{Binding TituloVentana}"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Formulario con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Grupo 1: Datos de Identificación -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Identificación del Producto"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Descripción -->
                        <TextBlock Text="Descripción / Nombre del Artículo *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Cuaderno Universitario A4 80 Hojas Rayado"
                                    Margin="0,0,0,12" />

                        <!-- Código de Barras -->
                        <TextBlock Text="Código de Barras (Opcional)"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. 7791234567890"
                                    FontFamily="{StaticResource FontFamilyMonospace}"
                                    Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Categoría -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Categoría (Opcional)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Categorias}"
                                          SelectedValue="{Binding IdCategoria, Mode=TwoWay}"
                                          SelectedValuePath="IdCategoria"
                                          DisplayMemberPath="NombreCategoria"
                                          Height="35"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Marca -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Marca (Opcional)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Marcas}"
                                          SelectedValue="{Binding IdMarca, Mode=TwoWay}"
                                          SelectedValuePath="IdMarca"
                                          DisplayMemberPath="NombreMarca"
                                          Height="35"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Es Servicio -->
                        <CheckBox Content="Es un servicio (no posee stock)"
                                  IsChecked="{Binding EsServicio}"
                                  Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Grupo 2: Enlace con Distribuidor / Proveedor -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconBoxIcons Kind="RegularLink"
                                                            Width="16" Height="16"
                                                            Foreground="{DynamicResource PrimaryBrush}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                <TextBlock Text="Enlace con Distribuidor / Proveedor"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Badge cuando está vinculado -->
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding EstaVinculadoAProveedor, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Vinculado a Catálogo"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryPressedBrush}" />
                            </Border>

                            <!-- Badge cuando NO está vinculado -->
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding NoEstaVinculadoAProveedor, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Costo Manual / Independiente"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </DockPanel>

                        <!-- Estado Desvinculado -->
                        <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Visibility="{Binding NoEstaVinculadoAProveedor, Converter={StaticResource BoolToVisConverter}}">
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center" MaxWidth="320">
                                    <TextBlock Text="Artículo sin enlace a catálogo externo."
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="El costo de reposición gestiona de forma manual."
                                               Style="{StaticResource TextBlockBodySecondary}"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Command="{Binding VincularCatalogoCommand}"
                                        Style="{StaticResource KeycapButtonStyle}"
                                        Padding="12,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconBoxIcons Kind="RegularLink" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Vincular con Distribuidor..." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>

                        <!-- Estado Vinculado -->
                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Visibility="{Binding EstaVinculadoAProveedor, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Info Proveedor y Artículo -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <iconPacks:PackIconBoxIcons Kind="RegularBuilding" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ProveedorRazonSocial}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource PrimaryPressedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="Cód. Proveedor: "
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding CodigoProveedor}"
                                                       FontSize="11"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding DescripcionProveedor}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Costo en Catálogo -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Costo en Catálogo"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CostoProveedor, StringFormat={}{0:C2}}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{DynamicResource SurfaceBorderBrush}" Margin="0,4,0,8" />

                                <!-- Botones de Acción de Enlace -->
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="💡 Costo sincronizado con la lista del proveedor."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Command="{Binding DesvincularCatalogoCommand}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="8,4"
                                                Margin="0,0,8,0"
                                                ToolTip="Eliminar la vinculación con el distribuidor y pasar a costo manual">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconBoxIcons Kind="RegularUnlink" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                                                <TextBlock Text="Desvincular" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding VincularCatalogoCommand}"
                                                Style="{StaticResource KeycapButtonStyle}"
                                                Padding="8,4"
                                                ToolTip="Cambiar el artículo vinculado del distribuidor">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconBoxIcons Kind="RegularRefreshCw" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Cambiar..." FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Grupo 3: Precios y Markup -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cálculo de Precios"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Costo de Reposición -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Costo Reposición ($)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding CostoReposicion, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="0.00" />
                            </StackPanel>

                            <!-- Porcentaje de Ganancia -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Margen Ganancia (%)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding PorcentajeGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="40.00" />
                            </StackPanel>
                        </Grid>

                        <!-- Tarjeta de Precio de Venta Calculado -->
                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,10">
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PRECIO DE VENTA"
                                               Foreground="{DynamicResource PrimaryPressedBrush}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="$"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PrecioVentaCalculado, StringFormat={}{0:N2}}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Grupo 3: Control de Stock -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Control de Stock"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stock Actual -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stock Actual (Unidades)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ManejaStockFisico}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="0" />
                            </StackPanel>

                            <!-- Stock Mínimo -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stock Mínimo"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ManejaStockFisico}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        Width="100" />

                <Button Content="Guardar Artículo"
                        Click="BtnGuardar_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        DockPanel.Dock="Right"
                        Padding="16,8" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
