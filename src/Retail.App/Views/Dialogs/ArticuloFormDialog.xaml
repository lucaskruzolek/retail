<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ArticuloFormDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{Binding TituloVentana}"
                  Width="560"
                  Height="640"
                  MinWidth="500"
                  MinHeight="580"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding TituloVentana}"
                     Padding="8,0,0,0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Tag24" Foreground="{DynamicResource PrimaryBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Formulario con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Grupo 1: Datos de Identificación -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Identificación del Producto"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Descripción -->
                        <TextBlock Text="Descripción / Nombre del Artículo *"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. Cuaderno Universitario A4 80 Hojas Rayado"
                                    Margin="0,0,0,12" />

                        <!-- Código de Barras -->
                        <TextBlock Text="Código de Barras (Opcional si es producto artesanal o servicio)"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. 7791234567890 (Dejar vacío para artesanías)"
                                    FontFamily="{StaticResource FontFamilyMonospace}"
                                    Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Categoría -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Categoría / Rubro (Opcional)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Categorias}"
                                          SelectedValue="{Binding IdCategoria}"
                                          SelectedValuePath="IdCategoria"
                                          DisplayMemberPath="NombreCategoria"
                                          Height="35"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Marca -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Marca / Fabricante (Opcional)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Marcas}"
                                          SelectedValue="{Binding IdMarca}"
                                          SelectedValuePath="IdMarca"
                                          DisplayMemberPath="NombreMarca"
                                          Height="35"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Es Servicio -->
                        <CheckBox Content="Es un servicio (no descuenta stock físico ni genera alertas)"
                                  IsChecked="{Binding EsServicio}"
                                  Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Grupo 2: Precios y Markup -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cálculo de Precios y Margen de Ganancia (Markup)"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Costo de Reposición -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Costo Reposición ($) *"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding CostoReposicion, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="0.00" />
                            </StackPanel>

                            <!-- Porcentaje de Ganancia -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Margen Ganancia (%) *"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding PorcentajeGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="40.00" />
                            </StackPanel>
                        </Grid>

                        <!-- Tarjeta de Precio de Venta Calculado -->
                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,10">
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PRECIO DE VENTA SUGERIDO"
                                               Foreground="{DynamicResource PrimaryPressedBrush}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Calculado reactivamente según fórmula de markup"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="$"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PrecioVentaCalculado, StringFormat={}{0:N2}}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Grupo 3: Control de Stock -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Control de Existencias (Stock Físico)"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stock Actual -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stock Actual (Unidades)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ManejaStockFisico}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="0" />
                            </StackPanel>

                            <!-- Stock Mínimo -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stock Mínimo (Alerta Crítica)"
                                           Style="{StaticResource TextBlockBodySecondary}"
                                           Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ManejaStockFisico}"
                                            FontFamily="{StaticResource FontFamilyMonospace}"
                                            PlaceholderText="5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        Click="BtnCancelar_Click"
                        Style="{StaticResource KeycapButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        Width="100" />

                <Button Content="Guardar Artículo"
                        Click="BtnGuardar_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"
                        DockPanel.Dock="Right"
                        Padding="16,8" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
