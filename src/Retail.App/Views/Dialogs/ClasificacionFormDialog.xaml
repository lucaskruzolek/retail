<ui:FluentWindow x:Class="Retail.App.Views.Dialogs.ClasificacionFormDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:Retail.App.Views.Components"
                 Title="{Binding TituloVentana}"
                 Width="460"
                 MinWidth="420"
                 MinHeight="0"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource DialogBackgroundBrush}"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título: título y botones de ventana en la misma banda -->
        <components:EncabezadoDialogo Titulo="{Binding TituloVentana}" />

        <!-- Contenido Central -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
            <StackPanel>
                <!-- Alerta de Validación -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource DialogSectionStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Nombre -->
                        <TextBlock Text="{Binding EtiquetaNombre}"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Rubro (solo categorías) -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding MostrarRubro, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Rubro *"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Rubros}"
                                      SelectedItem="{Binding RubroSeleccionado}"
                                      DisplayMemberPath="NombreRubro" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior de Acciones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource KeycapButtonStyle}"
                        Margin="0,0,10,0"
                        IsCancel="True">
                    <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                </Button>

                <Button Command="{Binding GuardarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsDefault="True">
                    <TextBlock Text="Guardar" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
