<ui:FluentWindow x:Class="Retail.App.Views.Auth.LoginWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:helpers="clr-namespace:Retail.App.Helpers"
                  xmlns:components="clr-namespace:Retail.App.Views.Components"
                  Title="Retail POS - Inicio de sesión"
                  Width="440"
                  Height="480"
                  MinWidth="400"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="CanMinimize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de los diálogos sin título: solo minimizar y cerrar (el logo ya dice qué aplicación es). Esc no cierra:
             cerrar el inicio de sesión termina la aplicación. -->
        <components:EncabezadoDialogo Grid.Row="0" CerrarConEscape="False" />

        <!-- Contenedor Central: arriba, pegado a la banda, para que la ventana no tenga aire muerto -->
        <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Width="360" Margin="0,0,0,28">
            <StackPanel>
                <!-- Logotipo e Identidad Visual -->
                <StackPanel HorizontalAlignment="Center" Margin="{StaticResource StackXl}">
                    <!-- Logo horizontal de Retail, la versión principal de la marca (Views/Components/LogoRetail.cs). -->
                    <components:LogoRetail Variante="Horizontal"
                                           Height="34"
                                           HorizontalAlignment="Center"
                                           Margin="{StaticResource StackMd}" />

                    <TextBlock Text="Acceso a mostrador y gestión"
                               Style="{StaticResource TextBlockBodySecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Credenciales: sección sin borde sobre el fondo del diálogo -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <!-- Mensaje de Error / Feedback de Validación -->
                        <Border Background="{DynamicResource DangerBackgroundBrush}"
                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="{StaticResource StackLg}"
                                Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularAlertTriangle"
                                                            Width="14"
                                                            Height="14"
                                                            Foreground="{DynamicResource DangerForegroundBrush}"
                                                            Margin="{StaticResource InlineSm}"
                                                            VerticalAlignment="Top" />
                                <TextBlock Text="{Binding MensajeError}"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextWrapping="Wrap"
                                           Width="260" />
                            </StackPanel>
                        </Border>

                        <!-- Usuario -->
                        <TextBlock Text="Usuario"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ui:TextBox x:Name="TxtUsuario"
                                    Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Ingrese su usuario"
                                    Margin="{StaticResource StackMd}" />

                        <!-- Contraseña -->
                        <TextBlock Text="Contraseña"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ui:PasswordBox x:Name="TxtPassword"
                                        PlaceholderText="Ingrese su contraseña"
                                        Margin="{StaticResource StackXl}" />

                        <!-- Botón de Ingreso Principal -->
                        <Button x:Name="BtnIngresar"
                                Click="BtnIngresar_Click"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                helpers:ButtonHelper.IsLoading="{Binding EstaCargando}"
                                helpers:ButtonHelper.LoadingText="Iniciando sesión..."
                                IsDefault="True"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconBoxIcons Kind="RegularUserCheck"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="{StaticResource InlineSm}"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="Iniciar sesión" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
