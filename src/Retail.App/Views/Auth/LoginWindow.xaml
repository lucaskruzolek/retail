<ui:FluentWindow x:Class="Retail.App.Views.Auth.LoginWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:helpers="clr-namespace:Retail.App.Helpers"
                  Title="Retail POS - Inicio de Sesión"
                  Width="440"
                  Height="540"
                  MinWidth="400"
                  MinHeight="480"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource DialogBackgroundBrush}"
                  ResizeMode="CanMinimize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent Estandarizada (Título Centrado y Estilizado) -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         MinHeight="32"
                         Padding="8,0"
                         Background="{DynamicResource DialogBackgroundBrush}"
                         ShowMaximize="False"
                         CanMaximize="False" />
            <TextBlock Text="Retail POS"
                       FontFamily="{StaticResource FontFamilyText}"
                       FontSize="{StaticResource FontSizeSm}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Contenedor Central -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Margin="0,0,0,24">
            <StackPanel>
                <!-- Logotipo e Identidad Visual -->
                <StackPanel HorizontalAlignment="Center" Margin="{StaticResource StackXl}">
                    <Border Background="{DynamicResource PrimaryLightBrush}"
                            CornerRadius="24"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            Margin="{StaticResource StackMd}">
                        <iconPacks:PackIconBoxIcons Kind="RegularLock"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Retail POS"
                               Style="{StaticResource TextBlockHeader1}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Acceso a Mostrador y Gestión"
                               Style="{StaticResource TextBlockBodySecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Credenciales: sección sin borde sobre el fondo del diálogo -->
                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <!-- Mensaje de Error / Feedback de Validación -->
                        <Border Background="{DynamicResource DangerBackgroundBrush}"
                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="{StaticResource StackLg}"
                                Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularAlertTriangle"
                                                            Width="14"
                                                            Height="14"
                                                            Foreground="{DynamicResource DangerForegroundBrush}"
                                                            Margin="{StaticResource InlineSm}"
                                                            VerticalAlignment="Top" />
                                <TextBlock Text="{Binding MensajeError}"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextWrapping="Wrap"
                                           Width="260" />
                            </StackPanel>
                        </Border>

                        <!-- Usuario -->
                        <TextBlock Text="Usuario"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ui:TextBox x:Name="TxtUsuario"
                                    Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Ingrese su usuario"
                                    Margin="{StaticResource StackMd}" />

                        <!-- Contraseña -->
                        <TextBlock Text="Contraseña"
                                   Style="{StaticResource TextBlockBodySecondary}"
                                   Margin="{StaticResource StackXs}" />
                        <ui:PasswordBox x:Name="TxtPassword"
                                        PlaceholderText="Ingrese su contraseña"
                                        Margin="{StaticResource StackXl}" />

                        <!-- Botón de Ingreso Principal -->
                        <Button x:Name="BtnIngresar"
                                Click="BtnIngresar_Click"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                helpers:ButtonHelper.IsLoading="{Binding EstaCargando}"
                                helpers:ButtonHelper.LoadingText="Iniciando sesión..."
                                IsDefault="True"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconBoxIcons Kind="RegularUserCheck"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="{StaticResource InlineSm}"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="Iniciar Sesión" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
