<ui:FluentWindow x:Class="Retail.App.Views.Auth.LoginWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Retail POS - Inicio de Sesión"
                  Width="440"
                  Height="540"
                  MinWidth="400"
                  MinHeight="480"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  ResizeMode="CanMinimize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Retail.App;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Retail.App;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <ui:TitleBar Grid.Row="0"
                     Title="Retail POS"
                     Padding="8,0,0,0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BarcodeScanner24" Foreground="{DynamicResource PrimaryBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Contenedor Central -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Margin="0,0,0,24">
            <StackPanel>
                <!-- Logotipo e Identidad Visual -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Path Data="{StaticResource GeometryLock}"
                              Fill="{DynamicResource PrimaryBrush}"
                              Width="22"
                              Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Retail POS"
                               Style="{StaticResource TextBlockHeader1}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               FontWeight="Bold" />

                    <TextBlock Text="Acceso a Mostrador y Gestión"
                               Style="{StaticResource TextBlockCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Tarjeta de Credenciales -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel>
                        <!-- Mensaje de Error / Feedback de Validación -->
                        <Border Background="{DynamicResource DangerBackgroundBrush}"
                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,14"
                                Visibility="{Binding TieneError, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeometryWarning}"
                                      Fill="{DynamicResource DangerForegroundBrush}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Top" />
                                <TextBlock Text="{Binding MensajeError}"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Width="260" />
                            </StackPanel>
                        </Border>

                        <!-- Usuario -->
                        <TextBlock Text="Usuario"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ui:TextBox x:Name="TxtUsuario"
                                    Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. admin o cajero"
                                    Margin="0,0,0,12" />

                        <!-- Contraseña -->
                        <TextBlock Text="Contraseña"
                                   Style="{StaticResource TextBlockCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ui:PasswordBox x:Name="TxtPassword"
                                        PlaceholderText="Ingrese su contraseña"
                                        KeyDown="TxtPassword_KeyDown"
                                        Margin="0,0,0,20" />

                        <!-- Botón de Ingreso Principal -->
                        <Button x:Name="BtnIngresar"
                                Click="BtnIngresar_Click"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                IsDefault="True"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeometryUser}"
                                      Fill="White"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Iniciar Sesión"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Pie Informativo -->
                <TextBlock Text="v1.0.0-preview (.NET 8 LTS | Clean Monolith)"
                           Style="{StaticResource TextBlockCaption}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
