<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- FAMILIAS TIPOGRÁFICAS (Segoe UI Variable + Cascadia Code)         -->
    <!-- ================================================================= -->
    <FontFamily x:Key="FontFamilyText">Segoe UI Variable Text, Segoe UI, Helvetica Neue, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMonospace">Cascadia Code, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="CascadiaCodeFontFamily">Cascadia Code, Consolas, Courier New</FontFamily>

    <!-- ================================================================= -->
    <!-- ESCALA TIPOGRÁFICA DE TEXTBLOCK                                   -->
    <!-- ================================================================= -->

    <!-- Título Principal de Pantalla (22px, SemiBold) -->
    <Style x:Key="TextBlockHeader1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Subtítulo o Cabecera de Sección / Modal (16px, SemiBold) -->
    <Style x:Key="TextBlockHeader2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Cuerpo de Texto Estándar (14px, Regular) -->
    <Style x:Key="TextBlockBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Cuerpo de Texto Secundario (14px, Regular, Muted) -->
    <Style x:Key="TextBlockBodySecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Texto de Ayuda o Leyenda (12px, Regular) -->
    <Style x:Key="TextBlockCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Texto de Ayuda Secundario o Metadatos (11px, Regular) -->
    <Style x:Key="TextBlockCaptionSecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Cuerpo de Texto Apagado / Muted (13px, Regular) -->
    <Style x:Key="TextBlockBodyMuted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Total Gigante para Mostrador POS (32px, Bold, Monospace, alineado a la derecha) -->
    <Style x:Key="TextBlockDisplayCurrency" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- Importe Destacado / Saldo Deudor para Diálogos y Modales (24px, Bold, Monospace) -->
    <Style x:Key="TextBlockCurrencyLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- Celda de Precios y Subtotales en Grillas (14px, SemiBold, Monospace, alineado verticalmente al centro) -->
    <Style x:Key="TextBlockCurrencyCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Celda Monoespaciada Estándar en Grillas (Códigos de barra, Documentos, IDs - 13px, Cascadia Code) -->
    <Style x:Key="TextBlockMonospaceCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Celda de Texto Estándar en Grillas (14px, Regular, Segoe UI Variable, centrado vertical) -->
    <Style x:Key="TextBlockTextCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Etiqueta de Tecla Rápida [F1] a [F12] (11px, Bold, Monospace) -->
    <Style x:Key="TextBlockKeycap" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource KeycapForegroundBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Texto de Tecla Rápida Compacta (10px, Bold, Monospace) -->
    <Style x:Key="KeycapTextSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource KeycapForegroundBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
