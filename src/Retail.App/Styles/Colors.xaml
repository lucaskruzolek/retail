<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- SOBRESCRITURA DE PALETA DE ACENTO DE WPF-UI (Carmín / Borravino)  -->
    <!-- ================================================================= -->
    <Color x:Key="SystemAccentColor">#9D0F33</Color>
    <Color x:Key="SystemAccentColorLight1">#B8153E</Color>
    <Color x:Key="SystemAccentColorLight2">#D92B54</Color>
    <Color x:Key="SystemAccentColorLight3">#F36F8E</Color>
    <Color x:Key="SystemAccentColorDark1">#850C2A</Color>
    <Color x:Key="SystemAccentColorDark2">#6B0720</Color>
    <Color x:Key="SystemAccentColorDark3">#4D0416</Color>

    <SolidColorBrush x:Key="SystemAccentBrush" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentBrushLight1" Color="{StaticResource SystemAccentColorLight1}" />
    <SolidColorBrush x:Key="SystemAccentBrushLight2" Color="{StaticResource SystemAccentColorLight2}" />
    <SolidColorBrush x:Key="SystemAccentBrushLight3" Color="{StaticResource SystemAccentColorLight3}" />
    <SolidColorBrush x:Key="SystemAccentBrushDark1" Color="{StaticResource SystemAccentColorDark1}" />
    <SolidColorBrush x:Key="SystemAccentBrushDark2" Color="{StaticResource SystemAccentColorDark2}" />
    <SolidColorBrush x:Key="SystemAccentBrushDark3" Color="{StaticResource SystemAccentColorDark3}" />

    <!-- Casillas e interruptores encendidos en neutro (tinta del tema), no en carmín: el acento queda para la acción
         principal, el foco y el ítem activo. La marca de la casilla y la perilla toman el color opuesto para contrastar. -->
    <SolidColorBrush x:Key="ControlCheckedBrush" Color="#18181B" />
    <SolidColorBrush x:Key="ControlCheckedHoverBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="ControlCheckedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#18181B" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3F3F46" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#18181B" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#3F3F46" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#18181B" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#3F3F46" />

    <!-- Campo de texto con foco: contorno neutro más marcado en lugar del carmín de acento, y sin el subrayado de 2 px -->
    <SolidColorBrush x:Key="ControlFocusedBorderBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

    <!-- ================================================================= -->
    <!-- TOKENS SEMÁNTICOS DE MARCA Y ACCIÓN PRINCIPAL (RETAIL)            -->
    <!-- ================================================================= -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#9D0F33" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#850C2A" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#6B0720" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FDF2F4" />
    <!-- Contorno suave del carmín: opción marcada de las píldoras (el PrimaryBrush pleno pesaba demasiado) -->
    <SolidColorBrush x:Key="PrimarySoftBorderBrush" Color="#E8B9C4" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />

    <!-- ================================================================= -->
    <!-- TOKENS DE SUPERFICIES Y FONDOS (ZINC NEUTRAL)                     -->
    <!-- ================================================================= -->
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FAFAFA" />
    <!-- Fondo de un diálogo: un gris algo más marcado que el de la página, para que sus secciones blancas se lean sin borde -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#E8E8EC" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="SurfaceBorderFocusedBrush" Color="#9D0F33" />
    <!-- Neutro: antes era el rosa de PrimaryLight y el hover se confundía con la selección -->
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F4F4F5" />
    <!-- Rieles y cabeceras -->
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#EEEEF0" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E4E4E7" />
    <!-- Divisores de fila -->
    <SolidColorBrush x:Key="SurfaceBorderSubtleBrush" Color="#F0F0F2" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#18181B" />

    <!-- ================================================================= -->
    <!-- TOKENS DE TEXTO                                                   -->
    <!-- ================================================================= -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18181B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#52525B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA" />
    <!-- Títulos de tarjeta "grabados": entre secundario y atenuado, 4,8:1 sobre blanco (cumple AA, que el atenuado no) -->
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#71717A" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FAFAFA" />
    <!-- Título de sección de un modal y el ícono que lo precede: los dos toman este mismo token -->
    <SolidColorBrush x:Key="SectionTitleBrush" Color="#18181B" />

    <!-- ================================================================= -->
    <!-- TOKENS DE ESTADO Y SEMÁFOROS DE NEGOCIO (LIBRERÍA POS)            -->
    <!-- ================================================================= -->
    <!-- Alerta de Stock Mínimo / Advertencia de Caja -->
    <Color x:Key="WarningColor">#D97706</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#92400E" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FCD34D" />

    <!-- Error Fiscal ARCA / Límite de Crédito Excedido -->
    <Color x:Key="DangerColor">#DC2626</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FCA5A5" />

    <!-- Éxito / Cobro Confirmado / Turno de Caja Abierto -->
    <Color x:Key="SuccessColor">#059669</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#D1FAE5" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#065F46" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#6EE7B7" />

    <!-- Botones de Teclado Rápido de Mostrador (Keycaps F1 a F12) -->
    <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="#27272A" />
    <SolidColorBrush x:Key="KeycapForegroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="KeycapPrimaryBackgroundBrush" Color="#6B0720" />
    <SolidColorBrush x:Key="KeycapPrimaryBorderBrush" Color="#850C2A" />

    <!-- Elevación de superficies flotantes (popups, desplegables): color de la sombra de DropShadowEffect -->
    <Color x:Key="ElevationShadowColor">#18181B</Color>

    <!-- ================================================================= -->
    <!-- TOKENS DEL SIDEBAR (SUPERFICIE CLARA EN EL TEMA CLARO)            -->
    <!-- ================================================================= -->
    <!-- El carmín de marca (#9D0F33) sobre el fondo del sidebar (#F4F4F5) da cerca de 8:1: sirve como ícono o texto de
         acento (SidebarAccentBrush). El texto fuerte (#18181B) y el secundario (#52525B) superan AA con holgura. -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#EAEAEC" />
    <SolidColorBrush x:Key="SidebarPressedBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#52525B" />
    <SolidColorBrush x:Key="SidebarTextStrongBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="#71717A" />
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="#9D0F33" />
    <SolidColorBrush x:Key="SidebarActiveBackgroundBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="SidebarActiveForegroundBrush" Color="#18181B" />

</ResourceDictionary>
