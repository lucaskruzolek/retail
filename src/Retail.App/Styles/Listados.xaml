<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:components="clr-namespace:Retail.App.Views.Components">

    <!-- ================================================================= -->
    <!-- LISTADOS: BUSCADOR + FILTROS + GRILLA (Artículos, Clientes, ...)  -->
    <!-- ================================================================= -->
    <!-- Estilos compartidos por las páginas de listado. Se cargan después de Controls.xaml porque derivan de sus estilos.
         DataGridRetailStyle sigue siendo la grilla compacta (POS, modales); DataGridListadoStyle es la de las páginas. -->

    <!-- Encabezado liviano: peso normal y gris medio, para que la jerarquía la lleve el dato y no el título de columna -->
    <Style x:Key="DataGridColumnHeaderListadoStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRetailStyle}">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="DataGridColumnHeaderRightListadoStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderListadoStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="DataGridColumnHeaderCenterListadoStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderListadoStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Fila de una línea (44 px). La selección es un tinte carmín suave sin borde carmín (el carmín se reserva para la
         marca y las acciones); el hover es un gris suave que no se confunde con la selección. Es una copia de la plantilla
         de DataGridRowRetailStyle sin los triggers de la plantilla: la selección y el hover viven en Style.Triggers para que
         un estilo derivado los pueda redefinir (un trigger de ControlTemplate no se puede sobrescribir desde afuera). Una
         página con casillas de selección deriva este estilo y hace que el tinte siga a la casilla y no a la fila actual. -->
    <Style x:Key="DataGridRowListadoStyle" TargetType="DataGridRow">
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="DGR_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Column="1"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <DataGridDetailsPresenter Grid.Column="1"
                                                      Grid.Row="1"
                                                      SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                      Visibility="{TemplateBinding DetailsVisibility}" />
                            <DataGridRowHeader Grid.RowSpan="2"
                                               SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                               Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                        </SelectiveScrollingGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Grilla de las páginas de listado: ocupa todo el alto de su fila, así su borde redondeado llega hasta la paginación
         aunque haya pocas filas (el alto sobrante queda del color de la tarjeta) -->
    <Style x:Key="DataGridListadoStyle" TargetType="DataGrid" BasedOn="{StaticResource DataGridRetailStyle}">
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderListadoStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DataGridRowListadoStyle}" />
        <!-- La línea entre filas la dibuja la propia fila (borde inferior): sin esto se duplicaría -->
        <Setter Property="GridLinesVisibility" Value="None" />
    </Style>

    <!-- ================================================================= -->
    <!-- FILTROS: ETIQUETA ARRIBA Y CONTROL DEBAJO                         -->
    <!-- ================================================================= -->
    <!-- Uso: <HeaderedContentControl Header="Rubro" Style="{StaticResource FilterFieldStyle}"><ComboBox .../></...>.
         Sin código: el encabezado se pinta como texto chico y el contenido ocupa todo el ancho de su columna. -->
    <Style x:Key="FilterFieldStyle" TargetType="HeaderedContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <ContentPresenter ContentSource="Header"
                                          Margin="0,0,0,4"
                                          TextElement.FontSize="12"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selector de filtro: 36 px de alto y a todo el ancho de su columna (los textos largos no se cortan) -->
    <Style x:Key="ComboBoxFiltroStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ================================================================= -->
    <!-- BOTONES SECUNDARIOS DE LISTADO                                    -->
    <!-- ================================================================= -->
    <!-- Acción de texto sin borde ni fondo ("Limpiar filtros"): gris en reposo, fondo suave en hover. Es la versión
         neutra de GhostPrimaryButtonStyle, que queda para acciones de marca. -->
    <Style x:Key="GhostNeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostPrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================= -->
    <!-- BANDA DE FILTROS Y MENÚ DE FILA                                   -->
    <!-- ================================================================= -->
    <!-- Superficie hundida que agrupa los filtros de un listado (fondo de página con borde, un escalón por debajo de la
         tarjeta). Adentro, la página arma un Grid de una fila con columnas "*" y un FilterField por columna. -->
    <Style x:Key="FilterBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Botón "⋮" de una fila: 32 x 32 (va en una columna de 40), sin contorno ni fondo en reposo (en hover se marca con un
         fondo suave). Abre el ContextMenu del botón (MenuDesplegableHelper). -->
    <Style x:Key="RowMenuButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Casilla compacta de grilla (16 x 16): la de WPF-UI mide 20 y se ve enorme en una fila de 44. Marcada y en estado
         intermedio (algunas filas marcadas) se rellena de carmín; el estado intermedio dibuja un guion. -->
    <Style x:Key="CheckBoxCompactStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="16" Height="16" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Caja"
                                Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource TextMutedBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        <Path x:Name="Marca"
                              Data="M 3.5,8.5 L 6.8,11.5 L 12.5,5"
                              Stroke="White"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Visibility="Collapsed" />
                        <Rectangle x:Name="Guion"
                                   Width="8"
                                   Height="2"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Fill="White"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Guion" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ítem destructivo de un menú (dar de baja): texto rojo; deshabilitado se apaga como los demás ítems, para que el rojo
         no llame la atención sobre una acción que no se puede ejecutar. Un ícono que deba seguirlo enlaza su Foreground al
         del MenuItem. -->
    <Style x:Key="MenuItemDangerStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================= -->
    <!-- COMPONENTES DE PÁGINA: PageHeader Y BulkActionBar                 -->
    <!-- ================================================================= -->
    <!-- Plantillas de los controles de Views/Components. El Content de ambos (las acciones) hereda el DataContext de la
         página, así que sus botones se enlazan a los comandos del ViewModel sin puentes. -->
    <Style TargetType="{x:Type components:PageHeader}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:PageHeader}">
                    <DockPanel LastChildFill="False">
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Titulo}"
                                       Style="{StaticResource TextBlockPageTitle}" />
                            <TextBlock x:Name="TextoSubtitulo"
                                       Text="{TemplateBinding Subtitulo}"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <!-- Sin subtítulo no queda una línea vacía: el título se centra con las acciones -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitulo" Value="">
                            <Setter TargetName="TextoSubtitulo" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "✕" del badge de selección: círculo de 16 con la cruz en carmín; en hover se rellena de carmín y la cruz pasa a
         blanco, para que se lea como botón sobre el fondo rosa del badge -->
    <Style x:Key="BadgeCancelButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Acciones masivas, sin recuadro que las contenga: a la izquierda el badge "N seleccionados ✕" (fondo rosa como el de
         las filas marcadas, texto carmín; la "✕" cancela la selección); a la derecha, las acciones de la página (su
         Content), que aparecen solo con selección. Va en la barra del buscador (ListToolbar.AccionesDeSeleccion), en lugar
         de "Limpiar filtros", la carga y el contador. Mide lo mismo que el buscador (40) para que la página no se desplace. -->
    <Style TargetType="{x:Type components:BulkActionBar}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:BulkActionBar}">
                    <DockPanel LastChildFill="False" Height="40">
                        <Border DockPanel.Dock="Left"
                                Background="{DynamicResource PrimaryLightBrush}"
                                CornerRadius="14"
                                Height="28"
                                Padding="12,0,6,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding TextoSeleccion}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Command="{TemplateBinding ComandoCancelar}"
                                        Style="{StaticResource BadgeCancelButtonStyle}"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Cancelar selección"
                                        AutomationProperties.Name="Cancelar selección">
                                    <iconPacks:PackIconBoxIcons Kind="RegularX" Width="9" Height="9" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
