<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:components="clr-namespace:Retail.App.Views.Components">

    <!-- ================================================================= -->
    <!-- LISTADOS: BUSCADOR + FILTROS + GRILLA (Artículos, Clientes, ...)  -->
    <!-- ================================================================= -->
    <!-- Estilos compartidos por las páginas de listado. Se cargan después de Controls.xaml porque derivan de sus estilos.
         DataGridRetailStyle sigue siendo la grilla compacta (POS, modales); DataGridListadoStyle es la de las páginas. -->

    <!-- Encabezado liviano: texto chico en gris suave sobre la tarjeta, con una línea inferior; mide lo mismo que una fila
         (36) para que la grilla no tenga un salto de ritmo entre el título y los datos. -->
    <Style x:Key="DataGridColumnHeaderListadoStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderRetailStyle}">
        <Setter Property="MinHeight" Value="{StaticResource RowHeightListado}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DataGridColumnHeaderRightListadoStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderListadoStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="DataGridColumnHeaderCenterListadoStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderListadoStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Fila de una línea (36 px). La selección es un gris neutro (el carmín se reserva para la acción principal, el foco
         y la casilla marcada); el hover es un gris más suave que no se confunde con la selección. Es una copia de la plantilla
         de DataGridRowRetailStyle sin los triggers de la plantilla: la selección y el hover viven en Style.Triggers para que
         un estilo derivado los pueda redefinir (un trigger de ControlTemplate no se puede sobrescribir desde afuera). Una
         página con casillas de selección deriva este estilo y hace que el tinte siga a la casilla y no a la fila actual. -->
    <Style x:Key="DataGridRowListadoStyle" TargetType="DataGridRow">
        <Setter Property="Height" Value="{StaticResource RowHeightListado}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="DGR_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Column="1"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <DataGridDetailsPresenter Grid.Column="1"
                                                      Grid.Row="1"
                                                      SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                      Visibility="{TemplateBinding DetailsVisibility}" />
                            <DataGridRowHeader Grid.RowSpan="2"
                                               SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                               Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                        </SelectiveScrollingGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Grilla de las páginas de listado: ocupa todo el alto de su fila, así su borde redondeado llega hasta la paginación
         aunque haya pocas filas (el alto sobrante queda del color de la tarjeta) -->
    <Style x:Key="DataGridListadoStyle" TargetType="DataGrid" BasedOn="{StaticResource DataGridRetailStyle}">
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderListadoStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DataGridRowListadoStyle}" />
        <!-- La línea entre filas la dibuja la propia fila (borde inferior): sin esto se duplicaría -->
        <Setter Property="GridLinesVisibility" Value="None" />
    </Style>

    <!-- ================================================================= -->
    <!-- SUPERFICIE DE TABLA Y PAGINACIÓN                                  -->
    <!-- ================================================================= -->
    <!-- La tabla es la única superficie de la página: buscador y acciones van sobre el fondo, sin tarjeta que los agrupe.
         Contiene la grilla (sin borde propio, esquinas de arriba de 7: radio 8 menos el borde de 1) y, como continuación,
         la paginación separada por una línea. -->
    <Style x:Key="TablaListadoStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PaginacionTextoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- "Página [n]": cuadro de 28 con contorno, número centrado. Plantilla propia: el TextBox de WPF-UI mide 32
         y trae botón de borrar. -->
    <Style x:Key="PaginacionCuadroStyle" TargetType="TextBox">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumeric}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Marco"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMd}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource TextSubtleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chevron de las flechas: 16 x 16 trazado con Stroke sobre el lienzo de GeometryChevron* (Icons.xaml).
         Toma el Foreground del botón, así hereda el gris de reposo y la tinta plena del hover. -->
    <Style x:Key="PaginacionChevronStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- Primera / anterior / siguiente / última: cuadrado de 28 con contorno y chevron de 16; deshabilitado se apaga -->
    <Style x:Key="PaginacionFlechaStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRetailStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMd}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Número de página: sin contorno, 28 x 28. La actual, con el fondo gris de la selección y tinta plena
         (el carmín queda para las acciones) -->
    <Style x:Key="PaginacionNumeroStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumeric}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRetailStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource RadiusMd}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding EsActual}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================= -->
    <!-- FILTROS: ETIQUETA ARRIBA Y CONTROL DEBAJO                         -->
    <!-- ================================================================= -->
    <!-- Uso: <HeaderedContentControl Header="Rubro" Style="{StaticResource FilterFieldStyle}"><ComboBox .../></...>.
         Sin código: el encabezado se pinta como texto chico y el contenido ocupa todo el ancho de su columna. -->
    <Style x:Key="FilterFieldStyle" TargetType="HeaderedContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <ContentPresenter ContentSource="Header"
                                          Margin="{StaticResource StackXs}"
                                          TextElement.FontSize="{StaticResource FontSizeSm}"
                                          TextElement.FontWeight="Medium"
                                          TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selector de filtro: 32 px de alto y a todo el ancho de su columna (los textos largos no se cortan) -->
    <Style x:Key="ComboBoxFiltroStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ================================================================= -->
    <!-- BOTONES SECUNDARIOS DE LISTADO                                    -->
    <!-- ================================================================= -->
    <!-- Acción de texto sin borde ni fondo ("Limpiar filtros"): gris en reposo, fondo suave en hover. Es la versión
         neutra de GhostPrimaryButtonStyle, que queda para acciones de marca. -->
    <Style x:Key="GhostNeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostPrimaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Versión desplegable de GhostNeutralButtonStyle ("Más" en las acciones masivas): un ToggleButton que abre un menú
         (MenuDesplegableHelper) y queda hundido mientras el menú está abierto. BasedOn no cruza de Button a ToggleButton,
         así que repite la apariencia con los mismos tokens. -->
    <Style x:Key="GhostNeutralToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================= -->
    <!-- BANDA DE FILTROS Y MENÚ DE FILA                                   -->
    <!-- ================================================================= -->
    <!-- Superficie hundida que agrupa los filtros de un listado (gris suave sin borde, un escalón por debajo de la
         tarjeta). Adentro, la página arma un Grid de una fila con columnas "*" y un FilterField por columna. -->
    <Style x:Key="FilterBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Botón "⋮" de una fila: 28 x 28, sin contorno ni fondo en reposo (en hover se marca con un
         fondo suave). Es un ToggleButton que abre el ContextMenu del botón (MenuDesplegableHelper): mientras
         el menú está abierto el botón queda marcado (IsChecked) y se ve igual que presionado. -->
    <Style x:Key="RowMenuButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusMd}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Casilla compacta de grilla (16 x 16): la de WPF-UI mide 20 y se ve enorme en una fila de 36. Marcada y en estado
         intermedio (algunas filas marcadas) se rellena de carmín; el estado intermedio dibuja un guion. -->
    <Style x:Key="CheckBoxCompactStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="16" Height="16" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Caja"
                                Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource TextMutedBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        <Path x:Name="Marca"
                              Data="M 3.5,8.5 L 6.8,11.5 L 12.5,5"
                              Stroke="{DynamicResource ControlCheckedForegroundBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Visibility="Collapsed" />
                        <Rectangle x:Name="Guion"
                                   Width="8"
                                   Height="2"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Fill="{DynamicResource ControlCheckedForegroundBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource TextSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource ControlCheckedBrush}" />
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource ControlCheckedBrush}" />
                            <Setter TargetName="Guion" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- FILTRO DE COLUMNA (FiltroColumna)                                  -->
    <!-- ================================================================= -->
    <!-- Embudo de la cabecera (20 x 20). Mismo comportamiento que "⋮": queda hundido con el panel abierto. Con un filtro
         aplicado se resalta (fondo SurfaceSelected e ícono carmín) para que se vea desde la grilla qué columnas filtran. -->
    <Style x:Key="FiltroColumnaBotonStyle" TargetType="ToggleButton" BasedOn="{StaticResource RowMenuButtonStyle}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HayFiltroActivo}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Panel flotante del filtro: tarjeta con borde, radio 8 y la sombra de las superficies flotantes. El margen deja lugar
         a la sombra dentro del Popup transparente. -->
    <Style x:Key="FiltroColumnaPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Margin" Value="8,4,8,12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource ElevationShadowColor}"
                                  Opacity="0.18"
                                  BlurRadius="16"
                                  ShadowDepth="4"
                                  Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opción del filtro: toda la fila es clicable (casilla de 16 + texto), con hover suave. La casilla es la misma de
         CheckBoxCompactStyle; el estado intermedio (grupo con algunas marcadas) dibuja un guion. -->
    <Style x:Key="CheckBoxOpcionFiltroStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRetailStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Fila"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Border x:Name="Caja"
                                        Background="{DynamicResource SurfaceCardBrush}"
                                        BorderBrush="{DynamicResource TextMutedBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}" />
                                <Path x:Name="Marca"
                                      Data="M 3.5,8.5 L 6.8,11.5 L 12.5,5"
                                      Stroke="{DynamicResource ControlCheckedForegroundBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                                <Rectangle x:Name="Guion"
                                           Width="8"
                                           Height="2"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{DynamicResource ControlCheckedForegroundBrush}"
                                           Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fila" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource TextSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource ControlCheckedBrush}" />
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource ControlCheckedBrush}" />
                            <Setter TargetName="Guion" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ítem destructivo de un menú (dar de baja): texto rojo; deshabilitado se apaga como los demás ítems, para que el rojo
         no llame la atención sobre una acción que no se puede ejecutar. Un ícono que deba seguirlo enlaza su Foreground al
         del MenuItem. -->
    <Style x:Key="MenuItemDangerStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================= -->
    <!-- COMPONENTES DE PÁGINA: PageHeader Y BulkActionBar                 -->
    <!-- ================================================================= -->
    <!-- Plantillas de los controles de Views/Components. El Content de ambos (las acciones) hereda el DataContext de la
         página, así que sus botones se enlazan a los comandos del ViewModel sin puentes. -->
    <Style TargetType="{x:Type components:PageHeader}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:PageHeader}">
                    <DockPanel LastChildFill="False">
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Titulo}"
                                       Style="{StaticResource TextBlockPageTitle}" />
                            <TextBlock x:Name="TextoSubtitulo"
                                       Text="{TemplateBinding Subtitulo}"
                                       Style="{StaticResource TextBlockBodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <!-- Sin subtítulo no queda una línea vacía: el título se centra con las acciones -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitulo" Value="">
                            <Setter TargetName="TextoSubtitulo" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "✕" del badge de selección: cuadrado de 16 (radio 4, como la insignia) con la cruz en gris; en hover se rellena
         de un gris más claro que el badge y la cruz pasa a tinta plena, para que se lea como botón -->
    <Style x:Key="BadgeCancelButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusSm}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Acciones masivas, sin recuadro que las contenga: a la izquierda la insignia rectangular (radio 4, como las de la
         grilla) "N seleccionados ✕" (fondo gris como el de
         las filas marcadas, texto de tinta; la "✕" cancela la selección); a la derecha, las acciones de la página (su
         Content), que aparecen solo con selección. Va en la barra del buscador (ListToolbar.AccionesDeSeleccion), en lugar
         de "Limpiar filtros", la carga y el contador. Mide lo mismo que el buscador (32) para que la página no se desplace. -->
    <Style TargetType="{x:Type components:BulkActionBar}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:BulkActionBar}">
                    <DockPanel LastChildFill="False" Height="{StaticResource ControlHeight}">
                        <Border DockPanel.Dock="Left"
                                Background="{DynamicResource SurfaceSelectedBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Height="{StaticResource ControlHeightSm}"
                                Padding="8,0,6,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding TextoSeleccion}"
                                           FontSize="{StaticResource FontSizeBase}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Command="{TemplateBinding ComandoCancelar}"
                                        Style="{StaticResource BadgeCancelButtonStyle}"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Cancelar selección"
                                        AutomationProperties.Name="Cancelar selección">
                                    <iconPacks:PackIconBoxIcons Kind="RegularX" Width="9" Height="9" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
