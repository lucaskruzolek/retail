<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Retail.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Retail.Infrastructure.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Retail.Application\Retail.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="MiniExcel" Version="1.34.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView" Version="2.0.5" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!--
      D-13: referencias EXPLÍCITAS a SkiaSharp 3.119.0. LiveChartsCore.SkiaSharpView 2.0.5 pide por sí solo 2.88.9, pero
      LiveChartsCore.SkiaSharpView.WPF (Retail.App, Fase 5) pide 3.119.0. Sin estas líneas, NuGet resolvería 2.88.9 en
      Infrastructure, Retail.Cli y los tests, y 3.119.0 en la App: el mismo gráfico se dibujaría con dos motores distintos.
    -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.0" />
  </ItemGroup>

</Project>
