        string numero_comprobante
        datetime fecha_emision
        decimal subtotal
        decimal total
        string estado
        int id_pedido_origen "FK nullable, UK (filtered) (RF-29)"
        datetime deleted_at
    }

    DETALLE_COMPRAS {
        int id_detalle_compra PK
        int id_compra FK
        int id_articulo FK
        int cantidad
        decimal costo_unitario
        decimal subtotal_item
    }

    PEDIDOS {
        int id_pedido PK
        int id_proveedor FK "UK (filtered): un Borrador por proveedor"
        int id_usuario FK
        string estado "Borrador, Emitido, Recibido, Cancelado"
        datetime created_at
        datetime fecha_emision "nullable"
        datetime fecha_cierre "nullable"
        string motivo_cancelacion "nullable"
        rowversion row_version "concurrencia optimista (A-13)"
        datetime deleted_at
    }

    DETALLE_PEDIDOS {
        int id_detalle_pedido PK
        int id_pedido FK "UK composite con id_catalogo_proveedor"
        int id_articulo FK
        int id_catalogo_proveedor FK
        string codigo_proveedor "foto al agregar"
        string descripcion "foto al agregar"
        int cantidad ">= 1"
        decimal costo_pactado "foto al agregar, > 0"
    }

    REGISTROS_BACKUP {
        int id_registro_backup PK
        guid referencia UK "identidad estable entre bases (R-1)"
        string tipo "Manual | Automatico | PreRestauracion | PreMigracion"
        string estado "EnCurso | Exitoso | Verificado | Fallido | ArchivoPurgado"
        int id_usuario "foto del operador, sin FK"
        string nombre_usuario
        datetime fecha_inicio
        datetime fecha_fin
        string ruta_archivo
        bigint tamano_bytes
        string hash_sha256
        string ultima_migracion
        string version_app
        string mensaje_error
        datetime created_at
        datetime deleted_at
    }
