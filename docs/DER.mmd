    USUARIOS {
        int id_usuario PK
        string nombre_usuario UK
        string password_hash
        string nombre
        string apellido
        string email_recuperacion
        bool debe_cambiar_password
        int id_rol FK
        datetime deleted_at
        datetime created_at
    }

    ROLES {
        int id_rol PK
        string nombre_rol
        string descripcion
        datetime deleted_at
    }

    CLIENTES {
        int id_cliente PK
        string razon_social_o_nombre
        string tipo_documento
        string numero_documento UK
        string condicion_iva
        string domicilio_fiscal
        string telefono
        string email
        bool tiene_cuenta_corriente
        decimal limite_credito
        decimal saldo_cuenta_corriente
        datetime deleted_at
        datetime created_at
    }

    COBRANZAS_CLIENTES {
        int id_cobranza PK
        int id_cliente FK
        int id_turno FK
        int id_usuario FK
        datetime fecha_hora
        string medio_pago
        decimal monto
        string referencia
    }

    TURNOS_CAJA {
        int id_turno PK
        int id_usuario FK
        datetime fecha_apertura
        decimal saldo_inicial
        datetime fecha_cierre
        decimal total_ventas_efectivo
        decimal total_ingresos_efectivo
        decimal total_egresos_efectivo
        decimal saldo_teorico_efectivo
        decimal saldo_declarado_efectivo
        decimal diferencia_efectivo
        decimal total_ventas_electronicas
        decimal monto_retenido_en_caja
        string estado
    }

    MOVIMIENTOS_CAJA {
        int id_movimiento PK
        int id_turno FK
        string tipo_movimiento
        decimal monto
        string concepto
        datetime fecha_hora
    }

    RUBROS {
        int id_rubro PK
        string nombre_rubro "UK filtrado, Modern_Spanish_CI_AI"
        datetime deleted_at
    }

    CATEGORIAS {
        int id_categoria PK
        int id_rubro FK
        string nombre_categoria "UK filtrado, Modern_Spanish_CI_AI"
        datetime deleted_at
    }

    MARCAS {
        int id_marca PK
        string nombre_marca "UK filtrado, Modern_Spanish_CI_AI"
        datetime deleted_at
    }

    TERMINOS_CLASIFICACION {
        int id_termino PK
        string termino "UK filtrado, mayúsculas sin tildes (Track 6.6)"
        int id_categoria "FK nullable; NULL = término ambiguo"
        datetime deleted_at
    }

    PARES_CLASIFICACION {
        int id_par PK
        int id_termino FK "solo términos ambiguos (P-3, Dominio)"
        string segunda_palabra "UK filtrado con id_termino, CHECK una palabra"
        int id_categoria "FK nullable; NULL = par ignorado (P-4)"
        datetime deleted_at
    }

    ALIAS_MARCAS {
        int id_alias PK
        int id_marca FK
        string alias "UK filtrado (una sola marca)"
        datetime deleted_at
    }

    PREFIJOS_EAN_MARCAS {
        int id_prefijo PK
        int id_marca FK
        string prefijo "varchar(7), UK filtrado, CHECK 7 dígitos sin 2 inicial"
        datetime deleted_at
    }

    ARTICULOS {
        int id_articulo PK
        string codigo_barras "UK nullable (filtered)"
        string descripcion
        int id_categoria "FK nullable"
        int id_marca "FK nullable"
        string origen_categoria "nullable; Manual, SugerenciaAceptada o SugerenciaCorregida (Track 6.6)"
        string origen_marca "nullable; con id_marca NULL = Sin marca confirmada"
        int id_catalogo_proveedor "FK nullable, UK (filtered): fuente principal (A-16)"
        int id_articulo_origen "FK nullable (self, RF-21)"
        int unidades_por_origen "nullable, >= 1 si es derivado"
        decimal costo_reposicion
        decimal porcentaje_ganancia
        decimal precio_venta
        int stock_actual
        int stock_minimo
        bool es_servicio
        rowversion row_version "concurrencia optimista (D-12)"
        datetime deleted_at
    }

    PROVEEDORES {
        int id_proveedor PK
        string razon_social
        string cuit "UK (filtered)"
        string telefono
        string email
        bool clasifica_catalogo "default 0: preferencia del toggle al importar (Track 6.6, M-75)"
        datetime deleted_at
    }

    CATALOGOS_PROVEEDORES {
        int id_catalogo PK
        int id_proveedor FK
        string codigo_proveedor "UK composite (filtered)"
        string codigo_barras "nullable"
        string descripcion_proveedor
        string rubro_proveedor "nullable, texto del proveedor (Track 6.6, M-12)"
        string categoria_proveedor "nullable, texto del proveedor"
        string marca_proveedor "nullable, texto del proveedor"
        int id_articulo "FK nullable: articulo del que es fuente, principal o adicional (Track 4.3, A-1)"
        int id_categoria_sugerida "FK nullable, Restrict: dato derivado del motor (Track 6.6, M-72)"
        int id_marca_sugerida "FK nullable, Restrict: dato derivado del motor (M-72)"
        datetime fecha_clasificacion "nullable: nula = pendiente de clasificar (M-74)"
        decimal precio_costo
        datetime fecha_actualizacion
        datetime deleted_at
    }

    EQUIVALENCIAS_CLASIFICACION {
        int id_equivalencia PK
        int id_proveedor FK
        string tipo "Categoria o Marca"
        string texto_rubro "nullable, contexto (M-31)"
        string texto "UK filtrado con id_proveedor, tipo y texto_rubro"
        int id_categoria "FK nullable"
        int id_marca "FK nullable; sin destino = ignorada (M-32)"
        datetime deleted_at
    }

    VENTAS {
        int id_venta PK
        int id_turno FK
        int id_usuario FK
        int id_cliente "FK nullable (NULL = Consumidor Final)"
        int id_presupuesto_origen FK
        datetime fecha_hora
        decimal subtotal
        decimal descuento
        decimal total
        string estado_fiscal
        datetime deleted_at
    }

